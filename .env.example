# Every setting Openscholar reads. Copy this file to .env.local for the Next.js app.
# Settings in the second part belong to the Convex deployment: set each one with
#   npx convex env set NAME value
# Leave a setting empty to turn off what it powers, unless it says it's required.

# =============================================================================
# Part 1: the Next.js app (.env.local)
# =============================================================================

# Convex. Required. The deployment's API and HTTP actions addresses.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Which deployment `npx convex` pushes to: CONVEX_DEPLOYMENT for Convex Cloud,
# or the two CONVEX_SELF_HOSTED_* settings for a self-hosted backend.
CONVEX_DEPLOYMENT=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Clerk. Required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenAlex, the search source. A key raises the rate limit; the email goes in OpenAlex's polite pool.
OPENALEX_API_KEY=
OPENALEX_CONTACT_EMAIL=

# Shared with Convex (same value): lets the app ask for free question-to-query writing,
# and a signed-out visitor's AI overview, on a caller's behalf.
FREE_QUERIES_SECRET=

# Cloudflare Turnstile shows a signed-out visitor is a person before their AI overview.
# Cloudflare's testing keys always pass: 1x00000000000000000000BB and 1x0000000000000000000000000000000AA.
# The site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Openscholar's own search index, used once a site admin switches search to it.
# Set the same four on Convex.
OPENSCHOLAR_API_URL=
OPENSCHOLAR_API_KEY=
OPENSCHOLAR_API_ACCESS_CLIENT_ID=
OPENSCHOLAR_API_ACCESS_CLIENT_SECRET=

# Analytics, all optional. PostHog in the browser and on the server; with POSTHOG_API_KEY a
# production build uploads its source maps to PostHog and serves none.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=
POSTHOG_API_KEY=
NEXT_PUBLIC_GA_ID=

# Sites whose pages may call the contact routes (app/api/contact) from a browser, comma-separated.
CONTACT_ORIGINS=

# =============================================================================
# Part 2: the Convex deployment (npx convex env set NAME value)
# =============================================================================

# Required: Convex reports any of these that are missing (convex/lib/envValidation.ts).
# ENCRYPTION_KEY=                 # encrypts users' own AI keys and community credentials
# CLERK_JWT_ISSUER_DOMAIN=        # the Clerk issuer that Convex trusts
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=          # signing secret of the Stripe webhook to /webhooks/stripe
# AUTUMN_URL=                     # the self-hosted Autumn server
# AUTUMN_SECRET_KEY=
# AUTUMN_WEBHOOK_SECRET=          # signing secret of Autumn's webhook to /webhooks/autumn
# EVIDENCE_LIBRARY_PLATFORM_DOMAIN=   # the domain communities get addresses under
# PAPER_PDFS_ENDPOINT=            # S3-compatible store (Cloudflare R2) for downloaded PDFs
# PAPER_PDFS_BUCKET=
# PAPER_PDFS_ACCESS_KEY_ID=
# PAPER_PDFS_SECRET_ACCESS_KEY=

# Sign-in and links
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=   # signing secret (whsec_...) of Clerk's webhook to /webhooks/clerk
# NEXT_PUBLIC_APP_URL=            # the app's public address, for links in emails and redirects

# Billing extras
# AUTUMN_DASHBOARD_URL=           # shows a Plans link to Autumn's dashboard in Admin
# STRIPE_CARD_ONLY_CONFIG=        # a Stripe payment method configuration that takes a typed card only

# AI
# OPENROUTER_API_KEY=
# OPENROUTER_PROVIDER_ORDER=      # optional provider order for OpenRouter's routing
# OPENROUTER_ALLOW_FALLBACKS=
# AI_PROVIDER=                    # optional defaults for the platform's own model
# AI_MODEL=
# OPENAI_API_KEY=                 # only for direct OpenAI calls

# Search
# OPENALEX_API_KEY=
# OPENALEX_CONTACT_EMAIL=
# FREE_QUERIES_SECRET=            # same value as in the app
# OPENSCHOLAR_API_URL=            # same four as in the app
# OPENSCHOLAR_API_KEY=
# OPENSCHOLAR_API_ACCESS_CLIENT_ID=
# OPENSCHOLAR_API_ACCESS_CLIENT_SECRET=
# SEARCH_INDEX_FEED_CREDENTIAL_DIGEST=   # digest of the credential the search index uses to read the reports feed

# Zotero sync (OAuth application keys)
# ZOTERO_CLIENT_KEY=
# ZOTERO_CLIENT_SECRET=

# Reports
# REPORT_EMAILS=                  # "off" keeps report emails in their records without sending them (shared development)

# Analytics
# POSTHOG_KEY=
# POSTHOG_HOST=

# Evidence Communities: creating, updating and hosting communities on a Coolify server.
# GITHUB_TOKEN=                   # reads the community runtime's releases and image
# EL_COOLIFY_URL=
# EL_COOLIFY_TOKEN=
# EL_COOLIFY_PROJECT_UUID=
# EL_COOLIFY_SERVER_UUID=
# EL_COOLIFY_ENVIRONMENT=
# EL_COOLIFY_GITHUB_APP_UUID=     # the Coolify source that builds the community runtime
# EL_CONVEX_SITE_URL=             # this deployment's HTTP actions address, as communities reach it
# EL_OPENSCHOLAR_URL=             # the app's address, as communities link back to it
# EL_DATABASE_PROVISIONER_URL=    # the service that creates each community's database
# EL_DATABASE_PROVISIONER_TOKEN=
# EL_RUNTIME_VERIFIER_URL=        # the service that checks a community is up after a deploy
# EL_RUNTIME_VERIFIER_TOKEN=
# EL_VOLUME_DELETER_URL=          # the service that removes a deleted community's volumes
# EL_VOLUME_DELETER_TOKEN=
# EL_STORAGE_URL=                 # file storage for community uploads
# EL_STORAGE_SERVICE_KEY=
# EL_STORAGE_MAX_PDF_BYTES=
# EL_SMTP_HOST=                   # mail server communities send from
# EL_SMTP_PORT=
# EL_SMTP_SECURITY=
# EL_SMTP_USERNAME=
# EL_SMTP_PASSWORD=
# EL_SMTP_FROM=
# EL_CUSTOM_DOMAIN_TARGET=        # the host a community's custom domain points its CNAME at
# EL_CUSTOM_DOMAIN_APEX_IPV4=     # the address an apex custom domain points at
# EL_RESERVED_DOMAIN_SUFFIXES=    # extra names no community may claim
# EL_ZOTERO_TRANSLATION_URL=      # a Zotero translation-server
# EL_DEFAULT_LOGO_URL=            # branding a new community starts with
# EL_DEFAULT_LOGO_DARK_URL=
# EL_DEFAULT_FAVICON_URL=
# EL_DEFAULT_ICON_URLS_JSON=
# EL_ZENODO_SANDBOX_TOKEN=        # shared Zenodo Sandbox and Crossref Test accounts for test DOIs;
# EL_CROSSREF_SANDBOX_LOGIN_ID=   # a community's own accounts are verified and stored per community
# EL_CROSSREF_SANDBOX_PASSWORD=
# EL_CROSSREF_SANDBOX_PREFIX=
# EL_CROSSREF_SANDBOX_DEPOSITOR_NAME=
# EL_CROSSREF_SANDBOX_EMAIL=
# EL_CROSSREF_SANDBOX_REGISTRANT=
# EL_OFFER_PRERELEASES=           # "true" offers each runtime prerelease at once (development)
# EL_INDEXNOW=                    # "true" lets communities tell IndexNow search engines about changed records (production)
# EL_ALLOW_DEVELOPMENT_TEARDOWN=  # "true" allows deleting a community's services (development only)
