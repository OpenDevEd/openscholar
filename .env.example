# =============================================================================
# Hosted OpenScholar development services
# =============================================================================
# Keep Convex and Clerk hosted. Do not replace these Convex URLs with localhost.
NEXT_PUBLIC_CONVEX_URL=https://convex.opendev.space
NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-site.opendev.space
CONVEX_SELF_HOSTED_URL=https://convex.opendev.space
CONVEX_SELF_HOSTED_ADMIN_KEY=
EVIDENCE_LIBRARY_PLATFORM_DOMAIN=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=

# Shared publishing sandboxes. Custom accounts are verified and stored per library.
# Configure these on the Convex deployment.
# After rotating platform sandbox credentials, reverify and activate each sandbox library.
EL_ZENODO_SANDBOX_TOKEN=
EL_CROSSREF_SANDBOX_LOGIN_ID=
EL_CROSSREF_SANDBOX_PASSWORD=
EL_CROSSREF_SANDBOX_PREFIX=
EL_CROSSREF_SANDBOX_DEPOSITOR_NAME=
EL_CROSSREF_SANDBOX_EMAIL=
EL_CROSSREF_SANDBOX_REGISTRANT=

# Shared with Convex (same name): lets the Next server ask for free question-to-query writing, and a signed-out
# visitor's AI overview, on behalf of a caller.
FREE_QUERIES_SECRET=

# Cloudflare Turnstile, which shows a signed-out visitor is a person before their AI overview (#1070). One widget per
# site, in Hassan@opendeved.net's Cloudflare account. Locally, Cloudflare's testing keys: 1x00000000000000000000BB and
# 1x0000000000000000000000000000000AA always pass. The site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Our own search index (OpenDevEd/openscholar-api). Needed once a site admin switches search to it, in Convex and the app alike.
OPENSCHOLAR_API_URL=
OPENSCHOLAR_API_KEY=
OPENSCHOLAR_API_ACCESS_CLIENT_ID=
OPENSCHOLAR_API_ACCESS_CLIENT_SECRET=
