# =============================================================================
# Hosted OpenScholar development services
# =============================================================================
# Keep Convex and Clerk hosted. Do not replace these Convex URLs with localhost.
NEXT_PUBLIC_CONVEX_URL=https://convex.opendev.space
NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-site.opendev.space
CONVEX_SELF_HOSTED_URL=https://convex.opendev.space
CONVEX_SELF_HOSTED_ADMIN_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=

# =============================================================================
# Chat web search (Tavily — Path B)
# =============================================================================
# When set, the chat enables the visible-streaming "Searching the web…" tool
# step backed by Tavily's /search endpoint. Without it, the chat falls back to
# OpenRouter's server-side web search (Path A) which only emits source-url
# citations after the answer.
#
# Get a key at https://app.tavily.com (1 credit per basic call, 2 per advanced).
TAVILY_API_KEY=
