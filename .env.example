# Keep Convex and Clerk hosted. Do not replace these Convex URLs with localhost.
NEXT_PUBLIC_CONVEX_URL=https://convex.opendev.space
NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-site.opendev.space
CONVEX_SELF_HOSTED_URL=https://convex.opendev.space
CONVEX_SELF_HOSTED_ADMIN_KEY=
EVIDENCE_LIBRARY_PLATFORM_DOMAIN=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=

# Shared publishing sandboxes. Custom accounts are verified and stored per library.
# Configure these on the Convex deployment.
# After rotating platform sandbox credentials, reverify and activate each sandbox library.
EL_ZENODO_SANDBOX_TOKEN=
EL_CROSSREF_SANDBOX_LOGIN_ID=
EL_CROSSREF_SANDBOX_PASSWORD=
EL_CROSSREF_SANDBOX_PREFIX=
EL_CROSSREF_SANDBOX_DEPOSITOR_NAME=
EL_CROSSREF_SANDBOX_EMAIL=
EL_CROSSREF_SANDBOX_REGISTRANT=
