---
// One of the two organisations behind Openscholar, as a panel in its own colour: its mark, what it says it is, where its
// offices are, its people here (each a link to their page) and where to find it, with its picture on the right.
import Mark from "./Mark.astro";
import Arrow from "./Arrow.astro";
import { ORGS, TEAM, PLACE, LINK_NAMES, flag } from "../data/team.mjs";
import { LOGOS } from "../data/logos.mjs";
// `h` is the level of the panel's heading: 3 under the About page's own heading, 2 where the panel is a section of its own.
const { id, except, h = 3 } = Astro.props, Tag = `h${h}`, o = ORGS[id], people = TEAM.filter((m) => m.org === id && m.key !== except);
---
<article class="panel og" style={`--bg:${o.bg};--glow:${o.glow}`} aria-label={o.name}>
  <div class="og-art" aria-hidden="true"><img src={`/img/art-${o.art}.avif`} srcset={`/img/art-${o.art}-960.avif 960w, /img/art-${o.art}.avif 1672w`} sizes="(max-width: 900px) 100vw, 760px" width="1672" height="941" alt="" loading="lazy" decoding="async" /></div>
  <div class="og-in">
    <Tag class="og-h"><a class="logo" href={o.url} aria-label={o.name}><img src={`/img/team/${o.logo}-light.avif`} width={Math.round(o.tall * o.ratio)} height={o.tall} style={`height:${o.tall}px`} alt="" loading="lazy" /></a></Tag>
    <p>{o.line}</p>
    <ul class="base" aria-label="Offices">{o.base.map(([cc, city]) => <li><img src={flag(cc)} width="20" height="15" alt="" />{city}</li>)}</ul>
    {people.length > 0 && <ul class="faces" aria-label={`People from ${o.name}`}>{people.map((m) => <li><a href={`/about/${m.slug}/`} aria-label={m.name} style={`--at:${PLACE[m.place].bg}`}><img src={`/img/team/${m.key}-face.avif`} width="52" height="52" alt="" loading="lazy" /></a></li>)}</ul>}
    <div class="go"><a class="btn" href={o.url}>{o.host}<Arrow /></a><ul class="soc">{o.links.map(([kind, url]) => <li><a class="svc" href={url} aria-label={`${o.short} on ${LINK_NAMES[kind]}`} data-label={LINK_NAMES[kind]} style={`--brand:${LOGOS[kind].color}`}><Mark kind={kind} size={20} /></a></li>)}</ul></div>
  </div>
</article>
<style>
  .og { display: grid; min-height: 380px; padding: clamp(28px, 3.4vw, 48px) var(--pad); }
  /* The picture stands at the right, its empty left half under the words. */
  .og-art { position: absolute; right: 0; bottom: 0; z-index: -1; height: 100%; aspect-ratio: 1672 / 941; max-width: none; } .og-art img { width: 100%; height: 100%; transform-origin: 75% 100%; transition: scale 1.6s var(--ease); } @media (hover: hover) { .og:hover .og-art img { scale: 1.04; } }
  .og-in { display: grid; gap: 20px; justify-items: start; align-content: center; max-width: 440px; }
  /* The logo is the panel's heading, for anyone moving through the page by its headings. */
  .og-h { font: inherit; letter-spacing: inherit; } .logo { display: block; } .logo img { width: auto; } .og p { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; color: rgb(255 255 255 / .88); }
  .base { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; } .base li { display: inline-flex; align-items: center; gap: 8px; } .base img { border-radius: 3px; box-shadow: 0 0 0 1px rgb(255 255 255 / .22); }
  .faces { display: flex; } .faces li + li { margin-left: -8px; } .faces a { display: block; border-radius: 50%; background: var(--at); box-shadow: 0 0 0 3px var(--bg); transition: translate .3s var(--ease), box-shadow .3s var(--ease); } @media (hover: hover) { .faces a:hover { position: relative; translate: 0 -5px; box-shadow: 0 0 0 2px #fff; } } .faces img { width: 52px; height: 52px; border-radius: 50%; }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 4px; } .soc { display: flex; gap: 10px; }
  /* Narrow: the words above, the picture below them. */
  @media (min-width: 761px) and (max-width: 900px) { .og-in { max-width: 360px; } }
  @media (max-width: 760px) { .og { padding-bottom: 0; } .og-art { order: 2; position: relative; width: calc(100% + 2 * var(--pad)); height: auto; margin: 8px calc(-1 * var(--pad)) 0; aspect-ratio: 16 / 9; } .og-art img { object-fit: cover; object-position: 100% 100%; } .og-in { max-width: none; } }
  @media (max-width: 420px) { .faces img { width: 44px; height: 44px; } }
</style>
