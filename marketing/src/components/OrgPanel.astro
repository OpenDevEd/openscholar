---
// One of the two organisations behind Openscholar, as a panel in its own colour: its mark, what it says it is, where its
// offices are, its people here (each a link to their page) and where to find it, with its picture on the right. A panel
// narrower than 729 px (a phone's, or one of the two side by side on the About page) has its picture along its foot instead.
// It measures itself, so it needs no telling where it stands.
import Mark from "./Mark.astro";
import Arrow from "./Arrow.astro";
import { ORGS, TEAM, PLACE, LINK_NAMES, flag } from "../data/team.mjs";
import { LOGOS } from "../data/logos.mjs";
// `h` is the level of the panel's heading: 3 under the About page's own heading, 2 where the panel is a section of its own.
const { id, except, h = 3 } = Astro.props, Tag = `h${h}`, o = ORGS[id], people = TEAM.filter((m) => m.org === id && m.key !== except);
---
<div class="ogc"><article class="panel og" style={`--bg:${o.bg};--glow:${o.glow}`} aria-label={o.name}>
  <div class="og-art" aria-hidden="true"><img src={`/img/art-${o.art}.avif`} srcset={`/img/art-${o.art}-960.avif 960w, /img/art-${o.art}.avif 1672w`} sizes="(max-width: 900px) 100vw, 760px" width="1672" height="941" alt="" loading="lazy" decoding="async" onload="this.dataset.loaded = ''" onerror="this.dataset.loaded = ''" /></div>
  <div class="og-in">
    <Tag class="og-h"><a class="logo" href={o.url} aria-label={o.name}><img src={`/img/team/${o.logo}-light.avif`} width={Math.round(o.tall * o.ratio)} height={o.tall} style={`height:${o.tall}px`} alt="" loading="lazy" onload="this.dataset.loaded = ''" onerror="this.dataset.loaded = ''" /></a></Tag>
    <p>{o.line}</p>
    <ul class="base" aria-label="Offices">{o.base.map(([cc, city]) => <li><img src={flag(cc)} width="20" height="15" alt="" />{city}</li>)}</ul>
    {people.length > 0 && <ul class="faces" aria-label={`People from ${o.name}`}>{people.map((m) => <li><a href={`/about/${m.slug}/`} aria-label={m.name} style={`--at:${PLACE[m.place].bg}`}><img src={`/img/team/${m.key}-face.avif`} width="52" height="52" alt="" loading="lazy" data-portrait={m.slug} /></a></li>)}</ul>}
    <div class="go"><a class="btn" href={o.url} target="_blank" rel="noopener">{o.host}<Arrow /></a><ul class="soc">{o.links.map(([kind, url]) => <li><a class="svc" href={url} target="_blank" rel="noopener" aria-label={`${o.short} on ${LINK_NAMES[kind]}`} data-label={LINK_NAMES[kind]} style={`--brand:${LOGOS[kind].color}`}><Mark kind={kind} size={20} /></a></li>)}</ul></div>
  </div>
</article></div>
<style>
  .ogc { display: grid; container-type: inline-size; }
  .og { display: grid; min-height: 380px; padding: var(--pad); }
  /* The picture stands at the right, its empty left half under the words. */
  .og-art { position: absolute; right: 0; bottom: 0; z-index: -1; height: 100%; aspect-ratio: 1672 / 941; max-width: none; } .og-art img { width: 100%; height: 100%; transform-origin: 75% 100%; transition: scale 1.6s var(--ease), opacity .6s var(--ease); } :global(html.js) .og-art img:not([data-loaded]) { opacity: 0; } @media (hover: hover) { .og:hover .og-art img { scale: 1.04; } }
  .og-in { display: grid; gap: 20px; justify-items: start; align-content: center; max-width: 440px; }
  /* The logo is the panel's heading, for anyone moving through the page by its headings. Like the picture, it fades in
     when it lands. */
  .og-h { font: inherit; letter-spacing: inherit; } .logo img { width: auto; transition: opacity .5s var(--ease); } :global(html.js) .logo img:not([data-loaded]) { opacity: 0; }
  /* Where two panels stand side by side, the pair gives both logos a box as tall as the taller one (--logo-box), so every
     row under them is level. A panel on its own has none. */
  .logo { display: grid; align-items: center; height: var(--logo-box, auto); } .og p { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; color: rgb(255 255 255 / .88); }
  .base { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; } .base li { display: inline-flex; align-items: center; gap: 8px; } .base img { border-radius: 3px; box-shadow: 0 0 0 1px rgb(255 255 255 / .22); }
  .faces { display: flex; } .faces li + li { margin-left: -8px; } .faces a { display: block; border-radius: 50%; background: var(--at); box-shadow: 0 0 0 3px var(--bg); transition: translate .3s var(--ease), box-shadow .3s var(--ease); } .faces a:focus-visible { position: relative; translate: 0 -5px; } @media (hover: hover) { :global(html:not(.cold)) .faces a:hover { position: relative; translate: 0 -5px; box-shadow: 0 0 0 2px #fff; } } .faces img { width: 52px; height: 52px; border-radius: 50%; }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 4px; } .soc { display: flex; gap: 10px; }
  /* A panel not much wider than its words keeps them in a narrower column, and its picture a little further right, so
     the row of link buttons stays clear of it. */
  @container (729px <= width <= 868px) { .og-in { max-width: 360px; } .og-art { right: -88px; } }
  /* Narrower still: the words above, and the picture along the foot with its empty sky cropped off. Two such panels side
     by side are the same height, so the words start at the top and both pictures stand on one line. */
  @container (width < 729px) { .og { grid-template-rows: 1fr auto; padding-bottom: 0; } .og-art { order: 2; position: relative; width: calc(100% + 2 * var(--pad)); height: auto; margin: 8px calc(-1 * var(--pad)) 0; aspect-ratio: 21 / 9; } .og-art img { object-fit: cover; object-position: 100% 100%; } .og-in { max-width: none; align-content: start; } }
  @media (max-width: 420px) { .faces img { width: 44px; height: 44px; } }
</style>
