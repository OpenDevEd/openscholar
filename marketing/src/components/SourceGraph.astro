---
// How a community comes together, drawn as what it is: your sources run through your rules into one place, and readers get everything out of it.
import Icon from "./Icon.astro";
const Z = "M21.231 2.462 7.18 20.923h14.564V24H2.256v-2.462L16.308 3.076H2.975V0h18.256v2.462z";
const sources = [["zotero", "Zotero group", "Two-way sync, PDFs included"], ["openscholar", "OpenScholar collection", "Anything your team has gathered"], ["search", "Saved search", "Fetches only what changed"], ["pen", "Your team", "Records you write yourselves"]];
const outs = [["search", "Search and filter", "#22d3ee", "c-search-laptop-light"], ["globe", "Maps of your field", "#38bdf8", "c-map-laptop-light"], ["spark", "Ask AI, with sources", "#fbbf24", "c-home2-laptop-light"], ["mail", "Digests of new work", "#34d399", "c-home-laptop-light"], ["cite", "Citations and exports", "#fb7185", "c-search-laptop-dark"]];
const H = 640, sy = (i) => 110 + i * 140, oy = (i) => 88 + i * 116, CY = H / 2;
const types = [["Randomised trial", 94, "#6ee7b7"], ["Narrative review", 81, "#fde68a"], ["Modelling study", 52, "#fda4af"]];
---
<div class="stages" aria-hidden="true"><span>Connect your sources</span><span>Read by AI as they arrive</span><span>Go live</span></div>
<div class="graph" data-in>
  <img class="fib" src="/img/art-fibres.avif" srcset="/img/art-fibres-960.avif 960w, /img/art-fibres.avif 1672w" sizes="100vw" width="1672" height="941" loading="lazy" decoding="async" alt="" aria-hidden="true" />
  <svg class="lines" viewBox="0 0 1000 640" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <defs><linearGradient id="g-in" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".12" /><stop offset="1" stop-color="#fff" stop-opacity=".7" /></linearGradient></defs>
    {sources.map((_, i) => <><path class="ln" d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="url(#g-in)" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i}`} d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="#fff" stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
    {outs.map(([, , c], i) => <><path class="ln" d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-opacity=".55" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i + 2}`} d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
  </svg>
  <ul class="srcs" aria-label="Where a community's records come from">{sources.map(([k, t, d], i) => <li style={`top:${(sy(i) / H) * 100}%;--i:${i}`}><i class="logo">{k === "zotero" ? <svg viewBox="0 0 24 24" width="22" height="22" fill="#cc2936" aria-hidden="true"><path d={Z} /></svg> : k === "openscholar" ? <img src="/favicon.svg" width="24" height="24" alt="" /> : <Icon name={k === "pen" ? "pen" : "search"} size={20} />}</i><span><b>{t}</b><em>{d}</em></span></li>)}</ul>
  <div class="hub"><img class="gem" src="/img/art-hub.avif" width="1672" height="941" loading="lazy" decoding="async" alt="" /><img class="logo-m" src="/favicon.svg" width="36" height="36" alt="" /><b>Your community</b></div>
  <div class="sv" aria-label="Screened against your subject: what doesn't fit is left out">
    <div class="drop" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <i class:list={["sh", { off: i === 3 }]} style={`--i:${i}`}><u></u><u></u><u></u></i>)}</div>
    <img class="obj" src="/img/gem-funnel.avif" width="240" height="240" loading="lazy" decoding="async" alt="" />
    <div class="note l"><b>Screened against your subject</b><span>AI checks what comes in</span></div>
    <div class="note r"><i aria-hidden="true"><Icon name="flagq" size={12} /></i><span>Soil carbon in alpine meadows</span><em>left out</em></div>
  </div>
  <div class="lb" aria-label="Labelled by AI, corrected by your editors">
    <img class="obj" src="/img/gem-tag.avif" width="240" height="240" loading="lazy" decoding="async" alt="" />
    <div class="note l"><b>Labelled by AI</b><span>Corrected by your editors</span></div>
    <ul class="types">{types.map(([t, v, c], i) => <li style={`--c:${c};--v:${v}%;--i:${i}`} class:list={{ low: v < 60 }}><b>{t}</b><u aria-hidden="true"></u>{v < 60 ? <em>uncertain</em> : <em>{v}%</em>}</li>)}</ul>
  </div>
  <ul class="outs" aria-label="What readers get">{outs.map(([k, t, c, img], i) => <li style={`top:${(oy(i) / H) * 100}%;--c:${c};--i:${i}`}><img class="thumb" src={`/img/screens/${img}-1000.avif`} width="96" height="60" loading="lazy" decoding="async" alt="" /><b>{t}</b></li>)}</ul>
</div>
<style>
  /* Above the gem: papers fall into a glass funnel, and one that doesn't fit veers away. Below it: the same records leave with a label. */
  .sv, .lb { position: absolute; z-index: 2; left: 50%; translate: -50% 0; width: min(46%, 500px); height: 196px; font-size: 13px; line-height: 1.25; } .sv { top: 0; } .lb { bottom: 0; }
  .obj { position: absolute; left: 50%; width: 112px; height: 112px; translate: -50% 0; filter: drop-shadow(0 12px 22px rgb(30 0 8 / .7)); } .sv .obj { top: 54px; } .lb .obj { top: 16px; }
  .drop { position: absolute; left: 50%; top: 0; width: 180px; height: 92px; translate: -50% 0; } .sh { position: absolute; left: calc(var(--i) * 34px + 8px); top: 0; display: grid; align-content: start; gap: 3px; width: 26px; height: 34px; padding: 6px 5px; border-radius: 3px; background: #fffdf6; box-shadow: 0 6px 12px -4px rgb(30 0 8 / .7); animation: fall 6s var(--ease) calc(var(--i) * 1.2s) infinite both; } .sh u { display: block; height: 2px; border-radius: 1px; background: rgb(10 26 63 / .22); } .sh u:first-child { background: rgb(10 26 63 / .5); }
  @keyframes fall { 0% { transform: translate(0, -14px); opacity: 0; } 10%, 22% { transform: none; opacity: 1; } 42% { transform: translate(calc((2 - var(--i)) * 34px), 74px) scale(.5); opacity: 1; } 48%, 100% { transform: translate(calc((2 - var(--i)) * 34px), 84px) scale(.3); opacity: 0; } }
  .sh.off { animation-name: veer; } @keyframes veer { 0% { transform: translate(0, -14px); opacity: 0; } 10%, 22% { transform: none; opacity: 1; } 38% { transform: translate(-6px, 40px) rotate(-8deg); opacity: 1; } 62%, 100% { transform: translate(64px, 104px) rotate(34deg); opacity: 0; } }
  .graph:not(.in) .sh, :global(.away) .sh { animation-play-state: paused; }
  .note { position: absolute; display: grid; gap: 2px; width: 150px; } .note.l { right: calc(50% + 66px); text-align: right; } .sv .note.l { top: 76px; } .lb .note.l { top: 44px; } .note b { font-weight: 500; font-size: 15px; line-height: 1.2; } .note span { opacity: .8; }
  .note.r { left: calc(50% + 66px); top: 84px; grid-template-columns: 18px minmax(0, 1fr); column-gap: 8px; align-items: start; } .note.r i { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; background: rgb(255 255 255 / .12); } .note.r em { grid-column: 2; font-style: normal; font: 400 12px/1.2 var(--mono); color: #fda4af; }
  .graph .types { position: absolute; inset: auto; left: calc(50% + 66px); top: 26px; display: grid; width: 180px; gap: 9px; pointer-events: auto; } .graph .types li { position: static; translate: none; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3px 8px; align-items: baseline; } .types b { font-weight: 500; font-size: 13px; color: var(--c); } .types em { font-style: normal; font: 400 12px/1 var(--mono); opacity: .9; } .types u { grid-column: 1 / -1; grid-row: 2; display: block; height: 3px; border-radius: 2px; background: linear-gradient(90deg, var(--c) var(--v), rgb(255 255 255 / .14) 0); text-decoration: none; } .low em { color: var(--c); }
  .fib { position: absolute; z-index: -1; left: 50%; top: 50%; width: max(100vw, 1100px); max-width: none; height: auto; translate: -50% -50%; opacity: .8; -webkit-mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); }
  .stages { display: grid; grid-template-columns: 25% minmax(0, 1fr) 25%; margin-bottom: 14px; font: 400 14px/1.3 var(--mono); color: rgb(255 255 255 / .72); } .stages span:nth-child(2) { text-align: center; }
  .thumb { flex: none; width: 76px; height: 50px; border-radius: 8px; object-fit: cover; object-position: top left; box-shadow: 0 0 0 1px rgb(255 255 255 / .2), 0 8px 18px -8px #000; }
  .graph { position: relative; height: 640px; } .lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pulse { opacity: 0; stroke-dasharray: 6 94; stroke-linecap: round; animation: travel 3.4s linear 3; animation-delay: calc(var(--i) * .4s + 1.2s); } @keyframes travel { from { stroke-dashoffset: 0; opacity: 1; } 96% { opacity: 1; } to { stroke-dashoffset: -100; opacity: 0; } }
  ul { position: absolute; inset: 0; pointer-events: none; } li { position: absolute; display: flex; align-items: center; gap: 12px; pointer-events: auto; translate: 0 -50%; transition: transform .25s var(--ease); }
  .srcs li { left: 0; width: 25%; min-height: 72px; padding: 10px 12px; border-radius: 16px; background: rgb(50 4 18 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); } .srcs li:hover { transform: translateX(4px); }
  .logo { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: #fff; color: var(--ink); box-shadow: 0 6px 14px -6px rgb(0 0 0 / .5); } .srcs b, .outs b { display: block; font-weight: 500; line-height: 1.25; } .srcs em { display: block; font-style: normal; font-size: 13px; line-height: 1.3; opacity: .78; }
  .outs li { left: 75%; width: 25%; padding: 7px 10px; border-radius: 14px; background: rgb(50 4 18 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); }  .outs li:hover { transform: translateX(-4px); }
  .hub { position: absolute; left: 39%; width: 22%; min-width: 220px; top: 50%; translate: 0 -50%; display: grid; justify-items: center; gap: 6px; padding: 18px 14px; color: #fff; text-align: center; isolation: isolate; } .gem { position: absolute; z-index: -1; left: 50%; top: 50%; width: 300%; max-width: none; height: auto; translate: -50% -50%; -webkit-mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); } .logo-m { filter: brightness(0) invert(1); } .hub b { font-weight: 500; font-size: 20px; letter-spacing: -.01em; text-shadow: 0 1px 10px rgb(60 0 10 / .9); } .hub > span { font-size: 13px; line-height: 1.3; text-shadow: 0 1px 8px rgb(60 0 10 / .9); }
  :global(.js) .graph[data-in] { opacity: 1; transform: none; } :global(.js) .graph .ln { stroke-dasharray: 1400; stroke-dashoffset: 1400; } :global(.js) .graph.in .ln { stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s var(--ease) .2s; } :global(.js) .graph .srcs li, :global(.js) .graph .outs li, :global(.js) .graph .hub, :global(.js) .graph .sv, :global(.js) .graph .lb { opacity: 0; } :global(.js) .graph.in .srcs li, :global(.js) .graph.in .outs li { opacity: 1; transition: opacity .6s var(--ease) calc(var(--i) * .1s + .1s), transform .25s var(--ease); } :global(.js) .graph.in .outs li { transition-delay: calc(var(--i) * .1s + .9s), 0s; } :global(.js) .graph.in .hub, :global(.js) .graph.in .sv, :global(.js) .graph.in .lb { opacity: 1; transition: opacity .7s var(--ease) .45s; }
  @media (prefers-reduced-motion: reduce) { .pulse { display: none; } .sh { opacity: 1; } }
  @media (max-width: 900px) { .graph { height: auto; display: grid; gap: 16px; } .lines, .fib { display: none; } ul { position: static; display: grid; gap: 8px; } li { position: static; translate: none; } .srcs li, .outs li { width: auto; } .outs { grid-template-columns: 1fr; } .stages { display: none; } .hub { position: relative; left: 0; top: 0; translate: none; width: auto; padding-block: 44px; overflow: clip; } .gem { width: 180%; } .sv, .lb { position: relative; left: 0; translate: none; width: 100%; height: 196px; } .note.l { right: auto; left: 0; width: calc(50% - 64px); text-align: left; } .note.r, .graph .types { left: calc(50% + 62px); width: calc(50% - 62px); } .graph .types { position: absolute; } }
</style>
