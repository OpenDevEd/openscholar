---
// How a community comes together, drawn as what it is: your sources run through your rules into one place, and readers get everything out of it.
import Icon from "./Icon.astro";
const Z = "M21.231 2.462 7.18 20.923h14.564V24H2.256v-2.462L16.308 3.076H2.975V0h18.256v2.462z";
const sources = [["zotero", "Zotero group", "Two-way sync, PDFs included"], ["openscholar", "Openscholar collection", "Anything your team has gathered"], ["search", "Saved search", "Fetches only what changed"], ["pen", "Your team", "Records you write yourselves"]];
const outs = [["search", "Search and filter", "#22d3ee", "c-search-laptop-light"], ["globe", "Maps of your field", "#38bdf8", "c-map-laptop-light"], ["spark", "Ask AI, with sources", "#fbbf24", "c-home2-laptop-light"], ["mail", "Digests of new work", "#34d399", "c-home-laptop-light"], ["cite", "Citations and exports", "#fb7185", "c-search-laptop-dark"]];
const H = 640, sy = (i) => 110 + i * 140, oy = (i) => 88 + i * 116, CY = H / 2;
// The two steps in the middle share one card, so they read as a pair: what the step is, then three records going through it.
const steps = [
  { cls: "sv", obj: "gem-funnel", title: "Screened against your subject", sub: "AI checks what comes in", rows: [["Peer tutoring and reading fluency"], ["Reading tutors in rural schools"], ["Soil carbon in alpine meadows", "Left out"]] },
  { cls: "lb", obj: "gem-tag", title: "Labelled by AI", sub: "Corrected by your editors", rows: [["Randomised trial"], ["Narrative review"], ["Modelling study", "Uncertain"]] },
];
---
<div class="stages" aria-hidden="true"><span>Connect your sources</span><span>Read by AI as they arrive</span><span>Go live</span></div>
<div class="graph" data-in>
  <img class="fib" src="/img/art-fibres.avif" srcset="/img/art-fibres-960.avif 960w, /img/art-fibres.avif 1672w" sizes="100vw" width="1672" height="941" loading="lazy" decoding="async" alt="" aria-hidden="true" />
  <svg class="lines" viewBox="0 0 1000 640" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <defs><linearGradient id="g-in" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".12" /><stop offset="1" stop-color="#fff" stop-opacity=".7" /></linearGradient></defs>
    {sources.map((_, i) => <><path class="ln" d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="url(#g-in)" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i}`} d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="#fff" stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
    {outs.map(([, , c], i) => <><path class="ln" d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-opacity=".55" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i + 2}`} d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
  </svg>
  <ul class="srcs" aria-label="Where a community's records come from">{sources.map(([k, t, d], i) => <li style={`top:${(sy(i) / H) * 100}%;--i:${i}`}><i class="logo">{k === "zotero" ? <svg viewBox="0 0 24 24" width="22" height="22" fill="#cc2936" aria-hidden="true"><path d={Z} /></svg> : k === "openscholar" ? <img src="/favicon.svg" width="24" height="24" alt="" /> : <Icon name={k === "pen" ? "pen" : "search"} size={20} />}</i><span><b>{t}</b><em>{d}</em></span></li>)}</ul>
  <div class="hub"><img class="gem" src="/img/art-hub.avif" width="1672" height="941" loading="lazy" decoding="async" alt="" /><img src="/favicon-dark.svg" width="36" height="36" alt="" /><b>Your community</b></div>
  {steps.map(({ cls, obj, title, sub, rows }) => <div class:list={["step", cls]}>
    <div class="st-h"><div class="pic" aria-hidden="true"><img src={`/img/${obj}.avif`} width="240" height="240" loading="lazy" decoding="async" alt="" />{cls === "sv" && [0, 1, 2].map((i) => <i class:list={["sh", { off: i === 2 }]} style={`--i:${i}`}></i>)}</div><div><b>{title}</b><span>{sub}</span></div></div>
    <ul class="rows">{rows.map(([t, flag]) => <li class:list={{ flag }}><Icon name={flag ? "flagq" : "check"} size={14} /><span>{t}</span>{flag && <em>{flag}</em>}</li>)}</ul>
  </div>)}
  <ul class="outs" aria-label="What readers get">{outs.map(([k, t, c, img], i) => <li style={`top:${(oy(i) / H) * 100}%;--c:${c};--i:${i}`}><img class="thumb" src={`/img/screens/${img}-240.avif`} width="96" height="60" loading="lazy" decoding="async" alt="" /><b>{t}</b></li>)}</ul>
</div>
<style>
  /* Above the gem and below it, one card each, the same width and height, sitting clear of the lines. */
  .step { position: absolute; z-index: 2; left: 35%; width: 30%; display: grid; gap: 10px; padding: 14px 16px; border-radius: 16px; background: rgb(46 5 24 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); } .sv { top: 0; } .lb { bottom: 0; }
  .st-h { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 12px; align-items: center; } .st-h b { display: block; font-weight: 500; line-height: 1.25; } .st-h span { display: block; margin-top: 2px; font-size: 13px; line-height: 1.3; opacity: .78; }
  .pic { position: relative; width: 72px; height: 72px; } .pic img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 14px rgb(28 2 12 / .7)); }
  /* Papers drop into the funnel, and one that doesn't fit falls away towards the line that says so. */
  .sh { position: absolute; left: 30px; top: -4px; width: 12px; height: 16px; border-radius: 2px; background: #fffdf6; box-shadow: 0 3px 6px -2px rgb(28 2 12 / .7); animation: fall 5.4s var(--ease) calc(var(--i) * 1.8s) infinite both; } @keyframes fall { 0% { transform: translateY(-6px); opacity: 0; } 8%, 16% { transform: none; opacity: 1; } 34% { transform: translateY(30px) scale(.5); opacity: 1; } 40%, 100% { transform: translateY(36px) scale(.3); opacity: 0; } } .sh.off { animation-name: veer; } @keyframes veer { 0% { transform: translateY(-6px); opacity: 0; } 8%, 16% { transform: none; opacity: 1; } 30% { transform: translate(-22px, 26px) rotate(-14deg); opacity: 1; } 46%, 100% { transform: translate(-30px, 58px) rotate(-30deg); opacity: 0; } }
  .graph:not(.in) .sh, :global(.away) .sh { animation-play-state: paused; }
  .graph .rows { position: static; display: grid; pointer-events: auto; border-top: 1px solid rgb(255 255 255 / .12); padding-top: 6px; } .graph .rows li { position: static; translate: none; display: grid; grid-template-columns: 14px minmax(0, 1fr) auto; gap: 8px; align-items: center; min-height: 24px; font-size: 13px; line-height: 1.25; } .rows li span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; } .rows :global(svg) { color: #6ee7b7; } .rows .flag :global(svg), .rows em { color: #fda4af; } .rows em { font-style: normal; }
  .fib { position: absolute; z-index: -1; left: 50%; top: 50%; width: max(100vw, 1100px); max-width: none; height: auto; translate: -50% -50%; opacity: .8; -webkit-mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); }
  .stages { display: grid; grid-template-columns: 25% minmax(0, 1fr) 25%; margin-bottom: 14px; font-size: 15px; line-height: 1.3; color: rgb(255 255 255 / .82); } .stages span:nth-child(2) { text-align: center; }
  .thumb { flex: none; width: 76px; height: 50px; border-radius: 8px; object-fit: cover; object-position: top left; box-shadow: 0 0 0 1px rgb(255 255 255 / .2), 0 8px 18px -8px #000; }
  .graph { position: relative; height: 640px; } .lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pulse { opacity: 0; stroke-dasharray: 6 94; stroke-linecap: round; animation: travel 3.4s linear 3; animation-delay: calc(var(--i) * .4s + 1.2s); } @keyframes travel { from { stroke-dashoffset: 0; opacity: 1; } 96% { opacity: 1; } to { stroke-dashoffset: -100; opacity: 0; } }
  ul { position: absolute; inset: 0; pointer-events: none; } li { position: absolute; display: flex; align-items: center; gap: 12px; pointer-events: auto; translate: 0 -50%; transition: transform .25s var(--ease); }
  .srcs li { left: 0; width: 25%; min-height: 72px; padding: 10px 12px; border-radius: 16px; background: rgb(46 5 24 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); } .srcs li:hover { transform: translateX(4px); }
  .logo { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: #fff; color: var(--ink); box-shadow: 0 6px 14px -6px rgb(0 0 0 / .5); } .srcs b, .outs b { display: block; font-weight: 500; line-height: 1.25; } .srcs em { display: block; font-style: normal; font-size: 13px; line-height: 1.3; opacity: .78; }
  .outs li { left: 75%; width: 25%; padding: 7px 10px; border-radius: 14px; background: rgb(46 5 24 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); }  .outs li:hover { transform: translateX(-4px); }
  .hub { position: absolute; left: 39%; width: 22%; min-width: 220px; top: 50%; translate: 0 -50%; display: grid; justify-items: center; gap: 6px; padding: 18px 14px; color: #fff; text-align: center; isolation: isolate; } .gem { position: absolute; z-index: -1; left: 50%; top: 50%; width: 300%; max-width: none; height: auto; translate: -50% -50%; -webkit-mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); } .hub b { font-weight: 500; font-size: 20px; letter-spacing: -.01em; text-shadow: 0 1px 10px rgb(56 3 20 / .9); } .hub > span { font-size: 13px; line-height: 1.3; text-shadow: 0 1px 8px rgb(56 3 20 / .9); }
  :global(.js) .graph[data-in] { opacity: 1; transform: none; } :global(.js) .graph .ln { stroke-dasharray: 1400; stroke-dashoffset: 1400; } :global(.js) .graph.in .ln { stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s var(--ease) .2s; } :global(.js) .graph .srcs li, :global(.js) .graph .outs li, :global(.js) .graph .hub, :global(.js) .graph .sv, :global(.js) .graph .lb { opacity: 0; } :global(.js) .graph.in .srcs li, :global(.js) .graph.in .outs li { opacity: 1; transition: opacity .6s var(--ease) calc(var(--i) * .1s + .1s), transform .25s var(--ease); } :global(.js) .graph.in .outs li { transition-delay: calc(var(--i) * .1s + .9s), 0s; } :global(.js) .graph.in .hub, :global(.js) .graph.in .sv, :global(.js) .graph.in .lb { opacity: 1; transition: opacity .7s var(--ease) .45s; }
  @media (prefers-reduced-motion: reduce) { .pulse { display: none; } .sh { opacity: 1; } }
  /* Stacked, it reads top to bottom in the order the records travel. */
  @media (max-width: 1120px) { .graph { height: auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; } .lines, .fib, .stages { display: none; } .srcs, .outs { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } .srcs { order: 1; } .sv { order: 2; } .hub { order: 3; } .lb { order: 4; } .outs { order: 5; } .step { position: relative; left: 0; width: min(100%, 460px); margin-inline: auto; } .srcs li, .outs li { position: static; translate: none; width: auto; } .hub { position: relative; left: 0; top: 0; translate: none; width: 100%; padding-block: 44px; overflow: clip; } .gem { width: min(180%, 720px); } }
  @media (max-width: 560px) { .srcs, .outs { grid-template-columns: minmax(0, 1fr); } }
</style>
