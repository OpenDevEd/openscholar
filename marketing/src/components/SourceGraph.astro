---
// How a community comes together, drawn as what it is: your sources run through your rules into one place, and readers get everything out of it.
import Icon from "./Icon.astro";
const Z = "M21.231 2.462 7.18 20.923h14.564V24H2.256v-2.462L16.308 3.076H2.975V0h18.256v2.462z";
const sources = [["zotero", "Zotero group", "Two-way sync, PDFs included"], ["openscholar", "OpenScholar collection", "Anything your team has gathered"], ["search", "Saved search", "Fetches only what changed"], ["pen", "Your team", "Records you write yourselves"]];
const outs = [["search", "Search and filter", "#22d3ee", "c-search-laptop-light"], ["globe", "Maps of your field", "#38bdf8", "c-map-laptop-light"], ["spark", "Ask AI, with sources", "#fbbf24", "c-home2-laptop-light"], ["mail", "Digests of new work", "#34d399", "c-home-laptop-light"], ["cite", "Citations and exports", "#fb7185", "c-search-laptop-dark"]];
const H = 480, sy = (i) => 60 + i * 120, oy = (i) => 48 + i * 96, CX = 500, RX = 800, CY = H / 2;
---
<div class="stages" aria-hidden="true"><span>Connect your sources</span><span>Make it yours</span><span>Go live</span></div>
<div class="graph" data-in>
  <img class="fib" src="/img/art-fibres.avif" srcset="/img/art-fibres-960.avif 960w, /img/art-fibres.avif 1672w" sizes="100vw" width="1672" height="941" loading="lazy" decoding="async" alt="" aria-hidden="true" />
  <svg class="lines" viewBox="0 0 1000 480" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <defs><linearGradient id="g-in" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".12" /><stop offset="1" stop-color="#fff" stop-opacity=".7" /></linearGradient></defs>
    {sources.map((_, i) => <><path class="ln" d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="url(#g-in)" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i}`} d={`M250 ${sy(i)}C360 ${sy(i)} 330 ${CY} 440 ${CY}`} stroke="#fff" stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
    {outs.map(([, , c], i) => <><path class="ln" d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-opacity=".55" stroke-width="1.5" vector-effect="non-scaling-stroke" /><path class="pulse" style={`--i:${i + 2}`} d={`M560 ${CY}C670 ${CY} 640 ${oy(i)} 750 ${oy(i)}`} stroke={c} stroke-width="2" vector-effect="non-scaling-stroke" pathLength="100" /></>)}
  </svg>
  <ul class="in" aria-label="Where a community's records come from">{sources.map(([k, t, d], i) => <li style={`top:${(sy(i) / H) * 100}%;--i:${i}`}><i class="logo">{k === "zotero" ? <svg viewBox="0 0 24 24" width="22" height="22" fill="#cc2936" aria-hidden="true"><path d={Z} /></svg> : k === "openscholar" ? <img src="/favicon.svg" width="24" height="24" alt="" /> : <Icon name={k === "pen" ? "pen" : "search"} size={20} />}</i><span><b>{t}</b><em>{d}</em></span></li>)}</ul>
  <div class="hub"><img class="gem" src="/img/art-hub.avif" width="1672" height="941" loading="lazy" decoding="async" alt="" /><img class="logo-m" src="/favicon.svg" width="36" height="36" alt="" /><b>Your community</b><span>Your name, address and colours</span></div>
  <p class="gate"><Icon name="sieve" size={14} />AI screens what comes in against your subject</p>
  <ul class="out" aria-label="What readers get">{outs.map(([k, t, c, img], i) => <li style={`top:${(oy(i) / H) * 100}%;--c:${c};--i:${i}`}><img class="thumb" src={`/img/screens/${img}-1000.avif`} width="96" height="60" loading="lazy" decoding="async" alt="" /><b>{t}</b></li>)}</ul>
</div>
<style>
  .fib { position: absolute; z-index: -1; left: 50%; top: 50%; width: max(100vw, 1100px); max-width: none; height: auto; translate: -50% -50%; opacity: .8; -webkit-mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); }
  .stages { display: grid; grid-template-columns: 25% minmax(0, 1fr) 25%; margin-bottom: 14px; font: 400 14px/1.3 var(--mono); color: rgb(255 255 255 / .72); } .stages span:nth-child(2) { text-align: center; }
  .thumb { flex: none; width: 76px; height: 50px; border-radius: 8px; object-fit: cover; object-position: top left; box-shadow: 0 0 0 1px rgb(255 255 255 / .2), 0 8px 18px -8px #000; }
  .graph { position: relative; height: 480px; } .lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pulse { opacity: 0; stroke-dasharray: 6 94; stroke-linecap: round; animation: travel 3.4s linear 3; animation-delay: calc(var(--i) * .4s + 1.2s); } @keyframes travel { from { stroke-dashoffset: 0; opacity: 1; } 96% { opacity: 1; } to { stroke-dashoffset: -100; opacity: 0; } }
  ul { position: absolute; inset: 0; pointer-events: none; } li { position: absolute; display: flex; align-items: center; gap: 12px; pointer-events: auto; translate: 0 -50%; transition: transform .25s var(--ease); }
  .in li { left: 0; width: 25%; min-height: 72px; padding: 10px 12px; border-radius: 16px; background: rgb(50 4 18 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); } .in li:hover { transform: translateX(4px); }
  .logo { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: #fff; color: var(--ink); box-shadow: 0 6px 14px -6px rgb(0 0 0 / .5); } .in b, .out b { display: block; font-weight: 500; line-height: 1.25; } .in em { display: block; font-style: normal; font-size: 13px; line-height: 1.3; opacity: .78; }
  .out li { left: 75%; width: 25%; padding: 7px 10px; border-radius: 14px; background: rgb(50 4 18 / .78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); }  .out li:hover { transform: translateX(-4px); }
  .hub { position: absolute; left: 39%; width: 22%; min-width: 220px; top: 50%; translate: 0 -50%; display: grid; justify-items: center; gap: 6px; padding: 18px 14px; color: #fff; text-align: center; isolation: isolate; } .gem { position: absolute; z-index: -1; left: 50%; top: 50%; width: 300%; max-width: none; height: auto; translate: -50% -50%; -webkit-mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); mask-image: radial-gradient(ellipse 34% 34% at 50% 50%, #000 70%, transparent 100%); } .logo-m { filter: brightness(0) invert(1); } .hub b { font-weight: 500; font-size: 20px; letter-spacing: -.01em; text-shadow: 0 1px 10px rgb(60 0 10 / .9); } .hub > span { font-size: 13px; line-height: 1.3; text-shadow: 0 1px 8px rgb(60 0 10 / .9); } .gate { position: absolute; left: 50%; bottom: 44px; translate: -50% 0; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12); font-size: 13px; white-space: nowrap; } .gate :global(svg) { color: #6ee7b7; }
  :global(.js) .graph[data-in] { opacity: 1; transform: none; } :global(.js) .graph .ln { stroke-dasharray: 1400; stroke-dashoffset: 1400; } :global(.js) .graph.in .ln { stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s var(--ease) .2s; } :global(.js) .graph li, :global(.js) .graph .hub, :global(.js) .graph .gate { opacity: 0; } :global(.js) .graph.in li { opacity: 1; transition: opacity .6s var(--ease) calc(var(--i) * .1s + .1s), transform .25s var(--ease); } :global(.js) .graph.in .out li { transition-delay: calc(var(--i) * .1s + .9s), 0s; } :global(.js) .graph.in .hub, :global(.js) .graph.in .gate { opacity: 1; transition: opacity .7s var(--ease) .5s; }
  @media (prefers-reduced-motion: reduce) { .pulse { display: none; } }
  @media (max-width: 900px) { .graph { height: auto; display: grid; gap: 16px; } .lines, .fib { display: none; } ul { position: static; display: grid; gap: 8px; } li { position: static; translate: none; } .in li, .out li { width: auto; } .out { grid-template-columns: 1fr; } .stages { display: none; } .hub { position: relative; left: 0; top: 0; translate: none; width: auto; padding-block: 44px; overflow: clip; } .gem { width: 180%; } .gate { position: static; translate: none; white-space: normal; } }
</style>
