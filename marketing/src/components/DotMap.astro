---
// A map of real places: land as faint dots, and each research institution brightening its cell.
import { readFileSync } from "node:fs";
const earth = new Int16Array((() => { const f = readFileSync("src/data/earth.bin"); return f.buffer.slice(f.byteOffset, f.byteOffset + f.length); })());
const INST = 9988, CELL = 2.4, TOP = 76, BOT = -58, W = 360 / CELL, H = (TOP - BOT) / CELL, cells = new Map();
const add = (lon, lat, weight) => { if (lat > TOP || lat < BOT) return; const k = `${Math.floor((lon + 180) / CELL)},${Math.floor((TOP - lat) / CELL)}`; const c = cells.get(k) ?? { inst: 0 }; c.inst += weight; cells.set(k, c); };
const land = (earth.length - 2 - INST * 2) / 2;
for (let i = 0; i < INST; i++) add(earth[2 + i * 2] / 100, earth[3 + i * 2] / 100, 1);
for (let i = 0; i < land; i++) add(earth[2 + INST * 2 + i * 2] / 100, earth[3 + INST * 2 + i * 2] / 100, 0);
const HUES = ["#38bdf8", "#22d3ee", "#34d399", "#fbbf24", "#fb923c", "#f472b6"], groups = {};
for (const [k, c] of cells) { const [x, y] = k.split(",").map(Number), hue = HUES[Math.min(5, Math.floor((x / W) * 6))], size = c.inst > 40 ? 3 : c.inst > 8 ? 2 : c.inst > 0 ? 1 : 0, key = size === 0 ? "land" : `${hue}|${size}`; (groups[key] ??= []).push(`M${x + .5} ${y + .5}h0`); }
const paths = Object.entries(groups).map(([k, d]) => { if (k === "land") return { d: d.join(""), stroke: "rgb(255 255 255 / .28)", w: .38 }; const [c, s] = k.split("|"); return { d: d.join(""), stroke: c, w: [0, .5, .72, .94][+s] }; });
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A world map with research institutions lit up on every continent" style="width:100%;height:auto">{paths.map((p) => <path d={p.d} stroke={p.stroke} stroke-width={p.w} stroke-linecap="round" fill="none" />)}</svg>
