---
import data from "../data/search-default.json";
import { APP } from "../data/site.mjs";
import Shape from "./Shape.astro";
const toggles = [["is_oa:true", "Open access", "oa=true"], ["has_abstract:true", "Has an abstract", "abs=true"], ["type:review", "Reviews", "review=true"], ["publication_year:>2019", "Recent", "yf=2020"]];
---
<section class="b search" id="search" data-console data-default={JSON.stringify({ years: data.years, results: data.results.slice(0, 4) })}>
  <Shape kind="dots" color="rgb(255 255 255 / .34)" />
  <div class="head"><h2>Ask like a person. Search like a <span class="hl wipe" style="--c:#fff">librarian</span></h2><p class="lead">Change the words below and the whole field redraws, live, in the colours of your query.</p></div>
  <form data-form role="search">
    <label class="sr" for="q">Search query</label>
    <div class="field"><div class="mirror" data-mirror aria-hidden="true"></div><input id="q" data-q value={data.q} spellcheck="false" autocomplete="off" /></div>
    <button class="key" aria-label="Search"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg></button>
  </form>
  <div class="tabs" role="group" aria-label="Filters">{toggles.map(([f, l, u]) => <button type="button" aria-pressed="false" data-filter={f} data-url={u}>{l}</button>)}</div>
  <div class="out" data-out>
    <figure class="scope"><figcaption>Papers per year</figcaption><div class="chart" data-chart aria-hidden="true"></div><div class="axis" aria-hidden="true"><span>1997</span><span>Today</span></div></figure>
    <div class="sheet"><ol class="res" data-res></ol><a class="pen" data-open href={`${APP}/results?q=${encodeURIComponent(data.q)}`}>Open this search in OpenScholar</a></div>
  </div>
  <p class="err" data-err hidden>That search didn't come back. Check the query, or try again in a moment.</p>
</section>
<script>
  const root = document.querySelector("[data-console]"), q = root.querySelector("[data-q]"), mirror = root.querySelector("[data-mirror]"), chart = root.querySelector("[data-chart]"), res = root.querySelector("[data-res]"), err = root.querySelector("[data-err]"), open = root.querySelector("[data-open]");
  const API = "https://api.openalex.org/works", APP = open.href.split("/results")[0];
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  // Each term gets its own highlighter, in the query and in the results.
  const COL = ["#FFE14D", "#8FD0FF", "#7DF0B4", "#FFB3DC"];
  const terms = () => (q.value.match(/"[^"]+"|\b(?!AND\b|OR\b|NOT\b)[\w-]{3,}/g) ?? []).map((t) => t.replace(/"/g, ""));
  const paint = () => { let i = 0; mirror.innerHTML = q.value.split(/("[^"]*"|\b(?:AND|OR|NOT)\b|\s+)/).map((p) => { if (!p) return ""; if (/^(AND|OR|NOT)$/.test(p)) return `<i class="op">${p}</i>`; if (!p.trim()) return p; if (!p.startsWith('"') && p.replace(/[()]/g, "").length < 3) return esc(p); return `<i style="background:${COL[i++ % 4]}">${esc(p)}</i>`; }).join(""); };
  const mark = (t) => { let s = esc(t); terms().forEach((w, i) => { s = s.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi"), `<mark style="background:${COL[i % 4]}">$1</mark>`); }); return s; };
  const calm = (t) => (t === t.toUpperCase() ? t[0] + t.slice(1).toLowerCase() : t);
  const YEARS = Array.from({ length: 30 }, (_, i) => 1997 + i);
  chart.innerHTML = YEARS.map((y, k) => `<span><i style="--c:hsl(${6 + k * 6.8} 96% 62%)"></i></span>`).join("");
  const draw = (years) => { const map = new Map(years), max = Math.max(1, ...YEARS.map((y) => map.get(y) ?? 0)); YEARS.forEach((y, k) => { chart.children[k].firstChild.style.setProperty("--h", `${Math.sqrt((map.get(y) ?? 0) / max) * 100}%`); }); };
  const list = (r) => { res.innerHTML = r.map((x) => `<li><b>${mark(x.t)}</b><span>${esc(x.a || "")}${x.a ? ", " : ""}${x.y ?? ""}${x.oa ? '<em>Open access</em>' : ""}</span></li>`).join("") || '<li class="none">Nothing matches that. Try fewer words.</li>'; };
  let token = 0, timer;
  async function run() {
    const mine = ++token, text = q.value.trim().replace(/,/g, " "); if (!text) { root.toggleAttribute("data-busy", false); return; } root.toggleAttribute("data-busy", true); err.hidden = true;
    const pressed = [...root.querySelectorAll('[data-filter][aria-pressed="true"]')], filters = [`title_and_abstract.search:${text}`, ...pressed.map((b) => b.dataset.filter)].join(",");
    open.href = `${APP}/results?q=${encodeURIComponent(q.value.trim())}${pressed.map((b) => `&${b.dataset.url}`).join("")}`;
    try {
      const [a, b] = await Promise.all([fetch(`${API}?${new URLSearchParams({ filter: filters, sort: "relevance_score:desc", "per-page": "4", select: "id,display_name,publication_year,authorships,open_access" })}`), fetch(`${API}?${new URLSearchParams({ filter: filters, group_by: "publication_year" })}`)]);
      if (!a.ok || !b.ok) throw new Error(`${a.status} ${b.status}`);
      const [ra, rb] = await Promise.all([a.json(), b.json()]); if (mine !== token) return;
      draw(rb.group_by.map((g) => [+g.key, g.count])); list(ra.results.map((x) => ({ t: calm(x.display_name ?? "Untitled"), y: x.publication_year, a: x.authorships?.[0]?.author?.display_name ?? "", oa: x.open_access?.is_oa })));
    } catch (e) { if (mine === token) { console.error("Search:", e); err.hidden = false; } }
    if (mine === token) root.toggleAttribute("data-busy", false);
  }
  const follow = () => { mirror.scrollLeft = q.scrollLeft; };
  q.addEventListener("scroll", follow, { passive: true }); q.addEventListener("keyup", follow); q.addEventListener("click", follow);
  q.addEventListener("input", () => { token++; paint(); follow(); clearTimeout(timer); timer = setTimeout(run, 650); });
  root.querySelector("[data-form]").addEventListener("submit", (e) => { e.preventDefault(); clearTimeout(timer); run(); });
  root.querySelectorAll("[data-filter]").forEach((b) => b.addEventListener("click", () => { b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") === "true" ? "false" : "true"); run(); }));
  paint(); const d0 = JSON.parse(root.dataset.default); draw(d0.years); list(d0.results);
</script>
<style is:global>
  [data-mirror] i { font-style: normal; border-radius: .14em; padding-inline: .06em; margin-inline: -.06em; -webkit-box-decoration-break: clone; box-decoration-break: clone; } [data-mirror] .op { color: var(--t3); }
  [data-res] mark { color: inherit; border-radius: 3px; padding-inline: 2px; margin-inline: -2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  [data-chart] span { flex: 1; display: flex; align-items: flex-end; height: 100%; }
  [data-chart] i { display: block; width: 100%; height: 100%; background: var(--c); -webkit-mask: radial-gradient(circle, #000 3.2px, transparent 3.8px) 50% 100%/100% 10px; mask: radial-gradient(circle, #000 3.2px, transparent 3.8px) 50% 100%/100% 10px; clip-path: inset(calc(100% - var(--h, 0%)) 0 0); transition: clip-path .6s var(--ease); }
  [data-res] li { display: grid; gap: 4px; padding-block: 14px; border-top: 1px solid var(--line); } [data-res] li:first-child { border-top: 0; padding-top: 0; }
  [data-res] b { font-weight: 500; font-size: 17px; line-height: 1.3; letter-spacing: -.01em; } [data-res] span { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; font-size: 14px; color: var(--t2); } [data-res] em { font-style: normal; font-size: 12px; font-weight: 500; padding: 1px 7px; border-radius: 6px; background: #d7f8e7; color: #0b5e3f; }
  [data-res] .none { font-size: 17px; color: var(--t2); }
</style>
<style>
  .search { background: var(--sun); }
  .head { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 16px 40px; align-items: end; margin-bottom: 28px; } .lead { color: var(--ink); }
  form { display: flex; align-items: center; gap: 14px; padding: 12px 14px 17px 22px; border-radius: 22px; background: #fff; box-shadow: 0 0 0 2px var(--ink); } form:focus-within { box-shadow: 0 0 0 4px var(--ink); }
  .field { position: relative; flex: 1; min-width: 0; font: 700 clamp(20px, 3.4vw, 46px)/1.25 var(--sans); letter-spacing: -.03em; overflow: hidden; padding-block: 2px; }
  .mirror, input { display: block; width: 100%; white-space: pre; font: inherit; letter-spacing: inherit; }
  .mirror { position: absolute; inset: 2px 0; pointer-events: none; overflow: hidden; }
  input { position: relative; background: none; border: 0; outline: 0; color: transparent; caret-color: var(--ink); padding: 0; }
  form .key { width: 56px; padding: 0; flex: none; }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 12px 18px 0; } .tabs button { height: 36px; padding-inline: 14px; border-radius: 10px 10px 4px 4px; background: rgb(11 16 32 / .1); font-size: 14px; font-weight: 500; transition: background-color .15s var(--ease), color .15s var(--ease), translate .15s var(--ease); } .tabs button:hover { background: rgb(11 16 32 / .2); } .tabs [aria-pressed="true"] { background: var(--ink); color: #fff; translate: 0 -3px; }
  .out { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 12px; margin-top: 4px; transition: opacity .2s var(--ease); } [data-busy] .out { opacity: .6; }
  .scope { display: flex; flex-direction: column; padding: 20px; border-radius: 22px; background: var(--ink); color: #fff; min-height: 380px; } figcaption { font-weight: 500; font-size: 15px; margin-bottom: 14px; }
  .chart { flex: 1; min-height: 240px; display: flex; align-items: flex-end; gap: 1px; } .axis { display: flex; justify-content: space-between; margin-top: 10px; font: 400 13px var(--mono); color: rgb(255 255 255 / .7); }
  .sheet { padding: 22px; border-radius: 22px; background: #fff; display: flex; flex-direction: column; } .res { flex: 1; } .sheet .pen { align-self: flex-start; margin-top: 8px; }
  .err { margin-top: 12px; font-weight: 500; }
  @media (max-width: 860px) { .head, .out { grid-template-columns: minmax(0, 1fr); } .scope { min-height: 280px; } .chart { min-height: 170px; } form { padding-left: 14px; gap: 8px; } form .key { width: 44px; height: 44px; } .field { font-size: 16px; font-weight: 500; letter-spacing: -.01em; } [data-chart] i { -webkit-mask-size: 100% 8px; mask-size: 100% 8px; } }
</style>
