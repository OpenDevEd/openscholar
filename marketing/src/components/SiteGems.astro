---
// The six communities as glass emblems on a dark tray, with the chosen one's name and description below. Sits inside a [data-sites] element.
import Arrow from "./Arrow.astro";
import { COMMUNITIES } from "../data/site.mjs";
---
<div class="gems" data-tabs role="tablist" aria-label="Live Evidence Communities">{COMMUNITIES.map((c, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-label={c.name} style={`--c:${c.color}`}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /></button>)}</div>
<div class="cap">{COMMUNITIES.map((c, i) => <a class:list={["about", { on: i === 0 }]} data-i={i} href={c.url}><b>{c.name}<Arrow /></b><span>{c.text}</span></a>)}</div>
<script>
  import { picker } from "../scripts/picker.js";
  document.querySelectorAll("[data-sites]").forEach((r) => picker(r));
</script>
<style>
  .gems { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); padding: 4px; border-radius: 16px; background: #0d1436; }
  [role="tab"] { display: grid; place-items: center; height: min(calc(var(--hu, 1px) * 72), 15vw); border-radius: 12px; } [role="tab"] img { width: min(calc(var(--hu, 1px) * 56), 10vw); height: min(calc(var(--hu, 1px) * 56), 10vw); object-fit: contain; filter: saturate(1.5) drop-shadow(0 0 8px color-mix(in srgb, var(--c) 45%, transparent)); opacity: .72; transition: transform .5s var(--ease), opacity .3s var(--ease); } [role="tab"]:hover img { opacity: 1; } [role="tab"][aria-selected="true"] img { opacity: 1; transform: scale(1.28); }
  .cap { display: grid; margin-top: calc(var(--hu, 1px) * 12); min-height: calc(var(--hu, 1px) * 84); } .about { grid-area: 1 / 1; display: grid; align-content: start; gap: 4px; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .3s var(--ease), transform .45s var(--ease), visibility 0s .3s; } .about.on { opacity: 1; visibility: visible; transform: none; transition: opacity .3s var(--ease), transform .45s var(--ease); }
  :global(html:not(.has-js)) .gems { display: none; } :global(html:not(.has-js)) .about { grid-area: auto; margin-bottom: 12px; opacity: 1; visibility: visible; transform: none; }
  .about b { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: max(15px, calc(var(--hu, 1px) * 18)); letter-spacing: -.01em; line-height: 1.25; } .about b :global(i) { display: grid; color: var(--brand); transition: transform .25s var(--ease); } .about:hover b :global(i) { transform: translateX(4px); } .about span { font-size: max(13px, calc(var(--hu, 1px) * 15)); line-height: 1.4; color: var(--t2); }
</style>
