---
const { items, title = "Questions teams ask" } = Astro.props;
// The same questions as structured data, so search engines can show them with the page.
const schema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: items.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
---
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
<section class="faq"><h2>{title}</h2><div>{items.map(([q, a]) => <details><summary>{q}<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg></summary><p>{a}</p></details>)}</div></section>
<style>
  .faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px clamp(24px, 4vw, 64px); padding: clamp(40px, 6vw, 80px) var(--pad); }
  details { border-top: 1px solid var(--line); } details:last-child { border-bottom: 1px solid var(--line); } summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 18px; font-weight: 500; font-size: 18px; letter-spacing: -.01em; list-style: none; cursor: pointer; } summary::-webkit-details-marker { display: none; } summary { transition: color .15s var(--ease), padding-left .3s var(--ease); } summary:hover { color: var(--brand-ink); padding-left: 6px; } summary svg { flex: none; color: var(--brand-ink); transition: rotate .2s var(--ease); } details[open] summary svg { rotate: 45deg; } p { padding-bottom: 20px; color: var(--t2); max-width: 44rem; }
  @media (max-width: 800px) { .faq { grid-template-columns: minmax(0, 1fr); padding-inline: 8px; } }
</style>
