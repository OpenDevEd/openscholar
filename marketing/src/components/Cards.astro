---
// Small pieces of the product, built so they stay sharp over the screens.
const { kind } = Astro.props;
---
{kind === "query" && <div class="card"><span class="k">You ask</span><p class="plain">Does peer tutoring improve reading?</p><span class="k">OpenScholar searches</span><p class="q"><mark style="--m:#ffe08a">"peer tutoring"</mark> <i>AND</i> <mark style="--m:#a9d6ff">reading</mark></p></div>}
{kind === "answer" && <div class="card"><div class="tabs"><b>Who took part?</b><span>Study design</span><span>Main finding</span></div><p class="val">73 elementary school students, aged 11 to 12</p><div class="meter"><i style="width:88%"></i></div><p class="src">Grounded in the abstract, with the source a click away</p></div>}
{kind === "approve" && <div class="card"><b class="t">Start an extraction</b><dl><div><dt>Papers</dt><dd>8 in Peer tutoring trials</dd></div><div><dt>Questions</dt><dd>Who took part? Study design? Main finding?</dd></div></dl><div class="acts"><span class="yes">Allow once</span><span class="no">Don't do this</span></div></div>}
{kind === "rule" && <div class="card"><b class="t">Your criteria</b><ul class="rules"><li><span>Is it an intervention study?</span><em style="--w:92%"></em></li><li><span>Is it about reading or literacy?</span><em style="--w:100%"></em></li><li><span>Is it in primary school?</span><em style="--w:78%"></em></li></ul></div>}
<style>
  .card { padding: 16px 18px; border-radius: 14px; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px rgb(10 26 63 / .08), 0 22px 40px -16px rgb(10 20 60 / .55); font-size: 14px; }
  .k { display: block; color: var(--t3); font-size: 13px; } .plain { margin-bottom: 10px; font-size: 15px; } .q { font-size: 17px; font-weight: 500; letter-spacing: -.01em; } .q mark { background: var(--m); color: inherit; border-radius: 4px; padding: 1px 4px; } .q i { font-style: normal; color: var(--t3); }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-bottom: 10px; color: var(--t3); font-size: 13px; } .tabs b { font-weight: 500; color: var(--ink); } .val { font-size: 19px; font-weight: 500; line-height: 1.2; letter-spacing: -.015em; } .meter { height: 6px; margin-block: 10px 8px; border-radius: 3px; background: var(--soft); } .meter i { display: block; height: 100%; border-radius: 3px; background: #059669; } .src { color: var(--t2); font-size: 13px; }
  .t { display: block; font-weight: 500; font-size: 16px; letter-spacing: -.01em; margin-bottom: 8px; } dl { display: grid; gap: 4px; margin-bottom: 12px; font-size: 13px; } dl div { display: grid; grid-template-columns: 72px 1fr; gap: 8px; } dt { color: var(--t3); } .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; } .yes { padding: 7px 12px; border-radius: 9px; background: var(--brand); color: #fff; font-weight: 500; } .no { color: var(--t2); }
  .rules { display: grid; gap: 9px; } .rules span { display: block; font-size: 13px; margin-bottom: 3px; } .rules em { display: block; height: 6px; border-radius: 3px; background: linear-gradient(90deg, #059669 var(--w), var(--soft) 0); }
</style>
