---
// One capability: a colour field, the case for it, and the real product.
const { id, field, title, text, points = [], img, w = 1600, h = 1000, alt, flip = false, fit = false } = Astro.props;
---
<section id={id} class:list={["panel", "f", { flip, fit }]}>
  <img class="field" src={`/img/field-${field}.avif`} width="1200" height="750" loading="lazy" decoding="async" alt="" />
  <div class="copy"><h2>{title}</h2><p class="lead">{text}</p>
    {points.length > 0 && <ul>{points.map((p) => <li><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8 14.5 16 5.5" /></svg><span>{p}</span></li>)}</ul>}
    <slot name="extra" />
  </div>
  <div class="view"><div class="win"><img src={`/img/${img}.avif`} width={w} height={h} loading="lazy" decoding="async" alt={alt} /></div></div>
</section>
<style>
  .f { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); align-items: center; padding: var(--pad) 0 var(--pad) var(--pad); min-height: 560px; }
  .f.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); padding: var(--pad) var(--pad) var(--pad) 0; } .flip .copy { order: 2; }
  .copy { display: grid; gap: 18px; } ul { display: grid; gap: 10px; margin-top: 4px; } li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; line-height: 1.35; align-items: start; } li svg { margin-top: 2px; }
  .view { min-width: 0; } .view .win { width: 112%; border-radius: 14px 0 0 14px; } .flip .view .win { border-radius: 0 14px 14px 0; width: 100%; } .fit { padding-right: var(--pad); } .fit .view .win { width: 100%; border-radius: 14px; }
  @media (max-width: 900px) { .f, .f.flip { grid-template-columns: minmax(0, 1fr); padding: var(--pad) 0 0 var(--pad); min-height: 0; } .f.flip { padding: var(--pad) var(--pad) 0 0; } .flip .copy { order: 0; padding-left: var(--pad); } .copy { padding-right: var(--pad); } .view .win { width: 100%; border-radius: 14px 0 0 0; } .flip .view .win { border-radius: 0 14px 0 0; } .fit { padding-right: 0; } .fit .view .win { border-radius: 14px 0 0 0; } }
</style>
