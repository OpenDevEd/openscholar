---
// One capability: art or a colour field, the case for it, and whatever shows it, passed in as the default slot.
import Art from "./Art.astro";
const { id, field, art, scrim = "--sc:3 44 66", chip = "#2563eb", title, text, flip = false, class: cls = "" } = Astro.props;
---
<section id={id} class:list={["panel", "f", cls, { flip }]} style={`--tint:${chip}`}>
  <i class={`field f-${field}`} aria-hidden="true"></i>{art && <Art name={art} class="dim" style={scrim} sizes="(max-width: 1280px) 100vw, 1280px" />}
  <div class="copy"><h2>{title}</h2><p class="lead">{text}</p><slot name="extra" /></div>
  <div class="view" data-in><slot /></div>
</section>
<style>
  .f { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); align-items: center; padding: 0 0 0 var(--pad); min-height: 640px; }
  .f.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); padding: 0 var(--pad) 0 0; } .flip .copy { order: 2; }
  .copy { display: grid; gap: 18px; min-width: 0; padding-block: var(--pad); }
  .view { position: relative; align-self: stretch; min-width: 0; min-height: 520px; }
  @media (max-width: 900px) { .f, .f.flip { grid-template-columns: minmax(0, 1fr); padding: 0 var(--pad); min-height: 0; gap: 0; } .flip .copy { order: 0; } .view { min-height: 0; } }
</style>
