---
// Three doorways, one inside the other: each role gets as far as its door. Pick one and see what it opens.
import Art from "./Art.astro";
import Icon from "./Icon.astro";
const roles = [
  { id: "admin", name: "Admin", text: "Runs the organization", color: "#f59e0b", door: [502, 10, 679, 784] },
  { id: "member", name: "Member", text: "Does the work", color: "#34d399", door: [658, 250, 372, 450] },
  { id: "guest", name: "Guest", text: "Sees what you share", color: "#60a5fa", door: [748, 393, 188, 255] },
];
const can = [["See all the organization's work", 1, 1, 0], ["Start searches, screenings and extractions", 1, 1, 0], ["Delete what they made", 1, 1, 0], ["Delete anything and manage roles", 1, 0, 0], ["See items shared with them", 1, 1, 1]];
---
<section class="bleed doors" id="roles" data-role="admin">
  <div class="stage"><div class="scene"><Art name="gates" />{roles.map((r) => <i class="door" data-door={r.id} style={`--c:${r.color};left:calc(var(--u) * ${r.door[0]});top:calc(var(--u) * ${r.door[1]});width:calc(var(--u) * ${r.door[2]});height:calc(var(--u) * ${r.door[3]})`} aria-hidden="true"></i>)}</div></div>
  <div class="inner body">
    <div class="pick"><h2>The right access for each person</h2><p class="lead">Your team sees your work. Guests see only what you share with them.</p>
      <div class="roles" role="radiogroup" aria-label="Choose a role">{roles.map((r, i) => <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-pick={r.id} style={`--c:${r.color}`}><b>{r.name}</b><span>{r.text}</span></button>)}</div>
      <ul class="can">{can.map(([t, a, m, g]) => <li data-admin={a} data-member={m} data-guest={g}><i><Icon name="check" size={14} /></i>{t}</li>)}</ul>
    </div>
  </div>
</section>
<script>
  const root = document.querySelector(".doors");
  if (root) { const btns = [...root.querySelectorAll("[data-pick]")]; const set = (b) => { root.dataset.role = b.dataset.pick; btns.forEach((x) => x.setAttribute("aria-checked", x === b)); }; btns.forEach((b, i) => { b.addEventListener("click", () => set(b)); b.addEventListener("pointerenter", () => set(b)); b.addEventListener("keydown", (e) => { const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); const n = btns[(i + d + btns.length) % btns.length]; set(n); n.focus(); } }); }); }
</script>
<style>
  .doors { background: #010a27; padding-block: clamp(56px, 7vw, 96px); min-height: min(52vw, 760px); display: grid; align-items: center; }
  .stage { position: absolute; z-index: -1; inset: 0; overflow: clip; } .scene { overflow: clip; } .scene { position: absolute; left: 50%; top: 50%; width: max(66vw, 900px); translate: -78% -50%; } .scene :global(.art) { -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%, #000 76%, transparent), linear-gradient(#000 86%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 16%, #000 76%, transparent), linear-gradient(#000 86%, transparent); mask-composite: intersect; }
  .door { position: absolute; z-index: 1; border-radius: 6px; box-shadow: 0 0 0 200vmax rgb(1 10 39 / .72); opacity: 0; transition: opacity .45s var(--ease); } [data-role="member"] [data-door="member"], [data-role="guest"] [data-door="guest"] { opacity: 1; }
  .body { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); } .pick { grid-column: 2; display: grid; gap: 18px; }
  .roles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 8px; } .roles button { display: grid; gap: 2px; padding: 12px 14px; border-radius: 14px; text-align: left; color: #fff; background: rgb(255 255 255 / .06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12); transition: background-color .2s var(--ease), box-shadow .2s var(--ease); } .roles b { font-weight: 500; font-size: 17px; } .roles span { font-size: 13px; line-height: 1.25; opacity: .78; } .roles [aria-checked="true"] { background: color-mix(in srgb, var(--c) 22%, transparent); box-shadow: inset 0 0 0 1.5px var(--c); }
  .can { display: grid; gap: 2px; } .can li { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: 16px; transition: opacity .25s var(--ease); opacity: .38; } .can i { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 7px; background: rgb(255 255 255 / .08); color: transparent; transition: background-color .25s var(--ease), color .25s var(--ease); }
  [data-role="admin"] [data-admin="1"], [data-role="member"] [data-member="1"], [data-role="guest"] [data-guest="1"] { opacity: 1; } [data-role="admin"] [data-admin="1"] i { background: #f59e0b; color: #0a1030; } [data-role="member"] [data-member="1"] i { background: #34d399; color: #0a1030; } [data-role="guest"] [data-guest="1"] i { background: #60a5fa; color: #0a1030; }
  @media (max-width: 900px) { .doors { min-height: 0; } .body { grid-template-columns: minmax(0, 1fr); } .pick { grid-column: 1; } .scene { width: 200vw; translate: -50% -50%; opacity: .32; } .roles { grid-template-columns: minmax(0, 1fr); } .roles button { grid-template-columns: 90px minmax(0, 1fr); align-items: baseline; } }
</style>
