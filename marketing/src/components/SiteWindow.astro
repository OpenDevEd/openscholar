---
// A browser window onto the real community sites, one at a time. Fills its parent; [data-i] parts follow the picker around it.
import Icon from "./Icon.astro";
import { COMMUNITIES } from "../data/site.mjs";
---
<div class="win">{COMMUNITIES.map((c, i) => <a class:list={["site", { on: i === 0 }]} data-i={i} href={c.url} tabindex="-1" aria-hidden="true"><span class="url"><span><Icon name="globe" size={14} />{c.host}</span></span><img src={`/img/site-${c.key}.avif`} width="960" height="600" decoding="async" alt="" /></a>)}</div>
<style>
  .win { position: relative; width: 100%; height: 100%; background: #fff; overflow: clip; border-radius: inherit; }
  .site { position: absolute; inset: 0; display: flex; flex-direction: column; background: #fff; opacity: 0; visibility: hidden; transition: opacity 0s .45s, visibility 0s .45s; } .site.on { z-index: 1; opacity: 1; visibility: visible; transition: opacity .45s var(--ease); }
  .url { flex: none; display: flex; align-items: center; height: calc(var(--hu, 1px) * 40); padding-inline: 10px; background: #fff; border-bottom: 1px solid var(--line); } .url > span { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px 4px 8px; border-radius: 8px; background: var(--soft); color: var(--t2); font: 400 max(11px, calc(var(--hu, 1px) * 13))/1.2 var(--mono); }
  .site img { flex: 1; min-height: 0; width: 100%; max-width: none; object-fit: cover; object-position: 0 0; }
</style>
