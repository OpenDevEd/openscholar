<style>
  /* The question as the app's first frame sets it (app/results/question-stage.module.css). */
  :global(.handq) { position: absolute; left: 0; width: 100vw; z-index: 7; display: flex; flex-wrap: wrap; justify-content: center; padding-inline: max(24px, calc((100vw - 1240px) / 2)); color: #ffe6cf; font-weight: 500; letter-spacing: -.04em; line-height: 1.06; text-align: center; pointer-events: none; font-size: 38px; } :global(.handq[data-size="medium"]) { font-size: 30px; } :global(.handq[data-size="small"]) { font-size: 22px; line-height: 1.2; letter-spacing: -.02em; }
  @media (min-width: 600px) { :global(.handq) { font-size: 56px; } :global(.handq[data-size="medium"]) { font-size: 44px; } :global(.handq[data-size="small"]) { font-size: 30px; } } @media (min-width: 1100px) { :global(.handq) { font-size: 64px; } :global(.handq[data-size="medium"]) { font-size: 52px; } :global(.handq[data-size="small"]) { font-size: 36px; } } @media (min-width: 1400px) { :global(.handq) { font-size: 72px; } }
  :global(.handq span) { display: inline-block; padding-inline: .13em; }
  :global(.handcover) { position: fixed; inset: 0; z-index: 40; background: var(--sky); pointer-events: none; animation: arrive 240ms ease-out backwards; }
  .sky { padding: 146px 0 0; background: var(--sky); text-align: center; }
  .plate { position: absolute; left: 50%; top: 0; z-index: -2; width: 2560px; max-width: none; height: 820px; margin-left: -1280px; pointer-events: none; mask-image: linear-gradient(#000 76%, transparent), linear-gradient(90deg, transparent 360px, #000 560px, #000 2000px, transparent 2200px); mask-composite: intersect; animation: arrive 1.2s var(--ease) backwards; }
  .stars { position: absolute; left: 50%; top: 0; z-index: -1; width: 2560px; max-width: none; height: 820px; margin-left: -1280px; animation: tw var(--tw) ease-in-out var(--twd) infinite alternate; } .s0 { --tw: 6s; --twd: 0s; } .s1 { --tw: 9s; --twd: -3s; } .s2 { --tw: 13s; --twd: -6s; } @keyframes tw { to { opacity: .35; } }

  .say { position: relative; z-index: 6; display: grid; justify-items: center; gap: 14px; }
  h1 { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 .26em; font-size: 38px; letter-spacing: -.04em; line-height: 1.06; } h1 span { display: inline-block; animation: rise 700ms var(--ease) calc(.05s + var(--i) * 45ms) backwards; } @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @media (min-width: 600px) { h1 { font-size: 56px; } } @media (min-width: 1100px) { h1 { font-size: 64px; } } @media (min-width: 1400px) { h1 { font-size: 72px; } } @media (max-width: 1099px) { h1 { max-width: 9em; } }
  /* The headline is filled with the same Earth under the sunrise: warm cream over the oceans, near white over land and ice, so every letter stays bright. */
  @supports (background-clip: text) or (-webkit-background-clip: text) { h1 span { padding: .08em .05em; margin: -.08em -.05em; color: transparent; background: linear-gradient(#ffe6cf, #ffe6cf), url(/img/earth-day.avif) calc(var(--i) * -3.2em - 6em) -2.6em / 20em 10em #ffe6cf; background-blend-mode: screen, normal; -webkit-background-clip: text; background-clip: text; } }
  .lead { font-size: 20px; color: #c9cfdc; animation: rise 800ms var(--ease) .36s backwards; }

  /* Openscholar's box is the one warm thing in the sky, lit like the sunrise on the planet below it. */
  /* Two lights run round the box's rim. The box clips them, so they only ever show in its 2px edge. */
  .halo { position: relative; isolation: isolate; overflow: clip; width: min(100%, 700px); margin-top: 8px; padding: 2px; border-radius: 20px; background: linear-gradient(90deg, var(--brand-deep), var(--brand) 30%, var(--brand-bright) 70%, var(--brand-deep)); box-shadow: inset 0 0 0 2px transparent, 0 0 22px -2px color-mix(in srgb, var(--brand) 70%, transparent); transition: box-shadow .5s var(--ease); animation: rise 800ms var(--ease) .46s backwards; } .halo :global(.big) { width: 100%; box-shadow: none; } .halo:focus-within { box-shadow: inset 0 0 0 2px transparent, 0 0 0 3px rgb(255 255 255 / .7), 0 0 22px -2px color-mix(in srgb, var(--brand) 70%, transparent); } .halo:global(.fired) { box-shadow: inset 0 0 0 2px #fff1e0, 0 0 24px 2px color-mix(in srgb, var(--brand-bright) 85%, transparent); }
  @supports (offset-path: inset(0 round 1px)) { .halo::before, .halo::after { content: ""; position: absolute; left: 0; top: 0; z-index: -1; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(closest-side, #fff1e0, var(--brand-bright) 34%, transparent); offset-path: inset(0 round 20px); offset-rotate: 0deg; animation: lap 11s linear infinite; pointer-events: none; } .halo::after { background: radial-gradient(closest-side, #ffd9b0, var(--brand-deep) 34%, transparent); animation-delay: -5.5s; } @keyframes lap { from { offset-distance: 0%; } to { offset-distance: 100%; } } .halo:focus-within::before, .halo:focus-within::after { animation-play-state: paused; } }
  @media (max-width: 719px) { .halo :global(button span) { display: none; } .halo :global(.btn) { --chip: var(--brand); --chipt: var(--brand-on); gap: 0; height: 48px; min-height: 0; padding: 0 6px; } }
  @media (max-width: 500px) { .halo { width: calc(100% + 32px); margin-inline: -16px; } }

  .space { position: relative; isolation: isolate; height: 562px; margin-top: -132px; overflow: clip visible; }
  .space::before { content: ""; position: absolute; left: var(--sx, 50%); top: var(--sy, 0); z-index: 0; width: 1400px; height: var(--sh, 900px); transform: translate(-50%, -50%); pointer-events: none; background: radial-gradient(closest-side, rgb(255 226 190 / .42), rgb(255 150 70 / .22) 16%, rgb(190 90 60 / .09) 44%, transparent); opacity: 0; transition: opacity 1.2s var(--ease); } :global(.lit) .space::before { opacity: 1; animation: sun 14s ease-in-out 1.2s infinite alternate; } @keyframes sun { to { opacity: .72; } }
  .earth { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; opacity: 0; transform: scale(.98); transition: opacity 1.2s var(--ease), transform 2.4s var(--ease); } :global(.lit) .earth { opacity: 1; transform: none; }
  .orb { position: absolute; inset: 0; pointer-events: none; will-change: transform; } .back { z-index: 1; } .front { z-index: 4; } .orb svg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; overflow: visible; }
  /* The ring's spark: a short tapering streak whose head is its right end, moved round by earth.js with a transform alone, so nothing is redrawn as it goes. */
  .spark { position: absolute; left: 0; top: 0; width: 150px; height: 3px; margin-top: -1.5px; border-radius: 2px; background: linear-gradient(90deg, transparent, rgb(255 241 224 / .3) 45%, rgb(255 241 224 / .75) 85%, #fff1e0); transform-origin: 100% 50%; opacity: 0; will-change: transform, opacity; pointer-events: none; }
  /* Level 0: the planet is a still image, drawn by the same shader, and no canvas is drawn. */
  .still { position: absolute; z-index: 3; opacity: 0; transition: opacity 1s cubic-bezier(.4, 0, .2, 1); max-width: none; height: auto; aspect-ratio: 1; pointer-events: none; } :global(.resting) .still { opacity: 1; } :global(.resting) .earth { opacity: 0; transition: opacity 1s cubic-bezier(.4, 0, .2, 1); } :global(.resting) .stars { animation: none; }
  /* The ring draws itself on: left to right in front, then right to left behind, the way the satellites travel. */
  @property --draw { syntax: "<length-percentage>"; inherits: false; initial-value: calc(100% + 160px); }
  .front .ringsvg { mask-image: linear-gradient(90deg, #000 calc(var(--draw) - 160px), transparent var(--draw)); transition: --draw 1s cubic-bezier(.45, 0, .9, .7) .3s; } .back .ringsvg { mask-image: linear-gradient(270deg, #000 calc(var(--draw) - 160px), transparent var(--draw)); transition: --draw 1s cubic-bezier(.1, .3, .55, 1) 1.2s; } :global(.js) [data-orbit]:not(.orbiting) .ringsvg { --draw: 0%; }

  .sats { display: contents; }
  .sat { position: absolute; left: 0; top: 0; width: 88px; height: 88px; opacity: 0; will-change: transform; }
  .sat img { width: 100%; height: 100%; object-fit: contain; will-change: transform; transition: opacity .9s var(--ease) calc(.7s + var(--i) * 100ms), scale .4s var(--ease); } :global(.js) [data-orbit]:not(.orbiting) .sat img { opacity: 0; } .sat:hover img, .sat:global(.held) img { scale: 1.18; } .sat:hover, .sat:global(.caught) { z-index: 7 !important; }
  /* The link's own label, above its emblem so it stays clear of the strip below, and only one ever shows. */
  .sat b { position: absolute; left: 50%; bottom: 100%; width: 220px; translate: calc(-50% + var(--nudge, 0px)) -4px; font: 500 14px/1.25 var(--sans); text-wrap: balance; text-align: center; opacity: 0; transition: opacity .25s var(--ease), translate .25s var(--ease); pointer-events: none; text-shadow: 0 1px 2px rgb(4 7 16 / .95), 0 0 6px rgb(4 7 16 / .95), 0 0 16px rgb(4 7 16 / .95); } .sat:hover b { opacity: 1; translate: calc(-50% + var(--nudge, 0px)) -10px; }

  .hub { position: relative; z-index: 6; }
  .hubline, .fields { animation: arrive 1.2s var(--ease) 1.4s backwards; } @keyframes arrive { from { opacity: 0; } }
  .hubline { font-size: 16px; color: #c9cfdc; } .hubline a { font-weight: 500; font-size: 18px; color: #fff; margin-right: 8px; } .hubline a:hover { text-decoration: underline; }
  /* Each live community as a tile across the whole width: its real site behind its emblem and name. As a satellite passes
     the front, its tile lights in the community's colour. */
  .fields { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2px; margin: 16px calc(50% - 50vw) 0; padding: 0; list-style: none; }
  .fields a { position: relative; display: block; height: 176px; overflow: hidden; background: #0b1330; color: #e8ebf2; text-align: left; }
  .fields a::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgb(7 11 26 / .92) 10%, rgb(7 11 26 / .5) 45%, transparent 75%); }
  .fields a::after { content: ""; position: absolute; inset: auto 0 0; z-index: 1; height: 100%; background: radial-gradient(90% 70% at 30% 100%, color-mix(in srgb, var(--c) 34%, transparent), transparent 70%); opacity: 0; transition: opacity .6s var(--ease); }
  /* Each community's story in glass, in its own colour, generated with its prompt in art/art-prompts.txt. */
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; filter: brightness(.72); transform-origin: 70% 40%; transition: filter .6s var(--ease), transform 1.2s var(--ease); }
  .tag { position: absolute; inset: auto 16px 16px; z-index: 2; display: grid; text-shadow: 0 1px 14px #070b1a, 0 0 4px rgb(7 11 26 / .8); }
  .tag b { font: 500 14px/1.22 var(--sans); text-wrap: balance; transition: color .6s var(--ease); } .tag small { margin-top: 3px; overflow: hidden; font-size: 12px; color: #8f98ae; text-overflow: ellipsis; white-space: nowrap; }
  .fields :global(li.on) a::after, .fields li:hover a::after, .fields li:focus-within a::after { opacity: 1; } .fields :global(li.on) .shot, .fields li:hover .shot, .fields li:focus-within .shot { filter: brightness(1); transform: scale(1.05); }
  .fields :global(li.on) b, .fields li:hover b, .fields li:focus-within b { color: var(--c); }

  /* Below the laptop sizes everything steps down in fixed sizes, never with the window. */
  @media (max-width: 1399px) { .sky { padding-top: 142px; } .space { height: 478px; } } @media (max-width: 1199px) { .sky { padding-top: 136px; } .space { height: 504px; } }
  @media (max-width: 999px) { .sky { padding-top: 134px; } .space { height: 448px; } .sat { width: 80px; height: 80px; } .sat b { display: none; } .fields { grid-template-columns: repeat(3, minmax(0, 1fr)); } .fields a { height: 152px; } }
  @media (hover: none) { .sat b { display: none; } }
  @media (max-width: 699px) { .sky { padding-top: 126px; } .space { height: 302px; margin-top: -76px; } .space::before { width: 800px; } .sat { width: 52px; height: 52px; } .hubline a, .hubline span { display: block; margin: 0; } .lead { font-size: 17px; } }
  @media (max-width: 599px) { .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fields a { height: 144px; } .tag { inset: auto 12px 12px; } .tag b { font-size: 13.5px; } }

  /* Scrolling lifts the words away and sinks the stars. The planet, ring and strip stay with the page, so no text can collide. */
  @media (prefers-reduced-motion: no-preference) { @supports (animation-timeline: scroll()) {
    .say { animation: lift linear both; }
    .say { animation-timeline: scroll(root); animation-range: 0 500px; }
    .stars { animation: tw var(--tw) ease-in-out var(--twd) infinite alternate, sink linear both; }
    .stars { animation-timeline: auto, scroll(root); animation-range: normal, 0 640px; }
    @keyframes lift { to { translate: 0 -80px; } } @keyframes sink { to { translate: 0 60px; } }
  } }
  :global(.away) .stars, :global(.away) .space::before, :global(.away) .halo::before, :global(.away) .halo::after { animation-play-state: paused; }

  /* No scripts or no WebGL: the headline, the box and all six links are the whole hero. If the planet fails later, the art goes and the page keeps its shape. */
  :global(html:not(.has-js)) .sats, :global(html:not(.has-js)) .orb, :global(html:not(.has-js)) .earth, :global(html:not(.has-js)) .space::before, :global(.bare) .sats, :global(.bare) .orb, :global(.bare) .earth, :global(.bare) .space::before { display: none; } :global(html:not(.has-js)) .space { height: 24px; margin-top: 0; } :global(html:not(.has-js)) .plate { height: 100%; object-fit: cover; }
</style>
