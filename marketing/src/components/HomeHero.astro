---
// Two products, two bands, each name wall to wall: the workspace a team signs in to on navy, and the public sites anyone can visit in daylight. The search box belongs to the workspace alone.
import AskBar from "./AskBar.astro";
import SiteGems from "./SiteGems.astro";
import SiteWindow from "./SiteWindow.astro";
---
<link rel="preload" as="image" href="/img/art-sea-960.avif" media="(max-width: 999px)" />
<link rel="preload" as="image" href="/img/art-sea.avif" media="(min-width: 1000px)" fetchpriority="high" />
<section class="bleed wall">
  <div class="band os">
    <h1><b>OpenScholar</b> <span>is where your team works through the evidence</span></h1>
    <div class="ask-w"><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
  </div>
  <div class="band ec light" data-sites>
    <h2><b>Evidence Communities</b> <span>are where anyone can read it</span></h2>
    <div class="pick"><SiteGems /></div>
    <div class="w"><SiteWindow /></div>
  </div>
</section>
<style>
  .wall { --hu: 1px; --strip: calc(100vw - var(--pad) * 2); display: grid; grid-template-columns: minmax(0, 1fr); }
  .band { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: calc(var(--hu) * 18); padding-inline: var(--pad); overflow: clip; min-height: 0; }

  /* Both names measure the full strip, whatever the window. */
  h1, h2 { display: grid; font-weight: 500; letter-spacing: -.02em; } h1 b, h2 b { font-weight: 500; line-height: .96; letter-spacing: -.055em; white-space: nowrap; } h1 span, h2 span { font-size: max(19px, calc(var(--hu) * 26)); letter-spacing: -.02em; line-height: 1.15; }
  h1 b { font-size: calc(var(--strip) / 5.35); background: url(/img/art-sea-960.avif) 40% 55% / 120% auto #3f6bff; background-blend-mode: screen; -webkit-background-clip: text; background-clip: text; color: transparent; animation: drift 40s ease-in-out infinite alternate; } @keyframes drift { to { background-position: 60% 72%; } }
  h2 b { font-size: calc(var(--strip) / 9.42); }

  .os { padding-top: 96px; padding-bottom: 32px; background: #01072c; color: #fff; } .os span { color: #a9bbe6; } .ask-w :global(.big) { width: 100%; } .ask-w :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .ec { padding-top: 32px; background: var(--soft); color: var(--ink); } .ec span { color: var(--t2); } .pick :global(.gems), .pick :global(.cap) { width: 100%; }
  .w { aspect-ratio: 16 / 10; margin-top: 8px; margin-bottom: -20px; border-radius: 14px 14px 0 0; overflow: clip; box-shadow: 0 0 0 1px var(--line), 0 36px 60px -30px rgb(10 26 63 / .6); }
  .os > *, .ec > * { animation: up .9s var(--ease) backwards; } .ec > * { animation-delay: .12s; } @keyframes up { from { opacity: 0; transform: translateY(16px); } }

  /* From a small laptop up, both bands fit the first screen below the alpha notice. The top band is exactly as tall as what it holds, and leaning into the daylight band tucks its second row away. */
  @media (min-width: 1000px) {
    .wall { --hu: max(.62px, min(1px, (100svh - 32px) / 868, 100vw / 1400)); --edge: max(var(--pad), calc(50vw - 624px)); --strip: calc(100vw - var(--edge) * 2); --pt: max(84px, calc(var(--hu) * 112)); --name: calc(var(--pt) + var(--strip) / 5.35 * .96); --top: calc(var(--name) + var(--hu) * 18 + max(58px, var(--hu) * 72) + var(--hu) * 36); height: max(620px, calc(100svh - 32px)); grid-template-rows: var(--top) minmax(0, 1fr); transition: grid-template-rows .75s .1s var(--ease); } .wall:has(.ec:hover), .wall:has(.ec:focus-within) { --top: calc(var(--name) + var(--hu) * 12); --fade: 0; --cap: 1; }
    h1 b { background-image: url(/img/art-sea.avif); }
    .band { padding-inline: var(--edge); }
    .os { padding-top: var(--pt); padding-bottom: 0; grid-template-columns: minmax(0, 1fr) calc(var(--hu) * 620); column-gap: calc(var(--hu) * 40); align-items: center; } .os h1 { display: contents; } .os h1 b { grid-column: 1 / -1; } .os h1 span { font-size: calc(var(--hu) * 30); max-width: 19em; text-wrap: balance; } .os h1 span, .ask-w { opacity: var(--fade, 1); transition: opacity .35s var(--ease); }
    .ec { padding-top: calc(var(--hu) * 22); grid-template-columns: calc(var(--hu) * 460) minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr); column-gap: calc(var(--hu) * 40); } .ec h2 { display: contents; } .ec h2 b { grid-column: 1 / -1; } .ec h2 span { grid-column: 1; font-size: calc(var(--hu) * 24); text-wrap: balance; } .pick { grid-column: 1; }
    .w { grid-area: 2 / 2 / span 2; aspect-ratio: auto; height: calc(100% + 24px); margin: 0; }
  }
  /* On a short screen the description waits until the band opens, instead of being cut mid-line. */
  @media (min-width: 1000px) and (max-height: 800px) { .pick :global(.cap) { opacity: var(--cap, 0); transition: opacity .35s var(--ease); } }
</style>
