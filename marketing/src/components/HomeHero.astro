    <h1>{HEAD.map((w, i) => <><span style={`--i:${i}`}>{w}</span>{" "}</>)}</h1>
    <p class="lead">Less time sorting papers, more time on what they mean.</p>
    <div class="halo"><AskBar id="ask-hero" class="big" questions={QUESTIONS} mark label="Search with Openscholar" go="Search Openscholar" /></div>
  </div>
  <div class="space">
    <div class="orb back" aria-hidden="true"><svg class="ringsvg"><defs><linearGradient id="spectrum" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#3b82f6" /><stop offset=".2" stop-color="#22d3ee" /><stop offset=".42" stop-color="#34d399" /><stop offset=".6" stop-color="#fde047" /><stop offset=".8" stop-color="#fb923c" /><stop offset="1" stop-color="#fb7185" /></linearGradient><filter id="ringsoft" x="-5%" y="-100%" width="110%" height="300%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="9" /></filter></defs><g data-ring="back"></g></svg><svg class="cometsvg"><g data-comet="back" opacity="0"></g></svg></div>
    <canvas class="earth" data-day="/img/earth-day.avif" data-night="/img/earth-night.avif" data-clouds="/img/earth-clouds.avif" data-water="/img/earth-water.avif" aria-hidden="true"></canvas>
