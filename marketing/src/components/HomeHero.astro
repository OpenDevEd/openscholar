---
// A living Earth under OpenScholar's search box, with the communities as glass satellites you can catch as they go round, named in the strip below. NASA Blue Marble, Black Marble and cloud imagery, drawn by a small shader, so the planet really turns, with day, night, weather and sea glint.
import AskBar from "./AskBar.astro";
import { COMMUNITIES } from "../data/site.mjs";
const HEAD = "Ask the world's research anything".split(" ");
const QUESTIONS = ["Do trees improve mental health?", "Can mindfulness reduce burnout?", "Do pesticides harm bees?", "Does remote work boost output?", "Do farm antibiotics harm people?", "Do cash transfers reduce hunger?"];
// Stars are fixed in size and place, so they never pop or shift between loads, and none sit behind the headline or the box. They thin out towards the bottom of the sky.
const rng = ((s) => () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296))(11);
const stars = Array.from({ length: 340 }, (_, i) => { const x = +(rng() * 2560).toFixed(1), y = +(rng() * 820).toFixed(1), big = i < 10, small = rng() < .85; return [x, y, +(big ? 1.4 + rng() * .4 : small ? .5 + rng() * .4 : .9 + rng() * .4).toFixed(2), +((big ? .9 : small ? .2 + rng() * .4 : .7) * Math.min(1, (820 - y) / 246)).toFixed(2), i % 3]; }).filter(([x, y, , o]) => o > 0 && (x < 720 || x > 1840 || y < 136 || y > 390));
---
<!-- The day map is fetched early unless the planet will be the still: data saver, a 2G connection, or a level this visit
     already settled on (the key is earth.js's MEMORY). The light levels use the smaller map. -->
<script is:inline>(() => { const c = navigator.connection; let l = -1; try { l = Number(sessionStorage.getItem("openscholar.planet-level") ?? -1); } catch {} if (l === 0 || (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || "")))) return; const k = document.createElement("link"); k.rel = "preload"; k.as = "image"; k.fetchPriority = "high"; k.href = l === 1 || l === 2 ? "/img/earth-day-2048.avif" : "/img/earth-day.avif"; document.head.append(k); })();</script>
<link rel="preload" as="image" href="/img/sky-plate.avif" />
<section class="bleed sky" data-orbit>
  <img class="plate" src="/img/sky-plate.avif" width="2560" height="820" alt="" decoding="async" />
  {[0, 1, 2].map((g) => <svg class={`stars s${g}`} viewBox="0 0 2560 820" aria-hidden="true" fill="#e6eaf5">{stars.filter((s) => s[4] === g).map(([x, y, r, o]) => <circle cx={x} cy={y} r={r} opacity={o} />)}</svg>)}
  <div class="inner say">
    <h1>{HEAD.map((w, i) => <><span style={`--i:${i}`}>{w}</span>{" "}</>)}</h1>
    <p class="lead">Less time sorting papers, more time on what they mean.</p>
    <div class="halo"><AskBar id="ask-hero" class="big" questions={QUESTIONS} mark label="Search with Openscholar" /></div>
  </div>
  <div class="space">
    <div class="orb back" aria-hidden="true"><svg class="ringsvg"><defs><linearGradient id="spectrum" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#ff6b35" /><stop offset=".16" stop-color="#ff9d36" /><stop offset=".34" stop-color="#ffd9ae" /><stop offset=".52" stop-color="#8fd3d8" /><stop offset=".76" stop-color="#5a9be6" /><stop offset="1" stop-color="#3c62b8" /></linearGradient><filter id="ringsoft" x="-5%" y="-100%" width="110%" height="300%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="9" /></filter></defs><g data-ring="back"></g></svg><i class="spark" data-spark="back"></i></div>
    <img class="still" data-still alt="" decoding="async" />
    <canvas class="earth" aria-hidden="true"></canvas>
    <div class="orb front" aria-hidden="true"><svg class="ringsvg"><g data-ring="front"></g></svg><i class="spark" data-spark="front"></i></div>
    <div class="sats" aria-hidden="true">{COMMUNITIES.map((c, i) => <a class="sat" data-sat tabindex="-1" href={c.url} style={`--c:${c.color};--i:${i}`}><img src={`/img/comm-${c.key}.avif`} width="96" height="96" alt="" decoding="async" /><b>{c.name}</b></a>)}</div>
  </div>
  <div class="inner hub">
    <p class="hubline"><a href="/evidence-communities/">Evidence Communities</a> <span>Curated evidence, open to anyone</span></p>
    <ul class="fields" aria-label="Live Evidence Communities">{COMMUNITIES.map((c) => <li style={`--c:${c.color}`}><a href={c.url}><img class="shot" src={`/img/art-tile-${c.key}-960.avif`} width="960" height="540" alt="" loading="lazy" decoding="async" /><span class="tag"><b>{c.name}</b><small>{c.host}</small></span></a></li>)}</ul>
  </div>
</section>
