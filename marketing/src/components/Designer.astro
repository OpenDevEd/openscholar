---
const accents = [["#2563eb", "Blue"], ["#f58220", "Orange"], ["#0f9d76", "Green"], ["#c2410c", "Rust"], ["#7c8aa5", "Slate"]];
const records = [["Randomised trial", "Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia"], ["Randomised trial", "Assessing the Differential Effects of Peer Tutoring for Tutors and Tutees"], ["Quasi-experiment", "Academic Achievement and Peer Tutoring in Mathematics: A Comparison Between Primary and Secondary Education"], ["Randomised trial", "An exploratory evaluation of a paired maths intervention with secondary aged pupils"], ["Quasi-experiment", "Effect Of Peer Tutoring On Students' Academic Achievement In Office Technology And Mangement In Nigerian Polytechnics"]];
---

  <section class="studio" data-studio>
    <div class="controls">
      <h2>Make it yours</h2><p class="sub">Go on, change something.</p>
      <label class="fld"><span>Name</span><input data-name value="Peer Tutoring Evidence" maxlength="48" /></label>
      <div class="fld"><span>Accent</span><div class="sw" role="radiogroup" aria-label="Accent colour">{accents.map(([c, n], i) => <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} aria-label={n} data-accent={c} style={`--c:${c}`}></button>)}</div></div>
      <div class="fld"><span>Appearance</span><div class="seg" role="radiogroup" aria-label="Appearance"><button type="button" role="radio" aria-checked="true" data-mode="dark">Dark</button><button type="button" role="radio" aria-checked="false" data-mode="light">Light</button></div></div>
      <div class="fld"><span>Language</span><div class="seg" role="radiogroup" aria-label="Language"><button type="button" role="radio" aria-checked="true" data-lang="en">English</button><button type="button" role="radio" aria-checked="false" data-lang="fr">Français</button><button type="button" role="radio" aria-checked="false" data-lang="ar">العربية</button></div></div>
      <div class="fld"><span>Features</span><div class="tog"><label><input type="checkbox" checked data-f="map" />Map</label><label><input type="checkbox" checked data-f="ask" />Ask AI</label><label><input type="checkbox" checked data-f="dig" />Digests</label></div></div>
      <button type="button" class="btn primary build" data-build>Go live</button>
    </div>
    <div class="browser" data-site data-mode="dark">
      <div class="url"><span class="mono" data-url>peer-tutoring-evidence.openscholar.ai</span><em data-live-tag hidden>Live</em></div>
      <div class="site" data-root>
        <header class="s-top"><img src="/mark.svg" width="22" height="22" alt="" /><b data-title>Peer Tutoring Evidence</b><nav><a data-t="lib">Library</a><a data-t="map" data-x="map">Map</a><a data-x="dig" data-t="dig">Digests</a><a data-t="contact">Contact Us</a></nav><span class="s-in" data-t="in">Sign in</span></header>
        <div class="s-hero">
          <img class="fan dark" src="/img/lib-fan-dark.avif" width="720" height="766" loading="lazy" decoding="async" alt="" /><img class="fan light" src="/img/lib-fan-light.avif" width="1000" height="356" loading="lazy" decoding="async" alt="" />
          <div class="s-copy"><h3 data-title2>Peer Tutoring Evidence</h3><div class="s-search"><span>peer tutoring</span><em data-x="ask" data-t="ask">Ask AI</em></div></div>
        </div>
        <div class="s-main">{records.slice(0, 3).map(([k, t]) => <article><span class="k" data-t={k === "Randomised trial" ? "rct" : "quasi"}>{k}</span><h4 lang="en" dir="ltr">{t}</h4></article>)}</div>
      </div>
    </div>
  </section>

  
<script>
  const STR = { en: { lib: "Library", map: "Map", contact: "Contact Us", in: "Sign in", ask: "Ask AI", dig: "Digests", rct: "Randomised trial", quasi: "Quasi-experiment" }, fr: { lib: "Bibliothèque de preuves", map: "Carte", contact: "Nous contacter", in: "Se connecter", ask: "Demander à l'IA", dig: "Derniers digests", rct: "Essai randomisé", quasi: "Quasi-expérience" }, ar: { lib: "مكتبة الأدلة", map: "خريطة", contact: "اتصل بنا", in: "تسجيل الدخول", ask: "اسأل الذكاء الاصطناعي", dig: "أحدث الملخصات", rct: "تجربة معشاة", quasi: "شبه تجربة" } };
  const S = document.querySelector("[data-studio]"), site = S.querySelector("[data-site]"), root = S.querySelector("[data-root]");
  const slug = (s) => s.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "library";
  const tag = S.querySelector("[data-live-tag]"), build = S.querySelector("[data-build]");
  const name = S.querySelector("[data-name]"); name.addEventListener("input", () => { const v = name.value || "Untitled library"; S.querySelector("[data-title]").textContent = v; S.querySelector("[data-title2]").textContent = v; tag.hidden = true; build.textContent = "Go live"; S.querySelector("[data-url]").textContent = `${slug(v)}.openscholar.ai`; });
  const radio = (sel, on) => { const btns = [...S.querySelectorAll(sel)]; btns.forEach((b) => b.addEventListener("click", () => { btns.forEach((x) => x.setAttribute("aria-checked", x === b ? "true" : "false")); on(b); })); };
  radio("[data-accent]", (b) => { site.style.setProperty("--a", b.dataset.accent); document.documentElement.style.setProperty("--lib", b.dataset.accent); });
  radio("[data-mode]", (b) => { site.dataset.mode = b.dataset.mode; });
  radio("[data-lang]", (b) => { const l = b.dataset.lang, t = STR[l]; root.dir = l === "ar" ? "rtl" : "ltr"; root.lang = l; root.querySelectorAll("[data-t]").forEach((e) => { e.textContent = t[e.dataset.t]; }); });
  S.querySelectorAll("[data-f]").forEach((c) => c.addEventListener("change", () => root.querySelectorAll(`[data-x="${c.dataset.f}"]`).forEach((e) => { e.hidden = !c.checked; })));
  build.addEventListener("click", () => { tag.hidden = false; build.textContent = "It's live"; site.classList.remove("going"); void site.offsetWidth; site.classList.add("going"); });
</script>
<style>
  .studio { min-height: 100svh;  display: grid; grid-template-columns: minmax(320px, 4fr) minmax(0, 9fr); gap: 32px; padding: 96px var(--edge) 40px; align-items: stretch; }
  .controls { display: flex; flex-direction: column; gap: 18px; }
  h2 { font-size: clamp(40px, 4.4vw, 72px); } .sub { color: var(--t2); font-size: 18px; margin-bottom: 8px; }
  .fld { display: grid; gap: 6px; } .fld > span { font-size: 13px; color: var(--t2); }
  .fld input:not([type="checkbox"]) { height: 44px; padding-inline: 12px; background: var(--s1); border: 1px solid var(--line2); border-radius: 10px; font-size: 15px; outline-color: var(--ink); }
  .sw { display: flex; gap: 8px; } .sw button { width: 34px; height: 34px; border-radius: 50%; background: var(--c); transition: box-shadow .15s var(--ease); } .sw [aria-checked="true"] { box-shadow: 0 0 0 2px #000, 0 0 0 4px var(--t1); }
  .seg { display: flex; gap: 4px; padding: 4px; background: var(--s1); border-radius: 12px; border: 1px solid var(--line); } .seg button { flex: 1; height: 34px; padding-inline: 10px; font-size: 13px; color: var(--t2); border-radius: 8px; transition: background-color .15s var(--ease), color .15s var(--ease); } .seg [aria-checked="true"] { background: var(--t1); color: #000; }
  .tog { display: flex; flex-wrap: wrap; gap: 14px; font-size: 14px; } .tog label { display: flex; align-items: center; gap: 6px; cursor: pointer; } .tog input { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
  .build { justify-content: center; margin-top: 4px; }
  .browser { --a: #2563eb; --bg: #0a0a0a; --card: #151515; --ink2: #ededed; --mut: #9a9a9a; --ln: rgb(255 255 255 / .1); display: flex; flex-direction: column; border-radius: 20px; overflow: hidden; border: 1px solid var(--line2); background: var(--bg); color: var(--ink2); transition: background-color .25s var(--ease), color .25s var(--ease); min-height: 620px; }
  .browser[data-mode="light"] { --bg: #f4f3f0; --card: #fff; --ink2: #171717; --mut: #6b6b6b; --ln: rgb(0 0 0 / .1); }
  .url { padding: 10px 16px; border-bottom: 1px solid var(--ln); text-align: center; } .url .mono { color: var(--mut); }
  .site { flex: 1; padding: 18px; display: flex; flex-direction: column; gap: 16px; }
  .s-top { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--card); border-radius: 14px; flex-wrap: wrap; } .s-top b { font-weight: 500; font-size: 16px; }
  .s-top nav { display: flex; gap: 16px; margin-inline: auto; font-size: 14px; color: var(--mut); flex-wrap: wrap; } .s-top nav a:first-child { color: var(--a); }
  .s-in { background: var(--a); color: #fff; padding: 6px 12px; border-radius: 8px; font-size: 13px; transition: background-color .2s var(--ease); }
  .s-hero { position: relative; flex: 1; min-height: 260px; display: flex; align-items: flex-end; border-radius: 14px; overflow: hidden; }
  .fan { position: absolute; right: 0; top: 0; width: 56%; height: 100%; object-fit: cover; object-position: 50% 0; mask-image: linear-gradient(90deg, transparent, #000 30%); } .fan.light { display: none; } [data-mode="light"] .fan.light { display: block; } [data-mode="light"] .fan.dark { display: none; }
  .s-copy { position: relative; width: min(60%, 560px); padding: 16px; } h3 { font: 700 clamp(30px, 3.6vw, 60px)/1 var(--sans); letter-spacing: -.035em; margin-bottom: 16px; text-wrap: balance; }
  .s-main { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .going .site { animation: sweep 1s var(--ease) both; } @keyframes sweep { from { clip-path: inset(0 100% 0 0); filter: brightness(1.8); } to { clip-path: inset(0); filter: none; } }
  [data-live-tag] { margin-left: 10px; font-style: normal; font-size: 12px; color: #000; background: var(--t1); padding: 1px 8px; border-radius: 999px; }
  .s-search { display: flex; align-items: center; justify-content: space-between; height: 44px; padding-inline: 14px 6px; background: var(--card); border-radius: 12px; font-size: 14px; color: var(--mut); } .s-search em { font-style: normal; background: var(--a); color: #fff; padding: 5px 10px; border-radius: 8px; font-size: 13px; }
  article { background: var(--card); border-radius: 14px; padding: 14px 16px; } .k { font-size: 13px; color: var(--a); } h4 { margin: 4px 0 0; font-weight: 400; font-size: clamp(15px, 1.4vw, 20px); line-height: 1.25; }
  [hidden] { display: none !important; }
  @media (max-width: 1000px) { .studio { display: flex; flex-direction: column; } .controls { display: contents; } .browser { order: 1; } .fld, .build { order: 2; } .browser { min-height: 560px; } .s-main { grid-template-columns: minmax(0, 1fr); } .s-copy { width: 100%; } .fan { opacity: .45; width: 100%; } }
</style>
