---
// What the team has published, as covers standing on a lit glass shelf that drifts by. Each cover opens its publication.
// The shelf is a picture (public/img/art-shelf): its top surface is 71.8% of the way down it, so the covers stand a fixed
// share of the picture's width (--w) above its foot. The picture is sunk a little below the panel's foot (--sink), which
// leaves less empty floor under the shelf and more room for the covers.
import { SHELF } from "../data/team.mjs";
---
<section class="research" id="research" aria-labelledby="shelf-h">
  <div class="sh-copy"><h2 id="shelf-h">Research by the team</h2></div>
  <div class="panel shelf"><div class="lane"><div class="run">{[0, 1].map((copy) => <ul aria-hidden={copy ? "true" : undefined}>{SHELF.map((b) => <li><a href={b.url} tabindex={copy ? -1 : undefined} aria-label={`${b.title}, ${b.year}`}><img src={`/img/team/pub-${b.cover}.avif`} srcset={`/img/team/pub-${b.cover}.avif 200w, /img/team/pub-${b.cover}-480.avif 480w`} sizes="(max-width: 700px) 120px, 200px" width="150" height="200" alt="" loading="lazy" decoding="async" /><span class="cap"><b>{b.title}</b><em>{b.year}</em></span></a></li>)}</ul>)}</div></div></div>
</section>
<script>
  // Reached with the keyboard, the shelf stops being a moving strip and becomes a row that scrolls, from exactly where the
  // strip had got to, and glides to the cover in focus. When the keyboard leaves, the strip carries on from exactly where
  // the row was scrolled to. Nothing jumps either way.
  const run = document.querySelector(".shelf .run"), calm = matchMedia("(prefers-reduced-motion: reduce)");
  if (run) {
    // The covers wait until the shelf is near, then all load: left to the browser, one further along the strip would load
    // only as it slid into the panel, and appear from one frame to the next.
    new IntersectionObserver(([near], io) => { if (!near.isIntersecting) return; io.disconnect(); for (const img of run.querySelectorAll("img")) img.loading = "eager"; }, { rootMargin: "800px" }).observe(run);
    const inset = () => parseFloat(getComputedStyle(run).paddingLeft);
    run.addEventListener("focusin", (e) => {
      if (!e.target.matches(":focus-visible")) return;
      if (!run.classList.contains("kb") && !calm.matches) { const x = -new DOMMatrix(getComputedStyle(run).transform).m41; run.classList.add("kb"); run.scrollLeft = x + inset(); }
      requestAnimationFrame(() => e.target.scrollIntoView({ block: "nearest", inline: "center", behavior: calm.matches ? "auto" : "smooth" }));
    });
    run.addEventListener("focusout", (e) => {
      if (!run.classList.contains("kb") || run.contains(e.relatedTarget)) return;
      // How far through its loop the strip would be to stand where the row now stands. The two copies of the covers make any
      // place on the row a place in the loop.
      const turn = (((run.scrollLeft - inset()) / run.firstElementChild.offsetWidth) % 1 + 1) % 1; run.classList.remove("kb"); run.style.animationDelay = `${-turn * parseFloat(getComputedStyle(run).animationDuration)}s`;
    });
  }
</script>
<style>
  /* The section is the box the shelf measures itself by (cqw): a box can't measure by itself, and the section is as wide as
     the panel. */
  .research { container-type: inline-size; padding-top: clamp(8px, 1vw, 16px); }
  /* The heading stands on the page, at the page's edge like the others, with the lit shelf as the panel under it. */
  .sh-copy { margin-bottom: clamp(24px, 3vw, 40px); padding-inline: var(--edge); }
  .shelf { --bg: #020614; --w: 100cqw; --sink: 5.6cqw; height: clamp(340px, 41cqw, 512px); background: linear-gradient(to top, #020614, transparent) 50% 100% / 100% 5cqw no-repeat, url(/img/art-shelf.avif) 50% calc(100% + var(--sink)) / var(--w) auto no-repeat, #020614; }
  /* The covers come out of the dark at one side of the panel and go back into it at the other. */
  .lane { position: absolute; left: 0; right: 0; bottom: calc(var(--w) * .156 - var(--sink)); -webkit-mask-image: linear-gradient(90deg, transparent, #000 72px, #000 calc(100% - 72px), transparent); mask-image: linear-gradient(90deg, transparent, #000 72px, #000 calc(100% - 72px), transparent); }
  /* They pass slowly along the shelf, and hold still under the pointer. The room above them is for a cover's lift and its
     title, and is inside the strip so that neither is cut off when the strip becomes a row that scrolls. */
  .run { display: flex; width: max-content; padding-top: 130px; animation: shelf 110s linear infinite; } .run:hover, .research:global(.away) .run { animation-play-state: paused; } @keyframes shelf { to { transform: translateX(-50%); } }
  .run ul { display: flex; align-items: flex-end; flex: none; gap: clamp(18px, 2.4cqw, 30px); padding-right: clamp(18px, 2.4cqw, 30px); }
  .run a { position: relative; display: block; transition: translate .35s var(--ease); } .run img { width: clamp(120px, 16cqw, 200px); height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 0; border-radius: 3px; box-shadow: 0 0 0 1px rgb(255 255 255 / .14), 0 -18px 40px -18px rgb(255 170 70 / .5), 0 2px 0 rgb(255 196 120 / .9); transition: box-shadow .35s var(--ease); }
  .run a:hover, .run a:focus-visible { translate: 0 -12px; } .run a:hover img, .run a:focus-visible img { box-shadow: 0 0 0 1px rgb(255 255 255 / .3), 0 -18px 50px -14px rgb(255 170 70 / .8), 0 14px 22px -8px rgb(0 0 0 / .8); }
  /* A cover names itself above when pointed at, as its own title is too small to read. */
  .cap { position: absolute; left: 50%; bottom: calc(100% + 12px); z-index: 2; display: grid; gap: 2px; width: 240px; padding: 10px 12px; border-radius: 12px; background: #10141f; box-shadow: 0 0 0 1px rgb(255 255 255 / .14), 0 18px 30px -12px #000; translate: -50% 6px; opacity: 0; pointer-events: none; transition: opacity .12s var(--ease), translate .12s var(--ease); } .run a:hover .cap, .run a:focus-visible .cap { opacity: 1; translate: -50% 0; }
  .cap b { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; font-weight: 500; font-size: 14px; line-height: 1.3; } .cap em { font: 400 13px/1.2 var(--mono); color: rgb(255 255 255 / .62); }
  @media (max-width: 700px) { .shelf { --w: 180cqw; --sink: 10cqw; height: clamp(320px, 84cqw, 380px); } .run { padding-top: 24px; } .lane { -webkit-mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent); } .run img { width: 120px; } .cap { display: none; } }
  /* With the keyboard on a cover (.kb, set by the script), or for a visitor who asked for less motion, the shelf is one row
     that scrolls. With less motion it holds the covers once; with the keyboard it keeps both copies, so nothing disappears. */
  .run:global(.kb) { width: auto; overflow-x: auto; scrollbar-width: none; animation: none; }
  @media (prefers-reduced-motion: reduce) { .run { width: auto; overflow-x: auto; } .run ul[aria-hidden] { display: none; } }
  /* As a row, it keeps its first and last covers clear of the fade at the panel's sides, with room for a title above them. */
  .run:global(.kb) { padding-inline: 72px; } @media (prefers-reduced-motion: reduce) { .run { padding-inline: 72px; } }
  @media (max-width: 700px) { .run:global(.kb) { padding-inline: 28px; } } @media (max-width: 700px) and (prefers-reduced-motion: reduce) { .run { padding-inline: 28px; } }
</style>
