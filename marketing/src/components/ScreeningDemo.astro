---
import Icon from "./Icon.astro";
const P = { Yes: 2, Unclear: 1, No: 0 };
const rows = [
  ["Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia", "Yes", "Yes"],
  ["Peer tutoring in reading in Scotland: thinking big", "Yes", "Yes"],
  ["Peer tutoring in reading: the effects of role and organization on two dimensions of self-esteem", "Yes", "Unclear"],
  ["How to Analyze Interpersonal and Individual Effects in Peer-Tutored Reading Intervention", "Unclear", "Yes"],
  ["A Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia", "Unclear", "Unclear"],
  ["How does peer tutoring contribute to the development of reading comprehension?", "No", "Unclear"],
  ["Psychological Effects of Peer Tutoring in Mathematics in Primary Education", "No", "No"],
].map(([t, a, b]) => ({ t, a, b, s: P[a] + P[b] }));
const MARK = 3;
---
<div class="win sd" data-screening>
  <div class="win-head">
    <label for="mark">Points to be included</label>
    <input id="mark" type="range" min="0" max="4" step="1" value={MARK} />
    <output for="mark" class="mono" data-mark>{MARK} of 4</output>
    <span class="tally mono"><b data-in>{rows.filter((r) => r.s >= MARK).length}</b> included</span>
  </div>
  <div class="qs mono"><span>1 Is this a randomized trial?</span><span>2 Is it about reading in primary school?</span></div>
  <ol>
    {rows.map((r) => (
      <li data-score={r.s} class={r.s >= MARK ? "in" : "out"}>
        <span class="st in-i"><Icon name="check" /></span><span class="st out-i"><Icon name="x" /></span>
        <span class="t">{r.t}<span class="vh" data-state>{r.s >= MARK ? ", included" : ", excluded"}</span></span>
        <span class:list={["a", r.a]}><span class="qn">1</span>{r.a}</span><span class:list={["a", "a2", r.b]}><span class="qn">2</span>{r.b}</span>
        <span class="meter" role="img" aria-label={`${r.s} of 4 points`}><i style={`transform:scaleX(${r.s / 4})`}></i></span>
      </li>
    ))}
  </ol>
</div>
<script is:inline>
  document.querySelectorAll("[data-screening]").forEach((el) => {
    const input = el.querySelector("input"), rows = [...el.querySelectorAll("li")];
    const apply = () => { const m = +input.value; let n = 0; for (const r of rows) { const on = +r.dataset.score >= m; r.className = on ? "in" : "out"; r.querySelector("[data-state]").textContent = on ? ", included" : ", excluded"; n += on; } el.querySelector("[data-mark]").textContent = `${m} of 4`; el.querySelector("[data-in]").textContent = n; };
    input.addEventListener("input", apply);
  });
</script>
<style>
  .sd .win-head { justify-content: flex-start; flex-wrap: wrap; color: var(--t1); }
  input[type="range"] { accent-color: var(--accent); width: 160px; height: 24px; }
  .tally { margin-left: auto; color: var(--t2); } .tally b { color: var(--t1); font-weight: 400; font-size: 16px; font-variant-numeric: tabular-nums; }
  .qs { display: flex; gap: 24px; padding: 8px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  li { display: grid; grid-template-columns: 20px minmax(0, 1fr) 64px 64px 80px; gap: 12px; align-items: center; padding: 12px 16px; border-top: 1px solid var(--line); font-size: 14px; }
  li:first-child { border-top: 0; }
  li.out .t, li.out .a { color: var(--t3); } li.out .meter { opacity: .5; }
  .t, .a { transition: color .18s var(--ease); } .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st { grid-area: 1 / 1; display: grid; place-items: center; }
  .in-i { color: var(--good); } .out-i { color: var(--t3); }
  li.in .out-i, li.out .in-i { visibility: hidden; }
  .a { font-size: 13px; display: flex; gap: 6px; } .qn { font-family: var(--mono); color: var(--t3); }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } .Yes { color: var(--good); } .No { color: var(--bad); } .Unclear { color: var(--warn); }
  .meter { height: 4px; border-radius: 2px; background: var(--s3); overflow: hidden; display: block; }
  .meter i { display: block; height: 100%; background: var(--ink); transform-origin: left; }
  @media (max-width: 720px) { li { grid-template-columns: 20px 72px 72px minmax(0, 1fr); row-gap: 4px; } .t { grid-area: 1 / 2 / auto / -1; white-space: normal; } .a { grid-row: 2; } .a:not(.a2) { grid-column: 2; } .a2 { grid-column: 3; } .meter { grid-row: 2; grid-column: 4; } }
</style>
