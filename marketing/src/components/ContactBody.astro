---
// Everything on the Contact page below its hero: the form that rises over the hero, email, answers and the close.
import Faq from "./Faq.astro";
import Arrow from "./Arrow.astro";
import Art from "./Art.astro";
import Icon from "./Icon.astro";
import { APP } from "../data/site.mjs";
import countries from "../data/countries.json";
const EMAIL = "habari@openscholar.ai";
// What people write to us about. Each topic asks for what it needs: a project where there is one, a country for the
// Southern plan, and a message labelled for the topic.
const topics = [
  { id: "community", icon: "layers", color: "#fb7185", title: "Start an Evidence Community", text: "A public home for your field's evidence", project: ["Your community", "What will it cover, who will read it, and where does its evidence come from today?"], message: ["Anything else", "Optional"] },
  { id: "team", icon: "team", color: "#38bdf8", title: "Bring your team", text: "Shared searches, screenings and extractions", project: ["Your project", "What is your team working on, and how many people are involved?"], message: ["Anything else", "Optional"] },
  { id: "southern", icon: "globe", color: "#34d399", title: "Southern plan", text: "For researchers in low- and middle-income countries", project: ["Your research", "What are you researching, and what do you want to use Openscholar for?"], country: true, org: "Institution", message: ["Anything else", "Optional"] },
  { id: "partner", icon: "buildings", color: "#fbbf24", title: "Research and partnerships", text: "Evidence work for your sector or programme", project: ["Your project", "What would you like to find out, and who is it for?"], message: ["Anything else", "Optional"] },
  { id: "account", icon: "key", color: "#7da7e6", title: "Help with your account", text: "Signing in, workspaces and access", message: ["What happened", "Tell us what you were trying to do and what happened instead.", true] },
  { id: "other", icon: "mail", color: "#ff9d36", title: "Something else", text: "Feedback, press or anything we missed", message: ["Message", "What's on your mind?", true] },
];
const first = topics[0];
const faq = [
  ["Can I try Openscholar before getting in touch?", "Yes. Get started and run your first search straight away. You don't need to talk to anyone first."],
  ["I found a mistake in a community's record", "Write to that community from its own Contact page. Messages there go to the people who look after it."],
  ["Where can I learn how something works?", "The documentation walks through searching, screening, extraction, the assistant, teams and communities, step by step."],
];
---
  <section class="desk" aria-labelledby="desk-h">
    <form class="form" data-contact novalidate>
      <div class="topics" role="radiogroup" aria-labelledby="desk-h">
        <h2 id="desk-h">What can we help with?</h2>
        <div class="tiles">{topics.map((t, i) => <label class="tile" style={`--c:${t.color}`} data-topic={JSON.stringify({ project: t.project ?? null, country: !!t.country, org: t.org ?? "Organisation", message: t.message })}><input type="radio" name="topic" value={t.id} checked={i === 0} /><span class="em" aria-hidden="true"><img src={`/img/topic-${t.id}.avif`} width="240" height="240" alt="" loading="lazy" decoding="async" /></span><b>{t.title}</b><em>{t.text}</em></label>)}</div>
      </div>
      <div class="fields">
        <div class="col">
        <div class="stack">
          <label class="f"><span class="lh"><span>Name</span><small class="side"><span class="err" id="e-name"></span></small></span><input name="name" autocomplete="name" maxlength="120" required aria-describedby="e-name" /></label>
          <label class="f"><span class="lh"><span>Email</span><small class="side"><span class="err" id="e-email"></span></small></span><input name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="e-email" /></label>
        </div>
        <div class="duo">
          <label class="f"><span class="lh"><span><span data-org>Organisation</span> <small class="opt-tag">Optional</small></span><small class="side"><span class="err" id="e-org"></span></small></span><input name="org" autocomplete="organization" maxlength="160" aria-describedby="e-org" /></label>
          <div class="opt off" data-opt="country"><div class="f"><span class="lh"><label for="country">Country</label><small class="side"><span class="err" id="e-country"></span></small></span>
            <div class="cbx" data-cbx>
              <span class="c-mark" aria-hidden="true"><span class="c-globe"><Icon name="globe" size={18} /></span><img class="c-flag" alt="" width="18" height="13" hidden /></span>
              <input id="country" name="country" role="combobox" aria-expanded="false" aria-controls="country-list" aria-autocomplete="list" autocomplete="off" placeholder="Search countries" required disabled aria-describedby="e-country" />
              <svg class="c-chev" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg>
            </div>
          </div></div>
        </div>
        </div>
        <div class="col">
        <div class="opt" data-opt="project"><label class="f"><span class="lh"><span data-project-label>{first.project[0]}</span><small class="side"><span class="err" id="e-project"></span><span class="count" data-count>0 / 3,000</span></small></span><textarea name="project" rows="4" maxlength="3000" required data-min="20" placeholder={first.project[1]} aria-describedby="e-project"></textarea></label></div>
        <label class="f"><span class="lh"><span><span data-msg-label>{first.message[0]}</span> <small class="opt-tag" data-msg-optional>Optional</small></span><small class="side"><span class="err" id="e-message"></span><span class="count" data-count>0 / 3,000</span></small></span><textarea name="message" rows="3" maxlength="3000" data-msg placeholder="" aria-describedby="e-message"></textarea></label>
        <div class="send"><button class="btn brand" type="submit">Send message<Arrow /></button><p class="note">Replies come from {EMAIL}</p></div>
        </div>
      </div>
      <ul id="country-list" class="c-pop" role="listbox" aria-label="Countries" popover="manual">{countries.map(([code, name]) => <li role="option" id={`c-${code}`} data-code={code} aria-selected="false"><img src={`https://flagcdn.com/w20/${code.toLowerCase()}.png`} alt="" width="18" height="13" loading="lazy" />{name}</li>)}<li class="c-none" role="presentation" hidden>No country matches</li></ul>
      <div class="sent" data-sent hidden>
        <svg class="env" viewBox="0 0 220 160" fill="none" aria-hidden="true">
          <defs><linearGradient id="trail" x1="0" x2="1"><stop offset="0" stop-color="#2563eb" stop-opacity="0" /><stop offset=".35" stop-color="#22d3ee" /><stop offset=".6" stop-color="#34d399" /><stop offset=".8" stop-color="#fbbf24" /><stop offset="1" stop-color="#fb7185" /></linearGradient><linearGradient id="glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6ea" /><stop offset="1" stop-color="#ffd3a3" /></linearGradient></defs>
          <path class="trail" d="M6 150C56 150 92 128 128 92" stroke="url(#trail)" stroke-width="3" stroke-linecap="round" pathLength="1" />
          <g class="fly"><rect x="104" y="44" width="96" height="66" rx="10" fill="url(#glass)" stroke="#e0650a" stroke-width="2" /><path class="flap" d="M105 50 152 86l47-36" fill="#fff1df" stroke="#e0650a" stroke-width="2" stroke-linejoin="round" /></g>
        </svg>
        <h2 tabindex="-1" data-sent-h>Thanks, it's on its way</h2>
        <p>Replies go to <b data-sent-to></b>.</p>
        <button class="btn line" type="button" data-again>Write another</button>
      </div>
    </form>
  </section>

  <section class="panel mail" aria-labelledby="mail-h">
    <i class="field f-night" aria-hidden="true"></i><Art name="contact-window" pos="100% 60%" class="m-art" />
    <div class="m-copy"><h2 id="mail-h">Prefer email?</h2><p class="lead">Write to us from your own inbox. It reaches the same people.</p></div>
    <div class="cap">
      <i class="cap-ic"><Icon name="mail" size={18} /></i>
      <a class="cap-addr" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <button type="button" class="cap-btn" data-copy={EMAIL} aria-label={`Copy ${EMAIL}`}><span class="swap"><span class="a"><Icon name="copy" size={16} /><span class="t">Copy</span></span><span class="b"><Icon name="check" size={16} /><span class="t">Copied</span></span></span></button>
    </div>
  </section>

  <Faq items={faq} title="Before you write" />
  <section class="bleed close"><Art name="close-rose" pos="50% 100%" /><h2>Or start on your own</h2><a class="btn" href={APP}>Get started<Arrow /></a></section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  if (form) {
    const sent = form.querySelector<HTMLElement>("[data-sent]")!;
    const msg = form.querySelector<HTMLTextAreaElement>("[data-msg]")!, project = form.querySelector<HTMLTextAreaElement>("textarea[name=project]")!;
    const country = form.querySelector<HTMLInputElement>("#country")!, list = form.querySelector<HTMLUListElement>("#country-list")!;
    const options = [...list.querySelectorAll<HTMLLIElement>("li[data-code]")], none = list.querySelector<HTMLElement>(".c-none")!;
    // Lower case and without accents, so "cote" finds Côte d'Ivoire.
    const plain = (text: string) => text.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase().trim();
    const byName = new Map(options.map((o) => [plain(o.textContent!), o]));
    let picked: HTMLLIElement | null = null;

    // Measured once with every field open: the message box takes over exactly the space the project field gives up, over the
    // same time, so the column it shares never changes height.
    const projectH = form.querySelector<HTMLElement>("[data-opt=project]")!.offsetHeight, msgH = msg.offsetHeight;

    // Validation. A field says what's wrong in its label row, where its character count sits, so nothing below it moves.
    // It speaks up once it has been left or the form has been sent, and goes quiet as soon as it's fixed.
    const EMAIL = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;
    const problem = (f: HTMLInputElement | HTMLTextAreaElement) => {
      if (f.disabled) return "";
      const v = f.value.trim();
      if (f === country) return !v ? "Choose a country" : picked && plain(picked.textContent!) === plain(v) ? "" : "Choose one from the list";
      if (!v) return f.required ? (f.name === "name" ? "Enter your name" : f.name === "email" ? "Enter your email" : "Required") : "";
      if (f.name === "email" && !EMAIL.test(v)) return "Check this address";
      const min = Number(f.dataset.min ?? 0);
      if (v.length < min) return `At least ${min} characters`;
      return "";
    };
    const fields = () => [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(".fields input, .fields textarea")];
    const show = (f: HTMLInputElement | HTMLTextAreaElement) => {
      const p = problem(f), box = f.closest<HTMLElement>(".f")!;
      box.classList.toggle("bad", !!p); f.setAttribute("aria-invalid", String(!!p));
      box.querySelector(".err")!.textContent = p;
      return !p;
    };
    const count = (f: HTMLTextAreaElement) => {
      const c = f.closest(".f")!.querySelector<HTMLElement>("[data-count]");
      if (!c) return;
      c.textContent = `${f.value.length.toLocaleString()} / ${f.maxLength.toLocaleString()}`;
      c.classList.toggle("near", f.value.length > f.maxLength * .9);
    };
    form.addEventListener("focusout", (e) => { const f = e.target as HTMLInputElement; if (f.closest?.(".fields") && f.name && f !== country) { f.dataset.seen = ""; show(f); } });
    form.addEventListener("input", (e) => { const f = e.target as HTMLInputElement | HTMLTextAreaElement; if (!f.closest?.(".fields")) return; if (f instanceof HTMLTextAreaElement) count(f); if ("seen" in f.dataset) show(f); });

    // The country picker: type to narrow the list, arrows to move, Enter to choose. The list opens in the top layer under the
    // field, at its width, so the field's folding container never clips it.
    let active: HTMLLIElement | null = null;
    const visible = () => options.filter((o) => !o.hidden);
    const mark = (o: HTMLLIElement | null) => {
      active?.classList.remove("on"); active = o; o?.classList.add("on");
      country.setAttribute("aria-activedescendant", o?.id ?? ""); o?.scrollIntoView({ block: "nearest" });
    };
    const place = () => { const r = country.getBoundingClientRect(); list.style.left = `${r.left}px`; list.style.top = `${r.bottom + 6}px`; list.style.width = `${r.width}px`; };
    const open = () => { if (list.matches(":popover-open")) return; place(); list.showPopover(); country.setAttribute("aria-expanded", "true"); };
    const close = () => { if (!list.matches(":popover-open")) return; list.hidePopover(); country.setAttribute("aria-expanded", "false"); mark(null); };
    const filter = () => {
      const q = plain(country.value), starts: HTMLLIElement[] = [], rest: HTMLLIElement[] = [];
      for (const o of options) { const n = plain(o.textContent!); const hit = !q || n.includes(q); o.hidden = !hit; if (hit) (q && n.startsWith(q) ? starts : rest).push(o); }
      // Names that start with what was typed come first.
      for (const o of [...starts, ...rest]) list.insertBefore(o, none);
      none.hidden = starts.length + rest.length > 0;
      mark(q ? (starts[0] ?? rest[0] ?? null) : picked);
    };
    const choose = (o: HTMLLIElement) => {
      picked?.setAttribute("aria-selected", "false"); picked = o; o.setAttribute("aria-selected", "true");
      country.value = o.textContent!; const flag = form.querySelector<HTMLImageElement>(".c-flag")!;
      flag.src = o.querySelector("img")!.src; flag.hidden = false; form.querySelector<HTMLElement>(".c-globe")!.hidden = true;
      close(); country.dataset.seen = ""; show(country);
    };
    const unpick = () => { picked?.setAttribute("aria-selected", "false"); picked = null; form.querySelector<HTMLImageElement>(".c-flag")!.hidden = true; form.querySelector<HTMLElement>(".c-globe")!.hidden = false; };
    country.addEventListener("focus", () => { filter(); open(); });
    country.addEventListener("click", () => { filter(); open(); });
    country.addEventListener("input", () => { if (picked && plain(picked.textContent!) !== plain(country.value)) unpick(); filter(); open(); });
    country.addEventListener("keydown", (e) => {
      const v = visible(), i = active ? v.indexOf(active) : -1;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); open(); mark(v[Math.max(0, Math.min(v.length - 1, i + (e.key === "ArrowDown" ? 1 : -1)))] ?? null); }
      else if (e.key === "Enter" && list.matches(":popover-open")) { e.preventDefault(); if (active) choose(active); }
      else if (e.key === "Escape" && list.matches(":popover-open")) { e.preventDefault(); close(); }
    });
    // A name typed out in full counts as choosing it.
    country.addEventListener("blur", () => { close(); const exact = byName.get(plain(country.value)); if (exact && exact !== picked) choose(exact); else if (country.value) { country.dataset.seen = ""; show(country); } });
    list.addEventListener("mousedown", (e) => e.preventDefault());
    list.addEventListener("click", (e) => { const o = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-code]"); if (o) choose(o); });
    list.addEventListener("mousemove", (e) => { const o = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-code]"); if (o && o !== active) mark(o); });
    addEventListener("scroll", () => { if (list.matches(":popover-open")) place(); }, { passive: true });
    addEventListener("resize", () => { if (list.matches(":popover-open")) place(); });

    const opt = (name: string, on: boolean) => {
      const el = form.querySelector<HTMLElement>(`[data-opt=${name}]`)!;
      el.classList.toggle("off", !on);
      el.querySelectorAll<HTMLInputElement>("input, textarea").forEach((f) => { f.disabled = !on; if (!on) { f.closest(".f")!.classList.remove("bad"); f.removeAttribute("aria-invalid"); } });
    };
    // The fields ask what the chosen topic needs.
    const topic = () => {
      const on = form.querySelector<HTMLInputElement>("input[name=topic]:checked")!.closest<HTMLElement>(".tile")!;
      const t = JSON.parse(on.dataset.topic!);
      opt("project", !!t.project); opt("country", t.country);
      if (t.project) { form.querySelector("[data-project-label]")!.textContent = t.project[0]; project.placeholder = t.project[1]; }
      form.querySelector("[data-org]")!.textContent = t.org;
      const [label, ask, required] = t.message;
      form.querySelector("[data-msg-label]")!.textContent = label;
      form.querySelector<HTMLElement>("[data-msg-optional]")!.hidden = !!required;
      msg.required = !!required; msg.placeholder = required ? ask : ""; msg.style.height = `${msgH + (t.project ? 0 : projectH)}px`;
      if ("seen" in msg.dataset) show(msg);
    };
    form.addEventListener("change", (e) => { if ((e.target as HTMLInputElement).name === "topic") topic(); });
    topic();

    // Mock: nothing is sent yet. The envelope seals and flies off, and the form gives way to a thank-you.
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const bad = fields().filter((f) => { f.dataset.seen = ""; return !show(f); });
      if (bad.length) { bad[0].focus(); return; }
      form.querySelector("[data-sent-to]")!.textContent = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      form.style.setProperty("--fh", `${form.offsetHeight}px`);
      form.classList.add("done"); sent.hidden = false;
      form.querySelector<HTMLElement>("[data-sent-h]")!.focus({ preventScroll: true });
    });
    form.querySelector("[data-again]")!.addEventListener("click", () => {
      form.reset(); unpick(); form.classList.remove("done"); sent.hidden = true;
      fields().forEach((f) => { delete f.dataset.seen; f.closest(".f")!.classList.remove("bad"); f.removeAttribute("aria-invalid"); if (f instanceof HTMLTextAreaElement) count(f); });
      topic(); form.querySelector<HTMLElement>("input[name=name]")!.focus();
    });
  }
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  copy?.addEventListener("click", async () => { await navigator.clipboard.writeText(copy.dataset.copy!); copy.classList.add("ok"); setTimeout(() => copy.classList.remove("ok"), 1800); });
</script>

<style>
  @keyframes c-up { from { opacity: 0; transform: translateY(18px); } }

  /* The form rises out of the hero onto the page. */
  .desk { position: relative; z-index: 1; margin-top: calc(clamp(130px, 11vw, 170px) * -1); animation: c-up .9s .14s var(--ease) both; }
  .form { position: relative; display: grid; gap: clamp(24px, 3vw, 36px); padding: clamp(20px, 3vw, 40px); border-radius: var(--r); background: #fff; box-shadow: 0 0 0 1px var(--line), 0 40px 80px -40px rgb(7 11 26 / .55); }
  .topics { display: grid; gap: 18px; min-width: 0; } .topics h2 { font-size: clamp(26px, 2.6vw, 34px); }
  /* Each topic is a tile with its own glass emblem. The chosen one fills with its colour and its emblem lifts and turns; the rest wait, a little quieter. */
  .tiles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .tile { position: relative; isolation: isolate; display: grid; grid-template-rows: auto auto 1fr; justify-items: center; align-content: start; gap: 4px; padding: 10px 12px 16px; border-radius: 20px; text-align: center; cursor: pointer; background: var(--soft); box-shadow: inset 0 0 0 1px transparent; transition: background-color .3s var(--ease), box-shadow .3s var(--ease); }
  .tile input { position: absolute; opacity: 0; pointer-events: none; }
  .tile:has(:focus-visible) { outline: 3px solid var(--brand-ink); outline-offset: 2px; }
  .em { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 1.25; margin-bottom: 2px; }
  .em::before { content: ""; position: absolute; z-index: -1; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 55%, transparent), transparent); opacity: 0; transform: scale(.6); transition: opacity .4s var(--ease), transform .5s var(--ease); }
  .em img { width: min(104px, 82%); height: auto; filter: saturate(.55) opacity(.8); transition: transform .55s cubic-bezier(.34, 1.56, .64, 1), filter .3s var(--ease); }
  .tile b { font-weight: 500; font-size: 15px; line-height: 1.25; text-wrap: balance; } .tile em { font-style: normal; font-size: 13px; line-height: 1.35; color: var(--t2); text-wrap: balance; }
  .tile:hover .em img { filter: none; transform: translateY(-3px) rotate(-3deg); }
  .tile:has(:checked) { background: color-mix(in srgb, var(--c) 14%, #fff); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c) 60%, #fff); }
  .tile:has(:checked) .em::before { opacity: 1; transform: none; }
  .tile:has(:checked) .em img { filter: none; transform: translateY(-6px) rotate(-8deg) scale(1.1); }
  .tile:has(:checked) b { color: color-mix(in srgb, var(--c) 30%, #171717); }

  .fields { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px clamp(20px, 3vw, 40px); align-items: start; } .col { display: grid; align-content: start; } .col > :not(.opt) + :not(.opt), .stack > :not(.opt) + :not(.opt) { margin-top: 14px; }
  .stack { display: grid; } .col > .send { margin-top: 20px; } .col > .duo { margin-top: 14px; }
  /* Country joins Institution in the same row, which makes room for it, so nothing below moves. */
  .duo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 14px; transition: grid-template-columns .45s var(--ease), column-gap .45s var(--ease); } .duo:has(> .off) { grid-template-columns: minmax(0, 1fr) minmax(0, 0fr); column-gap: 0; } .duo > .opt { grid-template-rows: auto; min-width: 0; } .duo > .opt > * { white-space: nowrap; }
  /* A field a topic doesn't need folds away; the space it leaves closes as one movement. */
  .opt { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .45s var(--ease), opacity .3s var(--ease); } .opt > * { min-height: 0; overflow: hidden; padding: 2px; margin: -2px; } .col > .opt:not(:first-child) > * > :first-child { margin-top: 14px; } .col > .opt:first-child > * > :last-child { margin-bottom: 14px; } .opt.off { grid-template-rows: 0fr; opacity: 0; }
  .f { display: grid; gap: 7px; font-size: 14px; font-weight: 500; min-width: 0; }
  .f input, .f textarea { width: 100%; font: 400 16px/1.45 var(--sans); color: var(--ink); padding: 12px 14px; border: 0; border-radius: 12px; background: var(--soft); box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s var(--ease), background-color .2s var(--ease), height .45s var(--ease); }
  .f input { height: 48px; } .f textarea { resize: vertical; min-height: 96px; } .f textarea::placeholder { color: var(--t3); }
  .f input:hover, .f textarea:hover { box-shadow: inset 0 0 0 1px var(--line2); }
  .f input:focus, .f textarea:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 1.5px var(--brand-deep), 0 0 0 4px color-mix(in srgb, var(--brand) 22%, transparent); }

  /* Each field's label row: its name on the left; on the right its character count, or what's wrong with it. */
  .lh { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; height: 20px; line-height: 20px; } .lh > :first-child { white-space: nowrap; } .opt-tag { font-weight: 400; color: var(--t3); font-size: 13px; margin-left: 4px; }
  .side { display: grid; justify-items: end; align-items: center; min-width: 0; font-size: 13px; font-weight: 400; line-height: 20px; } .side > * { grid-area: 1 / 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; transition: opacity .2s var(--ease); }
  .count { color: var(--t3); font-variant-numeric: tabular-nums; } .count.near { color: var(--brand-ink); } .err { color: #b91c1c; opacity: 0; } .f.bad .err { opacity: 1; } .f.bad .count { opacity: 0; }
