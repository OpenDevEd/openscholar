---
// The product pattern: a few words on white, two buttons, and a very large real screen.
import Arrow from "./Arrow.astro";
import Art from "./Art.astro";
import Device from "./Device.astro";
import { APP } from "../data/site.mjs";
---
<section class="bleed hero">
  <Art name="docs-ribbon" eager pos="100% 0" />
  <div class="inner in">
    <h1>The evidence workspace for research teams</h1>
    <p class="lead">Find the literature, screen it, extract the data and publish it, all in one place</p>
    <div class="acts"><a class="btn brand" href={APP}>Get started<Arrow /></a><a class="btn line" href="https://wealth-inequality.openscholar.ai">See a live community</a></div>
  </div>
  <div class="rise"><Device kind="laptop" name="search" theme="light" eager alt="OpenScholar's search results, with an overview of the field and a chart of papers per year" sizes="(max-width: 900px) 94vw, 1120px" /></div>
</section>
<style>
  .hero { background: #fff; color: var(--ink); padding-top: clamp(116px, 10vw, 148px); overflow: clip; } .hero > :global(.art) { z-index: -1; left: 58%; right: -8%; height: 66%; } @media (max-width: 900px) { .hero > :global(.art) { display: none; } }
  .in { display: grid; justify-items: start; gap: 18px; } h1 { max-width: 13em; font-size: clamp(42px, 5.4vw, 78px); line-height: 1.03; } .lead { color: var(--t2); } .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .rise { width: min(92%, 1120px); margin: clamp(32px, 3.6vw, 52px) auto 0; height: clamp(250px, 30vw, 460px); overflow: clip visible; -webkit-mask-image: linear-gradient(#000 80%, transparent); mask-image: linear-gradient(#000 80%, transparent); }
</style>
