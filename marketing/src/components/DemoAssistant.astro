---

---

  <section class="run" id="assistant" data-run>
    <img class="console" src="/img/scene-console-1672.avif" width="1672" height="941" loading="lazy" decoding="async" alt="An instrument console in the dark, with one dial lit" />
    <svg class="dial" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><ellipse class="dial-p" data-dial cx="1348" cy="376" rx="186" ry="108" pathLength="1" /></svg>
    <div class="intro">
      <h2>Hand over the legwork. Keep the judgement.</h2>
      <p class="lead">The results land right where you'd have put them, and nothing big happens until you say so.</p>
    </div>
    <div class="desk">
      <div class="chat">
        <div class="log" data-log aria-live="polite"></div>
        <form data-send><div class="prompt">Find three randomised trials of peer tutoring in primary school reading, screen them, and extract the sample size.</div><button class="btn primary" data-go>Send</button></form>
      </div>
      <div class="acct">
        <section class="pane" data-pane="col"><header><b>Your collection</b><span class="mono" data-col-n>Empty</span></header><ul data-col></ul></section>
        <section class="pane" data-pane="scr"><header><b>Screening</b><span class="mono" data-scr-s>Not started</span></header><div class="ring"><svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><circle cx="32" cy="32" r="28" /><circle class="p" data-scr-p cx="32" cy="32" r="28" pathLength="1" /></svg><dl><div><dt>Yes</dt><dd data-y>0</dd></div><div><dt>Unclear</dt><dd data-u>0</dd></div><div><dt>No</dt><dd data-n>0</dd></div></dl></div></section>
        <section class="pane" data-pane="ext"><header><b>Extraction</b><span class="mono" data-ext-s>Not started</span></header><div class="ex" data-ext></div></section>
      </div>
    </div>
  </section>
  
<script>
  const root = document.querySelector("[data-run]"), log = root.querySelector("[data-log]"), send = root.querySelector("[data-send]"), go = root.querySelector("[data-go]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches, wait = (ms) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));
  const papers = ["Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia", "A Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia", "How to Analyze Interpersonal and Individual Effects in Peer-Tutored Reading Intervention"];
  const $ = (s) => root.querySelector(s), add = (cls, html) => { const d = document.createElement("div"); d.className = cls; d.innerHTML = html; log.append(d); log.scrollTop = log.scrollHeight; return d; };
  const CHECK = '<svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10.5 8 14.5 16 5.5"/></svg>';
  const STEPS = 8; let done = 0; const fill = () => { done++; root.querySelector("[data-dial]").style.strokeDashoffset = 1 - Math.min(1, done / STEPS); };
  const step = async (doing, did) => { fill(); const s = add("step busy", `<i></i>${doing}`); await wait(900); s.className = "step"; s.innerHTML = `${CHECK}${did}`; };
  const ask = (title, rows) => new Promise((res) => { const a = add("ask", `<b>${title}</b><dl>${rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("")}</dl><div class="row"><button class="btn primary" data-yes>Allow once</button><button class="btn quiet" data-no>Don't do this</button></div>`); a.querySelector("[data-yes]").focus({ preventScroll: true }); a.addEventListener("click", (e) => { const y = e.target.closest("[data-yes]"), n = e.target.closest("[data-no]"); if (!y && !n) return; a.querySelector(".row").innerHTML = `<span class="mono">${y ? "Allowed" : "Not allowed"}</span>`; res(!!y); }); });
  const num = (el, v) => { el.textContent = v; };
  function reset() { done = 0; $('[data-pane="col"] b').textContent = "Your collection"; root.querySelector("[data-dial]").style.strokeDashoffset = 1; log.innerHTML = ""; $("[data-col]").innerHTML = ""; num($("[data-col-n]"), "Empty"); num($("[data-scr-s]"), "Not started"); $("[data-scr-p]").style.strokeDashoffset = 1; ["[data-y]", "[data-u]", "[data-n]"].forEach((s) => num($(s), 0)); num($("[data-ext-s]"), "Not started"); $("[data-ext]").innerHTML = ""; root.querySelectorAll(".pane").forEach((p) => p.removeAttribute("data-live")); }
  const finish = () => { send.hidden = false; go.textContent = "Run again"; log.scrollTop = log.scrollHeight; };
  async function play() {
    reset(); send.hidden = true; root.querySelector("[data-go]").textContent = "Send"; add("me", "Find three randomised trials of peer tutoring in primary school reading, screen them, and extract the sample size.");
    await step("Looking papers up", "Looked papers up"); await step("Reading 2 papers", "Read 2 papers");
    $('[data-pane="col"]').setAttribute("data-live", ""); $('[data-pane="col"] b').textContent = "Peer tutoring trials"; await step("Making a collection", "Made a collection: Peer tutoring trials");
    for (let i = 0; i < 3; i++) { await wait(320); const li = document.createElement("li"); li.textContent = papers[i]; $("[data-col]").append(li); num($("[data-col-n]"), `${i + 1} paper${i ? "s" : ""}`); }
    add("step", `${CHECK}Saved 3 papers`);
    const yes1 = await ask("Start a screening", [["Papers", "3 in Peer tutoring trials"], ["Question", "Is this a randomized trial?"]]);
    if (!yes1) { add("reply", "OK, I won't run it. Peer tutoring trials stays as it is, with its 3 papers."); finish(); return; }
    $('[data-pane="scr"]').setAttribute("data-live", ""); num($("[data-scr-s]"), "Running");
    const answers = [["[data-y]", 1], ["[data-u]", 1], ["[data-u]", 2]];
    fill(); for (let i = 0; i < 3; i++) { await wait(620); $("[data-scr-p]").style.strokeDashoffset = 1 - (i + 1) / 3; num($(answers[i][0]), answers[i][1]); }
    num($("[data-scr-s]"), "Done"); add("step", `${CHECK}Screened 3 papers`);
    const yes2 = await ask("Start an extraction", [["Papers", "3 in Peer tutoring trials"], ["Question", "What is the sample size?"], ["Reads", "Abstracts"]]);
    if (!yes2) { add("reply", "OK, I'll stop there. The screening found 1 yes and 2 unclear, so read those two before you trust them."); finish(); return; }
    fill(); fill(); $('[data-pane="ext"]').setAttribute("data-live", ""); num($("[data-ext-s]"), "Running");
    const rows = [["Colombia trial, 2023", "298"], ["Müller et al., 2015", "68"]];
    for (const [t, v] of rows) { await wait(760); const d = document.createElement("div"); d.className = "ex-row"; d.innerHTML = `<span>${t}</span><b>${v}</b>`; $("[data-ext]").append(d); }
    await wait(420); const d = document.createElement("div"); d.className = "ex-row miss"; d.innerHTML = `<span>Colombia trial, 2021</span><b>None</b><span class="mono">No abstract</span>`; $("[data-ext]").append(d);
    fill(); fill(); num($("[data-ext-s]"), "Done"); add("step", `${CHECK}Read the results`); await wait(500);
    add("reply", "The Colombia Paired Reading trial reports 298 pupils. Müller et al. report 68 dyads, so roughly double that in students. The 2021 Colombia record has no abstract, so it has no answer. Two of the three screened as unclear, so check those before you rely on them.");
    finish();
  }
  send.addEventListener("submit", (e) => { e.preventDefault(); play(); });
  // It starts by itself when it comes into view, and stops at the first Allow for the visitor to press.
  new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); if (!send.hidden) play(); } }, { threshold: 0.45 }).observe(root.querySelector(".desk"));
</script>
<style is:global>
  [data-log] .me { justify-self: end; max-width: 86%; background: var(--s3); padding: 10px 14px; border-radius: 14px; font-size: 14px; line-height: 20px; }
  [data-log] .step { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--t2); } [data-log] .step svg { color: var(--good); flex: none; }
  [data-log] .step.busy i { width: 12px; height: 12px; border: 1.5px solid var(--t3); border-top-color: var(--t1); border-radius: 50%; animation: turn .8s linear infinite; flex: none; }
  @keyframes turn { to { transform: rotate(1turn); } }
  [data-log] .ask { border: 1px solid var(--ink); border-radius: 14px; padding: 14px; background: #0c1730; animation: askIn .3s var(--ease) both; font-size: 14px; }
  @keyframes askIn { from { opacity: 0; transform: translateY(6px); } }
  [data-log] .ask b { font-weight: 500; font-size: 15px; } [data-log] .ask dl { margin-block: 8px 12px; display: grid; gap: 2px; } [data-log] .ask dl div { display: grid; grid-template-columns: 72px 1fr; } [data-log] .ask dt { color: var(--t3); }
  [data-log] .row { display: flex; flex-wrap: wrap; gap: 8px; } [data-log] .row .btn { height: 38px; padding-inline: 14px; font-size: 14px; border-radius: 10px; }
  [data-log] .reply { font-size: 15px; line-height: 22px; font-weight: 300; }
  [data-col] li { padding-block: 8px; border-top: 1px solid var(--line); font-size: 14px; animation: askIn .3s var(--ease) both; }
  .ex-row { display: grid; grid-template-columns: minmax(0, 1fr) 72px; gap: 12px; align-items: center; padding-block: 8px; border-top: 1px solid var(--line); font-size: 14px; animation: askIn .3s var(--ease) both; } .ex-row b { font-weight: 300; font-size: 24px; } .ex-row.miss b { font-size: 14px; font-weight: 400; color: var(--t3); }
</style>
<style>
  .run { position: relative; isolation: isolate; min-height: 100svh; padding: 104px var(--edge) 48px; overflow: hidden; background: #000; }
  .console, .dial { position: absolute; left: 0; right: 0; bottom: 0; z-index: -1; width: 100%; height: 100svh; }
  .console { object-fit: cover; object-position: 50% 100%; }
  .dial-p { fill: none; stroke: #ffc48a; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; transition: stroke-dashoffset .6s var(--ease); }
  .intro { max-width: 880px; margin-bottom: 32px; } .intro .lead { margin-top: 16px; max-width: 36rem; } .intro h2 { font-size: clamp(38px, 4.8vw, 80px); line-height: .98; text-shadow: 0 2px 40px #000; }
  .desk { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; }
  .chat { height: min(520px, 58svh); display: flex; flex-direction: column; background: rgb(12 13 16 / .94); box-shadow: 0 0 0 1px var(--line2), 0 30px 100px -20px #000; border-radius: 22px; overflow: hidden; }
  .log { flex: 1; min-height: 0; overflow-y: auto; padding: 20px; display: grid; align-content: start; gap: 12px; }
  form { display: flex; align-items: center; gap: 12px; padding: 12px; border-top: 1px solid var(--line); } form[hidden] { display: none; }
  .prompt { flex: 1; font-size: 14px; line-height: 19px; color: var(--t2); }
  .acct { display: grid; align-content: end; gap: 10px; } .acct ul:empty, .acct .ex:empty { display: none; }
  .pane { padding: 14px 18px; border-radius: 18px; background: #0c0d10; box-shadow: 0 0 0 1px var(--line); opacity: .32; transition: opacity .5s var(--ease); } .pane[data-live] { opacity: 1; }
  header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; } header b { font-weight: 500; font-size: 18px; }
  .ring { display: flex; align-items: center; gap: 24px; } .ring svg { width: 44px; height: 44px; }
  svg circle { fill: none; stroke: var(--s3); stroke-width: 5; } svg .p { stroke: #ffc48a; stroke-dasharray: 1; stroke-dashoffset: 1; transform: rotate(-90deg); transform-origin: center; transition: stroke-dashoffset .5s var(--ease); }
  .ring dl { display: flex; gap: 24px; } .ring dt { font-size: 13px; color: var(--t2); } .ring dd { font-weight: 500; font-size: 22px; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { .desk { grid-template-columns: minmax(0, 1fr); gap: 16px; } .chat { height: 520px; } .dial { display: none; } .console { opacity: .5; } }
</style>
