---

---
<section class="b agent" id="assistant" data-run>
  
  <h2>Hand over the legwork. <span class="hl wipe" style="--c:#FF9C1A">Keep the judgement</span></h2>
  <div class="desk">
    <div class="chat">
      <div class="meter" aria-hidden="true"><i></i></div>
      <div class="log" data-log aria-live="polite"></div>
      <form data-send><div class="prompt">Find three randomised trials of peer tutoring in primary school reading, screen them, and extract the sample size.</div><button class="key small sun" data-go>Send</button></form>
    </div>
    <div class="acct">
      <section class="pane f1" data-pane="col"><header><b>Your collection</b><span data-col-n>Empty</span></header><ul data-col></ul></section>
      <section class="pane f2" data-pane="scr"><header><b>Screening</b><span data-scr-s>Not started</span></header><div class="ring"><svg viewBox="0 0 64 64" width="44" height="44" aria-hidden="true"><circle cx="32" cy="32" r="28" /><circle class="p" data-scr-p cx="32" cy="32" r="28" pathLength="1" /></svg><dl><div><dt>Yes</dt><dd data-y>0</dd></div><div><dt>Unclear</dt><dd data-u>0</dd></div><div><dt>No</dt><dd data-n>0</dd></div></dl></div></section>
      <section class="pane f3" data-pane="ext"><header><b>Extraction</b><span data-ext-s>Not started</span></header><div class="ex" data-ext></div></section>
    </div>
  </div>
</section>
<script>
  const root = document.querySelector("[data-run]"), log = root.querySelector("[data-log]"), send = root.querySelector("[data-send]"), go = root.querySelector("[data-go]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches, wait = (ms) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));
  const papers = ["Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia, 2023", "A Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia, 2021", "How to Analyze Interpersonal and Individual Effects in Peer-Tutored Reading Intervention"];
  const $ = (s) => root.querySelector(s), add = (cls, html) => { const d = document.createElement("div"); d.className = cls; d.innerHTML = html; log.append(d); log.scrollTop = log.scrollHeight; return d; };
  const CHECK = '<svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10.5 8 14.5 16 5.5"/></svg>';
  const STEPS = 8; let done = 0; const fill = () => { done++; root.style.setProperty("--done", Math.min(1, done / STEPS)); };
  const step = async (doing, did) => { fill(); const s = add("step busy", `<i></i>${doing}`); await wait(900); s.className = "step"; s.innerHTML = `${CHECK}${did}`; };
  const ask = (title, rows) => new Promise((res) => { const a = add("ask", `<b>${title}</b><dl>${rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("")}</dl><div class="row"><button class="stamp" data-yes><span>Allow</span></button><button class="nope" data-no>Don't do this</button></div>`); if (root.contains(document.activeElement)) a.querySelector("[data-yes]").focus({ preventScroll: true }); a.addEventListener("click", (e) => { const y = e.target.closest("[data-yes]"), n = e.target.closest("[data-no]"); if (!y && !n) return; a.querySelector(".row").innerHTML = `<span class="${y ? "stamped" : "nah"}">${y ? "Allowed" : "Not allowed"}</span>`; res(!!y); }); });
  const num = (el, v) => { el.textContent = v; };
  function reset() { done = 0; $('[data-pane="col"] b').textContent = "Your collection"; root.style.setProperty("--done", 0); log.innerHTML = ""; $("[data-col]").innerHTML = ""; num($("[data-col-n]"), "Empty"); num($("[data-scr-s]"), "Not started"); $("[data-scr-p]").style.strokeDashoffset = 1; ["[data-y]", "[data-u]", "[data-n]"].forEach((s) => num($(s), 0)); num($("[data-ext-s]"), "Not started"); $("[data-ext]").innerHTML = ""; root.querySelectorAll(".pane").forEach((p) => p.removeAttribute("data-live")); }
  const finish = () => { send.hidden = false; go.textContent = "Run again"; log.scrollTop = log.scrollHeight; };
  async function play() {
    reset(); send.hidden = true; root.querySelector("[data-go]").textContent = "Send"; add("me", "Find three randomised trials of peer tutoring in primary school reading, screen them, and extract the sample size.");
    await step("Looking papers up", "Looked papers up"); await step("Reading 3 papers", "Read 3 papers");
    $('[data-pane="col"]').setAttribute("data-live", ""); $('[data-pane="col"] b').textContent = "Peer tutoring trials"; await step("Making a collection", "Made a collection: Peer tutoring trials");
    for (let i = 0; i < 3; i++) { await wait(320); const li = document.createElement("li"); li.textContent = papers[i]; $("[data-col]").append(li); num($("[data-col-n]"), `${i + 1} paper${i ? "s" : ""}`); }
    add("step", `${CHECK}Saved 3 papers`);
    const yes1 = await ask("Start a screening", [["Papers", "3 in Peer tutoring trials"], ["Question", "Is this a randomised trial?"]]);
    if (!yes1) { add("reply", "OK, I won't run it. Peer tutoring trials stays as it is, with its 3 papers."); finish(); return; }
    $('[data-pane="scr"]').setAttribute("data-live", ""); num($("[data-scr-s]"), "Running");
    const answers = [["[data-y]", 1], ["[data-u]", 1], ["[data-u]", 2]];
    fill(); for (let i = 0; i < 3; i++) { await wait(620); $("[data-scr-p]").style.strokeDashoffset = 1 - (i + 1) / 3; num($(answers[i][0]), answers[i][1]); }
    num($("[data-scr-s]"), "Done"); add("step", `${CHECK}Screened 3 papers`);
    const yes2 = await ask("Start an extraction", [["Papers", "3 in Peer tutoring trials"], ["Question", "What is the sample size?"], ["Reads", "Abstracts"]]);
    if (!yes2) { add("reply", "OK, I'll stop there. The screening found 1 yes and 2 unclear, so read those two before you trust them."); finish(); return; }
    fill(); fill(); $('[data-pane="ext"]').setAttribute("data-live", ""); num($("[data-ext-s]"), "Running");
    const rows = [["Colombia trial, 2023", "298"], ["Müller et al., 2015", "68"]];
    for (const [t, v] of rows) { await wait(760); const d = document.createElement("div"); d.className = "ex-row"; d.innerHTML = `<span>${t}</span><b>${v}</b>`; $("[data-ext]").append(d); }
    await wait(420); const d = document.createElement("div"); d.className = "ex-row miss"; d.innerHTML = `<span>Colombia trial, 2021, no abstract</span><b>None</b>`; $("[data-ext]").append(d);
    fill(); fill(); num($("[data-ext-s]"), "Done"); add("step", `${CHECK}Read the results`); await wait(500);
    add("reply", "The Colombia Paired Reading trial reports 298 pupils. Müller et al. report 68 dyads, so roughly double that in students. The 2021 Colombia record has no abstract, so it has no answer. Two of the three screened as unclear, so check those before you rely on them.");
    finish();
  }
  send.addEventListener("submit", (e) => { e.preventDefault(); play(); });
  // It starts by itself when it comes into view, and stops at the first Allow for the visitor to press.
  new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); if (!send.hidden) play(); } }, { threshold: 0.45 }).observe(root.querySelector(".desk"));
</script><style is:global>
  [data-log] .me { justify-self: end; max-width: 88%; background: var(--paper); padding: 10px 14px; border-radius: 14px 14px 4px 14px; font-size: 15px; line-height: 1.3; font-weight: 500; }
  [data-log] .step { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--t2); } [data-log] .step svg { color: #0b8a57; flex: none; }
  [data-log] .step.busy i { width: 12px; height: 12px; border: 2px solid var(--line); border-top-color: var(--ink); border-radius: 50%; animation: turn .8s linear infinite; flex: none; } @keyframes turn { to { rotate: 1turn; } }
  [data-log] .ask { position: relative; padding: 14px; border-radius: 16px; background: var(--mark-1); animation: askIn .3s var(--ease) both; font-size: 14px; } @keyframes askIn { from { opacity: 0; transform: translateY(6px); } }
  [data-log] .ask > b { font-weight: 700; font-size: 16px; letter-spacing: -.02em; } [data-log] .ask dl { margin-block: 6px 12px; display: grid; gap: 2px; } [data-log] .ask dl div { display: grid; grid-template-columns: 72px 1fr; } [data-log] .ask dt { color: var(--t2); }
  [data-log] .row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  [data-log] .stamp { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: #d42c1a; color: #fff; font-weight: 700; font-size: 16px; letter-spacing: -.01em; box-shadow: 0 5px 0 #8f1d10; outline: 2px dashed rgb(255 255 255 / .85); outline-offset: -9px; rotate: -7deg; transition: rotate .2s var(--ease), translate .1s var(--ease), box-shadow .1s var(--ease); cursor: pointer; } [data-log] .stamp:hover { rotate: 0deg; } [data-log] .stamp:active { translate: 0 5px; box-shadow: 0 0 0 #8f1d10; }
  [data-log] .nope { font-weight: 500; background: linear-gradient(var(--ink), var(--ink)) no-repeat 0 100% / 100% 2px; }
  [data-log] .stamped { display: inline-block; padding: 3px 10px; border: 3px solid #d0301d; border-radius: 8px; color: #d0301d; font-weight: 700; font-size: 18px; letter-spacing: -.01em; rotate: -5deg; animation: thump .28s var(--ease) both; } @keyframes thump { from { opacity: 0; scale: 1.7; } } [data-log] .nah { font-weight: 500; color: var(--t2); }
  [data-log] .reply { font-size: 16px; line-height: 1.4; }
  [data-col] li { padding-block: 6px; font-size: 14px; line-height: 1.25; animation: askIn .3s var(--ease) both; border-top: 1px solid var(--line); }
  .ex-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; padding-block: 6px; border-top: 1px solid var(--line); font-size: 14px; animation: askIn .3s var(--ease) both; } .ex-row b { font-weight: 700; font-size: 20px; letter-spacing: -.02em; } .ex-row.miss b { font-size: 14px; font-weight: 500; color: var(--t2); }
</style>
<style>
  .agent { background: var(--ink); color: #fff; } :global(.agent) :global(.s1) { position: absolute; right: 24px; top: 20px; rotate: 12deg; } h2 { max-width: 12em; margin-bottom: 28px; padding-right: 110px; }
  .desk { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 12px; }
  .chat { height: 560px; display: flex; flex-direction: column; background: #fff; color: var(--ink); border-radius: 22px; overflow: hidden; }
  .meter { height: 8px; background: var(--paper); } .meter i { display: block; height: 100%; background: linear-gradient(90deg, var(--coral), var(--tang), var(--sun), var(--mint)); transform: scaleX(var(--done, 0)); transform-origin: left; transition: transform .6s var(--ease); }
  .log { flex: 1; min-height: 0; overflow-y: auto; padding: 18px; display: grid; align-content: start; gap: 12px; }
  form { display: flex; align-items: center; gap: 12px; padding: 10px 12px 15px; border-top: 1px solid var(--line); } form[hidden] { display: none; } .prompt { flex: 1; font-size: 14px; line-height: 1.25; color: var(--t2); }
  .acct { display: grid; grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr); gap: 2px; }
  .pane { position: relative; padding: 14px 18px; border-radius: 4px 18px 18px 18px; margin-top: 22px; color: var(--ink); min-height: 0; } .pane::before { content: ""; position: absolute; left: 0; top: -20px; width: 120px; height: 21px; background: inherit; border-radius: 10px 14px 0 0; }
  .pane:not([data-live]) header span { opacity: .8; }
  .f1 { background: var(--sun); } .f2 { background: var(--mint); } .f3 { background: var(--pink); }
  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; } header b { font-weight: 700; font-size: 19px; letter-spacing: -.025em; } header span { font-size: 14px; font-weight: 500; }
  ul[data-col] { min-height: 28px; } .ring { display: flex; align-items: center; gap: 20px; }
  svg circle { fill: none; stroke: rgb(11 16 32 / .18); stroke-width: 7; } svg .p { stroke: var(--ink); stroke-dasharray: 1; stroke-dashoffset: 1; transform: rotate(-90deg); transform-origin: center; transition: stroke-dashoffset .5s var(--ease); }
  .ring dl { display: flex; gap: 22px; } .ring dt { font-size: 13px; font-weight: 500; } .ring dd { font-weight: 700; font-size: 22px; font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) { .desk { grid-template-columns: minmax(0, 1fr); } .chat { height: 560px; } :global(.agent) :global(.s1) { width: 80px; height: 80px; right: 12px; top: 8px; } h2 { padding-right: 76px; } }
</style>
