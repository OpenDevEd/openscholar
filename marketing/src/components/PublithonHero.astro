<style>
  /* Fixed heights that step down with the width, never scaled with the window. */
  .phero { background: var(--night); min-height: 800px; padding-block: 176px 200px; display: grid; align-content: start; }
  .ph-view { position: absolute; inset: 0; z-index: -2; overflow: clip; }
  .ph-sky, .ph-air { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease); } .phero.live .ph-sky, .phero.live .ph-air { opacity: 1; }
  /* The still, for when the scene can't run: the same idea as one picture. */
  .ph-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 100%; opacity: 0; transition: opacity 1.4s var(--ease); -webkit-mask-image: linear-gradient(transparent, #000 12%); mask-image: linear-gradient(transparent, #000 12%); } .phero.resting .ph-still, .ph-still.on { opacity: 1; }
  /* The words keep a calm night behind them, and the scene sinks into the night the next section stands on. */
  .phero::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, rgb(7 11 26 / .5), rgb(7 11 26 / .22) 34%, transparent 56%); }
  .ph-copy { position: relative; display: grid; gap: 22px; justify-items: start; }
  .ph-copy h1 { font-size: 128px; line-height: .94; letter-spacing: -.045em; max-width: 7em; text-shadow: 0 2px 40px rgb(7 11 26 / .6); }
  .ph-copy .lead { max-width: 29em; color: rgb(255 255 255 / .88); text-shadow: 0 1px 18px rgb(7 11 26 / .9); }
  /* All the hero's text arrives one way: each block rises out of a blur, the headline's two lines first, then the
