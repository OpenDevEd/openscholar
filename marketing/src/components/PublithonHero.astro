              // Its thread runs back down toward where it lifted off.
              pen.globalAlpha = Math.min(1, light * (far ? .32 : .5) * (1 - k * .45));
              pen.setTransform(scale, 0, 0, scale, x * scale, y * scale); pen.rotate(-Math.atan2(-across, climbed)); pen.drawImage(thread, far ? -.35 : -.6, 0, far ? .7 : 1.2, climbed * (far ? 1 : .8));
            }
            pen.setTransform(scale, 0, 0, scale, x * scale, y * scale); pen.rotate(page.turn + age * page.rate);
            if (kind === NEAR) { pen.globalAlpha = Math.min(1, light * .3); if (soft) pen.drawImage(soft, (page.cell % 3) * SOFT, Math.floor(page.cell / 3) * SOFT, SOFT, SOFT, -side / 2, -side / 2, side, side); continue; }
            // Too far to have a shape, it is a point of light; nearer, the page itself.
            if (side < 6.5) { pen.globalAlpha = Math.min(1, light); pen.drawImage(spark, -side * 1.3, -side * 1.3, side * 2.6, side * 2.6); continue; }
            pen.globalAlpha = Math.min(1, light * (far ? .9 : 1.1)); pen.drawImage(sharp, sx, sy, CELL, CELL, -side / 2, -side / 2, side, side);
            // In strong light the glass burns brighter than one pass can show.
            if (!far && light > .7) { pen.globalAlpha = Math.min(.55, (light - .7) * 1.1); pen.drawImage(sharp, sx, sy, CELL, CELL, -side / 2, -side / 2, side, side); }
          }
          pen.setTransform(1, 0, 0, 1, 0, 0); pen.globalAlpha = 1; pen.globalCompositeOperation = "source-over";
        };

        // The pointer leans the camera; scrolling sinks the planet a little and the stars with it.
        let px = 0, py = 0, tx = 0, ty = 0, sink = 0, sway = 0;
        if (matchMedia("(hover: hover)").matches) {
          root.addEventListener("pointermove", (e) => { const box = root.getBoundingClientRect(); tx = (e.clientX - box.left) / box.width - .5; ty = (e.clientY - box.top) / box.height - .5; });
          root.addEventListener("pointerleave", () => { tx = ty = 0; });
        }

        let began = 0, last = 0, spin = START, frame = 0, seen = true, lost = false, ready = false, slow = 0, tally = 0, total = 0;
        const draw = (now: number) => {
          frame = 0; if (lost || !ready) return;
          if (!began) { began = now; last = now; people(now); }
          const step = Math.min(64, now - last); last = now;
          // A device that can't keep up gets a coarser sky, then fewer pages, then the still.
          if (step < 250 && now - began > 1200) { tally++; total += step; if (tally === 50) { if (total / tally > 26) { slow++; if (slow === 1 && scale > 1) { scale = Math.max(1, scale - .5); size(); } else if (slow <= 2) { counts = counts.map((count) => Math.ceil(count * .6)); people(now - 4000); } else { lost = true; rest(); return; } } tally = total = 0; } }
          const seconds = (now - began) / 1000, up = Math.min(1, Math.max(0, (seconds - .25) / 3.4)), risen = up * up * (3 - 2 * up), dawn = risen * (.94 + .06 * Math.sin(seconds * .45));
          // The camera drifts a little by itself and leans to the pointer; the planet comes up 44 px as the sun does, and sinks as the page scrolls.
          sway = Math.sin(seconds * .17) * .05; spin += step * .001 * TURN; px += (tx + sway - px) * .06; py += (ty - py) * .06; sink = Math.max(0, Math.min(H, scrollY)) * .22 + 44 * (1 - risen);
          gl.uniform2f(U.c, (cx - px * 12) * scale, sky.height - (cy + sink - py * 7) * scale); gl.uniform1f(U.r, R * scale); gl.uniform1f(U.d, scale); gl.uniform1f(U.t, seconds); gl.uniform1f(U.spin, spin);
          gl.uniform1f(U.dawn, dawn); gl.uniform1f(U.a0, Math.asin((sunX - cx) / R)); gl.uniform1f(U.fd, (narrow ? 60 : 96) * scale); gl.uniform1f(U.drift, sink * .5);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          fly(now);
          if (!root.classList.contains("live")) root.classList.add("live");
          if (seen && !document.hidden) frame = requestAnimationFrame(draw);
        };
        const run = () => { if (!frame && seen && !document.hidden && !lost) { last = performance.now(); frame = requestAnimationFrame(draw); } };

        scale = Math.min(devicePixelRatio || 1, view.clientWidth * view.clientHeight > 1.4e6 ? 1.5 : 2); size();
        Promise.all([picture("/img/earth-night-band-4096.avif"), picture("/img/earth-clouds.avif")]).then(([night, clouds]) => {
          if (gl.isContextLost()) return rest();
          upload(0, night); upload(1, clouds); ready = true; run();
          // The sharper night map follows where there are the pixels and the texture size for it.
          if (W >= 1000 && gl.getParameter(gl.MAX_TEXTURE_SIZE) >= 8192) picture("/img/earth-night-band.avif").then((image) => { if (!gl.isContextLost()) upload(0, image); }, () => {});
        }, rest);
