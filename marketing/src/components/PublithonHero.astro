  .wd { display: inline-block; white-space: nowrap; }
  .wd, .ph-copy > :not(h1) { animation: ph-rise .9s cubic-bezier(.2, .9, .3, 1) calc(.1s + var(--i, 0) * .12s) both; } .ph-copy > .lead { --i: 2.2; } .ph-copy > .acts { --i: 3.2; }
  @keyframes ph-rise { from { opacity: 0; transform: translateY(24px); filter: blur(10px); } }
  /* The headline takes the scene's light, as the planet does: a cool white while it is in the planet's shade, and once
