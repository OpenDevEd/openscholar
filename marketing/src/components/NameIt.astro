---
// Type a field and a real community home page takes its name, its address and its colour. The page behind is a real community with its own words removed.
import Device from "./Device.astro";
import Art from "./Art.astro";
import Arrow from "./Arrow.astro";
import { APP } from "../data/site.mjs";
const first = "Early childhood education";
const colours = [["Blue", "#2563eb"], ["Teal", "#0f766e"], ["Forest", "#15803d"], ["Amber", "#b45309"], ["Crimson", "#be123c"]];
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 34).replace(/^-|-$/g, "");
---
<section class="panel nameit" id="yours" data-name style={`--acc:${colours[0][1]}`}>
  <Art name="close-rose" pos="50% 100%" />
  <div class="n-left">
    <h2>Put your field's name on it</h2>
    <p class="lead">Your name, your address and your colours, on a community built around your evidence.</p>
    <label class="f"><span>Your field</span><input data-field type="text" maxlength="60" value={first} autocomplete="off" spellcheck="false" /></label>
    <p class="addr" aria-live="polite"><span>Public address</span><code data-addr>{slug(first)}.openscholar.ai</code></p>
    <div class="f"><span id="n-col">Colour</span><div class="sw" role="group" aria-labelledby="n-col">{colours.map(([n, c], i) => <button type="button" aria-label={n} aria-pressed={i === 0 ? "true" : "false"} data-c={c} style={`--c:${c}`}></button>)}</div></div>
    <a class="btn" href={`${APP}/evidence-libraries`}>Create your community<Arrow /></a>
  </div>
  <div class="n-dev" aria-hidden="true">
    <Device kind="laptop" name="c-blank" theme="light" sizes="(max-width: 900px) 94vw, 780px">
      <div class="site"><div class="in">
        <b class="navname" data-out>{first}</b><span class="signin">Sign in</span>
        <div class="hero-s"><h3 data-out>{first}</h3><p class="sub">Research on <span data-low>{first.toLowerCase()}</span>, updated every night.</p><p class="body">We gather the research on <strong data-low>{first.toLowerCase()}</strong>. Search it, read it and cite it. Where the licence allows, the full text is here too.</p><div class="row"><span class="b1">Explore the community</span><span class="b2">Get the digest</span></div></div>
      </div></div>
    </Device>
  </div>
</section>
<script>
  const root = document.querySelector("[data-name]");
  if (root) {
    const input = root.querySelector("[data-field]"), addr = root.querySelector("[data-addr]"), outs = root.querySelectorAll("[data-out]"), lows = root.querySelectorAll("[data-low]"), marks = [...root.querySelectorAll("[data-c]")];
    const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 34).replace(/^-|-$/g, "") || "your-field";
    const show = () => { const v = input.value.trim() || "Your field"; outs.forEach((o) => { o.textContent = v; }); lows.forEach((o) => { o.textContent = v.toLowerCase(); }); addr.textContent = `${slug(v)}.openscholar.ai`; };
    input.addEventListener("input", show);
    marks.forEach((m) => m.addEventListener("click", () => { root.style.setProperty("--acc", m.dataset.c); marks.forEach((x) => x.setAttribute("aria-pressed", String(x === m))); }));
  }
</script>
<style>
  @font-face { font-family: Montserrat; font-weight: 500 700; font-display: swap; src: url(/fonts/montserrat-latin.woff2) format("woff2"); }
  .nameit { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(24px, 3.4vw, 48px); align-items: center; padding: var(--pad); background: #2e020d; } .nameit > :global(.art) { z-index: -1; opacity: .5; -webkit-mask-image: linear-gradient(transparent 40%, #000); mask-image: linear-gradient(transparent 40%, #000); }
  .n-left { display: grid; gap: 16px; justify-items: start; } .f { display: grid; gap: 7px; width: 100%; } .f > span, .addr span { font-size: 14px; opacity: .8; } .f input { width: 100%; height: 50px; padding-inline: 14px; border: 0; border-radius: 12px; background: #fff; color: var(--ink); font-size: 17px; outline: 0; box-shadow: 0 16px 32px -18px #000; } .f input:focus { box-shadow: 0 0 0 3px #fda4af, 0 16px 32px -18px #000; }
  .addr { display: grid; gap: 4px; width: 100%; } code { font: 400 15px/1.3 var(--mono); overflow-wrap: anywhere; color: #fecdd3; }
  .sw { display: flex; gap: 8px; } .sw button { width: 38px; height: 38px; border-radius: 11px; background: var(--c); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .28); transition: transform .2s var(--ease), box-shadow .2s var(--ease); } .sw button:hover { transform: translateY(-2px); } .sw [aria-pressed="true"] { box-shadow: 0 0 0 2px #2e020d, 0 0 0 4px #fff; }
  .nameit :global(.btn) { --chip: #be123c; margin-top: 4px; }
  /* The page's own measurements, in 1440ths of its width, so the words sit exactly where the real site puts them. */
  .site { position: absolute; inset: 0; z-index: 1; container-type: inline-size; color: #0f0f0f; text-align: left; } .in { --p: calc(100cqw / 1440); position: absolute; inset: 0; font-family: var(--sans); }
  .navname { position: absolute; left: calc(var(--p) * 283); top: calc(var(--p) * 52); max-width: calc(var(--p) * 430); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 500; font-size: calc(var(--p) * 24); line-height: calc(var(--p) * 30); letter-spacing: -.025em; color: #000; }
  .signin { position: absolute; left: calc(var(--p) * 1108); top: calc(var(--p) * 48); display: grid; place-items: center; width: calc(var(--p) * 86); height: calc(var(--p) * 30); border-radius: calc(var(--p) * 8); background: var(--acc); color: #fff; font-weight: 500; font-size: calc(var(--p) * 16); transition: background-color .25s var(--ease); }
  .hero-s { position: absolute; left: calc(var(--p) * 56); top: calc(var(--p) * 200); width: calc(var(--p) * 760); display: grid; gap: calc(var(--p) * 20); justify-items: start; }
  h3 { max-width: calc(var(--p) * 720); font: 700 calc(var(--p) * 60)/1 Montserrat, var(--sans); letter-spacing: -.03em; overflow-wrap: anywhere; } .sub { width: calc(var(--p) * 500); font: 500 calc(var(--p) * 24)/calc(var(--p) * 32) Montserrat, var(--sans); letter-spacing: -.025em; color: rgb(15 15 15 / .72); } .body { width: calc(var(--p) * 544); margin-top: calc(var(--p) * 8); font-size: calc(var(--p) * 17); line-height: calc(var(--p) * 28); color: rgb(15 15 15 / .75); } .body strong { font-weight: 500; color: #0f0f0f; }
  .row { display: flex; gap: calc(var(--p) * 12); margin-top: calc(var(--p) * 14); } .row span { display: grid; place-items: center; height: calc(var(--p) * 40); padding-inline: calc(var(--p) * 18); border-radius: calc(var(--p) * 10); font-size: calc(var(--p) * 14); } .b1 { background: var(--acc); color: #fff; transition: background-color .25s var(--ease); } .b2 { background: #f4f4f5; color: rgb(0 0 0 / .75); font-weight: 500; }
  @media (max-width: 900px) { .nameit { grid-template-columns: minmax(0, 1fr); } }
</style>
