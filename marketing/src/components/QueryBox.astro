---
import data from "../data/peer-tutoring-years.json";
const all = new Map(data.years);
const years = Array.from({ length: 27 }, (_, i) => 2000 + i).map((y) => [y, all.get(y) ?? 0]);
const max = Math.max(...years.map((y) => y[1]));
const W = 640, H = 140, step = W / years.length;
---
<div class="win q">
  <div class="field"><span class="tag">Research question</span>Does peer tutoring improve reading in primary school?</div>
  <div class="field"><span class="tag">Keywords</span><code><i class="a">("peer tutoring" OR "reciprocal tutoring")</i> AND <i class="b">(reading OR literacy)</i> AND <i class="c">("primary school" OR elementary)</i></code></div>
  <div class="bar"><b>{data.total}</b> results<span class="act">Translate</span><span class="act">Start chat</span><span class="act">Screen all</span></div>
  <div class="chart">
    <div class="ch-head"><span>Papers per year</span><span class="mono">2019, the most before this year: 26</span></div>
    <svg viewBox={`0 0 ${W} ${H + 20}`} role="img" aria-label="Bar chart of papers per year from 2000 to 2026, peaking at 26 in 2019, with 34 so far in 2026">
      {years.map(([y, n], i) => <rect x={i * step + 2} y={H - (n / max) * H} width={step - 4} height={(n / max) * H} rx="2" fill={y === 2019 ? "#60a5fa" : y === 2026 ? "#1e3a8a" : "#1d4ed8"} opacity={y === 2019 ? 1 : .7} />)}
      <g font-family="var(--mono)" font-size="12" fill="#888"><text x="2" y={H + 16}>2000</text><text x={W - 2} y={H + 16} text-anchor="end">2026 so far</text></g>
    </svg>
  </div>
</div>
<style>
  .q { font-size: 14px; }
  .field { padding: 16px; border-bottom: 1px solid var(--line); }
  .tag { display: block; font-size: 12px; color: var(--t3); margin-bottom: 4px; }
  code { font: 400 15px/22px var(--mono); color: var(--t2); }
  i { font-style: normal; border-radius: 4px; padding-inline: 2px; }
  .a { color: #fbbf77; } .b { color: #7dd3fc; } .c { color: #86efac; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-bottom: 1px solid var(--line); color: var(--t2); flex-wrap: wrap; }
  .bar b { color: var(--t1); font-size: 18px; font-weight: 500; font-variant-numeric: tabular-nums; margin-right: -10px; }
  .act { color: var(--t1); padding: 4px 10px; border-radius: 8px; background: var(--s2); }
  .act:first-of-type { margin-left: auto; }
  .chart { padding: 16px; }
  .ch-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  svg { width: 100%; height: auto; }
</style>
