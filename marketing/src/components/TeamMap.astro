---
// Where the team is: the world drawn in the globe's cells, research institutions lit, with each place's people pinned on it.
import { CELL, earthCells } from "../data/earth.mjs";
import { PLACES, flag } from "../data/team.mjs";
// The window onto the world: from the Pacific coast of North America to India, from the Cape to Scotland.
const W = [-130, 80], N = [64, -38], lonW = W[1] - W[0], latH = N[0] - N[1];
const p = earthCells(), dots = [];
for (let i = 0; i < p.length; i += 3) { const lon = (p[i] + .5) * CELL - 180, lat = 90 - (p[i + 1] + .5) * CELL; if (lon < W[0] || lon > W[1] || lat > N[0] || lat < N[1]) continue; dots.push([lon - W[0], N[0] - lat, p[i + 2]]); }
const at = (lon, lat) => `left:${((lon - W[0]) / lonW) * 100}%;top:${((N[0] - lat) / latH) * 100}%`;
// Where each place's card sits beside its pin, so Kenya and Tanzania don't land on each other.
const SIDE = { Kenya: "ne", Tanzania: "se", "South Africa": "se", Nigeria: "sw", Morocco: "w", London: "n", Canada: "n", "United States": "s" };
---
<div class="tmap" data-tmap>
  <svg viewBox={`0 0 ${lonW} ${latH}`} aria-hidden="true">{dots.map(([x, y, k]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={k ? .5 + k * .12 : .45} fill={k ? "#9fd3ff" : "#cfe6ff"} fill-opacity={k ? .3 + k * .2 : .13} />)}</svg>
  {PLACES.map((pl) => <div class:list={["pin", SIDE[pl.place] ?? "n"]} style={at(pl.lon, pl.lat)} data-place={pl.place}>
    <i class="ring" aria-hidden="true"></i>
    <div class="card"><span class="faces">{pl.people.map((m) => <img src={`/img/team/${m.key}.avif`} width="40" height="40" alt="" />)}</span><span class="where"><img class="fl" src={flag(pl.cc)} width="18" height="13" alt="" />{pl.place}</span></div>
  </div>)}
</div>
<script>
  // A person's row and their place on the map light up together.
  for (const map of document.querySelectorAll("[data-tmap]")) {
    const pins = new Map([...map.querySelectorAll(".pin")].map((p) => [p.dataset.place, p]));
    for (const row of document.querySelectorAll("[data-row-place]")) {
      const pin = pins.get(row.dataset.rowPlace); if (!pin) continue;
      row.addEventListener("pointerenter", () => { map.classList.add("hl"); pin.classList.add("on"); });
      row.addEventListener("pointerleave", () => { map.classList.remove("hl"); pin.classList.remove("on"); });
    }
  }
</script>
<style>
  .tmap { position: relative; aspect-ratio: 210 / 102; } svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pin { position: absolute; width: 0; height: 0; transition: opacity .25s var(--ease); } .hl .pin:not(.on) { opacity: .3; }
  .ring { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--brand-bright); background: rgb(255 157 54 / .25); box-shadow: 0 0 0 6px rgb(255 157 54 / .12); }
  .pin.on .ring { scale: 1.3; } .ring { transition: scale .25s var(--ease); }
  .card { position: absolute; display: flex; align-items: center; gap: 10px; padding: 4px 12px 4px 4px; border-radius: 999px; background: rgb(16 20 31 / .86); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14), 0 12px 30px -12px rgb(0 0 0 / .8); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); white-space: nowrap; transition: box-shadow .25s var(--ease); }
  .pin.on .card { box-shadow: inset 0 0 0 1.5px var(--brand-bright), 0 12px 30px -12px rgb(0 0 0 / .8); }
  .faces { display: flex; } .faces img { max-width: none; width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; box-shadow: 0 0 0 2px #10141f; } .faces img + img { margin-left: -10px; }
  .where { display: flex; align-items: center; gap: 7px; font-size: 14px; color: #fff; } .fl { border-radius: 2px; }
  /* The card sits off its pin on the side named for it. */
  .n .card { left: 0; bottom: 16px; translate: -50% 0; } .s .card { left: 0; top: 16px; translate: -50% 0; }
  .ne .card { left: 14px; bottom: 14px; } .se .card { left: 14px; top: 14px; } .sw .card { right: 14px; top: 14px; } .w .card { right: 22px; top: 0; translate: 0 -50%; }
  /* On a phone the cards would cover each other, so only the pins stay; the list below names everyone. */
  @media (max-width: 760px) { .card { display: none; } .ring { left: -5px; top: -5px; width: 10px; height: 10px; box-shadow: 0 0 0 4px rgb(255 157 54 / .14); } }
</style>
