---
// What each audience ends up holding, in real words.
const { kind } = Astro.props;
---
{kind === "review" && <div class="aud rev" aria-hidden="true"><div class="r-h"><b>Peer tutoring and reading screening</b><span>14 of 15 included</span></div><i class="b"><u></u></i><ul><li><em>Tutoring as a reading intervention for bilingual learners</em><span>3/3</span></li><li><em>Peer tutoring and children's e-book reading</em><span>3/3</span></li><li class="m"><em>Role of peer tutoring in urban primary schools</em><span>2/3</span></li></ul></div>}
{kind === "brief" && <div class="aud" aria-hidden="true"><b>Does peer tutoring improve reading?</b><p>Pupils <mark>did significantly better than control pupils</mark> in a trial across 80 schools.</p><em>Topping and colleagues, 2011</em></div>}
{kind === "community" && <div class="aud com" aria-hidden="true"><div class="hd"><img src="/favicon.svg" width="16" height="16" alt="" /><span>Wealth Inequality and Social Mobility</span></div><div class="s"><span>Search the community</span><i>Ask AI</i></div></div>}
<style>
  .rev { justify-content: flex-start; gap: 6px; } .r-h { display: flex; justify-content: space-between; gap: 10px; } .r-h b { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .r-h span { flex: none; font-size: 12px; color: var(--t2); } .b { display: block; height: 5px; border-radius: 3px; background: #fbbf24; overflow: hidden; } .b u { display: block; width: 93%; height: 100%; background: #10b981; } .rev ul { display: grid; gap: 3px; } .rev ul, .rev li { min-width: 0; } .rev li { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; } .rev li em { margin: 0; font-size: 13px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .rev li span { flex: none; font: 400 12px/1.3 var(--mono); color: #047857; } .rev .m span { color: #b45309; }
  svg { width: 100%; height: auto; }
  .aud { display: flex; flex-direction: column; justify-content: center; min-height: 0; aspect-ratio: 360 / 150; padding: 12px 14px; border-radius: 12px; background: #fff; color: var(--ink); font-size: 14px; line-height: 1.3; overflow: hidden; } .aud b { font-weight: 500; margin-bottom: 4px; } mark { background: #fde68a; color: inherit; border-radius: 3px; padding-inline: 2px; } em { margin-top: 6px; font-style: normal; font-size: 12px; color: var(--t2); }
  .hd { display: flex; align-items: center; gap: 8px; font-weight: 500; line-height: 1.2; margin-bottom: 12px; } .hd img { flex: none; } .s { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 6px 6px 12px; border-radius: 10px; background: var(--soft); color: var(--t2); } .s i { flex: none; font-style: normal; padding: 4px 9px; border-radius: 7px; background: #047857; color: #fff; font-size: 13px; }
  @media (max-width: 1100px) and (min-width: 901px) { .aud { font-size: 12px; aspect-ratio: auto; height: 100%; } }
</style>
