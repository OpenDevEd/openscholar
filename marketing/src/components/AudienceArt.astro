---
// What each audience ends up holding, in real words.
const { kind } = Astro.props;
const seq = [1,1,0,2,1,0,0,1,0,2,0,1,1,0,0,2,0,1,0,0,1,0,2,0,1,0,0,1,0,1,0,2,0,0,1,0,1,0,0,2];
---
{kind === "review" && <svg viewBox="0 0 360 150" aria-hidden="true">{seq.map((v, i) => <rect x={(i % 10) * 36 + 2} y={Math.floor(i / 10) * 37 + 2} width="30" height="30" rx="7" fill={v === 1 ? "#fff" : v === 2 ? "#fde68a" : "rgb(255 255 255 / .18)"} />)}{seq.map((v, i) => v === 1 && <path d={`M${(i % 10) * 36 + 10} ${Math.floor(i / 10) * 37 + 18}l5 5 9-11`} fill="none" stroke="#0e7490" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />)}</svg>}
{kind === "brief" && <div class="aud" aria-hidden="true"><b>Does peer tutoring improve reading?</b><p>Pupils <mark>did significantly better than control pupils</mark> in a trial across 80 schools.</p><em>Topping and colleagues, 2011</em></div>}
{kind === "community" && <div class="aud com" aria-hidden="true"><div class="top"><img src="/favicon.svg" width="16" height="16" alt="" /><span>Wealth Inequality and Social Mobility</span></div><div class="s"><span>Search the community</span><i>Ask AI</i></div></div>}
<style>
  svg { width: 100%; height: auto; }
  .aud { display: flex; flex-direction: column; justify-content: center; min-height: 0; aspect-ratio: 360 / 150; padding: 12px 14px; border-radius: 12px; background: #fff; color: var(--ink); font-size: 14px; line-height: 1.3; overflow: hidden; } .aud b { font-weight: 500; margin-bottom: 4px; } mark { background: #fde68a; color: inherit; border-radius: 3px; padding-inline: 2px; } em { margin-top: 6px; font-style: normal; font-size: 12px; color: var(--t2); }
  .top { display: flex; align-items: center; gap: 8px; font-weight: 500; line-height: 1.2; margin-bottom: 12px; } .top img { flex: none; } .s { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 6px 6px 12px; border-radius: 10px; background: var(--soft); color: var(--t2); } .s i { flex: none; font-style: normal; padding: 4px 9px; border-radius: 7px; background: #047857; color: #fff; font-size: 13px; }
  @media (max-width: 1100px) and (min-width: 901px) { .aud { font-size: 12px; aspect-ratio: auto; height: 100%; } }
</style>
