---
// A drawing for each audience, in white on its colour field.
const { kind } = Astro.props;
const seq = [1,1,0,2,1,0,0,1,0,2,0,1,1,0,0,2,0,1,0,0,1,0,2,0,1,0,0,1,0,1,0,2,0,0,1,0,1,0,0,2];
---
{kind === "review" && <svg viewBox="0 0 360 150" aria-hidden="true">{seq.map((v, i) => <rect x={(i % 10) * 36 + 2} y={Math.floor(i / 10) * 37 + 2} width="30" height="30" rx="7" fill={v === 1 ? "#fff" : v === 2 ? "#fde68a" : "rgb(255 255 255 / .18)"} />)}{seq.map((v, i) => v === 1 && <path d={`M${(i % 10) * 36 + 10} ${Math.floor(i / 10) * 37 + 18}l5 5 9-11`} fill="none" stroke="#0e7490" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />)}</svg>}
{kind === "brief" && <svg viewBox="0 0 360 150" aria-hidden="true"><rect x="2" y="2" width="210" height="146" rx="10" fill="#fff" /><rect x="20" y="20" width="110" height="10" rx="3" fill="#9f1239" />{[46, 66, 86, 106, 126].map((y, i) => <rect x="20" y={y} width={[172, 150, 164, 140, 96][i]} height="7" rx="3" fill={i === 1 ? "#fde68a" : i === 3 ? "#fbcfe8" : "rgb(10 26 63 / .16)"} />)}<g fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="3 5"><path d="M212 70C250 70 250 36 286 36" /><path d="M212 110C250 110 250 112 286 112" /></g><rect x="286" y="8" width="72" height="56" rx="8" fill="rgb(255 255 255 / .92)" /><rect x="296" y="20" width="52" height="6" rx="3" fill="#fde68a" /><rect x="296" y="34" width="40" height="6" rx="3" fill="rgb(10 26 63 / .18)" /><rect x="286" y="84" width="72" height="56" rx="8" fill="rgb(255 255 255 / .92)" /><rect x="296" y="96" width="52" height="6" rx="3" fill="#fbcfe8" /><rect x="296" y="110" width="40" height="6" rx="3" fill="rgb(10 26 63 / .18)" /></svg>}
{kind === "library" && <svg viewBox="0 0 360 150" aria-hidden="true">{[[120, 2, .4], [70, 16, .7], [20, 30, 1]].map(([x, y, o]) => <g opacity={o}><rect x={x} y={y} width="220" height="118" rx="10" fill="#fff" /><rect x={x} y={y} width="220" height="22" rx="10" fill="#047857" /><circle cx={x + 16} cy={y + 11} r="5" fill="#a7f3d0" /><rect x={x + 16} y={y + 36} width="110" height="11" rx="3" fill="rgb(10 26 63 / .75)" /><rect x={x + 16} y={y + 56} width="150" height="7" rx="3" fill="rgb(10 26 63 / .18)" /><rect x={x + 16} y={y + 72} width="130" height="7" rx="3" fill="rgb(10 26 63 / .18)" /><rect x={x + 16} y={y + 90} width="66" height="16" rx="5" fill="#047857" /></g>)}</svg>}
<style>svg { width: 100%; height: auto; }</style>
