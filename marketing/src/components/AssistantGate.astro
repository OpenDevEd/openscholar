---
// The assistant's one promise, played out: the work waits at a glass door, the real approval card hangs on it, and only your answer lets the papers through to the report.
import Art from "./Art.astro";
---
<section class="panel gate" id="assistant" data-gate>
  <div class="g-stage">
    <Art name="door-front" sizes="(max-width: 1280px) 134vw, 1672px" />
    <div class="g-copy"><h2>Delegate the groundwork, not the decisions</h2><p class="lead">Describe the review you need. The assistant searches, builds collections and runs jobs in your workspace, stops for your approval, and tells you which results to check by hand.</p></div>
    <div class="queue" aria-hidden="true">{Array.from({ length: 5 }, (_, i) => <img src="/img/sheet-glass.avif" width="280" height="280" loading="lazy" decoding="async" alt="" style={`--i:${i}`} />)}</div>
    <i class="glow" aria-hidden="true"></i>
    <div class="hinge">
      <div class="leaf">
        <div class="ask">
          <img src="/img/screens/panel-approve-light.avif" width="809" height="602" loading="lazy" decoding="async" alt="The research assistant asking for approval before it starts an extraction, with Allow once and Always allow in this chat" />
          <button type="button" class="yes one" data-yes aria-label="Allow once"></button>
          <button type="button" class="yes all" data-yes aria-label="Always allow in this chat"></button>
        </div>
        <i class="handle" aria-hidden="true"></i>
      </div>
    </div>
    <p class="hold wait">Nothing moves until you answer</p>
    <div class="hold done"><p>Then it tells you what to check by hand</p><button type="button" class="again" data-again>See it again</button></div>
    <div class="report"><img src="/img/screens/panel-assistant-light.avif" width="878" height="926" loading="lazy" decoding="async" alt="The research assistant's report, listing which papers to check by hand and why" /></div>
  </div>
</section>
<script>
  const gate = document.querySelector("[data-gate]");
  if (gate) {
    const again = gate.querySelector("[data-again]"), first = gate.querySelector("[data-yes]");
    gate.querySelectorAll("[data-yes]").forEach((b) => b.addEventListener("click", () => { gate.classList.add("open"); again.focus({ preventScroll: true }); }));
    again.addEventListener("click", () => { gate.classList.remove("open"); first.focus({ preventScroll: true }); });
  }
</script>
<style>
  /* Phones and small windows: the two real panels, one above the other. */
  .gate { padding: var(--pad); background: #05124f; } .g-stage { position: relative; isolation: isolate; display: grid; gap: 20px; } .g-copy { display: grid; gap: 18px; } .queue, .glow, .handle, .yes, .hold { display: none; } .ask img, .report img { display: block; width: 100%; height: auto; border-radius: 16px; box-shadow: 0 0 0 1px rgb(255 255 255 / .3), 0 40px 80px -30px rgb(2 8 50 / .85); }
  @media (min-width: 701px) and (max-width: 1100px) { .g-stage { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } .g-copy { grid-column: 1 / -1; } }
  @media (max-width: 1100px) { .gate :global(.art) { display: none; } .gate { background: radial-gradient(ellipse 80% 50% at 50% 100%, #1740b8, transparent), #05124f; } }
  /* From here up everything is measured against the door in the picture, and the whole scene fits the window's height as well as its width. */
  @media (min-width: 1101px) {
    .gate { padding: 0; container-type: inline-size; background: #000a34; }
    .g-stage { --u: min(calc(100cqw / 1248), calc((100svh - 32px) / 860)); display: block; width: calc(var(--u) * 1248); height: calc(var(--u) * 860); margin-inline: auto; }
    .gate :global(.art) { inset: auto; left: calc(var(--u) * -60); top: 0; width: calc(var(--u) * 1672); height: calc(var(--u) * 941); -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%); mask-image: linear-gradient(90deg, transparent, #000 5%); }
    .g-copy { position: absolute; left: calc(var(--u) * 64); top: calc(var(--u) * 96); width: calc(var(--u) * 316); } .g-copy h2 { font-size: calc(var(--u) * 40); } .g-copy .lead { font-size: calc(var(--u) * 17.5); }
    /* The papers wait on the floor line, then walk into the doorway and away into its depth. */
    .queue { display: block; position: absolute; inset: 0; pointer-events: none; }
    .queue img { position: absolute; left: calc(var(--u) * (46 + var(--i) * 64)); top: calc(var(--u) * 650); width: calc(var(--u) * 96); height: calc(var(--u) * 106); object-fit: contain; opacity: .78; }
    /* The door, on its hinge. */
    .hinge { position: absolute; left: calc(var(--u) * 428); top: calc(var(--u) * 122); width: calc(var(--u) * 348); height: calc(var(--u) * 630); perspective: calc(var(--u) * 1400); }
    .leaf { position: absolute; inset: 0; display: grid; align-items: center; padding-inline: calc(var(--u) * 10); transform-origin: 0 50%; background: linear-gradient(118deg, rgb(170 205 255 / .2), rgb(150 190 255 / .05) 36%, rgb(190 225 255 / .13) 58%, rgb(150 190 255 / .04) 72%); box-shadow: inset 0 0 0 1px rgb(205 230 255 / .55); transition: transform 1.1s cubic-bezier(.55, 0, .15, 1); }
    .ask { position: relative; transition: opacity .35s var(--ease); } .ask img { border-radius: calc(var(--u) * 14); box-shadow: 0 0 0 1px rgb(255 255 255 / .4), 0 calc(var(--u) * 30) calc(var(--u) * 60) calc(var(--u) * -18) rgb(2 8 50 / .9); }
    .yes { display: block; position: absolute; top: 83.900%; height: 11.900%; border-radius: calc(var(--u) * 7); cursor: pointer; transition: background-color .15s var(--ease), box-shadow .15s var(--ease); } .one { left: 3.100%; width: 46%; box-shadow: 0 0 0 calc(var(--u) * 3) rgb(251 191 36 / .9), 0 0 calc(var(--u) * 26) rgb(251 191 36 / .55); } .all { left: 51%; width: 46%; } .yes:hover { background: rgb(255 255 255 / .16); } .yes:active { background: rgb(0 0 0 / .14); }
    .handle { display: block; position: absolute; right: calc(var(--u) * 10); top: 76%; width: calc(var(--u) * 5); height: calc(var(--u) * 80); border-radius: 99px; background: linear-gradient(90deg, #eef6ff, #8fb4e8); box-shadow: 0 0 calc(var(--u) * 12) rgb(160 210 255 / .7); }
    .glow { display: block; position: absolute; left: calc(var(--u) * 428); top: calc(var(--u) * 122); width: calc(var(--u) * 348); height: calc(var(--u) * 630); background: radial-gradient(ellipse 70% 62% at 56% 58%, rgb(150 215 255 / .55), rgb(70 140 255 / .14) 70%, transparent); opacity: 0; pointer-events: none; transition: opacity 1.2s var(--ease); }
    /* One line beside the door, before and after. */
    .hold { display: block; position: absolute; left: calc(var(--u) * 836); top: calc(var(--u) * 340); width: calc(var(--u) * 340); font-size: calc(var(--u) * 32); line-height: 1.15; letter-spacing: -.02em; font-weight: 500; transition: opacity .35s var(--ease); } .wait { transition-delay: .9s; } .done { opacity: 0; visibility: hidden; transition: opacity .5s var(--ease), visibility 0s .5s; } .open .wait { opacity: 0; transition-delay: 0s; } .open .done { opacity: 1; visibility: visible; transition: opacity .6s var(--ease) 2s; }
    .again { margin-top: calc(var(--u) * 14); color: rgb(255 255 255 / .78); font-size: calc(var(--u) * 15); font-weight: 400; letter-spacing: 0; text-decoration: underline; text-underline-offset: 3px; transition: color .15s var(--ease); } .again:hover { color: #fff; }
    /* The report comes forward out of the light and stands in the doorway. */
    .report { position: absolute; left: calc(var(--u) * 392); top: calc(var(--u) * 134); width: calc(var(--u) * 420); transform-origin: 50% 60%; } .report img { box-shadow: 0 0 0 1px rgb(255 255 255 / .4), 0 calc(var(--u) * 40) calc(var(--u) * 80) calc(var(--u) * -20) rgb(2 8 50 / .9), 0 0 calc(var(--u) * 70) rgb(120 190 255 / .4); }
    .open .leaf { transform: rotateY(76deg); } .open .ask { opacity: 0; pointer-events: none; } .open .yes { visibility: hidden; } .open .glow { opacity: 1; transition-delay: .25s; }
    .open .queue img { animation: pass 1.7s cubic-bezier(.5, 0, .3, 1) calc(.5s + (4 - var(--i)) * 130ms) forwards; } @keyframes pass { 58% { opacity: 1; translate: calc(var(--u) * (508 - var(--i) * 64)) 0; scale: 1; } to { opacity: 0; translate: calc(var(--u) * (508 - var(--i) * 64)) calc(var(--u) * -150); scale: .16; } }
    :global(.has-js) .gate:not(.open) .report { opacity: 0; scale: .3; visibility: hidden; pointer-events: none; transition: opacity .25s var(--ease), scale .25s var(--ease), visibility 0s .25s; } :global(.has-js) .gate.open .report { transition: opacity .7s var(--ease) 1.5s, scale 1s cubic-bezier(.2, .8, .3, 1) 1.5s; } :global(html:not(.has-js)) .ask { opacity: 0; }
  }
</style>
