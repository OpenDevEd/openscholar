---
import papers from "../data/extraction.json";
const Q = [["size", "What is the sample size?"], ["design", "What design did it use?"], ["who", "Who took part?"]];
---

  <section class="lab" data-lab data-papers={JSON.stringify(papers)}>
    <div class="lab-head">
      <h2>Never wonder where an answer came from</h2>
      <p class="lead">Click any answer and the sentence behind it lights up.</p>
    </div>
    <div class="split" data-split>
    <svg class="wire" aria-hidden="true"><path data-wire pathLength="1" /></svg>
    <div class="grid" role="table" aria-label="Extraction results">
      <div class="row head" role="row"><span role="columnheader">Paper</span>{Q.map(([, q]) => <span role="columnheader">{q}</span>)}</div>
      {papers.map((p, r) => (
        <div class="row" role="row" data-row={r}>
          <div class="paper" role="cell">
            <b>{p.title}</b>
            <div class="spec" aria-hidden="true">{p.sentences.map((s, k) => <i data-s={k} style={`flex:${s.length}`}></i>)}</div>
          </div>
          {Q.map(([k]) => <div role="cell"><button type="button" class:list={["cell", { none: p[k].at < 0 }]} data-r={r} data-k={k} data-at={p[k].at} disabled={p[k].at < 0}><span class:list={[k === "size" ? "num" : "txt"]}>{p[k].value}</span></button></div>)}
        </div>
      ))}
    </div>
    <div class="reading" aria-live="polite" tabindex="0"><p class="mono" data-from></p><p class="abs" data-abs></p></div>
    </div>
    <div class="dl">
      <span class="dlh">It's your data. Take it with you.</span>
      <button type="button" class="btn quiet" data-dl="csv">Download as CSV</button>
      <button type="button" class="btn quiet" data-dl="json">Download as JSON</button>
    </div>
  </section>
  
<script>
  const lab = document.querySelector("[data-lab]"), papers = JSON.parse(lab.dataset.papers), abs = lab.querySelector("[data-abs]"), from = lab.querySelector("[data-from]");
  const esc = (s) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]);
  const show = (r, k) => {
    const p = papers[r], at = p[k].at;
    lab.querySelectorAll(".cell[aria-pressed]").forEach((c) => c.removeAttribute("aria-pressed")); lab.querySelectorAll(".spec i.on").forEach((i) => i.classList.remove("on"));
    lab.querySelector(`.cell[data-r="${r}"][data-k="${k}"]`).setAttribute("aria-pressed", "true");
    lab.querySelector(`[data-row="${r}"] [data-s="${at}"]`).classList.add("on");
    from.textContent = `${p.title}, ${p.year}`;
    abs.innerHTML = p.sentences.map((s, i) => i === at ? `<mark>${esc(s)}</mark>` : esc(s)).join(" ");
    const reader = abs.parentElement, m = abs.querySelector("mark"); reader.scrollTop = Math.max(0, m.offsetTop - reader.offsetTop - 80);
    wire(true);
  };
  // A thread of light from the answer to its sentence.
  const split = lab.querySelector("[data-split]"), path = lab.querySelector("[data-wire]");
  function wire(fresh) { const cell = lab.querySelector(".cell[aria-pressed]"), m = abs.querySelector("mark"); if (!cell || !m) return; const o = split.getBoundingClientRect(), a = cell.getBoundingClientRect(), row = cell.closest(".row").getBoundingClientRect(), box = lab.querySelector(".reading").getBoundingClientRect(), b = m.getClientRects()[0], xc = a.left + a.width / 2 - o.left, top = row.top - o.top, end = row.right - o.left, x2 = box.left - o.left, y2 = Math.min(box.bottom - 16, Math.max(box.top + 16, b.top + b.height / 2)) - o.top, mid = (end + x2) / 2; path.setAttribute("d", `M${xc} ${a.top - o.top} L${xc} ${top} L${end} ${top} C${mid} ${top}, ${mid} ${y2}, ${x2} ${y2}`); if (fresh) path.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 500, easing: "ease-out" }); }
  addEventListener("resize", () => wire(), { passive: true }); lab.querySelector(".reading").addEventListener("scroll", () => wire(), { passive: true });
  lab.addEventListener("click", (e) => { const c = e.target.closest(".cell"); if (c && !c.disabled) show(+c.dataset.r, c.dataset.k); const d = e.target.closest("[data-dl]"); if (d) download(d.dataset.dl); });
  function download(kind) {
    const rows = papers.map((p) => ({ title: p.title, year: p.year, sample_size: p.size.value, design: p.design.value, who_took_part: p.who.value, sample_size_evidence: p.sentences[p.size.at] ?? "", design_evidence: p.sentences[p.design.at] ?? "", who_took_part_evidence: p.sentences[p.who.at] ?? "" }));
    const q = (v) => `"${String(v).replace(/"/g, '""')}"`;
    const body = kind === "json" ? JSON.stringify(rows, null, 2) : [Object.keys(rows[0]).map(q).join(","), ...rows.map((r) => Object.values(r).map(q).join(","))].join("\n");
    const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([body], { type: kind === "json" ? "application/json" : "text/csv" })); a.download = `extraction-results.${kind}`; a.click(); URL.revokeObjectURL(a.href);
  }
  show(1, "size");
</script>
<style>
  .lab { padding: 104px var(--edge) 64px; }
  .lab-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: end; margin-bottom: 48px; }
  
  .row { display: grid; grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 2fr)); gap: 12px; align-items: stretch; padding-block: 8px; border-top: 1px solid var(--line); }
  .head { color: var(--t2); font-size: 14px; border-top: 0; align-items: end; padding-bottom: 12px; }
  .paper b { font-weight: 400; font-size: 15px; line-height: 20px; display: block; margin-bottom: 8px; }
  .spec { display: flex; gap: 2px; height: 14px; }
  .spec i { display: block; min-width: 3px; background: var(--s3); border-radius: 1px; transition: background-color .2s var(--ease), box-shadow .2s var(--ease); }
  .spec i:global(.on) { background: #fff; box-shadow: 0 0 12px rgb(191 219 254 / .9); }
  .cell { width: 100%; height: 100%; min-height: 64px; display: flex; align-items: center; padding: 8px 14px; text-align: left; border-radius: 10px; transition: background-color .15s var(--ease); }
  .cell:hover:not(:disabled):not([aria-pressed]) { background: var(--s2); }
  .cell[aria-pressed] { background: var(--t1); color: #000; }
  .cell[aria-pressed] .num, .cell[aria-pressed] .txt { color: #000; }
  .cell:disabled { cursor: default; color: var(--t3); }
  .num { font-weight: 500; font-size: 22px; font-variant-numeric: tabular-nums; }
  .txt { font-size: 15px; line-height: 20px; }
  .wire { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; overflow: visible; pointer-events: none; } .wire path { fill: none; stroke: #9ff0c0; stroke-width: 1.5; stroke-dasharray: 1; }
  .split { position: relative; display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 5fr); gap: 32px; align-items: start; } .reading { position: sticky; top: 80px; padding: 24px; border: 1px solid var(--line2); border-radius: 18px; height: 460px; overflow-y: auto; scrollbar-width: thin; background: rgb(11 12 15 / .7); }
  .abs { margin-top: 12px; color: var(--t3); font-size: clamp(17px, 1.5vw, 23px); line-height: 1.5; }
  .abs :global(mark) { background: none; color: #fff; font-weight: 400; box-shadow: inset 0 -2px 0 #9ff0c0; }
  .dl { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; } .dlh { margin-right: auto; color: var(--t2); }
  @media (max-width: 1100px) { .wire { display: none; } .split { grid-template-columns: minmax(0, 1fr); } .reading { position: static; height: 340px; } }
  @media (max-width: 900px) { .lab-head { grid-template-columns: minmax(0, 1fr); } .row { grid-template-columns: 1fr 1fr 1fr; } .head span:first-child { display: none; } .paper { grid-column: 1 / -1; } .num { font-size: 26px; } .txt { font-size: 13px; } .cell { padding: 8px; } }
</style>
