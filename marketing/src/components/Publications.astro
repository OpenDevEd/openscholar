---
// A person's publications, newest first, six at a time, with a filter by kind where they have more than one kind. Each opens
// its publication. The list keeps the height of a full page while you page through it, so the buttons under it never move,
// and slides to its new height when a filter leaves fewer.
const { pubs } = Astro.props, PER = 6;
// What one of each kind is called on its row, where the source's word differs from the filter's.
const ONE = { "Journal Article": "Journal article", "Conference Paper": "Conference paper", "Book Section": "Book section", "Computer Program": "Software" };
const KINDS = { "Report": "Reports", "Journal Article": "Journal articles", "Conference Paper": "Conference papers", "Book Section": "Book sections", "Book": "Books", "Computer Program": "Software", "Presentation": "Presentations" };
const sorted = [...pubs].sort((a, b) => (Number(b.year) || 0) - (Number(a.year) || 0));
const kinds = [...new Set(sorted.map((b) => b.type))].map((k) => [k, sorted.filter((b) => b.type === k).length]).sort((a, b) => b[1] - a[1]);
const shown = Math.min(sorted.length, PER);
---
<section class="pubs" data-pubs data-per={PER} aria-labelledby="pubs-h">
  <header>
    <h2 id="pubs-h">Publications</h2>
    {kinds.length > 1 && <div class="kinds" role="group" aria-label="Kind of publication"><button type="button" aria-pressed="true" data-pick="">All<i>{sorted.length}</i></button>{kinds.map(([k, n]) => <button type="button" aria-pressed="false" data-pick={k}>{KINDS[k] ?? k}<i>{n}</i></button>)}</div>}
  </header>
  <ol class="tiles" style={`--rows2:${Math.ceil(shown / 2)};--rows1:${shown}`}>{sorted.map((b, i) => <li data-kind={b.type} hidden={i >= PER}><a href={b.url}>
    {b.cover ? <img class="cv" src={`/img/team/pub-${b.cover}.avif`} width="60" height="80" alt="" /> : <i class="cv none" aria-hidden="true"><span>{b.title}</span></i>}
    <span class="tx"><span class="meta"><span class="ty">{ONE[b.type] ?? b.type}</span><span class="yr">{b.year}</span></span><b>{b.title}</b><em>{b.by}</em></span>
  </a></li>)}</ol>
  {/* What a filter or a step left on show, said aloud. It is its own line because the pager hides when there is one page. */}
  {(kinds.length > 1 || sorted.length > PER) && <p class="sr" data-said aria-live="polite"></p>}
  {sorted.length > PER && <footer class="pager"><span data-range>1 to {PER} of {sorted.length}</span>
    <button type="button" data-step="-1" aria-label="Newer publications" disabled><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 5-5 5 5 5" /></svg></button>
    <button type="button" data-step="1" aria-label="Older publications"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
  </footer>}
</section>
<script>
  for (const root of document.querySelectorAll("[data-pubs]")) {
    const per = Number(root.dataset.per), list = root.querySelector(".tiles"), items = [...list.children], pager = root.querySelector(".pager"), range = root.querySelector("[data-range]"), steps = [...root.querySelectorAll("[data-step]")], picks = [...root.querySelectorAll("[data-pick]")], said = root.querySelector("[data-said]"), calm = matchMedia("(prefers-reduced-motion: reduce)");
    let kind = "", page = 0, target = null, timers = [];
    // Ends a change that is still playing: every row is at once where it was going. A new change then starts from there.
    const settle = () => { if (!target) return; list.style.transitionDelay = ""; timers.forEach(clearTimeout); timers = []; for (const li of items) { for (const a of li.getAnimations()) a.cancel(); li.hidden = !target.includes(li); li.style.order = ""; } target = null; };
    const show = () => {
      settle();
      const set = items.filter((li) => !kind || li.dataset.kind === kind), pages = Math.ceil(set.length / per); page = Math.max(0, Math.min(page, pages - 1));
      const from = page * per, now = set.slice(from, from + per), full = Math.min(set.length, per), out = items.filter((li) => !li.hidden);
      const stay = now.filter((li) => out.includes(li));
      // A full page's height for this filter, whichever page is showing. The list grows at once, and shrinks only when the
      // rows leaving it have gone, so none of them is cut by its edge on the way out.
      list.style.transitionDelay = full < Number(list.style.getPropertyValue("--rows1")) ? `${stay.length ? 110 : (per - 1) * 45 + 110}ms` : "";
      list.style.setProperty("--rows2", Math.ceil(full / 2)); list.style.setProperty("--rows1", full);
      // A step button that reaches the end is switched off: if it had the keyboard, the other one takes it.
      if (pager) { const had = steps.find((s) => s === document.activeElement); range.textContent = `${from + 1} to ${from + now.length} of ${set.length}`; steps[0].disabled = page === 0; steps[1].disabled = page >= pages - 1; pager.classList.toggle("off", pages < 2); if (had?.disabled) steps.find((s) => !s.disabled)?.focus(); }
      if (said) said.textContent = `${from + 1} to ${from + now.length} of ${set.length}`;
      target = now; if (calm.matches) return settle();
      const at = (ms, fn) => timers.push(setTimeout(fn, ms)), EASE = "cubic-bezier(.22, 1, .36, 1)";
      const arrive = (li, delay = 0) => li.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 320, delay, easing: EASE, fill: "backwards" });
      if (stay.length) {
        // A filter that keeps some of the rows on show: the ones leaving fade, the ones staying glide to their new places,
        // and the ones arriving fade in. The rows are always in the order they are written in, so nothing shares a place.
        const gone = out.filter((li) => !now.includes(li)), come = now.filter((li) => !out.includes(li));
        for (const li of gone) li.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 110, easing: "ease-in", fill: "forwards" });
        at(110, () => {
          const was = new Map(stay.map((li) => [li, li.getBoundingClientRect()]));
          for (const li of gone) li.hidden = true; for (const li of come) li.hidden = false;
          for (const [li, from] of was) { const to = li.getBoundingClientRect(), dx = from.left - to.left, dy = from.top - to.top; if (dx || dy) li.animate([{ translate: `${dx}px ${dy}px` }, { translate: "0 0" }], { duration: 380, easing: EASE }); }
          come.forEach((li, j) => arrive(li, 60 + j * 35));
        });
        return at(110 + 60 + per * 35 + 400, settle);
      }
      // Another page, or a filter with nothing in common: each row gives way to the one taking its place, one row after
      // another, so the list is never empty on the way. A row and its successor share a place in the grid by sharing an
      // order. A row with no successor fades and keeps its place until the end, so the rows after it never move up into it.
      for (let k = 0; k < per; k++) {
        const old = out[k], next = now[k]; if (old) old.style.order = k; if (next) next.style.order = k;
        at(k * 45, () => old?.animate([{ opacity: 1 }, { opacity: 0, transform: "translateY(-6px)" }], { duration: 110, easing: "ease-in", fill: "forwards" }));
        at(k * 45 + 110, () => { if (old && next) old.hidden = true; if (next) { next.hidden = false; arrive(next); } });
      }
      at(per * 45 + 440, settle);
    };
    for (const b of steps) b.addEventListener("click", () => { page += Number(b.dataset.step); show(); });
    for (const b of picks) b.addEventListener("click", () => { if (kind === b.dataset.pick) return; kind = b.dataset.pick; page = 0; picks.forEach((k) => k.setAttribute("aria-pressed", String(k === b))); show(); });
  }
</script>
<style>
  header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  /* The filter, shaped like the site's other switches. Where it wraps, each row of it is filled. The keyboard's ring is
     drawn inside a button, as the buttons stand closer together than the ring is wide. */
  .kinds button:focus-visible { outline-offset: -3px; } .kinds [aria-pressed="true"] { cursor: default; }
  .kinds { display: flex; flex-wrap: wrap; gap: 2px; padding: 4px; border-radius: 13px; background: var(--soft); } .kinds button { display: inline-flex; flex: 1 0 auto; align-items: center; justify-content: center; gap: 8px; height: 38px; padding-inline: 14px; border-radius: 10px; font-size: 15px; white-space: nowrap; color: var(--t2); transition: background-color .2s var(--ease), color .2s var(--ease), box-shadow .2s var(--ease); } .kinds button:not([aria-pressed="true"]):hover { color: var(--ink); } .kinds [aria-pressed="true"] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgb(12 16 28 / .14), 0 0 0 1px var(--line); }
  /* Seven choices that no longer fit one row break four and three, not six and one. A finger gets a taller button. */
  @media (min-width: 761px) and (max-width: 919px) { .kinds:has(> :nth-child(7)) button { flex-basis: calc(25% - 2px); } } @media (pointer: coarse) { .kinds button { height: 44px; } }
  .kinds i { font: 400 13px/1 var(--mono); font-style: normal; color: var(--t3); }
  /* Two columns of rows, every row the same height, so a page of six is always the same size. */
  .pubs { --cg: clamp(32px, 4vw, 64px); }
  .tiles { --row: 108px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: var(--row); column-gap: var(--cg); height: calc(var(--rows2) * var(--row)); clip-path: inset(-24px); transition: height .5s var(--ease); }
  .tiles li { border-top: 1px solid var(--line); } .tiles a { display: grid; grid-template-columns: 60px minmax(0, 1fr); gap: 18px; align-items: start; height: 100%; padding-top: 14px; }
  .cv { width: 60px; height: 80px; border-radius: 4px; object-fit: cover; object-position: 50% 0; box-shadow: 0 0 0 1px var(--line), 0 10px 16px -10px rgb(0 0 0 / .45); transform-origin: 50% 100%; transition: translate .35s var(--ease), rotate .35s var(--ease), box-shadow .35s var(--ease); } .tiles a:focus-visible .cv { translate: 0 -3px; rotate: -2.5deg; box-shadow: 0 0 0 1px var(--line), 0 16px 22px -10px rgb(0 0 0 / .5); } @media (hover: hover) { .tiles a:hover .cv { translate: 0 -3px; rotate: -2.5deg; box-shadow: 0 0 0 1px var(--line), 0 16px 22px -10px rgb(0 0 0 / .5); } }
  /* No cover: a page in the person's own colour (--bg, from their page) with its own title on it in small print, so no two
     of them are the same block. The title beside it is the one to read. */
  .cv.none { display: block; position: relative; overflow: hidden; background: linear-gradient(150deg, rgb(255 255 255 / .16), transparent 42%), var(--bg, var(--night)); }
  .cv.none span { position: absolute; inset: 9px 7px auto; display: -webkit-box; overflow: hidden; overflow-wrap: anywhere; -webkit-hyphens: auto; hyphens: auto; -webkit-box-orient: vertical; -webkit-line-clamp: 5; font-style: normal; font-weight: 500; font-size: 7.5px; line-height: 1.25; color: rgb(255 255 255 / .9); }
  .cv.none::after { content: ""; position: absolute; left: 8px; right: 30px; bottom: 10px; height: 2px; background: rgb(255 255 255 / .35); }
  .tx { display: grid; gap: 4px; min-width: 0; } .meta { display: flex; align-items: center; gap: 10px; } .ty { font-size: 13px; line-height: 1.2; color: var(--t2); } .yr { font: 400 13px/1.2 var(--mono); color: var(--t3); }
  .tx b { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-weight: 500; font-size: 16px; line-height: 1.3; } .tiles a:is(:hover, :focus-visible) b { text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px; }
  .tx em { overflow: hidden; font-style: normal; font-size: 14px; line-height: 1.3; white-space: nowrap; text-overflow: ellipsis; color: var(--t3); }
  /* Which six of how many, and the way to the others. With one page the row keeps its place, empty. */
  /* The rule that closes the list breaks at the gutter between the columns, as each row's rule does. */
  .pager { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding-top: 16px; background: linear-gradient(var(--line) 0 0) left top / calc(50% - var(--cg) / 2) 1px no-repeat, linear-gradient(var(--line) 0 0) right top / calc(50% - var(--cg) / 2) 1px no-repeat; } .pager span { margin-right: auto; font: 400 14px/1 var(--mono); color: var(--t3); transition: opacity .2s var(--ease), visibility 0s; } .pager:global(.off) > :is(*, :disabled) { opacity: 0; visibility: hidden; transition: opacity .2s var(--ease), visibility 0s .2s; }
  .pager button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; box-shadow: inset 0 0 0 1px var(--line2); transition: background-color .2s var(--ease), color .2s var(--ease), box-shadow .2s var(--ease), opacity .2s var(--ease), visibility 0s; } .pager button:not(:disabled):hover { background: var(--ink); color: #fff; box-shadow: none; } .pager button:disabled { opacity: .35; cursor: default; }
  /* Without scripts every publication is listed. */
  :global(html:not(.has-js)) .tiles { height: auto; } :global(html:not(.has-js)) .tiles li[hidden] { display: block; } :global(html:not(.has-js)) :is(.kinds, .pager) { display: none; }
  /* One column. Where the filter no longer fits beside the heading it fills the width, so two lines of it read as one control. */
  @media (max-width: 760px) { .tiles { grid-template-columns: minmax(0, 1fr); height: calc(var(--rows1) * var(--row)); } .pager { background: none; border-top: 1px solid var(--line); } .kinds { width: 100%; } .kinds button { height: 44px; } }
</style>
