---
// A team around one piece of real work: the shared screening, who it's shared with, and what's just happened on it.
import Art from "./Art.astro";
import Arrow from "./Arrow.astro";
import Device from "./Device.astro";
import Icon from "./Icon.astro";
import { APP } from "../data/site.mjs";
const Person = `<svg viewBox="0 0 24 24" fill="#0a1a3f" aria-hidden="true"><circle cx="12" cy="9" r="4"/><path d="M4 21c1-5 4-7 8-7s7 2 8 7z"/></svg>`;
const feed = [["Maya Chen", "changed an answer", "#34d399"], ["The assistant", "finished an extraction", "#67e8f9", true], ["Tomas Silva", "added papers to a collection", "#fbbf24"], ["Amina Bello", "shared it with a guest", "#fb7185"], ["Tomas Silva", "ran the screening again", "#fbbf24"]];
const people = [["Maya Chen", "Admin", "#34d399"], ["Tomas Silva", "Member", "#fbbf24"], ["Amina Bello", "Member", "#fb7185"], ["Lena Roth", "Guest", "#93c5fd"]];
---
<section class="bleed thero" style="--tint:#047857" id="activity">
  <Art name="team-merge" pos="50% 100%" eager />
  <div class="inner tin">
    <div class="tc"><h1>One workspace for your team's evidence</h1><p class="lead">Keep every search, screening and extraction in one place, see who did what, and stop passing spreadsheets around.</p><a class="btn" href={APP}>Bring your team in<Arrow /></a></div>
    <div class="ts">
      <Device class="lap" kind="laptop" name="screen" theme="light" eager alt="A shared screening with its progress, its questions and who ran it" sizes="(max-width: 900px) 61vw, 840px" />
      <div class="frost who" aria-label="People on this piece of work"><b>On this screening</b><ul>{people.map(([n, r, c]) => <li><i style={`--c:${c}`} set:html={Person} /><span>{n}</span><em>{r}</em></li>)}</ul></div>
      <div class="frost feed" data-feed aria-label="Recent activity"><b>Activity</b><ol>{feed.map(([n, w, c, ai], i) => <li class:list={{ hide: i > 3 }}><i style={`--c:${c}`}>{ai ? <Icon name="spark" size={16} /> : <span class="p" set:html={Person} />}</i><p><strong>{n}</strong> {w}</p></li>)}</ol></div>
    </div>
  </div>
</section>
<script>
  const feed = document.querySelector("[data-feed]");
  if (feed) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const list = feed.querySelector("ol"), root = feed.closest(".thero");
    let seen = false; new IntersectionObserver(([e]) => (seen = e.isIntersecting)).observe(root);
    setInterval(() => { if (!seen || document.hidden || still.matches) return; const last = list.lastElementChild; list.prepend(last); [...list.children].forEach((c, i) => c.classList.toggle("hide", i > 3)); last.animate([{ opacity: 0, transform: "translateY(-8px)" }, { opacity: 1, transform: "none" }], { duration: 450, easing: "ease-out" }); }, 3600);
  }
</script>
<style>
  .thero { background: #032630; padding-block: clamp(104px, 8.4vw, 124px) clamp(32px, 4vw, 56px); --g: 3 28 36; } .thero::after { display: none; } .thero :global(.art) { z-index: -2; }
  .tin { display: grid; gap: clamp(28px, 3.4vw, 44px); justify-items: center; text-align: center; }
  .tc { display: grid; gap: 18px; justify-items: center; max-width: 780px; } .tc h1 { font-size: clamp(40px, 4.8vw, 68px); } .tc .lead { max-width: 34em; opacity: .92; }
  .tc > * { animation: t-up .8s var(--ease) both; } .tc > :nth-child(2) { animation-delay: .06s; } .tc > :nth-child(3) { animation-delay: .12s; } @keyframes t-up { from { opacity: 0; transform: translateY(18px); } }
  .ts { position: relative; width: 100%; max-width: 1100px; display: grid; justify-items: center; text-align: left; animation: t-up .9s .16s var(--ease) both; } .ts :global(.lap) { width: min(76%, 840px); }
  .frost { position: absolute; z-index: 2; padding: 14px 14px 10px; font-size: 14px; background: rgb(3 28 36 / .92); } .frost > b { display: block; font-weight: 500; font-size: 15px; margin-bottom: 8px; }
  li > i { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--c); color: #0a1a3f; } li > i :global(svg), .p :global(svg) { width: 16px; height: 16px; } .p { display: grid; }
  .who { left: 0; top: 18%; width: 236px; } .who ul { display: grid; gap: 8px; margin-bottom: 4px; } .who li { display: flex; align-items: center; gap: 10px; white-space: nowrap; } .who em { margin-left: auto; font-style: normal; font: 400 12px/1 var(--mono); opacity: .78; }
  .feed { right: 0; top: 40%; width: 384px; } .feed ol { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin-bottom: 4px; } .feed li { display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: center; gap: 10px; min-height: 30px; } .feed li.hide { display: none; } .feed p { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; } .feed strong { font-weight: 500; }
  @media (max-width: 1100px) { .ts :global(.lap) { width: 100%; } .who { display: none; } .feed { right: 12px; top: auto; bottom: 12%; width: 340px; } }
  @media (max-width: 700px) { .ts { gap: 12px; } .feed { position: static; width: 100%; } .feed p { white-space: normal; } }
</style>
