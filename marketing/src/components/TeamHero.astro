---
// A team around one piece of real work: the shared screening, who it's shared with, and what's just happened on it.
import Art from "./Art.astro";
import Arrow from "./Arrow.astro";
import Device from "./Device.astro";
import Icon from "./Icon.astro";
import { APP } from "../data/site.mjs";
const Person = `<svg viewBox="0 0 24 24" fill="#0a1a3f" aria-hidden="true"><circle cx="12" cy="9" r="4"/><path d="M4 21c1-5 4-7 8-7s7 2 8 7z"/></svg>`;
const feed = [["Maya Chen", "changed an answer", "#34d399"], ["The assistant", "finished an extraction", "#67e8f9", true], ["Tomas Silva", "added papers to a collection", "#fbbf24"], ["Amina Bello", "shared it with a guest", "#fb7185"], ["Tomas Silva", "ran the screening again", "#fbbf24"], ["Lena Roth", "rated the first ten papers", "#93c5fd"]];
---
<section class="bleed thero" style="--tint:#047857" id="activity">
  <Art name="team-merge" pos="50% 100%" eager />
  <div class="inner tin">
    <div class="tc"><h1>One workspace for your team's evidence</h1><p class="lead">Keep every search, screening and extraction in one place, see who did what, and stop passing spreadsheets around.</p><a class="btn" href={APP}>Bring your team in<Arrow /></a></div>
    <div class="ts">
      <Device class="lap" kind="laptop" name="screen" theme="light" eager alt="A shared screening with its progress, its questions and who ran it" sizes="(max-width: 900px) 94vw, 980px" />
    </div>
  </div>
  <div class="ticker" aria-label="Recent activity on this screening"><ol>{[0, 1].map((copy) => feed.map(([n, w, c, ai]) => <li aria-hidden={copy ? "true" : undefined}><i style={`--c:${c}`}>{ai ? <Icon name="spark" size={16} /> : <span class="p" set:html={Person} />}</i><p><strong>{n}</strong> {w}</p></li>))}</ol></div>
</section>
<style>
  .thero { background: #032630; padding-block: clamp(104px, 8.4vw, 124px) clamp(32px, 4vw, 56px); --g: 3 28 36; } .thero::after { display: none; } .thero :global(.art) { z-index: -2; -webkit-mask-image: linear-gradient(#000 calc(100% - 170px), transparent calc(100% - 110px)); mask-image: linear-gradient(#000 calc(100% - 170px), transparent calc(100% - 110px)); }
  .tin { display: grid; gap: clamp(28px, 3.4vw, 44px); justify-items: center; text-align: center; }
  .tc { display: grid; gap: 18px; justify-items: center; max-width: 1040px; } .tc h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -.03em; } .tc .lead { max-width: 34em; opacity: .92; }
  .tc > * { animation: t-up .8s var(--ease) both; } .tc > :nth-child(2) { animation-delay: .06s; } .tc > :nth-child(3) { animation-delay: .12s; } @keyframes t-up { from { opacity: 0; transform: translateY(18px); } }
  .ts { position: relative; width: 100%; max-width: 1100px; display: grid; justify-items: center; text-align: left; animation: t-up .9s .16s var(--ease) both; } .ts :global(.lap) { width: min(88%, 980px); }
  /* The team's work runs past under the screen in one line, and nothing floats over the product. */
  .ticker { margin-top: clamp(18px, 2.4vw, 32px); overflow: clip; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); } .ticker ol { display: flex; width: max-content; gap: 34px; animation: tick 46s linear infinite; } .ticker:hover ol { animation-play-state: paused; } @keyframes tick { to { transform: translateX(calc(-50% - 17px)); } } .ticker li { display: flex; align-items: center; gap: 10px; white-space: nowrap; font-size: 15px; } .ticker strong { font-weight: 500; } .ticker li > i { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--c); color: #0a1a3f; } .ticker li > i :global(svg), .p :global(svg) { width: 16px; height: 16px; } .p { display: grid; }
  /* Wide screens: the words on the left and the real screen running off the right edge, with the ribbons filling the page behind. */
  @media (min-width: 1101px) { .thero { padding-block: clamp(96px, 7.6vw, 120px) clamp(28px, 3vw, 44px); } .thero :global(.art) { left: 30vw; right: -30vw; bottom: 90px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%), linear-gradient(#000 calc(100% - 60px), transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 16%), linear-gradient(#000 calc(100% - 60px), transparent); mask-composite: intersect; } .tin { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; justify-items: start; text-align: left; } .tc { justify-items: start; } .tc h1 { font-size: clamp(42px, 4.5vw, 72px); text-wrap: balance; } .ts { width: 128%; max-width: none; justify-items: start; } .ts :global(.lap) { width: 100%; } .ticker { position: relative; z-index: 1; } }
  @media (max-width: 1100px) { .ts :global(.lap) { width: 100%; } }
</style>
