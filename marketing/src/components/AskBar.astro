---
import { APP } from "../data/site.mjs";
const { id = "ask", key = "sun", chips = [] } = Astro.props;
const CHIP = ["#FFE14D", "#8FD0FF", "#7DF0B4", "#FFB3DC", "#FFC56B"];
---
<div class="wrap">
  <form class="ask" data-ask action={`${APP}/results`} method="get" role="search">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5L21 21" /></svg>
    <label class="sr" for={id}>Ask a research question</label>
    <input id={id} name="q" autocomplete="off" required data-ask-input placeholder="Does peer tutoring help reading?" />
    <button class:list={["key", key]}>Ask<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg></button>
  </form>
  {chips.length > 0 && <div class="chips">{chips.map((c, i) => <button type="button" data-chip style={`--c:${CHIP[i % 5]};--tilt:${[-1.5, 1, -.5, 1.5][i % 4]}deg`}>{c}</button>)}</div>}
</div>
<script>
  // The app reads `q` as keywords: words that only make it a sentence would narrow the search to almost nothing.
  const FILLER = /^(a|an|and|are|as|at|be|by|can|did|do|does|for|from|good|has|have|how|if|in|is|it|of|on|or|really|than|that|the|their|there|these|this|to|was|were|what|when|where|which|who|why|will|with|would)$/i;
  for (const form of document.querySelectorAll("[data-ask]")) form.addEventListener("submit", (e) => { const input = form.querySelector("input"), words = input.value.replace(/[?.!,]/g, " ").split(/\s+/).filter((w) => w && !FILLER.test(w)); if (!words.length) return; e.preventDefault(); location.href = `${form.action}?q=${encodeURIComponent(words.join(" "))}`; });
  for (const c of document.querySelectorAll("[data-chip]")) c.addEventListener("click", () => { const input = c.closest(".wrap").querySelector("input"); input.value = c.textContent; input.focus(); });
</script>
<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; width: min(620px, 100%); min-width: 0; }
  .ask { display: flex; align-items: center; gap: 12px; padding: 8px 12px 13px 18px; border-radius: 20px; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line), 0 18px 40px -18px rgb(11 16 32 / .5); }
  .ask > svg { flex: none; color: var(--t3); }
  input { flex: 1; min-width: 0; height: 52px; background: none; border: 0; outline: 0; font-size: clamp(16px, 1.5vw, 19px); font-weight: 500; } input::placeholder { color: var(--t3); font-weight: 400; }
  .ask:focus-within { box-shadow: 0 0 0 3px var(--ink), 0 18px 40px -18px rgb(11 16 32 / .5); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; } [data-chip] { padding: 7px 12px; border-radius: 10px; background: var(--c); color: var(--ink); font-size: 14px; font-weight: 500; rotate: var(--tilt); transition: rotate .2s var(--ease), translate .2s var(--ease); } [data-chip]:hover { rotate: 0deg; translate: 0 -2px; }
  @media (max-width: 500px) { .ask { padding-left: 14px; gap: 6px; } .ask > svg { display: none; } .ask .key { padding-inline: 16px; } }
</style>
