---
// The prompt pattern: a question for a headline, and the box to answer it, with the real product rising underneath.
import Art from "./Art.astro";
import AskBar from "./AskBar.astro";
import Device from "./Device.astro";
const tries = ["What keeps girls in secondary school?", "Do cash transfers improve child nutrition?", "How does wealth inequality affect social mobility?"];
---
<section class="bleed hero">
  <Art name="aurora" eager />
  <div class="inner in">
    <h1>What does the evidence say?</h1>
    <p class="lead">The evidence workspace for research teams, from your first search to your published evidence</p>
    <AskBar id="ask-hero" class="big" typing />
    <div class="tries" data-tries>{tries.map((t) => <button type="button" data-q={t}>{t}</button>)}</div>
  </div>
  <div class="rise"><Device kind="laptop" name="search" theme="dark" eager alt="OpenScholar's search results, with an overview of the field and a chart of papers per year" sizes="(max-width: 900px) 94vw, 1040px" /></div>
</section>
<script>
  for (const b of document.querySelectorAll("[data-tries] button")) b.addEventListener("click", () => { const form = document.querySelector("#ask-hero").closest("form"); form.querySelector("input").value = b.dataset.q; form.requestSubmit(); });
</script>
<style>
  .hero { background: #040b2e; padding-top: clamp(116px, 10vw, 148px); text-align: center; overflow: clip; }
  .hero > :global(.art) { inset: -5.6vw -30% auto; height: 74vw; z-index: -2; animation: dawn 1.6s var(--ease) both; } @keyframes dawn { from { opacity: 0; transform: scale(1.04); } }
  .hero::before { content: ""; position: absolute; z-index: -1; left: 50%; top: 96px; width: min(1040px, 100%); height: 400px; translate: -50% 0; background: radial-gradient(closest-side, #040b2e 62%, rgb(4 11 46 / 0)); }
  .in { display: grid; justify-items: center; gap: 18px; } h1 { max-width: 9em; font-size: clamp(42px, 5vw, 76px); line-height: 1.02; animation: up .9s var(--ease) both; } .lead { max-width: 34em; opacity: .9; animation: up .9s .07s var(--ease) both; }
  .in :global(.big) { width: min(100%, 680px); margin-top: 10px; animation: up .9s .14s var(--ease) both; }
  .tries { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; animation: up .9s .2s var(--ease) both; } .tries button { padding: 7px 13px; border-radius: 10px; background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14); color: rgb(255 255 255 / .86); font-size: 14px; transition: background-color .15s var(--ease), color .15s var(--ease); } .tries button:hover { background: rgb(255 255 255 / .18); color: #fff; }
  .rise { width: min(92%, 1040px); margin: clamp(32px, 3.6vw, 52px) auto 0; height: clamp(250px, 30vw, 440px); overflow: clip visible; perspective: 1800px; -webkit-mask-image: linear-gradient(#000 76%, transparent); mask-image: linear-gradient(#000 76%, transparent); animation: up 1.1s .26s var(--ease) both; }
  @supports (animation-timeline: scroll()) { .rise :global(.dev) { transform-origin: 50% 0; animation: settle linear both; animation-timeline: scroll(root); animation-range: 0 480px; } @keyframes settle { from { transform: rotateX(9deg); } to { transform: none; } } }
  @keyframes up { from { opacity: 0; transform: translateY(20px); } }
  @media (max-width: 700px) { .hero { padding-top: 112px; } .hero > :global(.art) { inset: 0 -50% auto; height: 440px; } .hero > :global(.art img) { object-position: 50% 0; } .hero::before { top: 60px; height: 360px; } .tries button:nth-child(n + 2) { display: none; } .rise { height: 56vw; } }
</style>
