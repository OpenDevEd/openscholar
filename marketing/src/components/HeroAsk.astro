---
// The prompt hero: a question for a headline and the box to answer it. Its art, light and what sits below can change.
import Art from "./Art.astro";
import AskBar from "./AskBar.astro";
import Device from "./Device.astro";
import Arrow from "./Arrow.astro";
import { COMMUNITIES } from "../data/site.mjs";
const { art = "aurora", look = "arch", light = false, below = "laptop" } = Astro.props;
const line = "The evidence workspace for research teams, from your first search to your published evidence";
const bars = [5, 6, 3, 5, 4, 6, 7, 6, 7, 6, 11, 8, 14, 6, 9, 8, 10, 22];
const papers = [
  { t: ["Peer tutoring", " in ", "reading", " in Scotland: thinking big"], y: 2011, who: "Keith James Topping, David Miller, Allen Thurston and others", a: ["A large-scale randomised-controlled trial of ", "reading", " tutoring in 80 schools in Scotland used the Paired Reading technique."], cited: 50 },
  { t: ["Fostering ", "reading", " comprehension in fifth grade by explicit instruction in ", "reading", " strategies and ", "peer tutoring"], y: 2004, who: "Sofie Van Keer", a: ["A Flemish study comparing explicit strategy instruction with same-age and cross-age ", "peer tutoring", "."], cited: 116 },
];
const hl = (s) => (s === "reading" ? "k2" : s.toLowerCase() === "peer tutoring" ? "k1" : "");
---
<section class:list={["bleed", "hero", look, { light }]}>
  <Art name={art} eager />
  {look === "slot" ? <div class="inner in">
    <h1>What does the evidence say?</h1>
    <AskBar id="ask-hero" class="big" typing />
    <div class="after"><p class="lead">{line}</p><nav class="comms" aria-label="Live Evidence Communities"><span>Live Evidence Communities</span><ul>{COMMUNITIES.map(([t, u, c, d], i) => <li style={`--c:${c};--i:${i}`}><a href={u}><i aria-hidden="true"></i><b>{t}</b><em>{d}</em><Arrow /></a></li>)}</ul></nav></div>
  </div> : <div class="inner in">
    <h1>What does the evidence say?</h1>
    <p class="lead">{line}</p>
    <AskBar id="ask-hero" class="big" typing />
    <nav class="comms" aria-label="Live Evidence Communities"><span>Live Evidence Communities</span><ul>{COMMUNITIES.map(([t, u, c, d], i) => <li style={`--c:${c};--i:${i}`}><a href={u}><i aria-hidden="true"></i><b>{t}</b><em>{d}</em><Arrow /></a></li>)}</ul></nav>
  </div>}
  {below === "laptop" && <div class="rise"><Device kind="laptop" name="search" theme={light ? "light" : "dark"} eager alt="OpenScholar's search results, with an overview of the field and a chart of papers per year" sizes="(max-width: 900px) 94vw, 1040px" /></div>}
  {below === "results" && <div class="inner res-w"><div class="res" aria-label="What a search returns">
    <article class="ov" style="--i:0"><header><span class="pill">Overview</span><span>Read 5 papers</span></header><p>Your search covers peer tutoring in reading: <b>829 papers</b> from 1997 to 2026. Psychology holds the most, with 441, followed by social sciences at 212.</p><div class="bars" aria-hidden="true">{bars.map((h, i) => <i style={`height:${(h / 22) * 100}%;--b:${i}`} class:list={{ top: i === bars.length - 1 }}></i>)}</div></article>
    {papers.map((p, i) => <article class="pp" style={`--i:${i + 1}`}><h2>{p.t.map((s) => (hl(s) ? <mark class={hl(s)}>{s}</mark> : s))} <span>({p.y})</span></h2><em>{p.who}</em><p>{p.a.map((s) => (hl(s) ? <mark class={hl(s)}>{s}</mark> : s))}</p><u>Cited by {p.cited}</u></article>)}
  </div></div>}
</section>
<style>
  .hero { --bg: #040b2e; background: var(--bg); padding-top: clamp(116px, 10vw, 148px); text-align: center; overflow: clip; }
  .hero > :global(.art) { inset: -5.6vw -30% auto; height: 74vw; z-index: -2; animation: dawn 1.6s var(--ease) both; } @keyframes dawn { from { opacity: 0; transform: scale(1.04); } }
  .hero::before { content: ""; position: absolute; z-index: -1; left: 50%; top: 96px; width: min(1040px, 100%); height: 400px; translate: -50% 0; background: radial-gradient(closest-side, var(--bg) 62%, transparent); }
  .in { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 18px; } h1 { max-width: 9em; font-size: clamp(42px, 5vw, 76px); line-height: 1.02; animation: up .9s var(--ease) both; } .lead { max-width: 34em; opacity: .9; animation: up .9s .07s var(--ease) both; }
  .in :global(.big) { width: min(100%, 680px); margin-top: 10px; animation: up .9s .14s var(--ease) both; }
  /* Our communities stand where other sites put customer logos. */
  .comms { display: grid; justify-items: center; gap: 10px; width: min(100%, 1120px); margin-top: 10px; text-align: left; animation: up .9s .2s var(--ease) both; } .comms > span { font-size: 14px; opacity: .72; }
  .comms ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; border-radius: 20px; overflow: hidden; background: rgb(10 16 56 / .86); -webkit-backdrop-filter: blur(20px) saturate(1.4); backdrop-filter: blur(20px) saturate(1.4); box-shadow: inset 0 1px 0 rgb(255 255 255 / .18), inset 0 0 0 1px rgb(255 255 255 / .1); }
  .comms li { display: grid; box-shadow: inset 1px 0 0 rgb(255 255 255 / .08), inset 0 1px 0 rgb(255 255 255 / .08); } .comms li:nth-child(3n + 1) { box-shadow: inset 0 1px 0 rgb(255 255 255 / .08); } .comms li:nth-child(-n + 3) { box-shadow: inset 1px 0 0 rgb(255 255 255 / .08); } .comms li:first-child { box-shadow: none; }
  .comms a { position: relative; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 4px 10px; align-content: start; padding: 16px 40px 16px 16px; color: #fff; transition: background-color .2s var(--ease); } .comms a:hover { background: color-mix(in srgb, var(--c) 16%, transparent); }
  .comms a > i:first-child { width: 22px; height: 22px; background: var(--c); -webkit-mask: url(/favicon.svg) center / contain no-repeat; mask: url(/favicon.svg) center / contain no-repeat; transition: rotate .4s var(--ease); } .comms a:hover > i:first-child { rotate: -14deg; }
  .comms b { font-weight: 500; font-size: 15px; line-height: 1.25; } .comms em { grid-column: 2; font-style: normal; font-size: 13.500px; line-height: 1.35; color: rgb(255 255 255 / .76); }
  .comms a > :global(i:last-child) { position: absolute; right: 14px; top: 16px; display: grid; color: var(--c); opacity: 0; transform: translateX(-6px); transition: opacity .2s var(--ease), transform .25s var(--ease); } .comms a:hover > :global(i:last-child) { opacity: 1; transform: none; }
  .light .comms ul { background: rgb(255 255 255 / .9); box-shadow: 0 0 0 1px var(--line2), 0 30px 60px -36px rgb(10 26 63 / .5); } .light .comms li { box-shadow: inset 1px 0 0 var(--line), inset 0 1px 0 var(--line); } .light .comms li:nth-child(3n + 1) { box-shadow: inset 0 1px 0 var(--line); } .light .comms li:nth-child(-n + 3) { box-shadow: inset 1px 0 0 var(--line); } .light .comms li:first-child { box-shadow: none; } .light .comms a { color: var(--ink); } .light .comms em { color: var(--t2); } .light .comms a:hover { background: color-mix(in srgb, var(--c) 14%, #fff); } .light .comms a > :global(i:last-child) { color: var(--ink); }
  .rise { width: min(92%, 1040px); margin: clamp(32px, 3.6vw, 52px) auto 0; height: clamp(220px, 24vw, 340px); overflow: clip visible; perspective: 1800px; -webkit-mask-image: linear-gradient(#000 76%, transparent); mask-image: linear-gradient(#000 76%, transparent); animation: up 1.1s .26s var(--ease) both; }
  @supports (animation-timeline: scroll()) { .rise :global(.dev) { transform-origin: 50% 0; animation: settle linear both; animation-timeline: scroll(root); animation-range: 0 480px; } @keyframes settle { from { transform: rotateX(9deg); } to { transform: none; } } }
  @keyframes up { from { opacity: 0; transform: translateY(20px); } }

  /* Daylight: the same idea on white, with the light product. */
  .light { --bg: #fff; color: var(--ink); } .light > :global(.art) { inset: -1vw -12% auto; height: 58vw; -webkit-mask-image: linear-gradient(#000 72%, transparent); mask-image: linear-gradient(#000 72%, transparent); } .light::before { top: 120px; height: 360px; } .light .lead { color: var(--t2); opacity: 1; } .light .in :global(.big) { box-shadow: 0 0 0 1px var(--line2), 0 30px 60px -28px rgb(37 99 235 / .55); }

  /* Bowl: two streams come down the sides and meet where the product starts. */
  .bowl > :global(.art) { inset: 0 0 auto; height: calc(100% - clamp(200px, 25vw, 360px)); } .bowl > :global(.art img) { object-position: 50% 100%; } .bowl > :global(.art) { -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent); } .bowl::before { display: none; }

  /* Slot: the literature comes in from both sides and meets at the box, which sits at the exact middle. Nothing else on the screen. */
  .slot { padding: 0; } .slot > :global(.art) { inset: 0 0 auto; height: 100svh; -webkit-mask-image: linear-gradient(#000 84%, transparent); mask-image: linear-gradient(#000 84%, transparent); } .slot::before { display: none; } .slot .in { padding-block: 92px 56px; grid-template-rows: max(216px, calc(50svh - 132px)) auto auto; gap: 0; } .slot h1 { align-self: end; margin-bottom: clamp(28px, 5vh, 52px); font-size: clamp(42px, 5.4vw, 80px); } .slot .in :global(.big) { width: min(100%, 780px); margin: 0; } .slot .in :global(.big input) { height: 68px; font-size: 19px; } .after { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; align-content: start; gap: 14px; padding-top: clamp(20px, 3.4vh, 32px); animation: up .9s .2s var(--ease) both; } .after .lead { max-width: 28em; } .slot .after { width: 100%; } .after .comms { margin: 8px auto 0; }

  /* Results: what a search returns, set straight on the page instead of in a device. */
  .res-w { margin-top: clamp(32px, 3.6vw, 52px); text-align: left; } .res { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr); gap: 12px; height: clamp(250px, 24vw, 330px); -webkit-mask-image: linear-gradient(#000 74%, transparent); mask-image: linear-gradient(#000 74%, transparent); }
  .res article { display: grid; align-content: start; gap: 10px; padding: 18px 20px; border-radius: 18px 18px 0 0; background: rgb(14 22 62 / .86); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1); font-size: 14px; line-height: 1.4; animation: up .9s calc(.28s + var(--i) * .1s) var(--ease) both; } .ov header { display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: rgb(255 255 255 / .7); } .pill { padding: 4px 10px; border-radius: 8px; background: rgb(255 255 255 / .14); color: #fff; } .ov p { font-size: 15px; } .ov b { font-weight: 500; color: #7dd3fc; }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 92px; } .bars i { flex: 1; border-radius: 3px 3px 0 0; background: rgb(56 189 248 / .4); transform-origin: bottom; animation: grow .7s var(--ease) calc(.5s + var(--b) * 26ms) both; } .bars .top { background: #38bdf8; } @keyframes grow { from { transform: scaleY(0); } }
  .pp h2 { font-size: 17px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; } .pp h2 span { font-weight: 400; opacity: .7; } .pp em { font-style: normal; font-size: 13px; opacity: .7; } .pp u { justify-self: start; padding: 4px 9px; border-radius: 8px; background: rgb(251 146 60 / .18); color: #fdba74; font-size: 13px; text-decoration: none; } mark { color: inherit; border-radius: 3px; padding-inline: 2px; } .k1 { background: rgb(253 224 138 / .28); color: #fde68a; } .k2 { background: rgb(125 211 252 / .24); color: #bae6fd; }

  @media (max-width: 900px) { .res { grid-template-columns: minmax(0, 1fr); height: auto; max-height: 520px; overflow: clip; } }
  @media (max-width: 960px) { .comms ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } .comms li, .comms li:nth-child(n), .light .comms li:nth-child(n) { box-shadow: inset 0 1px 0 rgb(255 255 255 / .08); } .comms li:nth-child(even) { box-shadow: inset 1px 0 0 rgb(255 255 255 / .08), inset 0 1px 0 rgb(255 255 255 / .08); } }
  /* On phones the communities become a row you swipe, so the hero stays short. */
  @media (max-width: 700px) { .comms { width: 100vw; margin-inline: calc(50% - 50vw); } .comms ul { display: flex; gap: 10px; padding-inline: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none; background: none; box-shadow: none; border-radius: 0; -webkit-backdrop-filter: none; backdrop-filter: none; } .comms li, .comms li:nth-child(n), .light .comms li:nth-child(n) { flex: 0 0 82%; scroll-snap-align: start; border-radius: 16px; background: rgb(10 16 56 / .9); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12); } .light .comms li:nth-child(n) { background: #fff; box-shadow: inset 0 0 0 1px var(--line2); } .hero { padding-top: 112px; } .arch > :global(.art) { inset: 0 -50% auto; height: 440px; } .arch > :global(.art img) { object-position: 50% 0; } .arch::before { top: 104px; height: 340px; } .rise { height: 56vw; } .slot { padding-top: 0; } .slot > :global(.art) { inset: 6% -60% auto; } .slot .in :global(.big input) { height: 52px; font-size: 16px; } .slot .in { grid-template-rows: auto auto auto; } .slot > :global(.art) { height: 62%; } .slot .after { padding-top: 24px; } }
</style>
