---
// The top of a product page: one photograph from the observatory, with the headline on its dark side.
import { existsSync } from "node:fs";
import Img from "./Img.astro";
const { scene, alt, title, lead, primary, secondary, high = false } = Astro.props;
const has = existsSync(`public/img/scene-${scene}-1672.avif`);
---
<section class:list={["scene", { high }]}>
  {has && <Img class="scene-img" name={`scene-${scene}`} widths={[1672, 1200]} ratio={16 / 9} alt={alt} priority />}
  <div class="wrap scene-copy enter">
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="actions">
      {primary && <a class="btn primary" href={primary.href}>{primary.label}</a>}
      {secondary && <a class="btn quiet" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>
<style>
  .scene { position: relative; min-height: min(100svh, 860px); display: flex; align-items: center; overflow: clip; padding-block: 112px 80px; }
  :global(.scene-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; mask-image: linear-gradient(to bottom, #000 72%, transparent); }
  .scene-copy { position: relative; }
  .high { align-items: flex-start; min-height: 100svh; padding-top: 104px; }
  .high :global(.scene-img) { object-position: center bottom; }
  .high .lead { max-width: 44rem; }
  .high h1 { max-width: none; }
  .scene-copy h1 { max-width: 11.5em; font-size: clamp(40px, 5vw, 72px); }
  .scene-copy .lead { margin-top: 24px; }
  @media (max-width: 900px) { .scene, .high { display: block; min-height: 0; padding-block: 64px 32px; } :global(.scene-img) { position: static; height: auto; aspect-ratio: 16 / 9; object-position: 75% center; mask-image: none; } .scene-copy { margin-top: 16px; } }
</style>
