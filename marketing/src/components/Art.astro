---
// Big illustrations, cropped by the block's edge. Flat shapes from the product's world.
const { kind, class: cls = "", style = "" } = Astro.props;
const ART = {
  lens: `<circle cx="300" cy="190" r="170" fill="#fff"/><g clip-path="url(#l)"><rect x="150" y="90" width="300" height="34" rx="6" fill="#FFE14D"/><rect x="160" y="98" width="250" height="18" rx="4" fill="#0b1020"/><rect x="150" y="150" width="250" height="18" rx="4" fill="#0b1020" opacity=".22"/><rect x="150" y="194" width="300" height="34" rx="6" fill="#8FD0FF"/><rect x="160" y="202" width="210" height="18" rx="4" fill="#0b1020"/><rect x="150" y="254" width="280" height="18" rx="4" fill="#0b1020" opacity=".22"/></g><clipPath id="l"><circle cx="300" cy="190" r="170"/></clipPath><circle cx="300" cy="190" r="170" fill="none" stroke="#0b1020" stroke-width="30"/><path d="M178 312L40 450" stroke="#0b1020" stroke-width="58" stroke-linecap="round"/>`,
  marker: `<g transform="rotate(-32 300 200)"><rect x="-80" y="130" width="420" height="140" rx="20" fill="#FFD233"/><rect x="170" y="130" width="60" height="140" fill="#0b1020"/><path d="M340 142l90 26v64l-90 26z" fill="#fff"/><path d="M430 176l44 12v24l-44 12z" fill="#FFE14D"/></g><path d="M420 330C 500 300 560 320 640 290" stroke="#FFE14D" stroke-width="46" stroke-linecap="round" fill="none"/>`,
  door: `<rect x="90" y="30" width="330" height="480" rx="14" fill="#0b1020"/><rect x="118" y="58" width="274" height="452" fill="#FFD233"/><rect x="146" y="92" width="218" height="74" rx="8" fill="#fff"/><rect x="164" y="112" width="150" height="14" rx="4" fill="#0b1020"/><rect x="164" y="136" width="96" height="10" rx="4" fill="#0b1020" opacity=".4"/><rect x="146" y="190" width="218" height="130" rx="8" fill="#FF9C1A"/><rect x="146" y="344" width="218" height="130" rx="8" fill="#FF9C1A"/><circle cx="342" cy="330" r="15" fill="#0b1020"/>`,
};
---
<svg class:list={["art", cls]} style={style} viewBox={kind === "door" ? "0 0 500 520" : "0 0 640 500"} aria-hidden="true" set:html={ART[kind]} />
<style>.art { position: absolute; z-index: -1; pointer-events: none; height: auto; }</style>
