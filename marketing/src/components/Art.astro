---
// Generated art. It paints instantly from the image; `live` wakes it up with the shader in scripts/live.js where the device can spare it.
const { name, live = false, eager = false, pos, class: cls = "", style } = Astro.props;
---
<div class:list={["art", cls]} data-live={live ? pos ?? "" : undefined} aria-hidden="true" style={style}><img src={`/img/art-${name}.avif`} srcset={`/img/art-${name}-960.avif 960w, /img/art-${name}.avif 1672w`} sizes="100vw" width="1672" height="941" alt="" decoding="async" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} style={pos ? `object-position:${pos}` : undefined} /></div>
