---
// The product in one loop: papers are read, the sentence that matters lights up, and a cited answer streams back. Without animation it rests on the finished answer.
const papers = [
  { c: "#FFE14D", title: "Paired Reading in Spanish in Colombia", who: "Thurston, 2023", before: "", lit: "Results indicated that Paired Reading could be an effective, low-cost strategy for improving reading.", after: "" },
  { c: "#7DF0B4", title: "Peer Tutoring for Tutors and Tutees", who: "Thurston, 2021", before: "Gains were ", lit: "significantly greater on independent standardised reading comprehension tests", after: " than in comparison classes." },
  { c: "#FFB3DC", title: "Peer tutoring in reading in Scotland", who: "Topping, 2011", before: "On short-term evaluation, ", lit: "pupils did significantly better than control pupils", after: " in both years." },
];
const answer = [["Yes, in the trials here. ", null], ["Paired Reading could be an effective, low-cost way to improve reading", "#FFE14D"], [", with ", null], ["greater gains on comprehension tests", "#7DF0B4"], [" and ", null], ["better results than control pupils", "#FFB3DC"], [".", null]];
let n = 0;
const runs = answer.map(([t, m]) => ({ m, words: t.split(/(?<= )/).map((w) => ({ w, i: n++ })) }));
---
<div class="scene" aria-hidden="true">
  <div class="cards">{papers.map((p, i) => <article style={`--c:${p.c};--i:${i}`}><i class="tab"></i><b>{p.title}</b><span>{p.who}</span><p>{p.before}<mark>{p.lit}</mark>{p.after}</p></article>)}</div>
  <div class="threads">{papers.map((p, i) => <i style={`--c:${p.c};--i:${i}`}></i>)}</div>
  <div class="answer"><p class="q">Does peer tutoring help reading?</p><p class="a">{runs.map((r) => r.m ? <mark style={`--m:${r.m}`}>{r.words.map(({ w, i }) => <span style={`--w:${i}`}>{w}</span>)}</mark> : r.words.map(({ w, i }) => <span style={`--w:${i}`}>{w}</span>))}</p><div class="refs">{papers.map((p) => <em style={`--m:${p.c}`}>{p.who}</em>)}</div></div>
</div>
<style>
  .scene { position: absolute; inset: 0 0 0 auto; width: 47%; --d: 12s; display: flex; flex-direction: column; justify-content: center; padding: 24px 24px 24px 12px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  article { overflow: hidden; height: 236px; padding-bottom: 10px; background: #fff; color: var(--ink); border-radius: 14px; box-shadow: 0 16px 28px -14px rgb(11 16 32 / .55); } article:nth-child(1) { rotate: -1.5deg; } article:nth-child(3) { rotate: 1.5deg; }
  .tab { display: block; height: 12px; background: var(--c); } article b { display: block; margin: 8px 10px 2px; font-size: 13px; line-height: 1.15; font-weight: 700; letter-spacing: -.015em; } article span { display: block; margin-inline: 10px; font-size: 11px; color: var(--t2); } article p { margin: 8px 10px 0; font-size: 12px; line-height: 1.35; color: var(--t2); }
  article mark { color: var(--ink); background: linear-gradient(var(--c), var(--c)) no-repeat 0 0 / 100% 100%; border-radius: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; animation: sweep var(--d) calc(var(--i) * .3s) var(--ease) infinite; }
  @keyframes sweep { 0% { background-size: 0 100%; } 8%, 92% { background-size: 100% 100%; } 98%, 100% { background-size: 0 100%; } }
  .threads { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; height: 34px; margin-block: 2px; position: relative; z-index: 0; } .threads i { justify-self: center; width: 6px; height: 100%; border-radius: 3px; background: var(--c); transform-origin: top; animation: down var(--d) calc(var(--i) * .3s) var(--ease) infinite; }
  @keyframes down { 0%, 6% { transform: scaleY(0); } 12%, 92% { transform: scaleY(1); } 98%, 100% { transform: scaleY(0); } }
  .answer { min-height: 208px; padding: 18px 20px; border-radius: 20px; background: #fff; color: var(--ink); box-shadow: 0 24px 40px -18px rgb(11 16 32 / .6); position: relative; }
  .q { font-size: 14px; color: var(--t2); margin-bottom: 6px; } .a { font-size: clamp(17px, 1.65vw, 22px); line-height: 1.22; letter-spacing: -.02em; font-weight: 500; } .a mark { color: inherit; background: var(--m); border-radius: 4px; padding-inline: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; animation: word var(--d) .9s linear infinite; }
  .a span { animation: word var(--d) calc(1.1s + var(--w) * .09s) linear infinite; } @keyframes word { 0% { opacity: 0; } 2%, 88% { opacity: 1; } 94%, 100% { opacity: 0; } }
  .refs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; animation: word var(--d) 4s linear infinite; } .refs em { font-style: normal; font-size: 12px; font-weight: 500; padding: 3px 8px; border-radius: 7px; background: var(--m); }
  @media (max-width: 900px) { .scene { position: relative; inset: auto; order: 2; width: auto; margin: 20px calc(var(--pad) * -.6) 0; padding: 0 0 20px; } article { height: 232px; } article b { font-size: 12px; } article p { font-size: 11.5px; } .answer { min-height: 214px; } }
</style>
