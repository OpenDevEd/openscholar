---
import data from "../data/search-default.json";
import { APP } from "../data/site.mjs";
const toggles = [["is_oa:true", "Open access", "oa=true"], ["has_abstract:true", "Has an abstract", "abs=true"], ["type:review", "Reviews", "review=true"], ["publication_year:>2019", "Since 2020", "yf=2020"]];

---

  <section class="console" data-console data-default={JSON.stringify(data)}>
    <div class="d-head"><h2>Try your question on the world's research</h2><p class="lead">Change the words, and the whole field redraws itself.</p></div>
    <form data-form role="search">
      <label class="sr" for="q">Search query</label>
      <div class="field"><div class="mirror" data-mirror aria-hidden="true"></div><input id="q" data-q value={data.q} spellcheck="false" autocomplete="off" /></div>
      <button class="go" aria-label="Search"><svg width="28" height="28" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg></button>
    </form>
    <div class="filters" role="group" aria-label="Filters">{toggles.map(([f, l, u]) => <button type="button" aria-pressed="false" data-filter={f} data-url={u}>{l}</button>)}</div>
    <div class="out" data-out>
      <div class="total"><a class="link" data-open href={`${APP}/results?q=${encodeURIComponent(data.q)}`}>Open this search in OpenScholar</a>
      </div>
      <div class="chart" data-chart aria-hidden="true"></div>
      <ol class="res" data-res></ol>
    </div>
    <p class="mono err" data-err hidden>That search didn't come back. Check the query, or try again in a moment.</p>
  </section>

  
<script>
  const root = document.querySelector("[data-console]"), q = root.querySelector("[data-q]"), mirror = root.querySelector("[data-mirror]"), chart = root.querySelector("[data-chart]"), res = root.querySelector("[data-res]"), err = root.querySelector("[data-err]"), open = root.querySelector("[data-open]");
  const API = "https://api.openalex.org/works", APP = open.href.split("/results")[0];
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  // Each term or group gets a colour, in the query and in the results.
  const COL = ["#ffc48a", "#8fd3ff", "#9ff0c0", "#ffd9e6"];
  const terms = () => (q.value.match(/"[^"]+"|\b(?!AND\b|OR\b|NOT\b)[\w-]{3,}/g) ?? []).map((t) => t.replace(/"/g, ""));
  const paint = () => { let i = 0; mirror.innerHTML = q.value.split(/("[^"]*"|\b(?:AND|OR|NOT)\b|\s+)/).map((p) => { if (!p) return ""; if (/^(AND|OR|NOT)$/.test(p)) return `<i class="op">${p}</i>`; if (!p.trim()) return p; if (!p.startsWith('"') && p.replace(/[()]/g, "").length < 3) return esc(p); return `<i style="color:${COL[i++ % 4]}">${esc(p)}</i>`; }).join(""); };
  const mark = (t) => { let s = esc(t); terms().forEach((w, i) => { s = s.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi"), `<mark style="color:${COL[i % 4]}">$1</mark>`); }); return s; };
  const draw = (years) => { const map = new Map(years), Y = Array.from({ length: 30 }, (_, i) => 1997 + i), max = Math.max(1, ...Y.map((y) => map.get(y) ?? 0)); if (!chart.children.length) chart.innerHTML = Y.map((y) => `<span data-y="${y}"><i></i></span>`).join("") ; Y.forEach((y, k) => { chart.children[k].firstChild.style.setProperty("--h", `${(map.get(y) ?? 0) / max * 100}%`); }); };
  const list = (r) => { res.innerHTML = r.map((x) => `<li><b>${mark(x.t)}</b><span class="mono">${esc(x.a || "")}${x.a ? "  " : ""}${x.y ?? ""}</span>${x.oa ? '<span class="mono c">Open access</span>' : ""}</li>`).join(""); };
  const render = (d) => { draw(d.years); list(d.results); };
  let token = 0, timer;
  async function run() {
    const mine = ++token, text = q.value.trim().replace(/,/g, " "); if (!text) { root.toggleAttribute("data-busy", false); return; } root.toggleAttribute("data-busy", true); err.hidden = true;
    const filters = [`title_and_abstract.search:${text}`, ...[...root.querySelectorAll('[data-filter][aria-pressed="true"]')].map((b) => b.dataset.filter)].join(",");
    open.href = `${APP}/results?q=${encodeURIComponent(q.value.trim())}${[...root.querySelectorAll('[data-filter][aria-pressed="true"]')].map((b) => `&${b.dataset.url}`).join("")}`;
    try {
      const [a, b] = await Promise.all([fetch(`${API}?${new URLSearchParams({ filter: filters, sort: "cited_by_count:desc", "per-page": "4", select: "id,display_name,publication_year,cited_by_count,authorships,open_access" })}`), fetch(`${API}?${new URLSearchParams({ filter: filters, group_by: "publication_year" })}`)]);
      if (!a.ok || !b.ok) throw new Error(`${a.status} ${b.status}`);
      const [ra, rb] = await Promise.all([a.json(), b.json()]); if (mine !== token) return;
      render({ count: ra.meta.count, years: rb.group_by.map((g) => [+g.key, g.count]), results: ra.results.map((x) => ({ t: x.display_name ?? "Untitled", y: x.publication_year, c: x.cited_by_count, a: x.authorships?.[0]?.author?.display_name ?? "", oa: x.open_access?.is_oa })) });
    } catch (e) { if (mine === token) { console.error("Search:", e); err.hidden = false; } }
    if (mine === token) root.toggleAttribute("data-busy", false);
  }
  const follow = () => { mirror.scrollLeft = q.scrollLeft; };
  q.addEventListener("scroll", follow, { passive: true }); q.addEventListener("keyup", follow); q.addEventListener("click", follow);
  q.addEventListener("input", () => { token++; paint(); follow(); clearTimeout(timer); timer = setTimeout(run, 650); });
  root.querySelector("[data-form]").addEventListener("submit", (e) => { e.preventDefault(); clearTimeout(timer); run(); });
  root.querySelectorAll("[data-filter]").forEach((b) => b.addEventListener("click", () => { b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") === "true" ? "false" : "true"); run(); }));
  paint(); const d0 = JSON.parse(root.dataset.default); draw(d0.years); list(d0.results.slice(0, 4));

</script>
<style is:global>
  [data-mirror] i { font-style: normal; } [data-mirror] .op { color: #6b7280; }
  [data-res] mark { background: none; }
  [data-chart] span { flex: 1; display: flex; align-items: flex-end; height: 100%; }
  [data-chart] i { display: block; width: 100%; height: 100%; background: linear-gradient(#fff, #60a5fa); -webkit-mask: radial-gradient(circle, #000 1.6px, transparent 2px) 50% 100%/7px 7px; mask: radial-gradient(circle, #000 1.6px, transparent 2px) 50% 100%/7px 7px; clip-path: inset(calc(100% - var(--h, 0%)) 0 0); transition: clip-path .6s var(--ease); }
  [data-chart] em { position: absolute; bottom: -22px; left: 0; font-style: normal; } [data-chart] em.r { left: auto; right: 0; }
  [data-res] li { padding-block: 14px; border-top: 1px solid var(--line); display: grid; gap: 2px; }
  [data-res] b { font-weight: 400; font-size: 16px; line-height: 22px; }
  [data-res] .mono { white-space: pre-wrap; }
</style>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .console { min-height: 100svh; padding: 112px var(--edge) 64px; display: flex; flex-direction: column; } .d-head .lead { margin-top: 16px; max-width: 40rem; }
  
  form { display: flex; align-items: center; gap: 16px; margin-top: 24px; padding: 12px 12px 12px 28px; border-radius: 28px; background: var(--s1); box-shadow: inset 0 0 0 1px var(--line2); }
  form:focus-within { box-shadow: inset 0 0 0 1.5px var(--pale); }
  .field { position: relative; flex: 1; min-width: 0; font: 500 clamp(26px, 4.4vw, 72px)/1.2 var(--sans); letter-spacing: -.03em; overflow: hidden; }
  .mirror, input { display: block; width: 100%; white-space: pre; font: inherit; letter-spacing: inherit; }
  .mirror { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  input { position: relative; background: none; border: 0; outline: 0; color: transparent; caret-color: #fff; padding: 0; }
  .go { flex: none; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50%; background: var(--t1); color: #000; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .filters button { height: 36px; padding-inline: 14px; border-radius: 10px; border: 1px solid var(--line2); font-size: 14px; color: var(--t2); transition: background-color .15s var(--ease), color .15s var(--ease); }
  .filters button:hover:not([aria-pressed="true"]) { color: var(--t1); }
  .filters [aria-pressed="true"] { background: var(--t1); color: #000; border-color: var(--t1); }
  .out { flex: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr; gap: 20px 64px; margin-top: 28px; transition: opacity .2s var(--ease); }
  [data-busy] .out { opacity: .55; }
  
  .chart { position: relative; grid-column: 1; display: flex; align-items: flex-end; gap: 4px; height: min(34svh, 340px); align-self: start; }
  .res { grid-column: 2; grid-row: 1 / 3; align-self: start; }
  .err { color: var(--warn); margin-top: 16px; }
  @media (max-width: 900px) { .out { grid-template-columns: minmax(0, 1fr); } .res { grid-column: 1; grid-row: auto; } .go { width: 44px; height: 44px; } }
</style>
