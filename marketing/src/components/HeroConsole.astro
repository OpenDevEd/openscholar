---
// The hero's console: ask a question and watch it become a query, a screening, a table and a cited answer. It plays by itself until someone takes over, and the question box at the top really searches.
import AskBar from "./AskBar.astro";
import Icon from "./Icon.astro";
const steps = [["Search", "search", "#38bdf8"], ["Screen", "sieve", "#34d399"], ["Extract", "table", "#fbbf24"], ["Answer", "spark", "#fb7185"]];
const bars = [5, 6, 3, 5, 4, 6, 7, 6, 7, 6, 11, 8, 14, 6, 9, 8, 10, 22];
const qs = [["Is it an intervention study?", 11, 1, 3], ["Is it about reading or literacy?", 15, 0, 0], ["Is it in primary school?", 13, 1, 1]];
const rows = [["Assessing the differential effects of peer tutoring", "294 students aged 11 to 13", 90], ["Effect of peer tutoring for boys in French immersion", "Boys at a school in Vancouver", 85], ["Primary prevention of reading failure", "Kindergarten to Grade 3", 40]];
---
<div class="hc" data-hc>
  <AskBar id="ask-hero" class="big" typing />
  <div class="st-tabs" role="tablist" aria-label="See what happens to your question">{steps.map(([t, ic, c], i) => <button type="button" role="tab" id={`hc-t${i}`} aria-controls={`hc-p${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} style={`--c:${c}`}><Icon name={ic} size={16} /><span>{t}</span><u aria-hidden="true"></u></button>)}</div>
  <div class="st">
    <div class="p p0 on" id="hc-p0" role="tabpanel" aria-labelledby="hc-t0">
      <div class="q"><span>OpenScholar searches</span><p><b class="k1">"peer tutoring"</b> <i>AND</i> <b class="k2">reading</b></p></div>
      <div class="chart"><div class="n"><strong>829</strong> papers, 1997 to 2026</div><div class="bars" aria-hidden="true">{bars.map((h, i) => <i style={`height:${(h / 22) * 100}%;--i:${i}`} class:list={{ top: i === bars.length - 1 }}></i>)}</div></div>
    </div>
    <div class="p p1" id="hc-p1" role="tabpanel" aria-labelledby="hc-t1">
      <ol class="crit">{qs.map(([q, y, u, n], i) => <li style={`--i:${i}`}><span>{q}</span><em aria-label={`${y} yes, ${u} unclear, ${n} no`}><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></em></li>)}</ol>
      <div class="wall"><div class="n"><strong>14</strong> of 15 included</div><div class="tiles" aria-hidden="true">{Array.from({ length: 15 }, (_, i) => <i style={`--i:${i}`} class:list={{ amber: i === 9 }}><Icon name={i === 9 ? "flagq" : "check"} size={14} /></i>)}</div></div>
    </div>
    <div class="p p2" id="hc-p2" role="tabpanel" aria-labelledby="hc-t2">
      <div class="tb" role="table" aria-label="Answers extracted from papers"><div class="tr th" role="row"><span role="columnheader">Paper</span><span role="columnheader">Who took part?</span><span role="columnheader">Confidence</span></div>{rows.map(([t, w, c], i) => <div class="tr" role="row" style={`--i:${i}`}><span role="cell">{t}</span><span role="cell" class="v">{w}</span><span role="cell" class="cf"><u style={`--w:${c}%;--b:${c >= 85 ? "#34d399" : "#f87171"}`}></u>{c}%</span></div>)}</div>
    </div>
    <div class="p p3" id="hc-p3" role="tabpanel" aria-labelledby="hc-t3">
      <p class="ans">Most studies report reading gains from peer tutoring, but <mark>the highest-risk children did not gain as much as their peers</mark>.</p>
      <div class="src"><span class="cite"><Icon name="cite" size={14} />Primary prevention of reading failure, 2016</span><span class="chk"><Icon name="flagq" size={14} />Check this one by hand</span></div>
    </div>
  </div>
</div>
<script>
  const hc = document.querySelector("[data-hc]");
  if (hc) {
    const tabs = [...hc.querySelectorAll("[role=tab]")], panes = [...hc.querySelectorAll(".p")];
    const pick = (n, focus) => { tabs.forEach((t, i) => { const on = i === n; t.setAttribute("aria-selected", on); t.tabIndex = on ? 0 : -1; panes[i].classList.toggle("on", on); }); if (focus) tabs[n].focus(); };
    // The bar under a tab is the timer, so reduced motion, which removes it, leaves the console still.
    hc.addEventListener("animationend", (e) => { if (e.animationName.includes("hcfill")) pick((tabs.indexOf(e.target.parentElement) + 1) % tabs.length); });
    tabs.forEach((t, i) => { t.addEventListener("click", () => pick(i)); t.addEventListener("keydown", (e) => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); } }); });
    new IntersectionObserver(([en]) => hc.classList.toggle("off", !en.isIntersecting), { threshold: .3 }).observe(hc);
  }
</script>
<style>
  .hc { width: min(100%, 880px); display: grid; gap: 10px; padding: 10px; border-radius: 26px; background: rgb(8 14 48 / .62); -webkit-backdrop-filter: blur(24px) saturate(1.5); backdrop-filter: blur(24px) saturate(1.5); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(255 255 255 / .1), 0 50px 120px -40px rgb(0 0 0 / .8); color: #fff; text-align: left; }
  .hc :global(.big) { width: 100%; box-shadow: none; }
  .st-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  [role="tab"] { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; border-radius: 12px; background: rgb(255 255 255 / .05); color: rgb(255 255 255 / .72); font-size: 15px; transition: color .2s var(--ease), background-color .2s var(--ease); } [role="tab"]:hover { color: #fff; background: rgb(255 255 255 / .09); } [role="tab"] :global(svg) { flex: none; } [role="tab"][aria-selected="true"] { color: #fff; background: rgb(255 255 255 / .12); } [role="tab"][aria-selected="true"] :global(svg) { color: var(--c); }
  u { text-decoration: none; } [role="tab"] u { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--c); transform: scaleX(0); transform-origin: left; } [aria-selected="true"] u { animation: hcfill 6s linear forwards; } .hc:is(:hover, :focus-within, .off) [role="tab"] u { animation-play-state: paused; } @keyframes hcfill { to { transform: scaleX(1); } }
  .st { position: relative; height: 216px; border-radius: 16px; background: rgb(255 255 255 / .05); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); overflow: hidden; }
  .p { position: absolute; inset: 0; display: grid; gap: 28px; padding: 24px 28px; align-items: center; opacity: 0; visibility: hidden; transition: opacity .35s var(--ease), visibility 0s .35s; } .p.on { opacity: 1; visibility: visible; transition: opacity .35s var(--ease); }
  .p0, .p1 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .q span { display: block; margin-bottom: 8px; font-size: 14px; opacity: .7; } .q p { font-size: clamp(18px, 1.7vw, 23px); font-weight: 500; line-height: 1.5; letter-spacing: -.01em; } .q b { font-weight: 500; padding: 2px 8px; border-radius: 8px; color: var(--ink); box-decoration-break: clone; -webkit-box-decoration-break: clone; } .k1 { background: #ffe08a; } .k2 { background: #a9d6ff; } .q i { font-style: normal; opacity: .6; }
  .n { font-size: 15px; color: rgb(255 255 255 / .82); } .n strong { font: 400 clamp(32px, 3.6vw, 44px)/1 var(--mono); letter-spacing: -.03em; color: #fff; margin-right: 6px; }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 92px; margin-top: 10px; } .bars i { flex: 1; border-radius: 3px 3px 0 0; background: rgb(56 189 248 / .42); transform-origin: bottom; } .bars .top { background: #38bdf8; }
  .on .bars i { animation: grow .7s var(--ease) calc(var(--i) * 28ms) both; } @keyframes grow { from { transform: scaleY(0); } }
  .crit { display: grid; gap: 16px; font-size: 15px; } .crit span { display: block; margin-bottom: 6px; } .crit em { display: flex; gap: 2px; height: 6px; border-radius: 3px; overflow: hidden; } .y { background: #34d399; } .u { background: #fbbf24; } .x { background: rgb(255 255 255 / .22); } .on .crit em { animation: wipe .8s var(--ease) calc(var(--i) * 90ms) both; } @keyframes wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  .tiles { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-top: 12px; } .tiles i { display: grid; place-items: center; height: 30px; border-radius: 8px; background: rgb(52 211 153 / .2); color: #6ee7b7; } .tiles .amber { background: rgb(251 191 36 / .22); color: #fbbf24; } .on .tiles i { animation: pop .4s var(--ease) calc(var(--i) * 45ms) both; } @keyframes pop { from { opacity: 0; transform: scale(.7); } }
  .p2 { padding: 12px 28px; } .tb { display: grid; } .tr { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr); gap: 16px; align-items: center; min-height: 50px; border-top: 1px solid rgb(255 255 255 / .09); font-size: 15px; line-height: 1.25; } .th { min-height: 34px; border-top: 0; font-size: 13px; opacity: .65; } .v { color: #fff; } .on .tr:not(.th) { animation: row .5s var(--ease) calc(var(--i) * 110ms) both; } @keyframes row { from { opacity: 0; transform: translateY(8px); } }
  .cf { display: flex; align-items: center; gap: 8px; font: 400 13px/1 var(--mono); } .cf u { flex: 1; height: 5px; border-radius: 3px; background: linear-gradient(90deg, var(--b) var(--w), rgb(255 255 255 / .12) 0); }
  .p3 { align-content: center; gap: 16px; } .ans { font-size: clamp(18px, 2vw, 25px); font-weight: 500; line-height: 1.3; letter-spacing: -.012em; } .ans mark { color: var(--ink); background: linear-gradient(#fde68a, #fde68a) no-repeat 0 0 / 0 100%; border-radius: 4px; padding-inline: 3px; -webkit-box-decoration-break: clone; box-decoration-break: clone; color: inherit; transition: background-size .9s var(--ease) .2s, color .3s var(--ease) .4s; } .on .ans mark { background-size: 100% 100%; color: var(--ink); }
  .src { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; } .src span { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 9px; } .cite { background: rgb(255 255 255 / .1); } .chk { background: rgb(251 191 36 / .18); color: #fde68a; }
  @media (max-width: 700px) { .st { height: 332px; } .p { padding: 18px; gap: 16px; align-content: center; } .p0, .p1 { grid-template-columns: minmax(0, 1fr); } .bars { height: 64px; } .tiles i { height: 24px; } .crit { gap: 10px; font-size: 14px; } .p2 { padding: 8px 16px; } .tr { grid-template-columns: minmax(0, 1fr); gap: 2px; padding-block: 8px; font-size: 14px; } .th { display: none; } [role="tab"] { font-size: 14px; gap: 5px; } .cf { margin-top: 4px; } }
</style>
