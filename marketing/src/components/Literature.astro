---
// The whole field for one real query, a paper to a tile, with the first page of results picked out in it. Counts and first-page years are from this query on OpenAlex, 2026-11-03.
const counts = { 1972: 2, 1973: 1, 1974: 1, 1975: 2, 1976: 2, 1977: 5, 1978: 2, 1980: 5, 1981: 4, 1983: 1, 1984: 2, 1985: 8, 1986: 2, 1987: 5, 1988: 6, 1989: 8, 1990: 7, 1991: 7, 1992: 7, 1993: 8, 1994: 13, 1995: 8, 1996: 9, 1997: 9, 1998: 6, 1999: 9, 2000: 12, 2001: 11, 2002: 9, 2003: 14, 2004: 11, 2005: 16, 2006: 15, 2007: 17, 2008: 6, 2009: 14, 2010: 18, 2011: 15, 2012: 22, 2013: 20, 2014: 25, 2015: 23, 2016: 22, 2017: 39, 2018: 29, 2019: 47, 2020: 19, 2021: 30, 2022: 29, 2023: 33, 2024: 35, 2025: 67, 2026: 92 };
const firstPage = [[2011, "Peer tutoring in reading in Scotland: thinking big"], [2004, "Fostering reading comprehension in fifth grade by explicit instruction in reading strategies and peer tutoring"], [1977, "Peer Tutoring in the Reading Class"], [2015, "Using Peer Tutoring to Improve Reading Skills"], [1988, "Peer tutoring of reading using paired reading"], [1996, "Peer Tutored Instruction in Reading"], [1994, "Increasing Strategic Reading Practice with Peabody Classwide Peer Tutoring."], [2013, "Influence of peer tutoring on reading and reading motivation"], [2013, "Effects of Peer Tutoring on Reading Self-Concept"], [1989, "Peer Tutoring and Paired Reading: Combining Two Powerful Techniques."]];
const years = Array.from({ length: 2026 - 1972 + 1 }, (_, i) => 1972 + i);
const total = Object.values(counts).reduce((a, b) => a + b, 0);
const whole = `${total} papers, 1972 to 2026`;
---
<div class="lit" data-lit data-whole={whole}>
  <p class="asked">Does <mark style="--m:#ffe08a">peer tutoring</mark> improve <mark style="--m:#a9d6ff">reading</mark>?</p>
  <p class="query"><code style="--m:#ffe08a">"peer tutoring"</code> <i>AND</i> <code style="--m:#a9d6ff">reading</code><span class="readout" data-readout>{whole}</span></p>
  <div class="field-w">
    <ol class="page" aria-label="The first page of results">{firstPage.map(([y, t], k) => <li data-k={k}><span>{t}</span><em>{y}</em></li>)}</ol>
    <div class="plot" role="img" aria-label={`${whole}, rising to 92 in 2026. The ten papers on the first page of results are a tiny part of them.`}>
      {years.map((y, i) => { const n = counts[y] ?? 0, picks = firstPage.map(([f], k) => [f, k]).filter(([f]) => f === y); return <div class="c" data-t={`${y}, ${n === 1 ? "1 paper" : `${n} papers`}`} style={`--n:${n - picks.length};--i:${i}`}><i class="b"></i>{picks.map(([, k], j) => <u data-k={k} style={`--k:${j}`}></u>)}</div>; })}
    </div>
  </div>
  <div class="key" aria-hidden="true"><span class="k1">The first page</span><span class="k2">The other {total - firstPage.length}</span></div>
</div>
<script>
  const lit = document.querySelector("[data-lit]");
  if (lit) {
    const out = lit.querySelector("[data-readout]");
    lit.querySelectorAll(".c").forEach((c) => { const rows = [...c.querySelectorAll("u")].map((u) => lit.querySelector(`.page li[data-k="${u.dataset.k}"]`)); c.addEventListener("pointerenter", () => { out.textContent = c.dataset.t; rows.forEach((r) => r.classList.add("hit")); }); c.addEventListener("pointerleave", () => rows.forEach((r) => r.classList.remove("hit"))); });
    lit.querySelector(".plot").addEventListener("pointerleave", () => { out.textContent = lit.dataset.whole; });
    // A title and its tile light up together, so the page and the field read as one thing.
    lit.querySelectorAll(".page li").forEach((li) => { const tile = lit.querySelector(`u[data-k="${li.dataset.k}"]`); li.addEventListener("pointerenter", () => { tile.classList.add("hit"); li.classList.add("hit"); }); li.addEventListener("pointerleave", () => { tile.classList.remove("hit"); li.classList.remove("hit"); }); });
  }
</script>
<style>
  .lit { --t: 4px; display: grid; gap: 10px; padding: 22px 24px 18px; border-radius: 20px; background: rgb(3 24 38 / .74); -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4); box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1), 0 40px 80px -30px rgb(0 10 24 / .9); }
  .asked { font-size: clamp(20px, 2vw, 26px); line-height: 1.2; letter-spacing: -.015em; font-weight: 500; }
  .asked mark { color: inherit; border-radius: 4px; padding-inline: 3px; background: linear-gradient(color-mix(in srgb, var(--m) 30%, transparent), color-mix(in srgb, var(--m) 30%, transparent)) no-repeat 0 100% / 100% 100%; box-shadow: inset 0 -2px 0 var(--m); }
  .query { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 15px; } code { font: 400 14px/1 var(--mono); padding: 5px 7px; border-radius: 6px; background: var(--m); color: #0a1a3f; } .query i { font-style: normal; font: 400 13px/1 var(--mono); opacity: .8; } .readout { margin-left: auto; font: 400 13px/1.4 var(--mono); color: #bae6fd; }
  .field-w { position: relative; margin-top: 8px; } .page { position: absolute; z-index: 1; left: 0; top: 0; width: 62%; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1px; font-size: 13px; line-height: 1.25; } .page li { display: flex; justify-content: space-between; gap: 10px; padding: 3px 7px; border-radius: 5px; color: #fde68a; transition: background-color .12s var(--ease), color .12s var(--ease); } .page li:global(.hit) { background: #fbbf24; color: #1f1300; } .page span { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; } .page em { flex: none; font: 400 12px/1.4 var(--mono); font-style: normal; opacity: .8; }
  .plot { display: flex; align-items: flex-end; gap: 2px; height: calc(var(--t) * 92 + 8px); }
  .c { position: relative; flex: 1 1 0; height: 100%; min-width: 0; } .b { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--n) * var(--t)); background: repeating-linear-gradient(to top, #38bdf8 0 calc(var(--t) - 1px), transparent calc(var(--t) - 1px) var(--t)); transform-origin: 50% 100%; transition: filter .12s var(--ease); } .c:hover .b { filter: brightness(1.45); }
  u { position: absolute; left: -1px; right: -1px; bottom: calc(var(--n) * var(--t) + var(--k) * var(--t)); height: calc(var(--t) - 1px); background: #fbbf24; box-shadow: 0 0 8px 1px rgb(251 191 36 / .85); text-decoration: none; transition: box-shadow .12s var(--ease), background-color .12s var(--ease); } u:global(.hit) { background: #fff; box-shadow: 0 0 14px 4px #fbbf24; }
  .key { display: flex; align-items: center; gap: 16px; padding-top: 10px; border-top: 1px solid rgb(255 255 255 / .16); font-size: 14px; } .k1, .k2 { display: inline-flex; align-items: center; gap: 7px; } .k1::before, .k2::before { content: ""; width: 12px; height: 4px; background: #fbbf24; } .k2::before { background: #38bdf8; }
  /* The question lights up, its terms become the query, the first page arrives, and only then does the rest of the field build around it. */
  :global(.js) .lit .asked mark { background-size: 0 100%; box-shadow: none; } :global(.js) .lit .query { opacity: 0; translate: 0 6px; } :global(.js) .lit .b { transform: scaleY(0); } :global(.js) .lit u, :global(.js) .lit .page li { opacity: 0; }
  :global(.js .view.in) .lit .asked mark { background-size: 100% 100%; box-shadow: inset 0 -2px 0 var(--m); transition: background-size .6s var(--ease) .15s; } :global(.js .view.in) .lit .query { opacity: 1; translate: 0 0; transition: opacity .5s var(--ease) .6s, translate .6s var(--ease) .6s; } :global(.js .view.in) .lit .b { transform: none; transition: transform .8s var(--ease) calc(2s + var(--i) * 16ms), filter .12s var(--ease); } :global(.js .view.in) .lit u, :global(.js .view.in) .lit .page li { opacity: 1; transition: opacity .35s var(--ease) .9s, background-color .12s var(--ease), color .12s var(--ease), box-shadow .12s var(--ease); }
  @media (max-width: 700px) { .page { position: static; width: 100%; margin-bottom: 10px; } .page li:nth-child(n + 5) { display: none; } } @media (max-width: 560px) { .lit { --t: 3px; padding: 18px 16px 14px; } .plot { gap: 1px; } .readout { margin-left: 0; width: 100%; } .key { flex-wrap: wrap; gap: 8px 14px; } }
</style>
