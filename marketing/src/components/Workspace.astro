---
// The product on every screen: a laptop in the middle with a tablet and a phone either side, and a dock on the laptop's screen to move between the steps of the work.
import Device from "./Device.astro";
import Icon from "./Icon.astro";
const tabs = [
  { label: "Search", color: "#4fc3d9", icon: "search", lap: "search", tab: "search2", ph: "search2", alt: "Search results with an overview of the field, on a laptop, a tablet and a phone" },
  { label: "Screen", color: "#34d399", icon: "sieve", lap: "screen", tab: "screen", ph: "screen2", alt: "A screening's progress, questions and papers, on a laptop, a tablet and a phone" },
  { label: "Extract", color: "#fde047", icon: "table", lap: "extract-detail", tab: "extract", ph: "extract", alt: "An extraction table with an answer and a confidence score for each paper" },
  { label: "Assistant", color: "#7da7e6", icon: "spark", lap: "assistant", tab: "assistant", ph: "assistant", alt: "The research assistant reporting on an extraction and listing papers to check by hand" },
  { label: "Publish", color: "#fb7185", icon: "globe", lap: "c-home", tab: "c-map", ph: "c-search", alt: "A live Evidence Community under its own name" },
];
---
<div class="ws-pin"><div class="ws" data-ws data-theme="light" data-want="light" style={`--glow:${tabs[0].color}`}>
  <slot />
  <div class="stage">
    <i class="bloom" aria-hidden="true"></i>
    <div class="fan" aria-hidden="true">{tabs.map((t, i) => <img src={`/img/screens/${t.lap}-laptop-light-1000.avif`} width="1000" height="625" loading="lazy" decoding="async" alt="" style={`--c:${t.color};--n:${i - 2};--z:${2 - Math.abs(i - 2)}`} />)}</div>
    {tabs.map((t, i) => <div class:list={["pane", { on: i === 0 }]} id={`ws-p${i}`} role="tabpanel" aria-labelledby={`ws-t${i}`} data-c={t.color}>
      <Device class="tb" kind="tablet" name={t.tab} theme="dark" defer={i > 0} sizes="(max-width: 900px) 20vw, 300px" />
      <Device class="lap" kind="laptop" name={t.lap} theme="both" lazyDark alt={t.alt} defer={i > 0} sizes="(max-width: 900px) 66vw, 1000px" />
      <Device class="ph" kind="phone" name={t.ph} theme="dark" defer={i > 0} sizes="(max-width: 900px) 20vw, 200px" />
    </div>)}
    <div class="dock">
      <div class="tabs" role="tablist" aria-label="See each step of the work">{tabs.map((t, i) => <button type="button" role="tab" id={`ws-t${i}`} aria-controls={`ws-p${i}`} aria-label={t.label} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} style={`--c:${t.color}`}><Icon name={t.icon} size={18} /><span>{t.label}</span><u aria-hidden="true"></u></button>)}</div>
      <button type="button" class="mode" data-mode aria-label="Switch the laptop between light and dark"><i class="sun"><Icon name="sun" size={16} /></i><i class="moon"><Icon name="moon" size={16} /></i></button>
    </div>
  </div>
</div><i class="ws-go" data-ws-go aria-hidden="true"></i></div>
<script>
  const ws = document.querySelector("[data-ws]");
  if (ws) {
    const tabs = [...ws.querySelectorAll("[role=tab]")], panes = [...ws.querySelectorAll(".pane")];
    const load = (i) => { if (i.dataset.src) { i.srcset = i.dataset.srcset; i.src = i.dataset.src; delete i.dataset.src; delete i.dataset.srcset; } };
    // The laptop's dark screen only loads once someone has asked for dark. The tablet and phone are always dark, so they always load.
    let want = ws.dataset.theme, asks = 0;
    const fill = (k, dark = want === "dark") => panes[k].querySelectorAll("img").forEach((i) => { if (dark || !i.closest(".lap .scr.dark")) load(i); });
    // Nothing swaps until its images can paint, or half a second has passed, so a slow connection never shows a blank screen.
    const ready = (k) => Promise.race([Promise.all([...panes[k].querySelectorAll("img")].filter((i) => i.getAttribute("src")).map((i) => i.decode().catch(() => {}))), new Promise((r) => setTimeout(r, 500))]);
    let wanted = 0;
    const pick = (n, focus) => { wanted = n; [n, (n + 1) % panes.length].forEach((k) => fill(k)); tabs.forEach((t, i) => { const on = i === n; t.setAttribute("aria-selected", on); t.tabIndex = on ? 0 : -1; }); if (focus) tabs[n].focus(); ready(n).then(() => { if (wanted !== n) return; ws.style.setProperty("--glow", panes[n].dataset.c); panes.forEach((p, i) => p.classList.toggle("on", i === n)); }); };
    // The bar filling up under a tab is the timer: when its animation ends, the next tab starts. Reduced motion removes the animation, so nothing advances by itself.
    ws.addEventListener("animationend", (e) => { if (e.animationName.includes("fill")) pick((tabs.indexOf(e.target.parentElement) + 1) % tabs.length); });
    tabs.forEach((t, i) => { t.addEventListener("click", () => { ws.classList.add("held"); pick(i); }); t.addEventListener("keydown", (e) => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); } }); });
    ws.querySelector("[data-mode]").addEventListener("click", () => { want = want === "light" ? "dark" : "light"; ws.dataset.want = want; const asked = ++asks, theme = want, n = wanted; fill(n); ready(n).then(() => { if (asked === asks) ws.dataset.theme = theme; }); });
    // The tabs only start moving by themselves once the tour has finished opening.
    const go = document.querySelector("[data-ws-go]"); let seen = false, opened = getComputedStyle(go).display === "none"; const pace = () => ws.classList.toggle("off", !(seen && opened));
    new IntersectionObserver(([en]) => { seen = en.isIntersecting; pace(); }, { threshold: .2 }).observe(ws);
    new IntersectionObserver(([en]) => { if (en.isIntersecting || en.boundingClientRect.top < 0) { opened = true; pace(); } }).observe(go);
    const near = new IntersectionObserver(([en]) => { if (en.isIntersecting) { fill(1); near.disconnect(); } }); near.observe(ws);
  }
</script>
<style>
  .ws { position: relative; }
  /* Symmetry: laptop on the centre line, tablet and phone balanced at its feet, and colour blooming from behind in the step's own colour. */
  .stage { position: relative; aspect-ratio: 1248 / 720; }
  .bloom { position: absolute; left: 50%; top: 2%; width: 118%; height: 92%; translate: -50% 0; border-radius: 50%; background: radial-gradient(closest-side, var(--glow), transparent); opacity: .34; transition: background-color .5s var(--ease); pointer-events: none; }
  /* The new step fades in on top while the old one stays solid underneath, so nothing behind them ever shows through. */
  .pane { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 0s .45s, visibility 0s .45s; } .pane.on { opacity: 1; visibility: visible; transition: opacity .45s var(--ease); z-index: 1; }
  .pane :global(.lap) { position: absolute; left: 12%; top: 0; width: 76%; z-index: 1; }
  .pane :global(.tb) { position: absolute; left: 0; bottom: 3%; width: 21%; z-index: 2; }
  .pane :global(.ph) { position: absolute; right: 2%; bottom: 3%; width: 14.500%; z-index: 2; }
  .pane :global(.lap .scr.dark) { clip-path: inset(0 100% 0 0); } [data-theme="dark"] .pane :global(.lap .scr.dark) { clip-path: inset(0); }
  /* The dock sits on the laptop's screen, the way a real one would. */
  :global(html:not(.has-js)) .dock { display: none; }
  .dock { position: absolute; z-index: 3; left: 50%; bottom: 7%; translate: -50% 0; width: max-content; display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 20px; background: rgb(14 19 33 / .78); -webkit-backdrop-filter: blur(22px) saturate(1.6); backdrop-filter: blur(22px) saturate(1.6); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(255 255 255 / .1), 0 24px 50px -16px rgb(4 7 16 / .7); color: #fff; }
  .fan, .ws-go { display: none; } .ws > :global(h2) { margin-bottom: clamp(20px, 2.6vw, 36px); }
  .tabs { display: flex; gap: 2px; } @media (min-width: 701px) { .tabs { flex: none; } }
  [role="tab"] { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 8px; height: 46px; padding-inline: 14px; border-radius: 14px; color: rgb(255 255 255 / .72); font-size: 15px; white-space: nowrap; flex: none; transition: color .2s var(--ease), background-color .2s var(--ease); } [role="tab"]:hover { color: #fff; background: rgb(255 255 255 / .09); } [role="tab"][aria-selected="true"] { color: #fff; background: rgb(255 255 255 / .14); } [role="tab"][aria-selected="true"] :global(svg) { color: var(--c); }
  u { position: absolute; left: 10px; right: 10px; bottom: 3px; height: 2px; border-radius: 2px; background: var(--c); transform: scaleX(0); transform-origin: left; text-decoration: none; } [aria-selected="true"] u { animation: fill 7s linear forwards; } .ws:is(:hover, :focus-within, .off) u { animation-play-state: paused; } .ws:global(.held) u { animation: none; transform: none; opacity: 0; } @keyframes fill { to { transform: scaleX(1); } }
  .mode { position: relative; display: flex; flex: none; gap: 2px; margin-left: 4px; padding: 3px; border-radius: 14px; background: rgb(255 255 255 / .08); color: rgb(255 255 255 / .72); } .mode::before { content: ""; position: absolute; left: 3px; top: 3px; width: 34px; height: 38px; border-radius: 11px; background: #fff; transition: transform .32s var(--ease); } [data-want="dark"] .mode::before { transform: translateX(36px); } .mode i { position: relative; display: grid; place-items: center; width: 34px; height: 38px; transition: color .25s var(--ease); } [data-want="light"] .sun, [data-want="dark"] .moon { color: var(--ink); }
  /* The one scroll-tied moment on the site. The stage holds still while the closed laptop opens on its hinge and its screen wakes, then the tablet and phone slide in from the sides and the dock arrives. Browsers without scroll timelines just show it open, with no pause. Ranges count from the pin's top edge meeting the bottom of the screen. */
  @supports (animation-timeline: view()) { @media (prefers-reduced-motion: no-preference) and (min-width: 701px) and (min-height: 520px) {
    /* The sticky box fills the space under the header and centres the stage in it. Arriving, the headline lights up word by word while the five real screens spread out over a closed laptop. Once it holds still they gather and drop while the lid rises in front of them, followed by the tablet and phone, and the dock last. */
    .ws-pin { --at: calc(100svh - 74px); position: relative; view-timeline: --ws block; } .ws-pin::after { content: ""; display: block; height: 116svh; } .ws-pin .ws { position: sticky; top: 74px; display: grid; align-content: center; height: calc(100svh - 74px); }
    .ws-go { display: block; position: absolute; left: 0; top: 174svh; width: 1px; height: 1px; }
    .ws > :global(h2) { position: absolute; z-index: 4; left: 0; right: 0; top: 16px; margin: 0; animation: head-out linear both; animation-range: cover calc(var(--at) + 6svh) cover calc(var(--at) + 22svh); } .ws > :global(h2) :global(span) { animation: word-on linear both; animation-range: cover calc(var(--at) * (.1 + var(--i) * .06)) cover calc(var(--at) * (.26 + var(--i) * .06)); }
    /* The screens sit behind the laptop, so it covers them as they drop in. */
    .fan { display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none; } .fan img { position: absolute; z-index: var(--z); left: 30%; top: 15%; width: 40%; height: auto; max-width: none; border-radius: 12px; box-shadow: 0 0 0 1.5px var(--c), 0 0 60px -8px var(--c), 0 30px 60px -24px #000; animation: fan linear both; animation-range: cover 0 cover calc(var(--at) + 34svh + var(--z) * 2svh); }
    .pane :global(.lap .body) { transform-origin: 50% 100%; animation: lid linear both; animation-range: cover calc(var(--at) + 2svh) cover calc(var(--at) + 46svh); }
    /* Closed, you see the back of the lid, and it crossfades straight to the screen as the lid rises. */
    .pane :global(.lap .body)::before { content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; background: url(/favicon-dark.svg) 50% 50% / 7% auto no-repeat, linear-gradient(#f2f4f7, #c9ccd4 60%, #aeb2bc); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .6); pointer-events: none; animation: back linear both; animation-range: cover calc(var(--at) + 2svh) cover calc(var(--at) + 46svh); } @keyframes back { 0%, 10% { opacity: 1; } 72%, 100% { opacity: 0; } }
    .pane :global(.tb) { animation: out-l linear both; animation-range: cover calc(var(--at) + 44svh) cover calc(var(--at) + 66svh); } .pane :global(.ph) { animation: out-r linear both; animation-range: cover calc(var(--at) + 44svh) cover calc(var(--at) + 66svh); }
    .ws .bloom { animation: bloom linear both; animation-range: cover 0 cover calc(var(--at) + 50svh); } .ws .dock { animation: dock linear both; animation-range: cover calc(var(--at) + 62svh) cover calc(var(--at) + 74svh); }
    /* Tabbing to the dock always shows it, wherever the scroll has got to. */
    .ws .dock:focus-within { opacity: 1 !important; translate: -50% 0 !important; }
    /* Separate from the shorthands above: the minifier folds animation-timeline into them otherwise, and the browser then rejects the whole declaration. */
    .pane :global(.lap .body), .pane :global(.lap .body)::before, .pane :global(.tb), .pane :global(.ph), .ws .bloom, .ws .dock, .ws > :global(h2), .ws > :global(h2) :global(span), .fan img { animation-timeline: --ws; }
    @keyframes lid { from { transform: perspective(5200px) rotateX(-84deg); } to { transform: perspective(5200px) rotateX(0); } }
    @keyframes out-l { from { translate: -60% 0; opacity: 0; } 30% { opacity: 1; } to { translate: 0 0; opacity: 1; } } @keyframes out-r { from { translate: 80% 0; opacity: 0; } 30% { opacity: 1; } to { translate: 0 0; opacity: 1; } }
    @keyframes word-on { from { opacity: .16; } to { opacity: 1; } } @keyframes head-out { to { opacity: 0; translate: 0 -18px; } }
    @keyframes fan { 0% { opacity: 0; translate: calc(var(--n) * 12%) 34%; scale: .78; } 18% { opacity: 1; } 62%, 72% { opacity: 1; translate: calc(var(--n) * (70% - (var(--n) * var(--n) - 1) * 4%)) 0; scale: calc(1 - (2 - var(--z)) * .14); } 99.9% { opacity: 1; translate: 0 92%; scale: .24; } 100% { opacity: 0; translate: 0 92%; scale: .24; } }
    @keyframes bloom { from { opacity: 0; } to { opacity: .34; } } @keyframes dock { from { opacity: 0; translate: -50% 14px; } to { opacity: 1; translate: -50% 0; } }
  } }
  /* Phones get the same lid and the phone sliding in, without the pause. */
  @supports (animation-timeline: view()) { @media (prefers-reduced-motion: no-preference) and (max-width: 700px) {
    .ws { view-timeline: --wsp block; }
    .pane :global(.lap .body) { transform-origin: 50% 100%; animation: lid-p linear both; animation-range: cover 6% cover 36%; } .pane :global(.lap .glass)::after { content: ""; position: absolute; inset: 0; z-index: 2; background: #070b1a; pointer-events: none; animation: wake-p linear both; animation-range: cover 14% cover 38%; } .pane :global(.ph) { animation: out-p linear both; animation-range: cover 30% cover 46%; }
    .pane :global(.lap .body), .pane :global(.lap .glass)::after, .pane :global(.ph) { animation-timeline: --wsp; }
    @keyframes lid-p { from { transform: perspective(1200px) rotateX(-80deg); } to { transform: perspective(1200px) rotateX(0); } } @keyframes wake-p { from { opacity: 1; } to { opacity: 0; } } @keyframes out-p { from { translate: 130% 0; } to { translate: 0 0; } }
  } }
  /* Only the chosen tab shows its name here, and the name opens and closes rather than snapping. */
  @media (max-width: 1320px), (max-height: 860px) { [role="tab"] span { max-width: 0; margin-left: -8px; overflow: hidden; opacity: 0; transition: max-width .35s var(--ease), margin-left .35s var(--ease), opacity .25s var(--ease); } [role="tab"][aria-selected="true"] span { max-width: 96px; margin-left: 0; opacity: 1; } }
  @media (max-width: 480px) { [role="tab"] span, [role="tab"][aria-selected="true"] span { display: none; } }
  @media (max-width: 700px) { .stage { aspect-ratio: 402 / 400; } .pane :global(.lap) { left: 3%; width: 94%; } .pane :global(.tb) { display: none; } .pane :global(.ph) { right: 2%; bottom: 0; width: 28%; } .dock { position: relative; left: auto; bottom: auto; translate: none; margin: 12px auto 0; width: fit-content; order: 2; } .stage { display: grid; aspect-ratio: auto; } .pane { position: relative; grid-area: 1 / 1; inset: auto; aspect-ratio: 402 / 400; } .bloom { display: none; } [role="tab"] { padding-inline: 10px; } }
</style>
