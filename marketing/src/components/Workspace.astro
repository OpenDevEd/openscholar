---
// The product on every screen: a laptop in the middle with a tablet and a phone either side, and a dock on the laptop's screen to move between the steps of the work.
import Device from "./Device.astro";
import Icon from "./Icon.astro";
const tabs = [
  { label: "Search", color: "#60a5fa", icon: "search", lap: "search", tab: "search2", ph: "search2", alt: "Search results with an overview of the field, on a laptop, a tablet and a phone" },
  { label: "Screen", color: "#34d399", icon: "sieve", lap: "screen", tab: "screen", ph: "screen2", alt: "A screening's progress, questions and papers, on a laptop, a tablet and a phone" },
  { label: "Extract", color: "#fbbf24", icon: "table", lap: "extract-detail", tab: "extract", ph: "extract", alt: "An extraction table with an answer and a confidence score for each paper" },
  { label: "Assistant", color: "#22d3ee", icon: "spark", lap: "assistant", tab: "assistant", ph: "assistant", alt: "The research assistant reporting on an extraction and listing papers to check by hand" },
  { label: "Publish", color: "#fb7185", icon: "globe", lap: "c-home", tab: "c-map", ph: "c-search", alt: "A live Evidence Community under its own name" },
];
---
<div class="ws-pin"><div class="ws" data-ws data-theme="light" style={`--glow:${tabs[0].color}`}>
  <div class="stage">
    <i class="bloom" aria-hidden="true"></i>
    {tabs.map((t, i) => <div class:list={["pane", { on: i === 0 }]} id={`ws-p${i}`} role="tabpanel" aria-labelledby={`ws-t${i}`} data-c={t.color}>
      <Device class="tb" kind="tablet" name={t.tab} theme="dark" defer={i > 0} sizes="(max-width: 900px) 20vw, 300px" />
      <Device class="lap" kind="laptop" name={t.lap} theme="both" lazyDark alt={t.alt} defer={i > 0} sizes="(max-width: 900px) 66vw, 1000px" />
      <Device class="ph" kind="phone" name={t.ph} theme="dark" defer={i > 0} sizes="(max-width: 900px) 20vw, 200px" />
    </div>)}
    <div class="dock">
      <div class="tabs" role="tablist" aria-label="See each step of the work">{tabs.map((t, i) => <button type="button" role="tab" id={`ws-t${i}`} aria-controls={`ws-p${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} style={`--c:${t.color}`}><Icon name={t.icon} size={18} /><span>{t.label}</span><u aria-hidden="true"></u></button>)}</div>
      <button type="button" class="mode" data-mode aria-label="Switch the laptop between light and dark"><i class="sun"><Icon name="sun" size={16} /></i><i class="moon"><Icon name="moon" size={16} /></i></button>
    </div>
  </div>
</div></div>
<script>
  const ws = document.querySelector("[data-ws]");
  if (ws) {
    const tabs = [...ws.querySelectorAll("[role=tab]")], panes = [...ws.querySelectorAll(".pane")];
    const load = (i) => { if (i.dataset.src) { i.srcset = i.dataset.srcset; i.src = i.dataset.src; delete i.dataset.src; delete i.dataset.srcset; } };
    // A pane's dark screen only loads once someone has asked for dark.
    let want = ws.dataset.theme;
    const fill = (k, dark = want === "dark") => panes[k].querySelectorAll("img").forEach((i) => { if (dark || !i.closest(".scr.dark")) load(i); });
    // Nothing swaps until its images can paint, or half a second has passed, so a slow connection never shows a blank screen.
    const ready = (k) => Promise.race([Promise.all([...panes[k].querySelectorAll("img")].filter((i) => i.getAttribute("src")).map((i) => i.decode().catch(() => {}))), new Promise((r) => setTimeout(r, 500))]);
    let wanted = 0;
    const pick = (n, focus) => { wanted = n; [n, (n + 1) % panes.length].forEach((k) => fill(k)); tabs.forEach((t, i) => { const on = i === n; t.setAttribute("aria-selected", on); t.tabIndex = on ? 0 : -1; }); if (focus) tabs[n].focus(); ready(n).then(() => { if (wanted !== n) return; ws.style.setProperty("--glow", panes[n].dataset.c); panes.forEach((p, i) => p.classList.toggle("on", i === n)); }); };
    // The bar filling up under a tab is the timer: when its animation ends, the next tab starts. Reduced motion removes the animation, so nothing advances by itself.
    ws.addEventListener("animationend", (e) => { if (e.animationName.includes("fill")) pick((tabs.indexOf(e.target.parentElement) + 1) % tabs.length); });
    tabs.forEach((t, i) => { t.addEventListener("click", () => { ws.classList.add("held"); pick(i); }); t.addEventListener("keydown", (e) => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); } }); });
    ws.querySelector("[data-mode]").addEventListener("click", () => { want = want === "light" ? "dark" : "light"; const asked = want, n = wanted; fill(n); ready(n).then(() => { if (asked === want) ws.dataset.theme = asked; }); });
    new IntersectionObserver(([en]) => ws.classList.toggle("off", !en.isIntersecting), { threshold: .2 }).observe(ws);
    const near = new IntersectionObserver(([en]) => { if (en.isIntersecting) { fill(1); near.disconnect(); } }); near.observe(ws);
  }
</script>
<style>
  .ws { position: relative; }
  /* Symmetry: laptop on the centre line, tablet and phone balanced at its feet, and colour blooming from behind in the step's own colour. */
  .stage { position: relative; aspect-ratio: 1248 / 720; }
  .bloom { position: absolute; left: 50%; top: 2%; width: 118%; height: 92%; translate: -50% 0; border-radius: 50%; background: radial-gradient(closest-side, var(--glow), transparent); opacity: .34; transition: background-color .5s var(--ease); pointer-events: none; }
  .pane { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .45s var(--ease), visibility 0s .45s; } .pane.on { opacity: 1; visibility: visible; transition: opacity .45s var(--ease); z-index: 1; }
  .pane :global(.lap) { position: absolute; left: 12%; top: 0; width: 76%; z-index: 1; }
  .pane :global(.tb) { position: absolute; left: 0; bottom: 3%; width: 21%; z-index: 2; transform: translateX(40px); transition: transform .8s var(--ease); } .pane.on :global(.tb) { transform: none; }
  .pane :global(.ph) { position: absolute; right: 2%; bottom: 3%; width: 14.500%; z-index: 2; transform: translateX(-40px); transition: transform .8s var(--ease); } .pane.on :global(.ph) { transform: none; }
  .pane :global(.lap .scr.dark) { clip-path: inset(0 100% 0 0); } [data-theme="dark"] .pane :global(.lap .scr.dark) { clip-path: inset(0); }
  /* The dock sits on the laptop's screen, the way a real one would. */
  :global(html:not(.has-js)) .dock { display: none; }
  .dock { position: absolute; z-index: 3; left: 50%; bottom: 7%; translate: -50% 0; display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 20px; background: rgb(10 16 46 / .78); -webkit-backdrop-filter: blur(22px) saturate(1.6); backdrop-filter: blur(22px) saturate(1.6); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(255 255 255 / .1), 0 24px 50px -16px rgb(4 8 30 / .7); color: #fff; }
  .tabs { display: flex; gap: 2px; } @media (min-width: 701px) { .tabs { flex: none; } }
  [role="tab"] { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 8px; height: 46px; padding-inline: 14px; border-radius: 14px; color: rgb(255 255 255 / .72); font-size: 15px; white-space: nowrap; flex: none; transition: color .2s var(--ease), background-color .2s var(--ease); } [role="tab"]:hover { color: #fff; background: rgb(255 255 255 / .09); } [role="tab"][aria-selected="true"] { color: #fff; background: rgb(255 255 255 / .14); } [role="tab"][aria-selected="true"] :global(svg) { color: var(--c); }
  u { position: absolute; left: 10px; right: 10px; bottom: 3px; height: 2px; border-radius: 2px; background: var(--c); transform: scaleX(0); transform-origin: left; text-decoration: none; } [aria-selected="true"] u { animation: fill 7s linear forwards; } .ws:is(:hover, :focus-within, .off) u { animation-play-state: paused; } .ws:global(.held) u { animation: none; transform: none; opacity: 0; } @keyframes fill { to { transform: scaleX(1); } }
  .mode { display: flex; flex: none; gap: 2px; margin-left: 4px; padding: 3px; border-radius: 14px; background: rgb(255 255 255 / .08); color: rgb(255 255 255 / .72); } .mode i { display: grid; place-items: center; width: 34px; height: 38px; border-radius: 11px; transition: background-color .25s var(--ease), color .25s var(--ease); } [data-theme="light"] .sun, [data-theme="dark"] .moon { background: #fff; color: var(--ink); }
  /* The one scroll-tied moment on the site. The stage holds still while the closed laptop opens on its hinge and its screen wakes, then the tablet and phone slide in from the sides and the dock arrives. Browsers without scroll timelines just show it open, with no pause. Ranges count from the pin's top edge meeting the bottom of the screen. */
  @supports (animation-timeline: view()) { @media (prefers-reduced-motion: no-preference) and (min-width: 701px) {
    .ws-pin { --at: calc(100svh - 88px); view-timeline: --ws block; } .ws-pin::after { content: ""; display: block; height: 90svh; } .ws-pin .ws { position: sticky; top: 88px; }
    .pane :global(.lap .body) { transform-origin: 50% 100%; animation: lid linear both; animation-range: cover calc(var(--at) - 140px) cover calc(var(--at) + 42svh); }
    .pane :global(.lap .glass)::after { content: ""; position: absolute; inset: 0; z-index: 2; background: #03061c; pointer-events: none; animation: wake linear both; animation-range: cover calc(var(--at) - 10svh) cover calc(var(--at) + 46svh); }
    .pane :global(.tb) { animation: out-l linear both; animation-range: cover calc(var(--at) + 42svh) cover calc(var(--at) + 66svh); } .pane :global(.ph) { animation: out-r linear both; animation-range: cover calc(var(--at) + 42svh) cover calc(var(--at) + 66svh); }
    .ws .bloom { animation: bloom linear both; animation-range: cover calc(var(--at) - 20svh) cover calc(var(--at) + 50svh); } .ws .dock { animation: dock linear both; animation-range: cover calc(var(--at) + 62svh) cover calc(var(--at) + 74svh); }
    /* Separate from the shorthands above: the minifier folds animation-timeline into them otherwise, and the browser then rejects the whole declaration. */
    .pane :global(.lap .body), .pane :global(.lap .glass)::after, .pane :global(.tb), .pane :global(.ph), .ws .bloom, .ws .dock { animation-timeline: --ws; }
    @keyframes lid { from { transform: perspective(2600px) rotateX(-84deg); } to { transform: perspective(2600px) rotateX(0); } } @keyframes wake { from { opacity: 1; } to { opacity: 0; } }
    @keyframes out-l { from { translate: -220% 0; } to { translate: 0 0; } } @keyframes out-r { from { translate: 260% 0; } to { translate: 0 0; } }
    @keyframes bloom { from { opacity: 0; } to { opacity: .34; } } @keyframes dock { from { opacity: 0; translate: -50% 14px; } to { opacity: 1; translate: -50% 0; } }
  } }
  /* Phones get the same lid and the phone sliding in, without the pause. */
  @supports (animation-timeline: view()) { @media (prefers-reduced-motion: no-preference) and (max-width: 700px) {
    .ws { view-timeline: --wsp block; }
    .pane :global(.lap .body) { transform-origin: 50% 100%; animation: lid-p linear both; animation-range: cover 6% cover 36%; } .pane :global(.lap .glass)::after { content: ""; position: absolute; inset: 0; z-index: 2; background: #03061c; pointer-events: none; animation: wake-p linear both; animation-range: cover 14% cover 38%; } .pane :global(.ph) { animation: out-p linear both; animation-range: cover 30% cover 46%; }
    .pane :global(.lap .body), .pane :global(.lap .glass)::after, .pane :global(.ph) { animation-timeline: --wsp; }
    @keyframes lid-p { from { transform: perspective(1200px) rotateX(-80deg); } to { transform: perspective(1200px) rotateX(0); } } @keyframes wake-p { from { opacity: 1; } to { opacity: 0; } } @keyframes out-p { from { translate: 130% 0; } to { translate: 0 0; } }
  } }
  @media (max-width: 1320px) { [role="tab"] span { display: none; } [role="tab"][aria-selected="true"] span { display: inline; } }
  @media (max-width: 700px) { .stage { aspect-ratio: 402 / 400; } .pane :global(.lap) { left: 3%; width: 94%; } .pane :global(.tb) { display: none; } .pane :global(.ph) { right: 2%; bottom: 0; width: 28%; } .dock { position: relative; left: auto; bottom: auto; translate: none; margin: 12px auto 0; width: fit-content; order: 2; } .stage { display: grid; aspect-ratio: auto; } .pane { position: relative; grid-area: 1 / 1; inset: auto; aspect-ratio: 402 / 400; } .bloom { display: none; } [role="tab"] { padding-inline: 10px; } }
</style>
