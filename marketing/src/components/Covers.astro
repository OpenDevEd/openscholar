---
// Paper covers drifting past: real titles, each with its own bold print.
const COL = ["#FFD233", "#FF5A47", "#3DDC97", "#FF9BD0", "#FF9C1A", "#8FD0FF", "#fff", "#0b1020"];
const papers = [
  ["Peer tutoring in reading in Scotland: thinking big", "Topping", 2011],
  ["Using Peer Tutoring to Improve Reading Skills", "Topping", 2015],
  ["Assessing the Differential Effects of Peer Tutoring for Tutors and Tutees", "Thurston", 2021],
  ["Influence of peer tutoring on reading and reading motivation", "Slabe", 2013],
  ["Results from a Phase 2 exploratory trial of Paired Reading in Spanish", "Thurston", 2023],
  ["Effects of Peer Tutoring on Reading Self-Concept", "Flores", 2013],
  ["Peer Tutors Improve Reading Comprehension", "Lague", 2011],
  ["Fostering reading comprehension in fifth grade", "Van Keer", 2004],
  ["Academic Achievement and Peer Tutoring in Mathematics", "Alegre", 2020],
  ["Peer Tutoring and Paired Reading: Combining Two Powerful Techniques", "Topping", 1989],
];
const art = (i) => { const a = COL[i % 8], b = COL[(i + 3) % 8], c = COL[(i + 6) % 8]; return [
  `<rect width="200" height="150" fill="${a}"/><circle cx="60" cy="150" r="100" fill="${b}"/><circle cx="60" cy="150" r="55" fill="${c}"/>`,
  `<rect width="200" height="150" fill="${a}"/><path d="M0 0h100a100 100 0 01-100 100zM200 150h-100a100 100 0 01100-100z" fill="${b}"/><circle cx="150" cy="40" r="28" fill="${c}"/>`,
  `<rect width="200" height="150" fill="${a}"/>${[0, 1, 2, 3, 4].map((k) => `<rect x="${k * 40}" y="${150 - (k + 1) * 28}" width="34" height="${(k + 1) * 28}" fill="${k % 2 ? b : c}"/>`).join("")}`,
  `<rect width="200" height="150" fill="${a}"/>${[0, 1, 2, 3, 4, 5].map((k) => `<path d="M${-20 + k * 40} 150L${40 + k * 40} 0" stroke="${k % 2 ? b : c}" stroke-width="16"/>`).join("")}`,
  `<rect width="200" height="150" fill="${a}"/>${[0, 1, 2, 3].flatMap((y) => [0, 1, 2, 3, 4].map((x) => `<circle cx="${20 + x * 40}" cy="${20 + y * 37}" r="${6 + ((x * y + i) % 4) * 3.5}" fill="${(x + y) % 2 ? b : c}"/>`)).join("")}`,
  `<rect width="200" height="150" fill="${a}"/><path d="M100 0l26 54 58 8-42 40 10 58-52-28-52 28 10-58-42-40 58-8z" fill="${b}"/><circle cx="100" cy="82" r="20" fill="${c}"/>`,
][i % 6]; };
const Cover = papers.map(([t, who, y], i) => ({ t, who, y, art: art(i) }));
const cols = [Cover.filter((_, i) => i % 2 === 0), Cover.filter((_, i) => i % 2 === 1)];
---
<div class="covers" aria-hidden="true">
  {cols.map((col, k) => <div class:list={["col", `c${k}`]}><div class="run">{[...col, ...col].map((p) => <article><svg viewBox="0 0 200 150" preserveAspectRatio="xMidYMid slice" set:html={p.art} /><b>{p.t}</b><span>{p.who}, {p.y}</span></article>)}</div></div>)}
</div>
<style>
  .covers { position: absolute; inset: 0 0 0 auto; width: 42%; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding-inline: 8px 24px; transform: rotate(5deg) scale(1.2); transform-origin: 60% 50%; pointer-events: none; }
  .col { overflow: visible; } .run { display: grid; gap: 14px; animation: drift 46s linear infinite; will-change: transform; } .c1 .run { animation-direction: reverse; animation-duration: 54s; }
  @keyframes drift { to { transform: translateY(calc(-50% - 7px)); } }
  article { background: #fff; border-radius: 14px; overflow: hidden; padding-bottom: 12px; box-shadow: 0 14px 30px -12px rgb(11 16 32 / .45); color: var(--ink); }
  svg { width: 100%; height: auto; aspect-ratio: 4 / 3; } b { display: block; margin: 10px 12px 2px; font-size: 14px; line-height: 1.2; font-weight: 700; letter-spacing: -.015em; } span { margin-inline: 12px; font-size: 12px; color: var(--t2); }
  @media (max-width: 900px) { .covers { position: relative; inset: auto; order: 2; width: calc(100% + 2 * var(--pad)); height: 320px; margin: 28px calc(var(--pad) * -1) 0; transform: none; overflow: hidden; padding-inline: 20px; } }
</style>
