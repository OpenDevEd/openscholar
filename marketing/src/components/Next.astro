---
const { href, label, text } = Astro.props;
---
<a class="next" href={href}><b>{label}</b><span class="d">{text}</span></a>
<style>
  .next { display: block; padding: 96px var(--edge); border-top: 1px solid var(--line); transition: background-color .2s var(--ease); }
  .next:hover { background: var(--s1); }
  b { display: block; font-weight: 300; font-size: clamp(44px, 8vw, 132px); line-height: 1; letter-spacing: -.035em; margin-block: 8px 12px; }
  .d { color: var(--t2); font-weight: 300; font-size: clamp(16px, 1.4vw, 20px); }
</style>
