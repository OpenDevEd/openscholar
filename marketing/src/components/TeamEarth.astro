    const rest = () => { planet = null; const img = $("[data-still]"); img.onload = img.onerror = () => root.classList.add("lit"); root.classList.add("resting"); img.src = "/img/earth-still.avif"; select(Math.max(0, focus)); };
    const start = async () => {
      size(); let level = -1; try { level = Number(sessionStorage.getItem(Earth.memory) ?? -1); } catch {} level = Earth.startLevel(level);
      if (level) planet = Earth.renderer({ canvas: cv, width: W, height: W, layout: layout(), level: Math.min(level, 4), base: "/img/earth-", sharp: false, onLost: rest });
      if (planet) await planet.textures.catch(() => { planet = null; });
      if (!planet) return rest();
