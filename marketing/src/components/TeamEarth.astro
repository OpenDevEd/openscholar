    const ALL = facing({ lon: -18, lat: 12 });
    // The sun starts behind the planet's upper edge, a crescent with the cities lit, and comes round to the day side.
    const NIGHT = [-.72, .5, -.48], DAY = [-.42, .46, .78], DAWN_MS = 3000;
    let W = 0, R = 0, dpr = 1, spin = ALL - .5, vel = 0, goal = ALL, focus = wide.matches ? -1 : 0, pinned = false, held = false, drag = null, planet = null, raf = 0, last = 0, seen = false, dirty = true, born = 0, nextAt = 0, scrolling = 0, frozen = false, tick = 0, arcAt = 0;
