</script>
<style>
  .ah { background: radial-gradient(ellipse 620px 440px at calc(50% + 330px) 400px, #142a66, transparent 72%), var(--night); padding-block: clamp(104px, 8.4vw, 128px) clamp(16px, 2vw, 24px); }
  .plate { position: absolute; left: 50%; top: 0; z-index: -2; width: 2560px; max-width: none; height: 820px; margin-left: -1280px; opacity: .7; transition: opacity 1.2s var(--ease); pointer-events: none; -webkit-mask-image: linear-gradient(#000 70%, transparent), linear-gradient(90deg, transparent 120px, #000 520px, #000 2040px, transparent 2440px); -webkit-mask-composite: source-in; mask-image: linear-gradient(#000 70%, transparent), linear-gradient(90deg, transparent 120px, #000 520px, #000 2040px, transparent 2440px); mask-composite: intersect; } :global(.js) .plate:not([data-loaded]) { opacity: 0; }
  .stars { position: absolute; left: 50%; top: 0; z-index: -1; width: 2560px; max-width: none; height: 900px; margin-left: -1280px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 400px, #000 2160px, transparent); mask-image: linear-gradient(90deg, transparent, #000 400px, #000 2160px, transparent); animation: twinkle 5s ease-in-out infinite alternate; } .stars.s1 { animation-duration: 7s; animation-delay: -2s; } .stars.s2 { animation-duration: 9s; animation-delay: -5s; } @keyframes twinkle { to { opacity: .45; } } .ah:global(.away) .stars { animation-play-state: paused; }
  /* The sky is one picture 2560 px wide. On a wider window it fades out at both ends, so it never stops at an edge. */
  .ah-in { padding-inline: calc(var(--gap) + var(--edge)); display: grid; grid-template-columns: minmax(0, 1fr) clamp(420px, 46vw, 528px); grid-template-areas: "copy globe" "band band"; column-gap: 24px; align-items: center; }
  .ah-copy { grid-area: copy; display: grid; gap: 20px; padding-bottom: 40px; } .ah-copy h1 { font-size: clamp(44px, 5.2vw, 78px); line-height: 1; letter-spacing: -.04em; } .ah-copy .lead { max-width: 23em; color: rgb(255 255 255 / .84); }
  /* The words come in as they do on every other page's hero. */
  .ah-copy > * { animation: ah-up .8s var(--ease) both; } .ah-copy > :nth-child(2) { animation-delay: .06s; } @keyframes ah-up { from { opacity: 0; transform: translateY(18px); } }
  .ah-globe { grid-area: globe; position: relative; width: 100%; aspect-ratio: 1; touch-action: pan-y; user-select: none; cursor: grab; animation: ah-in 1.4s .1s var(--ease) both; } .ah-globe:global(.grab) { cursor: grabbing; } @keyframes ah-in { from { opacity: 0; transform: translateY(36px) scale(.94); } }
  /* A dark planet holds the place until the real one has its maps, so nothing appears out of nowhere. */
  .ah-globe::before { content: ""; position: absolute; inset: 11%; border-radius: 50%; background: radial-gradient(circle at 30% 26%, #16306c, #0a1840 50%, #050a1d); box-shadow: 0 0 70px rgb(90 150 255 / .2); transition: opacity 1.2s var(--ease); } .ah:global(.lit) .ah-globe::before { opacity: 0; }
  .earth, .arcs, .still { position: absolute; inset: 0; width: 100%; height: 100%; } .earth { opacity: 0; transition: opacity 1.2s var(--ease); } .ah:global(.lit) .earth { opacity: 1; } .arcs { pointer-events: none; }
  .still { inset: 11%; width: 78%; height: 78%; border-radius: 50%; object-fit: cover; } img.still:not([src]) { display: none; } [data-still] { transition: opacity 1.2s var(--ease); } .ah:not(:global(.lit)) [data-still] { opacity: 0; } .ah:global(.resting) :is(.earth, .arcs, .pins) { display: none; }
  .pins { position: absolute; inset: 0; pointer-events: none; }
  .pin { position: absolute; left: 0; top: 0; width: 0; height: 0; transition: opacity .35s var(--ease), visibility 0s; } .pin:global(.back) { opacity: 0; visibility: hidden; transition: opacity .25s var(--ease), visibility 0s .25s; }
  /* The pins wait until the planet has placed them, then light up one after another as the sun comes round. */
  .ah:not(.lit) .pins { visibility: hidden; } :global(.js) .ah:global(.lit) .pin { animation: pin-in .8s var(--ease) calc(1.5s + var(--i) * 110ms) backwards; } @keyframes pin-in { from { opacity: 0; scale: .4; } }
  .dot { position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; border-radius: 50%; background: #fff3e4; box-shadow: 0 0 0 3px rgb(255 157 54 / .85), 0 0 18px 4px rgb(255 157 54 / .7); }
  /* The pin of the place in focus sends out rings. */
  .dot::before, .dot::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid var(--brand-bright); opacity: 0; } .pin:global(.here) .dot::before, .pin:global(.here) .dot::after { animation: ring 2.4s var(--ease) infinite; } .pin:global(.here) .dot::after { animation-delay: 1.2s; } @keyframes ring { from { opacity: .9; scale: 1; } to { opacity: 0; scale: 4; } }
