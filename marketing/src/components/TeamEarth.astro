---
// Where the team is. The home hero's Earth (src/planet/earth.js) comes up out of the dark and turns to each place in turn,
// with the people there pinned to it and light running between the places. Under it the places stand side by side, each a
// glass model of itself: the one the globe is on opens to show who is there. Dragging turns the globe by hand.
import Arrow from "./Arrow.astro";
import Clock from "./Clock.astro";
import sharp from "sharp";
import { PLACES, LINKS, CLOCK_JS, peopleIn, flag } from "../data/team.mjs";
const places = PLACES.map((p) => ({ ...p, people: peopleIn(p.id) })).filter((p) => p.people.length);
const at = Object.fromEntries(places.map((p, i) => [p.id, i]));
const links = LINKS.filter(([a, b]) => a in at && b in at).map(([a, b]) => [at[a], at[b]]);
// Stars fixed in size and place, so they never shift between loads.
const rng = ((s) => () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296))(7);
const stars = Array.from({ length: 170 }, (_, i) => [+(rng() * 2560).toFixed(1), +(rng() * 900).toFixed(1), +(i < 8 ? 1.5 : .5 + rng() * .6).toFixed(2), +(i < 8 ? .9 : .2 + rng() * .5).toFixed(2)]);
// Three skies, so each can twinkle as a whole out of step with the others. Each is drawn here, once, as a picture the size
// it is laid out at, with its fade at both ends drawn in: the sky is 2560 px wide, and on a wider window it never stops at
// an edge. A browser keeps a picture that fades as a whole at the picture's own size, where a drawing is kept at the
// screen's density: three drawn skies on a Retina screen held about 100 MB for specks that look the same, which left too
// little room to redraw the places as they open, so they blinked.
const skies = await Promise.all([0, 1, 2].map(async (g) => `data:image/webp;base64,${(await sharp(Buffer.from(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2560 900" width="2560" height="900" fill="#e6eaf5"><linearGradient id="f"><stop stop-color="#000"/><stop offset=".15625" stop-color="#fff"/><stop offset=".84375" stop-color="#fff"/><stop offset="1" stop-color="#000"/></linearGradient><mask id="m"><rect width="2560" height="900" fill="url(#f)"/></mask><g mask="url(#m)">${stars.filter((_, i) => i % 3 === g).map(([x, y, r, o]) => `<circle cx="${x}" cy="${y}" r="${r}" opacity="${o}"/>`).join("")}</g></svg>`)).webp({ lossless: true }).toBuffer()).toString("base64")}`));
---
<section class="bleed ah" id="places" data-team-earth data-places={JSON.stringify(places.map(({ lon, lat }) => ({ lon, lat })))} data-links={JSON.stringify(links)}>
  <img class="plate" src="/img/sky-plate.avif" width="2560" height="820" alt="" decoding="async" onload="this.dataset.loaded = ''" />
  {skies.map((src, g) => <img class={`stars s${g}`} src={src} width="2560" height="900" alt="" />)}
  <div class="inner ah-in">
    {/* On a wide window the headline is large enough for its first line to run under the Earth's edge, and it runs on into a
        line that names the place the Earth is on ("around the world" with nobody picked). Each of those lines is marked
        data-at and follows the place in focus (-1 is nobody). The people of a place are listed on its card below. */}
    <div class="ah-copy">
      <h1>The people behind <br />Openscholar</h1>
      <div class="where" aria-hidden="true">
        <p class="on" data-at="-1">around the world</p>
        {places.map((p, i) => <p data-at={i} style={`--glow:${p.glow}`}><span>in{/^United/.test(p.name) ? " the" : ""}</span> <img class="fl" src={flag(p.cc)} width="48" height="36" alt="" /><b>{p.name}</b></p>)}
      </div>
      <p class="lead">One team working across Africa, Europe and North&nbsp;America, from two organisations.</p>
    </div>
    <div class="ah-globe">
      <noscript><img class="still" src="/img/earth-still.avif" width="1024" height="1024" alt="" /></noscript>
      <img class="still" data-still alt="" decoding="async" />
      <canvas class="earth" aria-hidden="true"></canvas>
      <canvas class="arcs" aria-hidden="true"></canvas>
      <div class="pins" aria-hidden="true">{places.map((p, i) => { const [dx, dy] = p.side; return <div class="pin" style={`--i:${i};--dx:${dx}px;--dy:${dy}px;--len:${Math.hypot(dx, dy).toFixed(1)}px;--ang:${(Math.atan2(dy, dx) * 180 / Math.PI).toFixed(1)}deg;--glow:${p.glow};--bg:${p.bg}`}>
        <i class="wire"></i><i class="dot"></i>
        <span class="stack" data-go={i}>{p.people.map((m) => <img src={`/img/team/${m.key}-face.avif`} width="40" height="40" alt="" />)}</span>
      </div>; })}</div>
    </div>
    <div class="band" role="group" aria-label="Where the team is">{places.map((p, i) => <div class="pl open" data-pl={i} style={`--i:${i};--bg:${p.bg};--glow:${p.glow}`}>
      <img class="pl-art" src={`/img/art-place-${p.id}-960.avif`} width="960" height="540" alt="" decoding="async" onload="this.dataset.loaded = ''" onerror="this.dataset.loaded = ''" />
      <button type="button" class="pl-head" data-place={i} aria-expanded="true" aria-controls={`pl-${p.id}`} aria-label={p.name}><img class="fl" src={flag(p.cc)} width="24" height="18" alt="" /><b>{p.name}</b></button>
      <span class="pl-faces" aria-hidden="true">{p.people.map((m) => <img src={`/img/team/${m.key}-face.avif`} width="34" height="34" alt="" />)}</span>
      <Clock tz={p.tz} />
      <ul class="pl-who" id={`pl-${p.id}`}>{p.people.map((m) => <li><a href={`/about/${m.slug}/`}><img src={`/img/team/${m.key}-face.avif`} width="44" height="44" alt="" data-portrait={m.slug} /><span><b>{m.name}</b><em>{m.role}</em></span><Arrow /></a></li>)}</ul>
    </div>)}</div>
  </div>
  {/* Every place is open in the markup, so the page reads without scripts. This shuts them as the page is read, before the
      first paint: all of them where they stand side by side, all but the first where they are a list, which keeps its height. */}
  <script is:inline>(() => { const wide = matchMedia("(min-width: 1080px)").matches; document.querySelectorAll("[data-pl]").forEach((el, i) => { const on = !wide && i === 0; el.classList.toggle("open", on); const head = el.querySelector(".pl-head"); head.setAttribute("aria-expanded", String(on)); head.setAttribute("aria-disabled", String(on)); el.querySelector(".pl-who").inert = !on; const art = el.querySelector(".pl-art"); if (art.complete) art.dataset.loaded = ""; }); })();</script>
  <script is:inline set:html={CLOCK_JS} />
</section>
