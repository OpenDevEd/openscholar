    const place = () => P.forEach((p, i) => { const [x, y, z] = at(p, spin); pins[i].style.transform = `translate3d(${(W / 2 + x * R).toFixed(1)}px,${(W / 2 - y * R).toFixed(1)}px,0)`; pins[i].classList.toggle("back", z < .1); });
    // Links of light: each a great circle lifted off the surface, hidden where the planet is in front of it, with a point of
    // light running along it. The focused place's links stay bright and the rest dim, easing over time, not per frame.
    const lit = LINKS.map(() => .8), glow = document.createElement("canvas");
    // The point of light at the head of each link, drawn once and stamped: a blur per link per frame costs far more.
    const bulb = () => { const s = glow.width = glow.height = Math.round(32 * dpr), g = glow.getContext("2d"), fill = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2); fill.addColorStop(0, "rgba(255,240,222,1)"); fill.addColorStop(.15, "rgba(255,157,54,.95)"); fill.addColorStop(1, "rgba(255,157,54,0)"); g.fillStyle = fill; g.fillRect(0, 0, s, s); };
    const drawArcs = (now) => {
      const S = ac.width, c = S / 2, r = R * dpr, grow = still() ? 1 : Math.min(1, (now - born - 1500) / 1600), ease = 1 - Math.exp(-Math.min(100, now - arcAt) / 130); arcAt = now; ink.clearRect(0, 0, S, S); if (grow <= 0) return; ink.lineCap = "round";
      LINKS.forEach(([a, b], k) => {
        const A = at(P[a], spin), B = at(P[b], spin), w = Math.acos(Math.min(1, A[0] * B[0] + A[1] * B[1] + A[2] * B[2])), sw = Math.sin(w), lift = .04 + .22 * w, want = focus < 0 ? .8 : a === focus || b === focus ? 1 : .2;
        // A link goes out as either of its ends turns out of sight, so none hangs off the edge of the globe going nowhere.
        const shown = Math.min(1, Math.max(0, (Math.min(A[2], B[2]) + .15) / .25)); lit[k] = still() ? want : lit[k] + (want - lit[k]) * ease; const alpha = lit[k] * shown; if (!alpha) return;
        const pt = (f) => { const s0 = Math.sin((1 - f) * w) / sw, s1 = Math.sin(f * w) / sw, h = 1 + Math.sin(f * Math.PI) * lift, x = (A[0] * s0 + B[0] * s1) * h, y = (A[1] * s0 + B[1] * s1) * h, z = (A[2] * s0 + B[2] * s1) * h; return [c + x * r, c - y * r, z > 0 || (z > -.3 && x * x + y * y > 1)]; };
        const N = 40, end = Math.round(N * grow); let on = false; ink.beginPath();
        for (let i = 0; i <= end; i++) { const [x, y, ok] = pt(i / N); if (!ok) { on = false; continue; } if (on) ink.lineTo(x, y); else ink.moveTo(x, y); on = true; }
        ink.strokeStyle = `rgba(255,176,104,${alpha * .62})`; ink.lineWidth = 1.4 * dpr; ink.stroke();
        if (still() || grow < 1) return;
        // The light takes about two and a half seconds to cross, then rests before the next one; no two links keep time.
        const u = ((now - born) / (2500 + k * 170) + k * .37) % 1.7; if (u > 1) return;
        const f = k % 2 ? 1 - u : u, back = k % 2 ? .16 : -.16;
        for (let j = 0; j < 8; j++) { const f0 = f + back * (1 - j / 8), f1 = f + back * (1 - (j + 1) / 8); if (Math.min(f0, f1) < 0 || Math.max(f0, f1) > 1) continue; const [x0, y0, k0] = pt(f0), [x1, y1, k1] = pt(f1); if (!k0 || !k1) continue; ink.beginPath(); ink.moveTo(x0, y0); ink.lineTo(x1, y1); ink.strokeStyle = `rgba(255,222,186,${alpha * (j + 1) / 8})`; ink.lineWidth = (1.2 + j * .16) * dpr; ink.stroke(); }
        const [hx, hy, ok] = pt(f); if (ok) { ink.globalAlpha = alpha; ink.drawImage(glow, hx - 16 * dpr, hy - 16 * dpr); ink.globalAlpha = 1; }
      });
    };
    const paint = (now) => { planet?.draw({ t: spin / .05, sun: sun(dawn(now)), shadow: 0 }); place(); dirty = false; };
    const frame = (now = performance.now()) => { paint(now); drawArcs(now); };
    const select = (i) => {
      focus = i; const to = i < 0 ? ALL : facing(P[i]); goal = to + Math.round((spin - to) / TAU) * TAU;
      panels.forEach((el, k) => { el.classList.toggle("open", k === i); heads[k].setAttribute("aria-expanded", String(k === i)); el.querySelector(".pl-who").inert = k !== i; });
      pins.forEach((el, k) => el.classList.toggle("here", k === i)); root.classList.toggle("some", i >= 0);
      if (still()) { spin = goal; vel = 0; frame(); } else { dirty = true; run(); }
    };
    // The tour: everyone, then each place in turn, for as long as nobody has picked one and the pointer and the keyboard are
    // elsewhere. In one column a place is always open, so the list keeps its height.
    const tour = (now) => { if (pinned || held || drag || root.contains(document.activeElement)) { nextAt = 0; return; } if (!nextAt) nextAt = now + (focus < 0 && now - born < DAWN_MS ? DAWN_MS + 200 : 2600); if (now < nextAt) return; const n = focus + 1; select(n < P.length ? n : wide.matches ? -1 : 0); nextAt = now + (focus < 0 ? 3400 : 4600); };
    const run = () => { if (!raf && born && seen && !still() && !document.hidden) raf = requestAnimationFrame(loop); };
    const loop = (now) => {
      raf = 0; if (!planet) return; run(); if (scrolling) return;
      const dt = Math.min(.05, (now - last) / 1000); last = now;
      // A spring carries the globe to where it's going, so a new pick mid-turn just moves the goal.
      if (!drag) { const k = 5.2, a = (goal - spin) * k * k - 2 * k * vel; vel += a * dt; spin += vel * dt; }
      // The planet is only drawn while it turns or the sun is coming up; at rest only the light on the links moves. The
      // monitor is told of every display frame of a turn, and a slow device then draws every second one (the level's own
      // pace), with the pins and links kept in step with the planet.
      const moving = dirty || drag || now - born < DAWN_MS + 400 || Math.abs(goal - spin) > 2e-4 || Math.abs(vel) > 2e-4;
      if (moving && now - born > 1000) watch(now, planet.level, 4);
