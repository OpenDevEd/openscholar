      if (document.documentElement.classList.contains("back")) { born -= DAWN_MS + 1600; spin = goal; }
      if (calm.matches) spin = goal; root.classList.add("lit"); select(focus); frame(); run();
    };
    for (const b of heads) {
      const i = Number(b.dataset.place), el = b.parentElement; let intent = 0;
      // In one column, opening a place shuts the one above it. The picked row is held where it was tapped while that happens.
      b.addEventListener("click", () => { pinned = true; const y0 = el.getBoundingClientRect().top, t0 = performance.now(); select(i); if (wide.matches) return; const hold = () => { scrollBy(0, el.getBoundingClientRect().top - y0); if (performance.now() - t0 < 650) requestAnimationFrame(hold); }; requestAnimationFrame(hold); });
