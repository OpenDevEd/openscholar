---
// The mark of a service someone links to, in the text's colour; a globe for a site of their own.
import Icon from "./Icon.astro";
import { LOGOS } from "../data/logos.mjs";
const { kind, size = 18 } = Astro.props, mark = LOGOS[kind];
---
{mark ? <svg width={size} height={size} viewBox={mark.box} fill="currentColor" aria-hidden="true" set:html={mark.body} /> : <Icon name="globe" size={size} />}
