---
// One real extraction: the table on one side, the abstract it read on the other, and a thread of light through a stack of glass from the chosen answer to the words it came from. The thread is as bright as the model is sure. Abstracts are word for word from each paper's record, cut only between sentences.
const rows = [
  { paper: "Assessing the Differential Effects of Peer Tutoring for Tutors and Tutees", who: "294 students aged\u00a011\u00a0to\u00a013", design: "Quasi-experimental", c: 90, ask: "How do you know it was 294 students?", before: "", pre: "A quasi-experimental study was undertaken involving ", mark: "294, 11 to 13-year-old students", post: ", taught by 12 teachers across three high schools.", after: " 149 students engaged in cooperative learning for a period of 12 weeks. 141 students served as comparison group. Gains were significantly greater on independent standardized reading tests for those engaged in cooperative learning, than those in comparison classes, and greater for tutors than tutees.", source: "Assessing the Differential Effects of Peer Tutoring for Tutors and Tutees in Elementary Reading Education. Cornerstone, Minnesota State University, Mankato, 2018" },
  { paper: "Effect of Peer Tutoring in Reading for Boys in French Immersion", who: "Boys at an elementary school in Vancouver", design: "School-based intervention", c: 85, ask: "How do you know it was a school in Vancouver?", before: "", pre: "Inspired by concern for the low motivation for reading in French of boys in French immersion programs, a study was undertaken in ", mark: "an elementary school in Vancouver", post: ", British Columbia, in the form of a reading intervention program.", after: " The program consisted of a peer tutoring reading group for French immersion males where the tutors were Grade 7 boys and the tutees were Grade 5 boys.", source: "Effect of peer tutoring in reading for boys in French immersion. University of British Columbia, 2012" },
  { paper: "The Overcoming Reading Difficulty through Peer Tutoring in Primary School", who: "Five tutees and five\u00a0tutors", design: "Action research", c: 97, ask: "How do you know it was five tutees and five tutors?", before: "In this study, it is aimed to determine the effect of peer tutoring method to resolve the difficulty in reading among 4th grade primary school students. ", pre: "The research is conducted with a group of ", mark: "five tutees who have reading difficulty and five tutors", post: ".", after: " The research was carried out in action research pattern of the qualitative research methods. Observation and interview methods were used to collect data.", source: "The Overcoming Reading Difficulty through Peer Tutoring in Primary School. Journal of Qualitative Research in Education, 2017" },
  { paper: "Role of Peer Tutoring and Methods to Boost Reading Skills", who: "Primary school students in Karachi", design: "Experimental", c: 60, ask: "How do you know it was students in Karachi?", before: "The current study aims to demonstrate the effectiveness of peer tutoring in comparison to the conventional teaching method in Pakistan. ", pre: "The population of the study is ", mark: "primary schools of district west Karachi and the primary school students", post: " are the main source of data.", after: " A test designed by the researchers covers three main objectives to improve student's reading skill.", source: "Role of Peer Tutoring and Methods to Boost Reading Skills at the Urban Sector Primary Schools. New Horizons, 2019" },
  { paper: "Primary Prevention of Reading Failure: Effect of Universal Peer Tutoring", who: "Kindergarten to Grade\u00a03 in\u00a0Canada", design: "District-wide programme", c: 40, ask: "How do you know it was kindergarten to Grade 3?", before: "", pre: "The authors examined the effects of a universal (school district-wide) implementation of a well-validated peer-tutoring reading intervention as a system-wide prevention measure in ", mark: "kindergarten through Grade 3 in a small metropolitan area in Canada", post: ".", after: " Results suggest that nearly all children demonstrated improved reading fluency over time.", source: "Primary prevention of reading failure: Effect of universal peer tutoring in the early grades. The Journal of Educational Research, 2016" },
].sort((x, y) => x.c - y.c);
// How much light a confidence gives, on a black-body scale: a dull ember, then orange, then near white.
const STOPS = [[40, 143, 84, 38], [60, 217, 128, 46], [85, 255, 157, 54], [97, 255, 232, 196]];
const heat = (c) => { const z = STOPS.findIndex((s) => c <= s[0]), b = STOPS[Math.max(z, 1)], a = STOPS[Math.max(z, 1) - 1], k = (c - a[0]) / (b[0] - a[0]); return `rgb(${[1, 2, 3].map((i) => Math.round(a[i] + (b[i] - a[i]) * k)).join(" ")})`; };
// Inside the glass a sure answer burns white, and a doubtful one shows as a dark line against the gold. Fills stop warming at orange, because near-white goes grey over black.
const shade = (c) => `--heat:${heat(c)};--tint:${heat(Math.min(c, 85))};--thru:${c < 70 ? "#2b1203" : "#fff8ea"}`;
const first = rows.findIndex((r) => r.c === 90); // The row lit before anyone chooses: bright enough that the thread reads at once, and above the fold.
---
<section class="panel traced" id="extraction" data-traced style={shade(rows[first].c)}>
  <div class="t-head"><h2>Stop retyping the literature into a spreadsheet</h2><p class="lead">Ask every abstract the same questions and get a table you can sort and export. Start with the answers the model is least sure of.</p></div>
  <div class="t-table">
    <div class="tools"><b>Peer tutoring trials</b><div class="acts"><button type="button" class="act" data-csv><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 17h12" /></svg>Export CSV</button><button type="button" class="act" data-sort><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4v12M3 13l3 3 3-3M14 16V4M11 7l3-3 3 3" /></svg><span data-label>Most confident first</span></button></div></div>
    <div role="table" aria-label="Answers extracted from five papers">
      <div class="rw hd" role="row"><span role="columnheader">Paper</span><span role="columnheader">Study design</span><span role="columnheader">Who took part?</span><span role="columnheader">Confidence</span></div>
      <div data-rows role="rowgroup">{rows.map(({ paper, who, design, c }, i) => <div class:list={["rw", { on: i === first }]} role="row" tabindex="0" data-c={c} data-i={i} aria-current={i === first ? "true" : undefined} style={shade(c)}><span class="ti" role="cell">{paper}</span><span class="des" role="cell">{design}</span><span class="who" role="cell"><span class="ans">{who}</span></span><span class="conf" role="cell" aria-label={`${c}% confidence`}><b>{c}%</b><span class="trk"><i style={`width:${c}%`}></i></span></span></div>)}</div>
    </div>
  </div>
  <div class="g-wrap">
    <div class="glass" aria-hidden="true"><img src="/img/art-stack.avif" width="448" height="1536" alt="" decoding="sync" /><div class="flare"><img src="/img/art-stack.avif" width="448" height="1536" alt="" decoding="sync" /></div></div>
    <div class="g-head"><h2>Built for the moment someone asks how you know</h2><p>Every answer keeps the sentence it came from. Your criteria are written down, and every change carries a name.</p></div>
    <div class="g-text" data-sheets>{rows.map(({ c, ask, before, pre, mark, post, after, source }, i) => <article class:list={["ab", { on: i === first }]} data-i={i} style={shade(c)}><h3>{ask}</h3><div class="ab-body"><p><span class="more">{before}</span><span class="sent">{pre}<mark>{mark}</mark>{post}</span><span class="more">{after}</span></p><p class="src">{source}</p></div></article>)}</div>
  </div>
  <svg class="wires" aria-hidden="true"><defs><linearGradient id="tail" gradientUnits="userSpaceOnUse"><stop offset="0" style="stop-color:var(--heat)" /><stop offset="1" style="stop-color:var(--heat);stop-opacity:.2" /></linearGradient></defs>{rows.map(() => <path class="hair" />)}{rows.map(() => <path class="spark" pathLength="1" />)}<path class="core" pathLength="1" /><path class="thru" pathLength="1" /><path class="run" pathLength="1" stroke="url(#tail)" /><path class="pulse" pathLength="1" /></svg>
</section>
<script>
  const root = document.querySelector("[data-traced]");
  const table = root.querySelector(".t-table"), glass = root.querySelector(".glass"), flare = root.querySelector(".flare"), list = root.querySelector("[data-rows]"), rows = [...list.children], sheets = [...root.querySelectorAll(".ab")], hairs = [...root.querySelectorAll(".hair")], sparks = [...root.querySelectorAll(".spark")], core = root.querySelector(".core"), thru = root.querySelector(".thru"), run = root.querySelector(".run"), pulse = root.querySelector(".pulse"), tail = root.querySelector("#tail"), holder = root.querySelector("[data-sheets]"), sort = root.querySelector("[data-sort]"), csv = root.querySelector("[data-csv]"), still = matchMedia("(prefers-reduced-motion: reduce)"), beside = matchMedia("(min-width: 1180px)");
  let chosen = root.querySelector(".rw.on"), now = null, raf = 0, last = 0, busyUntil = 0, sortUntil = 0, timer, opening = 0, seen = false, taken = false, surest = false;
  const box = (el) => { const r = el.getBoundingClientRect(), o = root.getBoundingClientRect(); return { l: r.left - o.left, r: r.right - o.left, t: r.top - o.top, b: r.bottom - o.top, w: r.width }; };
  // One route for every wire: out of the row, along its lane, then level to where it lands.
  const route = (sx, sy, lane, y, ex) => { const r = Math.min(10, Math.abs(y - sy) / 2), dy = Math.sign(y - sy), a = Math.sign(lane - sx), z = Math.sign(ex - lane); return `M${sx} ${sy}H${lane - a * r}Q${lane} ${sy} ${lane} ${sy + dy * r}V${y - dy * r}Q${lane} ${y} ${lane + z * r} ${y}H${ex}`; };
  // Where everything should be right now, read from the page. Lanes never cross: side by side they form a bracket into the glass, one above the other the top row runs outermost down the panel's right margin.
  const plan = () => { const t = box(table), g = box(glass), text = box(holder), o = root.getBoundingClientRect(), order = [...list.children], tracks = order.map((r) => box(r.querySelector(".trk"))), mid = (tracks[0].t + tracks.at(-1).b) / 2, wide = beside.matches;
    const lane = (n) => (wide ? t.r + 12 + Math.abs(n - 2) * 6 : o.width - 6 - n * 3.5);
    const paths = tracks.map((k, n) => { const y = (k.t + k.b) / 2; return wide ? route(k.r, y, lane(n), mid + (n - 2) * 7, g.l) : route(k.r, y, lane(n), g.t, lane(n)); });
    const n = order.indexOf(chosen), k = tracks[n], c = +chosen.dataset.c, mark = sheets[+chosen.dataset.i].querySelector("mark"), words = [...mark.getClientRects()], w = wide ? words[0] : words.reduce((a, b) => (b.right > a.right ? b : a)), at = wide ? g.r : lane(n) - 14;
    // Coming in from the margin, the thread would underline any words after the phrase, so on such a line it fades out before it reaches them.
    const after = document.createRange(); after.setStartAfter(mark); after.setEndAfter(mark.closest("p").lastChild); const stops = !wide && [...after.getClientRects()].some((r) => Math.abs(r.bottom - w.bottom) < 4 && r.right - w.right > 12);
    return { paths, wide, g, stops, fade: wide ? text.l : at - (stops ? 12 : 20), to: [k.l + (k.w * c) / 100, (k.t + k.b) / 2, lane(n), w.bottom - o.top - 1, at, stops ? at - 12 : (wide ? w.left : w.right) - o.left, (c - 40) / 57] }; };
  // The thread leaves its row, crosses the glass, thins before it reaches the words, and hands over to the rule under them.
  const paint = ({ paths, wide, g, fade, stops }) => { hairs.forEach((h, i) => h.setAttribute("d", paths[i])); sparks.forEach((s, i) => s.setAttribute("d", paths[i])); const [sx, sy, lane, y, at, ex, k] = now, d = route(sx, sy, lane, y, at), rest = `M${at} ${y}H${ex}`; core.setAttribute("d", d); thru.setAttribute("d", wide ? `M${g.l} ${y}H${g.r}` : `M${lane} ${g.t}V${g.b}`); run.setAttribute("d", rest); pulse.setAttribute("d", d + rest.replace("M", "L")); for (const [a, v] of [["x1", at], ["x2", fade], ["y1", y], ["y2", y]]) tail.setAttribute(a, v); tail.lastElementChild.style.stopOpacity = stops ? 0 : .2; const width = 1.6 + k * .9; core.style.strokeWidth = width; thru.style.strokeWidth = width; flare.style.setProperty("--at", `${wide ? y - g.t : lane - g.l}px`); root.style.setProperty("--k", k.toFixed(3)); };
  // Every moving part eases towards where the page says it is, so a new row and a resize follow the same thread. During a sort the thread's start stays on its row.
  const frame = (t) => { raf = 0; const p = plan(), dt = Math.min(50, t - last); last = t; if (!now || still.matches) now = p.to; else { const f = 1 - Math.exp(-dt / 80), held = t < sortUntil; now = now.map((v, i) => (held && i < 2 ? p.to[i] : v + (p.to[i] - v) * f)); } paint(p); if (t < busyUntil || now.some((v, i) => Math.abs(v - p.to[i]) > .15)) raf = requestAnimationFrame(frame); };
  const kick = (ms = 0) => { busyUntil = Math.max(busyUntil, performance.now() + ms); if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };
  const pick = (row) => { if (row === chosen) return; chosen.classList.remove("on"); chosen.removeAttribute("aria-current"); chosen = row; row.classList.add("on"); row.setAttribute("aria-current", "true"); root.style.setProperty("--heat", row.style.getPropertyValue("--heat")); root.style.setProperty("--thru", row.style.getPropertyValue("--thru")); sheets.forEach((s) => s.classList.toggle("on", s.dataset.i === row.dataset.i)); kick(); };
  // The table runs through its rows on its own until someone takes it.
  const wake = () => { clearTimeout(timer); if (seen && !taken && !still.matches && root.classList.contains("lit")) timer = setTimeout(() => { const order = [...list.children]; pick(order[(order.indexOf(chosen) + 1) % order.length]); wake(); }, 4600); };
  // The finished table, with the thread drawing from the lit row to its words.
  const finish = () => { clearTimeout(opening); sparks.forEach((s) => s.getAnimations().forEach((a) => a.cancel())); rows.forEach((r) => r.classList.add("got")); root.classList.add("lit"); kick(1800); wake(); };
  // Pulses leave the glass one at a time along the wires, and each landing writes that row's answer and fills its bar.
  const open = () => { [...list.children].forEach((row, n) => sparks[n].animate([{ strokeDashoffset: -.9, opacity: 0 }, { opacity: 1, offset: .15 }, { strokeDashoffset: 0, opacity: 1 }], { duration: 400, delay: n * 240, easing: "cubic-bezier(.45, 0, .55, 1)" }).finished.then(() => row.classList.add("got"), () => {})); opening = setTimeout(finish, 1640); };
  const take = () => { taken = true; clearTimeout(timer); holder.setAttribute("aria-live", "polite"); if (!root.classList.contains("lit")) finish(); };
  for (const r of rows) {
    // Only a pointer that really moved chooses: a page scroll also lands a resting pointer on a row.
    r.addEventListener("pointermove", (e) => { if (e.pointerType === "mouse" && (e.movementX || e.movementY)) { take(); pick(r); } });
    r.addEventListener("focus", () => { take(); pick(r); });
    r.addEventListener("click", () => { take(); pick(r); });
  }
  // Reading or touching the abstract also holds it still.
  holder.addEventListener("pointermove", (e) => { if (e.pointerType === "mouse" && (e.movementX || e.movementY)) take(); });
  holder.addEventListener("pointerdown", take);
  // The export is real: this table in its current order, as a file you can open, and each answer keeps its sentence.
  csv.addEventListener("click", () => { const quote = (v) => `"${String(v).replaceAll('"', '""')}"`, cell = (r, s) => r.querySelector(s).textContent.replaceAll("\u00a0", " "), lines = [["Paper", "Who took part?", "Study design", "Confidence", "Sentence"], ...[...list.children].map((r) => [cell(r, ".ti"), cell(r, ".ans"), cell(r, ".des"), r.dataset.c, cell(sheets[+r.dataset.i], ".sent")])].map((r) => r.map(quote).join(",")), a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob([lines.join("\n")], { type: "text/csv" })), download: "peer-tutoring-trials.csv" }); a.click(); URL.revokeObjectURL(a.href); });
  // Rows dissolve while they pass each other, so their words never overprint, and the wires wait for them. The lit row stays solid and slides over the others with its thread.
  sort.addEventListener("click", () => { take(); surest = !surest; const from = new Map(rows.map((r) => [r, r.getBoundingClientRect().top])); sort.querySelector("[data-label]").textContent = surest ? "Least confident first" : "Most confident first"; [...rows].sort((a, b) => (surest ? b.dataset.c - a.dataset.c : a.dataset.c - b.dataset.c)).forEach((r) => list.append(r)); if (still.matches) return kick(); const moves = rows.flatMap((r) => { const dy = from.get(r) - r.getBoundingClientRect().top; return dy ? [r.animate(r === chosen ? [{ transform: `translateY(${dy}px)` }, { transform: "none" }] : [{ transform: `translateY(${dy}px)`, opacity: 1 }, { opacity: 0, offset: .14 }, { opacity: 0, offset: .86 }, { transform: "none", opacity: 1 }], { duration: 520, easing: "cubic-bezier(.65, 0, .35, 1)" })] : []; }); root.classList.add("moving"); Promise.all(moves.map((m) => m.finished.catch(() => {}))).then(() => root.classList.remove("moving")); sortUntil = performance.now() + 540; kick(540); });
  new ResizeObserver(() => { now = null; kick(); }).observe(root);
  document.fonts.ready.then(() => { now = null; kick(); });
  // The opening waits until the table is on screen. Off screen the light stops and the rows stop changing.
  if (still.matches) finish();
  new IntersectionObserver(([e]) => { seen = e.isIntersecting; root.classList.toggle("away", !seen); if (seen && !opening && !root.classList.contains("lit")) open(); wake(); }, { threshold: .2 }).observe(table);
  still.addEventListener("change", () => { finish(); now = null; kick(); });
</script>
<style>
  /* Sizes in one place: the gap the wires cross, the width of the glass, and the abstract's measure. */
  .traced { --back: #120701; --gut: 32px; --band: 112px; --text: 320px; --face: calc(var(--text) + var(--gut) + var(--pad)); --copy: rgb(255 255 255 / .72); display: grid; grid-template-columns: minmax(0, 1fr) var(--text); column-gap: calc(var(--gut) * 2 + var(--band)); padding: 52px var(--pad) 40px; background: radial-gradient(300px 62% at calc(100% - var(--face) - var(--band) / 2) 50%, #6b3203, rgb(107 50 3 / .45) 42%, rgb(107 50 3 / .1) 76%, transparent), var(--back); } .traced::after { display: none; }
  .g-wrap { display: contents; } .t-head { grid-area: 1 / 1; } .t-table { grid-area: 2 / 1; } .g-head { grid-area: 1 / 2; } .g-text { grid-area: 2 / 2; }
  /* The glass runs off the panel's top and bottom. Where the thread crosses it, the same sheets light up. */
  .glass { position: absolute; top: 0; bottom: 0; right: var(--face); width: var(--band); z-index: -1; overflow: clip; container-type: inline-size; background: #5c2c06; } .glass img { width: 100%; height: 100%; object-fit: fill; }
  .flare { position: absolute; inset: 0; filter: brightness(1.7) saturate(1.1); opacity: calc(.15 + var(--k, 1) * .85); -webkit-mask-image: linear-gradient(transparent calc(var(--at, 0px) - 110px), rgb(0 0 0 / .55) calc(var(--at, 0px) - 34px), #000 var(--at, 0px), rgb(0 0 0 / .55) calc(var(--at, 0px) + 34px), transparent calc(var(--at, 0px) + 110px)); mask-image: linear-gradient(transparent calc(var(--at, 0px) - 110px), rgb(0 0 0 / .55) calc(var(--at, 0px) - 34px), #000 var(--at, 0px), rgb(0 0 0 / .55) calc(var(--at, 0px) + 34px), transparent calc(var(--at, 0px) + 110px)); }
  .t-head, .g-head { display: grid; align-content: start; align-self: first baseline; padding-bottom: 22px; } .t-head { gap: 16px; } .g-head { gap: 14px; } .t-head .lead { max-width: 34em; } @media (min-width: 1180px) { .g-head h2 { font-size: 32px; line-height: 1.1; letter-spacing: -.02em; } } .g-head p { font-size: 15px; line-height: 1.45; color: var(--copy); }
  .tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 12px; } .tools b { font-weight: 500; font-size: 17px; letter-spacing: -.01em; } .acts { display: flex; flex-wrap: wrap; gap: 8px; } :global(html:not(.has-js)) .acts { display: none; }
  .act { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding-inline: 12px; border-radius: 10px; background: rgb(255 255 255 / .08); font-size: 14px; font-weight: 500; white-space: nowrap; transition: background-color .15s var(--ease); } .act:hover { background: rgb(255 255 255 / .16); } [data-sort] { min-width: 180px; }
  /* Study design, then the answer that's wired, then how sure the model is. The bar sits on the table's right edge, so the thread leaves straight out of it. */
  .rw { display: grid; grid-template-columns: minmax(0, 2.05fr) minmax(0, 1.3fr) minmax(0, 1.45fr) 100px; gap: 12px; align-items: center; min-height: 74px; padding-block: 8px; padding-left: 12px; border-top: 1px solid rgb(255 255 255 / .1); font-size: 14px; line-height: 1.28; }
  .hd { min-height: 34px; color: rgb(255 255 255 / .6); font-size: 13px; }
  [data-rows] .rw { cursor: pointer; transition: background-color .2s var(--ease); } [data-rows] .rw:hover { background: rgb(255 255 255 / .04); } [data-rows] .rw.on { background: color-mix(in srgb, var(--tint) 13%, transparent); } .moving [data-rows] .rw.on { position: relative; z-index: 1; background: color-mix(in srgb, var(--tint) 13%, #1b0d03); }
  .ti { font-weight: 500; text-wrap: pretty; } .who, .des { text-wrap: balance; } .des { color: rgb(255 255 255 / .72); } .who { color: #fff; }
  .conf { display: grid; grid-template-columns: 34px minmax(0, 1fr); align-items: center; gap: 6px; } .conf b { font: 400 13px/1 var(--mono); color: rgb(255 255 255 / .86); } .trk { display: block; height: 6px; background: linear-gradient(rgb(255 255 255 / .14), rgb(255 255 255 / .14)) 0 50% / 100% 1px no-repeat; } .trk i { display: block; height: 100%; border-radius: 3px 0 0 3px; background: var(--heat); transform-origin: left; }
  /* The abstract: all five share one cell, so the glass never changes height. Only the one on show reaches a screen reader. Without scripts all five stack, and the table stays beside them. */
  .g-text { display: grid; align-content: start; } :global(.has-js) .ab { grid-area: 1 / 1; } :global(.has-js) .ab > * { opacity: 0; visibility: hidden; transition: opacity .14s linear, visibility 0s .14s; } :global(.has-js) .ab.on > * { opacity: 1; visibility: visible; transition: opacity .28s var(--ease) .1s; } :global(html:not(.has-js)) .ab + .ab { margin-top: 28px; } @media (min-width: 1180px) { :global(html:not(.has-js)) .t-table { position: sticky; top: 88px; align-self: start; } }
  .ab h3 { min-height: 2.5em; margin-bottom: 12px; font-size: 20px; line-height: 1.25; letter-spacing: -.012em; } .ab p { font-size: 16px; line-height: 1.62; color: rgb(255 255 255 / .56); } .ab .src { margin-top: 12px; font-size: 13px; line-height: 1.4; color: rgb(255 255 255 / .56); } .sent { color: rgb(255 255 255 / .9); }
  /* The answer in the table and the words in the abstract wear the same rule, and the thread runs between them. It lands on the first word and carries on under all of them, even round a line break. */
  mark, .on .ans { color: #fff; background: linear-gradient(var(--heat), var(--heat)) 0 100% / 100% 1.5px no-repeat, linear-gradient(color-mix(in srgb, var(--tint) 26%, transparent), color-mix(in srgb, var(--tint) 26%, transparent)) 0 0 / 100% 100% no-repeat; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
