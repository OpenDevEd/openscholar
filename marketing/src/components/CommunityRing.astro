---
// The real sites of our live communities on one flat strip: one large in the middle, its neighbours cut off by the edges of the window.
import { COMMUNITIES } from "../data/site.mjs";
const { eager = true } = Astro.props;
---
<nav class="rg" data-rg aria-label="Live Evidence Communities">
  <div class="stage3d"><ul class="track" data-track>{COMMUNITIES.map((c, i) => <li style={`--d:${((i + 9) % 6) - 3};--c:${c.color}`} class:list={{ on: i === 0 }}><a href={c.url} aria-label={`${c.name}: ${c.text}`}><span class="bar">{c.host}</span><img src={`/img/site-${c.key}.avif`} width="960" height="600" loading={eager && (i < 2 || i === 5) ? "eager" : "lazy"} decoding="async" alt="" /></a></li>)}</ul></div>
  <div class="cap" aria-hidden="true">{COMMUNITIES.map((c, i) => <div class:list={["about", { on: i === 0 }]} style={`--c:${c.color}`}><b>{c.name}</b><span>{c.text}</span></div>)}</div>
  <i class="timer" data-timer aria-hidden="true"></i>
</nav>
<script>
  const root = document.querySelector("[data-rg]");
  if (root) {
    const track = root.querySelector("[data-track]"), items = [...track.children], caps = [...root.querySelectorAll(".about")], timer = root.querySelector("[data-timer]"); let at = 0;
    const idx = (k) => ((k % items.length) + items.length) % items.length;
    // The ring only ever turns the short way round.
    const go = (n) => { const d = ((n - idx(at) + 9) % 6) - 3; at += d; items.forEach((li, i) => { const next = ((i - n + 9) % 6) - 3, wraps = Math.abs(next - +li.style.getPropertyValue("--d")) > 3; /* A frame going round from one end to the other jumps while it's off screen, instead of flying across the strip. */ if (wraps) li.style.transition = "none"; li.style.setProperty("--d", next); if (wraps) { void li.offsetWidth; li.style.transition = ""; } li.classList.toggle("on", i === n); caps[i].classList.toggle("on", i === n); }); timer.style.animation = "none"; void timer.offsetWidth; timer.style.animation = ""; };
    timer.addEventListener("animationend", () => go(idx(at + 1)));
    items.forEach((li, i) => { const a = li.querySelector("a"); a.addEventListener("click", (e) => { if (i !== idx(at)) { e.preventDefault(); root.classList.add("held"); go(i); } }); a.addEventListener("focus", () => { if (i !== idx(at) && a.matches(":focus-visible")) go(i); }); });
    new IntersectionObserver(([en]) => root.classList.toggle("off", !en.isIntersecting), { threshold: .2 }).observe(root);
  }
</script>
<style>
  .rg { --rw: clamp(300px, 54vw, 820px); position: relative; width: 100vw; margin-inline: calc(50% - 50vw); margin-top: clamp(20px, 3.4vh, 36px); overflow: clip visible; }
  .stage3d { height: calc(var(--rw) * .66); }
  .track { position: relative; height: 100%; }
  .track li { position: absolute; left: 50%; top: 0; width: var(--rw); margin-left: calc(var(--rw) / -2); transform: translateX(calc(var(--d) * (var(--rw) + 28px))); transition: transform 1s var(--ease); }
  .track a { display: block; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgb(255 255 255 / .22), 0 30px 70px -24px #000; opacity: .62; transition: opacity .6s var(--ease), box-shadow .6s var(--ease); } .on a { opacity: 1; box-shadow: 0 0 0 1.5px var(--c), 0 0 70px -6px color-mix(in srgb, var(--c) 70%, transparent), 0 30px 70px -24px #000; } .track a:hover { opacity: .85; } .on a:hover { opacity: 1; }
  .bar { display: grid; place-items: center; height: 28px; background: #10141f; color: rgb(255 255 255 / .82); font: 400 12px/1 var(--mono); }
  .track img { display: block; width: 100%; height: auto; max-width: none; }
  .cap { position: relative; min-height: 84px; margin-top: 12px; padding-inline: 20px; text-align: center; } .about { display: grid; justify-items: center; gap: 6px; } :global(.has-js) .about { position: absolute; inset: 0 20px auto; opacity: 0; transform: translateY(8px); transition: opacity .3s var(--ease), transform .45s var(--ease); } :global(.has-js) .about.on { opacity: 1; transform: none; } .about b { font-weight: 500; font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.01em; color: #fff; } .about span { max-width: 38em; font-size: 15px; line-height: 1.4; opacity: .84; }
  .timer { position: absolute; width: 0; height: 0; animation: rgtick 5.5s linear forwards; } .rg:is(:hover, :focus-within, .off) .timer { animation-play-state: paused; } .rg:global(.held) .timer { animation: none; } @keyframes rgtick { to { opacity: .99; } }
  @media (max-width: 700px) { .rg { --rw: 72vw; } .cap { min-height: 122px; } }
</style>
