---
// Each live community as one glass object, hanging from the search box by a thread of light. Picking one puts its question in the box and its name in the headline.
import Arrow from "./Arrow.astro";
import { COMMUNITIES } from "../data/site.mjs";
const X = COMMUNITIES.map((_, i) => 60 + i * 136), Y = [52, 92, 112, 112, 92, 52];
---
<nav class="em" data-em data-items={JSON.stringify(COMMUNITIES.map((c) => c.question))} aria-label="Live Evidence Communities">
  <svg class="threads" viewBox="0 0 800 130" fill="none" aria-hidden="true">{COMMUNITIES.map((c, i) => <path data-th={i} d={`M400 0C400 ${Y[i] * .5} ${X[i]} ${Y[i] * .4} ${X[i]} ${Y[i]}`} stroke={c.color} pathLength="1" />)}</svg>
  <div class="row" role="tablist" aria-label="Choose a community">{COMMUNITIES.map((c, i) => <button type="button" role="tab" id={`em-t${i}`} aria-controls={`em-p${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-label={c.name} style={`--c:${c.color};--y:${Y[i]}px;--n:${i}`}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><u aria-hidden="true"></u></button>)}</div>
  <div class="cap">{COMMUNITIES.map((c, i) => <div class:list={["about", { on: i === 0 }]} id={`em-p${i}`} role="tabpanel" aria-labelledby={`em-t${i}`} style={`--c:${c.color}`}><a href={c.url}><b>{c.name}<Arrow /></b><span>{c.text}</span></a></div>)}</div>
</nav>
<script>
  const root = document.querySelector("[data-em]");
  if (root) {
    const tabs = [...root.querySelectorAll("[role=tab]")], caps = [...root.querySelectorAll(".about")], threads = [...root.querySelectorAll("[data-th]")], items = JSON.parse(root.dataset.items);
    const pick = (n, focus) => { tabs.forEach((t, i) => { const on = i === n; t.setAttribute("aria-selected", on); t.tabIndex = on ? 0 : -1; caps[i].classList.toggle("on", on); threads[i].classList.toggle("on", on); }); document.dispatchEvent(new CustomEvent("community", { detail: { index: n, question: items[n] } })); if (focus) tabs[n].focus(); };
    threads[0].classList.add("on");
    // An invisible animation is the timer, so reduced motion, which removes it, leaves the choice alone. A click settles it for good.
    root.addEventListener("animationend", (e) => { if (e.animationName.includes("emfill")) pick((tabs.indexOf(e.target.parentElement) + 1) % tabs.length); });
    tabs.forEach((t, i) => { t.addEventListener("click", () => { root.classList.add("held"); pick(i); }); t.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pick(i); }); t.addEventListener("keydown", (e) => { const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key]; if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); } }); });
    new IntersectionObserver(([en]) => root.classList.toggle("off", !en.isIntersecting), { threshold: .3 }).observe(root);
  }
</script>
<style>
  .em { position: relative; width: min(100%, 800px); margin-top: 0; }
  .threads { position: absolute; left: 0; top: -2px; width: 100%; height: auto; overflow: visible; pointer-events: none; } .threads path { stroke-width: 1; opacity: .3; vector-effect: non-scaling-stroke; stroke-dasharray: 1; transition: opacity .3s var(--ease); } .threads path:global(.on) { stroke-width: 2.5; opacity: 1; filter: drop-shadow(0 0 5px currentColor); animation: em-draw .6s var(--ease) both; } @keyframes em-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .row { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); height: 212px; }
  [role="tab"] { position: relative; align-self: start; justify-self: center; display: grid; place-items: center; width: 96px; height: 96px; margin-top: var(--y); border-radius: 50%; animation: em-in .7s calc(.3s + var(--n) * .07s) var(--ease) both; } @keyframes em-in { from { opacity: 0; translate: 0 -14px; } }
  [role="tab"] img { width: 88px; height: 88px; object-fit: contain; filter: saturate(1.5) drop-shadow(0 0 10px color-mix(in srgb, var(--c) 45%, transparent)); transition: transform .5s var(--ease), filter .3s var(--ease); }
  [role="tab"][aria-selected="true"] img { filter: saturate(1.8) drop-shadow(0 0 22px color-mix(in srgb, var(--c) 85%, transparent)); transform: scale(1.3); }
  u { position: absolute; width: 0; height: 0; } [aria-selected="true"] u { animation: emfill 5.5s linear forwards; } .em:is(:hover, :focus-within, .off) [aria-selected="true"] u { animation-play-state: paused; } .em:global(.held) u { animation: none !important; } @keyframes emfill { to { opacity: .99; } }
  /* One caption, in the same place for all six. */
  .cap { position: relative; min-height: 92px; margin-top: 8px; text-align: center; } .about a { display: grid; justify-items: center; gap: 6px; } :global(.has-js) .about { position: absolute; inset: 0 0 auto; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .3s var(--ease), transform .45s var(--ease), visibility 0s .3s; } :global(.has-js) .about.on { opacity: 1; visibility: visible; transform: none; transition: opacity .3s var(--ease), transform .45s var(--ease); } :global(html:not(.has-js)) .about { margin-bottom: 16px; } :global(html:not(.has-js)) .row, :global(html:not(.has-js)) .threads { display: none; }
  .about b { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.01em; } .about b :global(i) { display: grid; color: var(--c); transition: transform .25s var(--ease); } .about:hover b :global(i) { transform: translateX(4px); } .about span { max-width: 38em; font-size: 15px; line-height: 1.4; opacity: .84; }
  :global(.light) .threads path { opacity: .5; } :global(.light) [role="tab"] img { filter: saturate(.75); } :global(.light) [role="tab"][aria-selected="true"] img { filter: drop-shadow(0 10px 18px color-mix(in srgb, var(--c) 50%, transparent)); }
  @media (max-width: 700px) { .threads { display: none; } .row { height: 84px; margin-top: 18px; } [role="tab"] { width: 100%; height: 56px; margin-top: 0; } [role="tab"] img { width: 48px; height: 48px; } [role="tab"][aria-selected="true"] img { transform: scale(1.18); } .cap { min-height: 132px; } }
</style>
