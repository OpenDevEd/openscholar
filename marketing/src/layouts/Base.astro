---
import "../styles/global.css";
import { APP, NAV } from "../data/site.mjs";
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/ubuntu-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ubuntu-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
    <slot name="head" />
</head>
<body>
  <div class="bar-wrap"><header class="bar">
    <a class="brand" href="/" aria-label="OpenScholar home"><img src="/favicon.svg" width="28" height="28" alt="" /><span>OpenScholar</span></a>
    <nav class="nav" aria-label="Main">{NAV.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}</nav>
    <div class="end"><a class="signin" href={`${APP}/sign-in`}>Sign in</a><a class="go" href={APP}>Get started</a>
      <details class="menu"><summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></summary><div class="sheet">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={`${APP}/sign-in`}>Sign in</a></div></details></div>
  </header></div>
  <main class="strip"><slot /></main>
  <footer class="foot"><div class="f-in">
    <div class="f-brand"><img src="/favicon.svg" width="32" height="32" alt="" /><p>The evidence workspace for research teams</p></div>
    <nav aria-label="Footer">
      <div><b>Product</b><a href="/#product">Overview</a><a href="/evidence-libraries/">Evidence Libraries</a><a href="/teams/">Teams</a></div>
      <div><b>Learn</b><a href="/docs/">Documentation</a><a href="/docs/#start">Get started</a></div>
      <div><b>Legal</b><a href={`${APP}/privacy`}>Privacy</a><a href={`${APP}/cookie-policy`}>Cookies</a><a href={`${APP}/credits`}>Attributions</a></div>
    </nav>
    <p class="credit">Built by OpenDevEd and eKitabu</p>
  </div></footer>
  <script>const menu = document.querySelector(".menu"); addEventListener("click", (e) => { if (menu?.open && (!menu.contains(e.target) || e.target.closest(".sheet a"))) menu.open = false; });</script>
</body>
</html>
<style>
  .bar-wrap { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / .92); backdrop-filter: blur(10px); }
  .bar { display: flex; align-items: center; gap: 24px; max-width: 1280px; height: 68px; margin-inline: auto; padding-inline: calc(var(--gap) + 8px); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 18px; letter-spacing: -.02em; flex: none; }
  .nav { display: flex; gap: 4px; margin-left: 12px; font-size: 15px; color: var(--t2); } .nav a { padding: 8px 12px; border-radius: 10px; transition: background-color .15s var(--ease), color .15s var(--ease); } .nav a:hover { background: var(--soft); color: var(--ink); } .nav a[aria-current] { color: var(--ink); background: var(--soft); }
  .end { display: flex; align-items: center; gap: 10px; flex: none; margin-left: auto; } .signin { font-size: 15px; padding: 8px 10px; color: var(--t2); } .signin:hover { color: var(--ink); }
  .go { padding: 9px 16px; border-radius: 11px; background: var(--brand); color: #fff; font-weight: 500; font-size: 15px; transition: background-color .15s var(--ease); } .go:hover { background: var(--brand-dark); }
  .menu { display: none; position: relative; } .menu summary { list-style: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--soft); cursor: pointer; } .menu summary::-webkit-details-marker { display: none; }
  .sheet { position: absolute; right: 0; top: 48px; width: 220px; padding: 8px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 18px 40px -12px rgb(10 26 63 / .3); display: grid; } .sheet a { padding: 10px 12px; border-radius: 9px; } .sheet a:hover { background: var(--soft); }
  .foot { margin-top: clamp(40px, 6vw, 80px); border-top: 1px solid var(--line); } .f-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px 48px; max-width: 1280px; margin-inline: auto; padding: 48px calc(var(--gap) + 8px) 32px; }
  .f-brand p { margin-top: 12px; color: var(--t2); max-width: 18em; } .foot nav { display: flex; gap: 56px; } .foot nav div { display: grid; gap: 8px; align-content: start; font-size: 15px; color: var(--t2); } .foot nav b { font-weight: 500; color: var(--ink); margin-bottom: 4px; } .foot nav a:hover { color: var(--brand); } .credit { grid-column: 1 / -1; font-size: 14px; color: var(--t3); }
  @media (max-width: 900px) { .nav, .signin { display: none; } .menu { display: block; } }
  @media (max-width: 365px) { .brand span { display: none; } }
  @media (max-width: 700px) { .f-in { grid-template-columns: minmax(0, 1fr); } .foot nav { gap: 32px; flex-wrap: wrap; } }
</style>
