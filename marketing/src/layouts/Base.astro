---
import "../styles/global.css";
import { APP, NAV } from "../data/site.mjs";
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f6f3ea" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/ubuntu-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ubuntu-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
  <script is:inline>document.documentElement.classList.add("js")</script>
  <slot name="head" />
</head>
<body>
  <div class="bar-wrap">
    <header class="bar">
      <a class="brand" href="/" aria-label="OpenScholar home"><img src="/favicon.svg" width="30" height="30" alt="" /><span>OpenScholar</span></a>
      <nav class="nav" aria-label="Main">{NAV.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}</nav>
      <div class="end">
        <a class="signin" href={`${APP}/sign-in`}>Sign in</a>
        <a class="key small" href={APP}>Get started</a>
        <details class="menu"><summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></summary><div class="sheet">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={`${APP}/sign-in`}>Sign in</a></div></details>
      </div>
    </header>
  </div>
  <main class="strip"><slot /></main>
  <footer class="strip foot-wrap">
    <div class="b foot">
      <div class="f-brand"><img src="/mark.svg" width="44" height="44" alt="" /><p>Know what the research really says</p></div>
      <nav aria-label="Footer">
        <div><b>Product</b><a href="/#search">Search</a><a href="/#review">Reviews</a><a href="/evidence-libraries/">Evidence Libraries</a><a href="/teams/">Teams</a></div>
        <div><b>Learn</b><a href="/docs/">Documentation</a><a href="/docs/#start">Get started</a></div>
        <div><b>Legal</b><a href={`${APP}/privacy`}>Privacy</a><a href={`${APP}/cookie-policy`}>Cookies</a><a href={`${APP}/credits`}>Attributions</a></div>
      </nav>
      <p class="credit">Built by OpenDevEd and eKitabu</p>
    </div>
  </footer>
  <script>
    const wipes = document.querySelectorAll(".hl.wipe");
    const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { e.target.classList.add("on"); io.unobserve(e.target); } }, { threshold: 0.6 });
    wipes.forEach((w) => io.observe(w));
    const menu = document.querySelector(".menu"); addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target)) menu.open = false; });
  </script>
</body>
</html>
<style>
  .bar-wrap { position: sticky; top: 0; z-index: 50; max-width: 1240px; margin-inline: auto; padding: var(--gap); }
  .bar { display: flex; align-items: center; gap: 24px; height: 60px; padding-inline: 16px 10px; border-radius: 20px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 6px 20px -8px rgb(11 16 32 / .2); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; letter-spacing: -.03em; flex: none; }
  .nav { display: flex; gap: 4px; margin-inline: auto; font-size: 15px; font-weight: 500; }
  .nav a { padding: 7px 12px; border-radius: 10px; transition: background-color .15s var(--ease); } .nav a:hover { background: var(--mark-1); } .nav a[aria-current] { background: var(--paper); }
  .end { display: flex; align-items: center; gap: 12px; flex: none; margin-bottom: 4px; } .signin { font-weight: 500; font-size: 15px; padding: 7px 8px; }
  .menu { display: none; position: relative; } .menu summary { list-style: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--paper); cursor: pointer; } .menu summary::-webkit-details-marker { display: none; }
  .sheet { position: absolute; right: 0; top: 48px; width: 220px; padding: 8px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 18px 40px -12px rgb(11 16 32 / .35); display: grid; } .sheet a { padding: 10px 12px; border-radius: 10px; font-weight: 500; } .sheet a:hover { background: var(--mark-1); }
  .foot-wrap { padding-top: 0; margin-top: var(--gap); }
  .foot { background: var(--ink); color: #fff; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px 48px; }
  .f-brand p { margin-top: 16px; font-size: clamp(24px, 3vw, 40px); font-weight: 700; letter-spacing: -.035em; line-height: 1.02; max-width: 11em; }
  .foot nav { display: flex; gap: 56px; } .foot nav div { display: grid; gap: 10px; align-content: start; font-size: 15px; color: rgb(255 255 255 / .75); } .foot nav b { color: var(--sun); margin-bottom: 4px; } .foot nav a:hover { color: #fff; }
  .credit { grid-column: 1 / -1; font-size: 14px; color: rgb(255 255 255 / .65); }
  @media (max-width: 1000px) { .nav, .signin { display: none; } .menu { display: block; } .end { margin-left: auto; } }
  @media (max-width: 700px) { .foot { grid-template-columns: minmax(0, 1fr); } .foot nav { gap: 32px; flex-wrap: wrap; } }
</style>
