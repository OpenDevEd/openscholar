---
import "../styles/global.css";
import { APP, NAV } from "../data/site.mjs";
const { title, description, plainFoot = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="preload" href="/fonts/ubuntu-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ubuntu-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
  <slot name="head" />
</head>
<body>
  <header class="top">
    <a class="brand" href="/" aria-label="OpenScholar home"><img src="/mark.svg" width="26" height="26" alt="" /><span>OpenScholar</span></a>
    <nav class="nav" aria-label="Main">{NAV.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}</nav>
    <div class="top-end">
      <a class="enter" href={APP}>Open app</a>
      <details class="menu">
        <summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></summary>
        <div class="menu-panel">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={APP}>Open app</a></div>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <p class="mono">Built by OpenDevEd and eKitabu with OpenAlex</p>
    <nav aria-label="Footer"><a href={`${APP}/privacy`}>Privacy</a><a href={`${APP}/cookie-policy`}>Cookies</a><a href={`${APP}/credits`}>Credits</a><a href="/features/">All features</a></nav>
  </footer>
</body>
</html>
<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 50; display: flex; align-items: center; gap: 32px; height: 64px; padding-inline: var(--edge); }
  .top::before { content: ""; position: absolute; inset: 0 0 -24px; z-index: -1; background: linear-gradient(#000 20%, transparent); pointer-events: none; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; flex: none; }
  .nav { display: flex; gap: 24px; margin-inline: auto; font-size: 14px; color: var(--t2); }
  .nav a { white-space: nowrap; transition: color .15s var(--ease); }
  .nav a:hover, .nav a[aria-current] { color: var(--t1); }
  .top-end { display: flex; align-items: center; gap: 12px; flex: none; }
  .enter { font-size: 14px; padding: 7px 14px; border-radius: 10px; border: 1px solid var(--line2); white-space: nowrap; transition: background-color .15s var(--ease); }
  .enter:hover { background: rgb(255 255 255 / .1); }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line2); cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; right: 0; top: 44px; width: 240px; padding: 8px; background: var(--s1); border: 1px solid var(--line2); border-radius: 14px; display: grid; }
  .menu-panel a { padding: 10px 12px; border-radius: 8px; font-size: 15px; }
  .menu-panel a:hover { background: var(--s2); }
  @media (max-width: 1100px) { .nav { display: none; } .menu { display: block; } .top-end { margin-left: auto; } }
  @media (max-width: 480px) { .enter { display: none; } }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 32px var(--edge); border-top: 1px solid var(--line); position: relative; }
  .foot nav { display: flex; gap: 20px; font-size: 14px; color: var(--t2); }
  .foot a:hover { color: var(--t1); }
</style>
