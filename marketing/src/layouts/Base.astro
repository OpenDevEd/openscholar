---
import "../styles/global.css";
import { APP, NAV } from "../data/site.mjs";
const { title, description, journey = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/ubuntu-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ubuntu-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
  <slot name="head" />
</head>
<body>
  <header class="top" data-top>
    <a class="brand" href="/" aria-label="OpenScholar home"><img src="/mark.svg" width="26" height="26" alt="" /><span>OpenScholar</span></a>
    <nav class="nav" aria-label="Main">{NAV.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}</nav>
    <div class="top-end">
      <a class="signin" href={`${APP}/sign-in`}>Sign in</a>
      <a class="enter" href={APP}>Get started</a>
      <details class="menu">
        <summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></summary>
        <div class="menu-panel">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={`${APP}/sign-in`}>Sign in</a><a href={APP}>Get started</a></div>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <script is:inline>(() => { const t = document.querySelector("[data-top]"), on = () => t.toggleAttribute("data-solid", scrollY > 40); on(); addEventListener("scroll", on, { passive: true }); })();</script>
  <footer class="foot">
    <div class="f-brand"><a class="brand" href="/" aria-label="OpenScholar home"><img src="/mark.svg" width="30" height="30" alt="" /><span>OpenScholar</span></a><p>Know what the research really says.</p></div>
    <nav aria-label="Footer">
      <div><b>Product</b><a href="/try/">See it work</a><a href="/evidence-libraries/">Evidence Libraries</a><a href="/teams/">Teams</a></div>
      <div><b>Learn</b><a href="/docs/">Documentation</a><a href="/docs/#start">Get started</a></div>
      <div><b>Legal</b><a href={`${APP}/privacy`}>Privacy</a><a href={`${APP}/cookie-policy`}>Cookies</a><a href={`${APP}/credits`}>Attributions</a></div>
    </nav>
    <p class="mono credit">Built by OpenDevEd and eKitabu</p>
  </footer>
</body>
</html>
<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 50; display: flex; align-items: center; gap: 32px; height: 64px; padding-inline: var(--edge); }
  .top { transition: background-color .25s var(--ease); } .top[data-solid] { background: rgb(0 0 0 / .86); box-shadow: inset 0 -1px 0 var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 500; letter-spacing: -.01em; flex: none; }
  .nav { display: flex; gap: 24px; margin-inline: auto; font-size: 14px; color: var(--t2); }
  .nav a { white-space: nowrap; transition: color .15s var(--ease); }
  .nav a:hover, .nav a[aria-current] { color: var(--t1); }
  .top-end { display: flex; align-items: center; gap: 12px; flex: none; }
  .enter { font-size: 14px; font-weight: 500; padding: 9px 18px; border-radius: 999px; background: var(--t1); color: #000; white-space: nowrap; transition: background-color .15s var(--ease); }
  .enter:hover { background: #fff; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line2); cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; right: 0; top: 44px; width: 240px; padding: 8px; background: var(--s1); border: 1px solid var(--line2); border-radius: 14px; display: grid; }
  .menu-panel a { padding: 10px 12px; border-radius: 8px; font-size: 15px; }
  .menu-panel a:hover { background: var(--s2); }
  @media (max-width: 1100px) { .nav { display: none; } .menu { display: block; } .top-end { margin-left: auto; } }
  @media (max-width: 1100px) { .signin { display: none; } }
  @media (max-width: 480px) { .enter { display: none; } }
  .signin { font-size: 14px; color: var(--t2); } .signin:hover { color: var(--t1); }
  .foot { position: relative; z-index: 1; background: #000; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; padding: 64px var(--edge) 32px; border-top: 1px solid var(--line); }
  .f-brand p { margin-top: 16px; color: var(--t2); font-size: 18px; }
  .foot nav { display: flex; gap: 72px; }
  .foot nav div { display: grid; gap: 10px; align-content: start; font-size: 15px; color: var(--t2); } .foot nav b { font-weight: 500; color: var(--t1); margin-bottom: 4px; }
  .foot nav a:hover { color: var(--t1); }
  .credit { grid-column: 1 / -1; }
  @media (max-width: 800px) { .foot { grid-template-columns: minmax(0, 1fr); } .foot nav { gap: 40px; flex-wrap: wrap; } }
</style>
