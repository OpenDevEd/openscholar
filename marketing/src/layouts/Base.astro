---
import "../styles/global.css";
import { APP, NAV } from "../data/site.mjs";
const { title, description, preload } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="preload" href="/fonts/ubuntu-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ubuntu-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  {preload && <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
</head>
<body>
  <header class="top">
    <a class="brand" href="/" aria-label="OpenScholar home"><img src="/mark.svg" width="28" height="28" alt="" /><span>OpenScholar</span></a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <div class="top-end">
      <a class="signin" href={`${APP}/sign-in`}>Sign in</a>
      <a class="btn primary small" href={APP}>Open OpenScholar</a>
      <details class="menu">
        <summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h14M3 14h14" /></svg></summary>
        <div class="menu-panel">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={`${APP}/sign-in`}>Sign in</a></div>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <slot name="closing" />
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand"><img src="/mark.svg" width="32" height="32" alt="" /><p class="mono">Built by OpenDevEd and eKitabu with OpenAlex</p></div>
      <div><h3>OpenScholar</h3><ul><li><a href="/search/">Search</a></li><li><a href="/screening/">Screening</a></li><li><a href="/extraction/">Extraction</a></li><li><a href="/assistant/">Assistant</a></li><li><a href="/workspaces/">Workspaces</a></li></ul></div>
      <div><h3>Evidence Library</h3><ul><li><a href="/evidence-libraries/">Overview</a></li><li><a href="/maps/">Maps</a></li><li><a href="https://aied.openscholar.ai">AIED library</a></li><li><a href="https://wealth-inequality.openscholar.ai">Wealth Inequality library</a></li></ul></div>
      <div><h3>Reference</h3><ul><li><a href="/features/">All features</a></li><li><a href={`${APP}/privacy`}>Privacy policy</a></li><li><a href={`${APP}/cookie-policy`}>Cookie policy</a></li><li><a href={`${APP}/credits`}>Credits</a></li></ul></div>
    </div>
  </footer>
</body>
</html>
<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 50; display: flex; align-items: center; gap: 32px; height: 64px; padding-inline: max(32px, (100vw - 1320px) / 2); background: rgb(0 0 0 / .9); border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 500; flex: none; }
  .nav { display: flex; gap: 4px; flex: 1; min-width: 0; font-size: 14px; color: var(--t2); }
  .nav a { padding: 6px 10px; border-radius: 8px; white-space: nowrap; transition: color .15s var(--ease), background-color .15s var(--ease); }
  .nav a:hover { color: var(--t1); background: var(--s2); }
  .nav a[aria-current] { color: var(--t1); background: var(--s2); }
  .top-end { display: flex; align-items: center; gap: 16px; flex: none; margin-left: auto; }
  .signin { font-size: 14px; color: var(--t2); white-space: nowrap; }
  .signin:hover { color: var(--t1); }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: var(--s2); border: 1px solid var(--line); cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; right: 0; top: 44px; width: 240px; padding: 8px; background: var(--s1); border: 1px solid var(--line2); border-radius: 12px; display: grid; }
  .menu-panel a { padding: 10px 12px; border-radius: 8px; font-size: 15px; }
  .menu-panel a:hover { background: var(--s2); }
  @media (max-width: 1240px) { .nav, .signin { display: none; } .menu { display: block; } .top { padding-inline: 20px; } }
  @media (max-width: 480px) { .top-end .btn { display: none; } }
  .foot { border-top: 1px solid var(--line); padding-block: 64px; font-size: 14px; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .foot h3 { font-size: 14px; line-height: 20px; margin-bottom: 12px; }
  .foot li + li { margin-top: 8px; }
  .foot li a { color: var(--t2); }
  .foot li a:hover { color: var(--t1); }
  .foot-brand p { margin-top: 16px; max-width: 16rem; }
  @media (max-width: 700px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
</style>
