---
import Base from "../../layouts/Base.astro";
import { GUIDES } from "../../data/docs.mjs";
import { group } from "../../data/features.mjs";
import Art from "../../components/Art.astro";
---
<Base title="Documentation: OpenScholar" description="How to use OpenScholar and Evidence Communities." tone="dark">
  <section class="bleed intro"><Art name="sea" eager class="dim" /><div class="inner"><h1>Documentation</h1><p class="lead">How to use OpenScholar and Evidence Communities.</p></div></section>
  <div class="docs">
    <aside>
      <label><span class="sr">Search the docs</span><input type="search" data-find placeholder="Search the docs" autocomplete="off" /></label>
      <nav aria-label="Documentation">{GUIDES.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}</nav>
    </aside>
    <article>
      {GUIDES.map((g) => (
        <section id={g.id} data-guide>
          <h2>{g.title}</h2>
          {g.intro.map((p) => <p class="p">{p}</p>)}
          {g.steps && <ol class="steps">{g.steps.map((s) => <li>{s}</li>)}</ol>}
          {g.group && <details class="more" data-block><summary>Everything in this area</summary>{g.group.map((id) => { const f = group(id); return (<div class="block">{g.group.length > 1 && <h3>{f.name}</h3>}<dl>{f.items.map(([n, t]) => <div data-text={`${n} ${t}`.toLowerCase()}><dt>{n}</dt><dd>{t}</dd></div>)}</dl></div>); })}</details>}
        </section>
      ))}
      <p class="none" data-none hidden>Nothing matches. Try a shorter word.</p>
    </article>
  </div>
</Base>
<script>
  const input = document.querySelector("[data-find]"), rows = [...document.querySelectorAll("[data-text]")], blocks = [...document.querySelectorAll("[data-block]")], guides = [...document.querySelectorAll("[data-guide]")], none = document.querySelector("[data-none]");
  input.addEventListener("input", () => { const q = input.value.trim().toLowerCase(); let n = 0; for (const r of rows) { const on = !q || r.dataset.text.includes(q); r.hidden = !on; n += on; } for (const b of blocks) { const any = !!b.querySelector("[data-text]:not([hidden])"); b.hidden = !any; b.open = !!q && any; } for (const g of guides) { const prose = g.textContent.toLowerCase().includes(q); g.hidden = !!q && !g.querySelector("[data-block]:not([hidden])") && !prose; } none.hidden = !q || guides.some((g) => !g.hidden); for (const a of document.querySelectorAll("aside nav a")) a.hidden = !!document.querySelector(a.getAttribute("href"))?.hidden; });
</script>
<style>
  .intro { padding-block: clamp(112px, 11vw, 160px) clamp(56px, 6vw, 88px); background: #07405c; } .intro .lead { margin-top: 10px; }
  .docs { display: grid; grid-template-columns: 260px minmax(0, 760px); gap: clamp(24px, 5vw, 72px); align-items: start; padding-top: 16px; }
  aside { position: sticky; top: 84px; max-height: calc(100svh - 100px); overflow-y: auto; scrollbar-width: thin; }
  input { width: 100%; height: 44px; padding-inline: 14px; background: var(--soft); border: 0; border-radius: 11px; font-size: 16px; outline: 0; margin-bottom: 10px; } input:focus { box-shadow: 0 0 0 2px var(--brand); } input::placeholder { color: var(--t3); }
  nav a { display: block; padding: 7px 10px; border-radius: 9px; font-size: 15px; color: var(--t2); transition: background-color .15s var(--ease), color .15s var(--ease); } nav a:hover { background: var(--soft); color: var(--ink); } nav a[hidden] { display: none; }
  article { min-width: 0; } section[data-guide] { padding-block: 28px; border-top: 1px solid var(--line); scroll-margin-top: 80px; } section[data-guide]:first-child { padding-top: 8px; border-top: 0; } section[hidden] { display: none; }
  section[data-guide] h2 { font-size: clamp(24px, 2.4vw, 32px); margin-bottom: 12px; }
  .p { color: var(--t2); font-size: 17px; margin-bottom: 12px; }
  .steps { counter-reset: s; display: grid; gap: 8px; } .steps li { counter-increment: s; display: grid; grid-template-columns: 34px 1fr; gap: 6px; color: var(--t2); } .steps li::before { content: counter(s); display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: #e6eeff; color: var(--brand-dark); font-weight: 500; font-size: 14px; }
  .more { margin-top: 12px; } .more[hidden] { display: none; } .more summary { cursor: pointer; font-weight: 500; color: var(--brand-dark); width: fit-content; list-style: none; } .more summary::-webkit-details-marker { display: none; } .more summary::after { content: " +"; } .more[open] summary::after { content: " \2212"; } .block { margin-top: 16px; } h3 { font-size: 18px; margin-bottom: 8px; }
  dl > div { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 16px; padding-block: 10px; border-top: 1px solid var(--line); font-size: 15px; line-height: 1.45; } dl > div[hidden] { display: none; } dt { font-weight: 500; } dd { color: var(--t2); }
  .none { color: var(--t2); font-size: 18px; } .none[hidden] { display: none; }
  @media (max-width: 900px) { .docs { grid-template-columns: minmax(0, 1fr); } aside { position: static; max-height: none; } aside nav { display: flex; flex-wrap: wrap; gap: 2px; } dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
