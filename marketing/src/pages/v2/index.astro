---
// Hero to compare, after Greptile on Mobbin: graph paper, heavy slab type and an old engraving, a heron picking one fish from a shoal. The communities are the figures of a scientific plate. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#ebebe6" title="Hero 2: OpenScholar" description="Hero option">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@800&family=IBM+Plex+Mono&display=swap" rel="stylesheet" />
  <section class="bleed hero light">
    <img class="p" src="/img/art-plate-heron.avif" srcset="/img/art-plate-heron-960.avif 960w, /img/art-plate-heron.avif 1672w" sizes="(max-width: 999px) 100vw, 1100px" width="1672" height="941" fetchpriority="high" alt="" />
    <div class="inner c">
      <h1>Sort the evidence from the noise.</h1>
      <p>With OpenScholar, find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
  </section>
  <section class="bleed ec light">
    <div class="inner">
      <div class="t"><h2>Evidence Communities are public homes for a field's evidence.</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
      <ul>{COMMUNITIES.map((c, i) => <li><a href={c.url}><img src={`/img/art-plate-${c.key}-480.avif`} width="480" height="480" decoding="async" loading="lazy" alt="" /><span class="cap"><i>Fig. {i + 1}</i><b>{c.name}</b><span>{c.host}</span></span></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .hero, .ec { margin-block: 0; }
  .hero, .ec { background-color: #ebebe6; background-image: linear-gradient(rgb(20 20 18 / .07) 1px, transparent 1px), linear-gradient(90deg, rgb(20 20 18 / .07) 1px, transparent 1px); background-size: 48px 48px; color: #1b1b18; }
  h1, h2 { font-family: Bitter, Georgia, serif; font-weight: 800; letter-spacing: -.03em; }
  .hero { position: relative; isolation: isolate; overflow: clip; padding: 124px 0 48vw; } .p { position: absolute; z-index: -1; right: 0; bottom: 0; width: 100%; height: auto; max-width: none; mix-blend-mode: multiply; filter: brightness(1.12) contrast(1.25); }
  .c { display: grid; justify-items: start; gap: 20px; } h1 { font-size: clamp(50px, 7vw, 92px); line-height: .98; text-wrap: balance; max-width: 8em; } .c > p { max-width: 26em; font: 400 16px/1.5 "IBM Plex Mono", var(--mono); } .c :global(.big) { width: min(100%, 560px); margin-top: 6px; border-radius: 4px; box-shadow: 0 0 0 1.5px #1b1b18, 6px 6px 0 #1b1b18; }
  .ec { padding: 64px 0 88px; border-top: 1.5px solid #1b1b18; } .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; } h2 { max-width: 17em; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.04; text-wrap: balance; } .all { display: inline-flex; align-items: center; gap: 8px; font: 400 14px/1 "IBM Plex Mono", var(--mono); } .all:hover { text-decoration: underline; } .all :global(i) { display: grid; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 32px; border-top: 1.5px solid #1b1b18; border-left: 1.5px solid #1b1b18; } li { min-width: 0; border-right: 1.5px solid #1b1b18; border-bottom: 1.5px solid #1b1b18; } li a { display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px; transition: background .2s var(--ease); } li a:hover { background: #fff; } li a > img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; mix-blend-mode: multiply; filter: brightness(1.12) contrast(1.25); } .cap { display: grid; gap: 3px; margin-top: 12px; font-family: "IBM Plex Mono", var(--mono); } .cap i { font-style: italic; font-size: 13px; } .cap b { font-weight: 400; font-size: 14px; line-height: 1.25; } .cap span { font-size: 12px; opacity: .65; overflow: clip; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 1000px) { .hero { min-height: 700px; padding-bottom: 80px; } .p { right: -110px; width: 1100px; } .c { width: 100%; } ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } li a { padding: 20px; } .cap b { font-size: 16px; } }
</style>
