---
// Hero to compare: Earth with one bright orbit around it. The search box is in the clear sky above, and the communities are satellites on the near side of the ring. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const SPOT = [[12, 77.6], [27, 82.6], [42.5, 84.6], [57.5, 84.6], [73, 82.6], [88, 77.6]];
---
<Base top="#02062c" title="Hero 2: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="stage">
      <img class="p" src="/img/art-space-orbit.avif" srcset="/img/art-space-orbit-960.avif 960w, /img/art-space-orbit.avif 1672w" sizes="min(1440px, 100vw)" width="1672" height="941" fetchpriority="high" alt="" />
      <h2>Evidence Communities are where anyone can read it</h2>
      <ul>{COMMUNITIES.map((c, i) => <li style={`--x:${SPOT[i][0]};--y:${SPOT[i][1]};--c:${c.color}`}><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 112px 0 28px; background: #02062c; text-align: center; overflow: clip; }
  .c { position: relative; z-index: 1; display: grid; justify-items: center; gap: 22px; } h1 { max-width: 13em; font-size: clamp(38px, 4.6vw, 62px); } .c :global(.big) { width: min(100%, 720px); }
  .stage { position: relative; width: min(100vw, 1440px); margin: 16px auto 0; } .p { display: block; width: 100%; height: auto; max-width: none; } h2 { padding: 8px var(--pad) 12px; font-size: 22px; letter-spacing: -.02em; line-height: 1.16; text-wrap: balance; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-inline: var(--pad); } li { min-width: 0; } li a { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 8px; height: 100%; padding: 8px 12px 8px 8px; border-radius: 14px; text-align: left; background: rgb(4 10 44 / .76); -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 50%, rgb(255 255 255 / .2)); transition: background .2s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 30%, rgb(4 10 44 / .86)); } li img { width: 40px; height: 40px; object-fit: contain; filter: saturate(1.4); } li b { font-weight: 500; font-size: 13.5px; line-height: 1.18; letter-spacing: -.005em; }
  @media (min-width: 1000px) { .hero { padding-bottom: 0; } .stage { margin-top: -262px; margin-bottom: -66px; } .p { position: relative; z-index: -1; } h2 { position: absolute; left: max(var(--pad), calc(50% - 624px)); top: 45%; width: 300px; padding: 0; text-align: left; font-size: 24px; } ul { display: block; padding: 0; } li { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%); width: 172px; translate: -50% -50%; } li a { height: auto; } }
</style>
