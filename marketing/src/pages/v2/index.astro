---
// Hero to compare. The idea, from Cohere and Vanta: the headline and search, then the product straight away as a mosaic. Each tile is one of the site's own colours, its art and a real screen. The communities are the rose tile. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
---
<Base top="#040b2e" title="Hero 2: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <i class="field f-cobalt" aria-hidden="true"></i>
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
  </section>
  <section class="grid" aria-label="What you can do">
    <a class="panel t find" href="/#product"><i class="field f-ocean" aria-hidden="true"></i><Art name="sea" class="dim" style="--sc:3 44 66" sizes="600px" /><span class="x"><h2>Find</h2><p>Start with the whole literature, not the first page of it<Arrow /></p></span><img class="s" src="/img/screens/search2-laptop-dark-1000.avif" width="1000" height="625" decoding="async" alt="OpenScholar's search with a query you can read and change" /></a>
    <a class="panel t screen" href="/#screening"><i class="field f-emerald" aria-hidden="true"></i><Art name="sieve-front" class="dim" style="--sc:2 44 34" sizes="600px" /><span class="x"><h2>Screen</h2><p>Decide what counts once, then apply it to every paper<Arrow /></p></span><img class="s" src="/img/screens/screen-laptop-dark-1000.avif" width="1000" height="625" decoding="async" alt="OpenScholar's screening with a decision on each paper" /></a>
    <a class="panel t extract light" href="/#extraction"><Art name="grid-light" class="pale" pos="100% 0" sizes="600px" /><span class="x"><h2>Extract</h2><p>Stop retyping the literature into a spreadsheet<Arrow /></p></span><img class="s" src="/img/screens/extract-detail-laptop-light-1000.avif" width="1000" height="625" decoding="async" alt="OpenScholar's extraction table" /></a>
    <a class="panel t helper" href="/#assistant"><i class="field f-night" aria-hidden="true"></i><Art name="door-front" class="dim" style="--sc:8 18 66" sizes="600px" /><span class="x"><h2>Assistant</h2><p>Delegate the groundwork, not the decisions<Arrow /></p></span><img class="card" src="/img/screens/panel-approve-light.avif" decoding="async" alt="The assistant asking for approval before it starts a job" /></a>
    <a class="panel t comm" href="/evidence-communities/"><i class="field f-rose" aria-hidden="true"></i><Art name="globe" pos="100% 50%" sizes="900px" /><span class="x"><h2>Evidence Communities</h2><p>Give your field a public home that anyone can read<Arrow /></p></span><img class="s" src="/img/site-aied.avif" width="960" height="600" decoding="async" alt="A live Evidence Community" /></a>
  </section>
</Base>
<style>
  .hero { padding: 128px 0 72px; background: #040b2e; } .hero > .field { position: absolute; inset: 0; z-index: -1; }
  .c { display: grid; justify-items: center; gap: 18px; text-align: center; } h1 { max-width: 13em; } .c :global(.big) { width: min(100%, 680px); margin-top: 6px; } .lead { opacity: .9; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); }
  .t { display: flex; flex-direction: column; min-height: 400px; transition: transform .35s var(--ease); } .t:hover { transform: translateY(-3px); } .t > .field { position: absolute; inset: 0; z-index: -2; } .t > :global(.art) { z-index: -1; opacity: .85; }
  .x { display: grid; gap: 8px; padding: 28px 28px 20px; } .x h2 { font-size: clamp(26px, 2.4vw, 32px); } .x p { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 16px; line-height: 1.35; } .x :global(i) { display: grid; transition: transform .25s var(--ease); } .t:hover .x :global(i) { transform: translateX(4px); }
  .s { display: block; width: calc(100% - 56px); height: auto; max-width: none; margin: auto 28px -40px; border-radius: 12px 12px 0 0; box-shadow: 0 0 0 1px rgb(255 255 255 / .18), 0 30px 50px -24px #000; }
  .extract { background: #fff4e6; color: var(--ink); } .extract > :global(.art) { opacity: .4; } .extract .s { box-shadow: 0 0 0 1px var(--line2), 0 30px 50px -28px rgb(90 50 0 / .5); } .x p { color: inherit; }
  .helper > :global(.art img) { object-position: 50% 30%; } .card { display: block; width: calc(100% - 56px); height: auto; margin: auto 28px -24px; border-radius: 14px 14px 0 0; box-shadow: 0 30px 50px -24px #000; }
  .comm { background: #520116; } .comm .s { margin-right: 28px; }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 440px; } .t { min-height: 0; } .find { grid-column: span 5; } .screen { grid-column: span 4; } .extract { grid-column: span 3; } .helper { grid-column: span 4; } .comm { grid-column: span 8; } .comm { flex-direction: row; align-items: stretch; gap: 8px; } .comm .x { flex: 0 0 340px; align-content: start; } .comm .s { flex: 1; min-width: 0; width: auto; height: 100%; margin: 40px 0 -40px; object-fit: cover; object-position: 0 0; } .extract .s { width: 150%; margin: auto -40px -40px 28px; } }
</style>
