---
// Hero to compare: two columns. The workspace with its search box and real screen on navy; the communities as an index in daylight, a picture, a name and an address on each line. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#01072c" title="Hero 2: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="os">
      <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      <div class="w"><img src="/img/screens/search-laptop-dark.avif" width="1280" height="800" decoding="async" alt="OpenScholar's search results, with an overview of the field and a chart of papers per year" /></div>
    </div>
    <div class="ec light">
      <h2><b>Evidence Communities</b> are where anyone can read it</h2>
      <ul>{COMMUNITIES.map((c) => <li><a href={c.url}><img src={`/img/art-field-${c.key}-480.avif`} width="480" height="480" decoding="async" alt="" /><span class="n"><b>{c.name}</b><span>{c.host}</span></span><Arrow /></a></li>)}</ul>
      <a class="all" href="/evidence-communities/">How Evidence Communities work<Arrow /></a>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; display: grid; grid-template-columns: minmax(0, 1fr); }
  h1, h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.06; text-wrap: balance; } h1 b, h2 b { font-weight: inherit; }
  .os { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--hu) * 22); padding: 104px var(--pad) 0; background: #01072c; color: #fff; overflow: clip; } h1 { font-size: clamp(34px, 8.4vw, calc(var(--hu) * 60)); color: #a9bbe6; } h1 b { color: #fff; } .os :global(.big) { width: 100%; } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .w { aspect-ratio: 16 / 9; margin-bottom: -16px; border-radius: 14px 14px 0 0; overflow: clip; box-shadow: 0 0 0 1px rgb(255 255 255 / .16); } .w img { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 0 0; }
  .ec { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: calc(var(--hu) * 12); padding: 32px var(--pad); background: var(--soft); color: var(--ink); } h2 { font-size: clamp(26px, 6.4vw, calc(var(--hu) * 38)); color: var(--t2); } h2 b { color: var(--ink); }
  ul { display: grid; gap: 2px; margin-inline: -8px; } li a { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 8px; border-radius: 14px; transition: background .2s var(--ease); } li a:hover { background: #fff; box-shadow: 0 0 0 1px var(--line); } li a > img { width: 64px; height: 64px; border-radius: 10px; object-fit: cover; } .n { display: grid; gap: 2px; min-width: 0; } .n b { font-weight: 500; font-size: 16px; line-height: 1.2; letter-spacing: -.01em; } .n span { color: var(--t2); font: 400 12px/1.3 var(--mono); overflow: clip; text-overflow: ellipsis; white-space: nowrap; } li a :global(i) { display: grid; color: var(--brand); transition: transform .25s var(--ease); } li a:hover :global(i) { transform: translateX(4px); }
  .all { justify-self: start; display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(14px, calc(var(--hu) * 15)); transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  @media (min-width: 1000px) {
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); height: max(620px, calc(100svh - 32px)); grid-template-columns: calc(var(--edge) + var(--strip) * .58) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }
    .os { grid-template-rows: auto auto minmax(0, 1fr); padding: max(88px, calc(var(--hu) * 104)) calc(var(--hu) * 48) 0 var(--edge); } .w { aspect-ratio: auto; height: calc(100% + 24px); margin: 0; }
    .ec { grid-template-rows: auto minmax(0, 1fr) auto; padding: max(88px, calc(var(--hu) * 104)) var(--edge) calc(var(--hu) * 22) calc(var(--hu) * 40); }
    ul { grid-auto-rows: minmax(0, 1fr); min-height: 0; } li { min-height: 0; } li a { height: 100%; grid-template-columns: calc(var(--hu) * 80) minmax(0, 1fr) auto; grid-template-rows: minmax(0, 1fr); padding: calc(var(--hu) * 5) calc(var(--hu) * 8); } li a > img { width: 100%; height: 100%; min-height: 0; } .n b { font-size: max(14px, calc(var(--hu) * 17)); } .n span { font-size: max(11px, calc(var(--hu) * 13)); }
    .os :global(.big .mk), .os :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); }
  }
</style>
