---
// Hero to compare: Earthrise from the Moon. The search box is in the black sky beside a huge Earth, and the communities stand out on the lunar surface. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#02062c" title="Hero 4: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <img class="p" src="/img/art-space-earthrise.avif" srcset="/img/art-space-earthrise-960.avif 960w, /img/art-space-earthrise.avif 1672w" sizes="(max-width: 999px) 200vw, max(1440px, 100vw)" width="1672" height="941" fetchpriority="high" alt="" />
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="inner ec">
      <h2>Evidence Communities are where anyone can read it</h2>
      <ul>{COMMUNITIES.map((c) => <li style={`--c:${c.color}`}><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 104px 0 32px; background: #02062c; overflow: clip; } .p { position: absolute; z-index: -1; left: 50%; top: 330px; width: 200vw; height: auto; max-width: none; translate: -66% 0; }
  .c { display: grid; justify-items: start; gap: 16px; } h1 { max-width: 12em; font-size: clamp(38px, 5vw, 66px); } .lead { max-width: 28em; } .c :global(.big) { width: 100%; margin-top: 6px; }
  .ec { display: grid; gap: 14px; margin-top: 94vw; } h2 { font-size: 22px; letter-spacing: -.02em; line-height: 1.16; text-shadow: 0 1px 3px #000, 0 2px 18px #000, 0 0 30px #000; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } li { min-width: 0; } li a { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 10px; height: 100%; padding: 8px 12px 8px 6px; border-radius: 14px; background: rgb(2 6 30 / .6); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14); transition: background .2s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 30%, rgb(2 6 30 / .75)); } li img { width: 44px; height: 44px; object-fit: contain; filter: saturate(1.4); } li b { font-weight: 500; font-size: 14px; line-height: 1.18; letter-spacing: -.005em; }
  @media (min-width: 1000px) { .hero { min-height: 810px; padding-top: 124px; } .p { top: auto; bottom: 0; width: max(1440px, 100%); translate: -50% 0; } .c { width: 100%; } .c > * { max-width: 620px; } .c :global(.big) { max-width: 600px; } .ec { margin-top: 118px; } ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
