---
// Hero to compare. The idea, from Exa and Origin: the search box is the centre of the picture. Here it is the site's screening pane: the literature runs in from the left as fine lit lines, and what counts comes out on the right as real papers. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { firstPage } from "../../data/field.mjs";
const titles = firstPage.map(([, t]) => t), rows = Array.from({ length: 13 }, (_, i) => i), keep = firstPage.slice(0, 5);
---
<Base top="#02140f" title="Hero 4: OpenScholar" description="Hero option">
  <section class="bleed hero">
        <div class="inner c"><h1>Ask once. Keep what counts.</h1><p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p></div>
    <Art name="sieve-front" class="sv" pos="50% 50%" />
    <div class="flow">
      <div class="in" aria-hidden="true">{rows.map((r) => <p style={`--r:${r}`}>{titles.concat(titles).slice(r % 10, r % 10 + 4).join("  ")}</p>)}</div>
      <div class="pane"><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
      <ul class="out" aria-label="Papers kept for one question">{keep.map(([y, t], i) => <li style={`--i:${i}`}><svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg><span>{t}</span><em>{y}</em></li>)}</ul>
    </div>
  </section>
  <section class="panel comm" style="--tint:#be123c">
    <i class="field f-rose" aria-hidden="true"></i><Art name="pavilion" pos="100% 50%" />
    <div class="cc"><h2>Evidence Communities give your field a public home</h2><p class="lead">Your own name and address, kept current from your sources, for anyone to search and read.</p><a class="btn" href="/evidence-communities/">Explore Evidence Communities<Arrow /></a></div>
  </section>
</Base>
<style>
  .hero { padding: 128px 0 72px; background: #02140f; } .hero > .field { position: absolute; inset: 0; z-index: -1; opacity: .35; }
  .c { display: grid; justify-items: center; gap: 16px; text-align: center; } .lead { opacity: .9; }
  .hero > :global(.sv) { z-index: -1; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 62%, #000 30%, transparent); mask-image: radial-gradient(ellipse 60% 70% at 50% 62%, #000 30%, transparent); }
  .flow { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 44px; padding-inline: var(--pad); }
  .in { display: none; } .pane { position: relative; z-index: 1; } .pane :global(.big) { width: 100%; box-shadow: 0 0 0 1px rgb(255 255 255 / .5), 0 0 60px 6px rgb(52 211 153 / .45), 0 24px 50px -18px #000; }
  .out { display: grid; gap: 4px; } .out li { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 10px; background: rgb(2 30 22 / .7); box-shadow: inset 0 0 0 1px rgb(110 231 183 / .28); font-size: 14px; line-height: 1.2; animation: come .7s var(--ease) calc(.5s + var(--i) * 90ms) backwards; } @keyframes come { from { opacity: 0; transform: translateX(-16px); } } .out svg { color: #6ee7b7; } .out span { overflow: clip; text-overflow: ellipsis; white-space: nowrap; } .out em { font: 400 12px/1 var(--mono); color: #a7f3d0; }
  .comm { min-height: 380px; display: grid; align-items: center; padding: var(--pad); background: #520116; } .comm > .field { position: absolute; inset: 0; z-index: -2; } .comm > :global(.art) { z-index: -1; } .cc { display: grid; justify-items: start; gap: 18px; max-width: 560px; } .comm :global(.btn) { --chip: var(--tint); }
  @media (min-width: 1000px) {
    .flow { grid-template-columns: minmax(0, 1fr) 560px minmax(0, 1fr); gap: 0; align-items: center; min-height: 340px; padding: 0; margin-top: 36px; }
    .in { display: grid; gap: 11px; overflow: clip; -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); } .in p { margin-left: calc(var(--r) * -37px); color: #86efac; font: 400 11px/1 var(--mono); white-space: pre; text-align: right; direction: rtl; opacity: .62; filter: drop-shadow(0 0 5px #34d399); animation: drift 26s linear infinite; animation-delay: calc(var(--r) * -2.3s); } @keyframes drift { from { translate: -60px 0; } to { translate: 60px 0; } }
    .out { padding-left: 0; margin-right: var(--pad); } .out li { border-radius: 0 10px 10px 0; }
  }
</style>
