---
// Hero to compare: a big blue panel with the button to OpenScholar, then six colour panels in the strip, one for each community in its own colour. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import Arrow from "../../components/Arrow.astro";
import { APP, COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#ffffff" title="Hero 4: OpenScholar" description="Hero option">
  <section class="wrap">
    <div class="panel os">
      <i class="field f-ocean" aria-hidden="true"></i><Art name="sea" eager sizes="1280px" />
      <div class="c">
        <h1>The evidence workspace for research teams</h1>
        <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
        <a class="btn cta" href={APP}>Try OpenScholar<Arrow /></a>
      </div>
    </div>
    <ul aria-label="Live Evidence Communities">{COMMUNITIES.map((c) => <li><a class="panel" href={c.url} style={`--c:${c.color}`}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b><span>{c.host}</span><Arrow /></a></li>)}</ul>
    <p class="ask">Evidence Communities are public homes for a field's evidence, open to anyone. <a href="/evidence-communities/">Start your own</a></p>
  </section>
</Base>
<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); padding-top: 88px; } .os { display: grid; align-items: center; padding: 56px var(--pad); background: #0b1f6b; } .os > .field { position: absolute; inset: 0; z-index: -2; } .os > :global(.art) { z-index: -1; } .os > :global(.art)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(4 22 66 / .9) 25%, rgb(4 22 66 / .25) 80%); }
  .c { display: grid; justify-items: start; gap: 18px; } h1 { max-width: 15em; } .cta { height: 64px; padding-inline: 26px 12px; font-size: 18px; margin-top: 6px; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); } li { min-width: 0; } li a { display: grid; grid-template-rows: auto 1fr auto auto; justify-items: start; gap: 8px; height: 100%; padding: 18px; background: color-mix(in srgb, var(--c) 26%, #070c2e); transition: background .25s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 42%, #070c2e); } li img { width: 84px; height: 84px; object-fit: contain; filter: saturate(1.4) drop-shadow(0 0 12px color-mix(in srgb, var(--c) 55%, transparent)); } li b { align-self: start; margin-top: 6px; font-weight: 500; font-size: 17px; line-height: 1.2; letter-spacing: -.01em; text-wrap: balance; } li span { font: 400 12px/1.25 var(--mono); opacity: .82; max-width: 100%; overflow: clip; text-overflow: ellipsis; white-space: nowrap; } li a :global(i) { display: grid; transition: transform .25s var(--ease); } li a:hover :global(i) { transform: translateX(4px); }
  .ask { padding-inline: var(--pad); font-size: 16px; line-height: 1.4; color: var(--t2); text-align: center; } .ask a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 1000px) { .os { padding: 64px 72px; } ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
