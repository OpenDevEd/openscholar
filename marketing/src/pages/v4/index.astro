---
// Hero to compare: the search box above the real size of the field for one question, every paper a tile, so you see why search alone isn't enough. The communities follow as their own section. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import Literature from "../../components/Literature.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#040b2e" title="Hero 4: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p>Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="inner field view" data-in><Literature /></div>
  </section>
  <section class="bleed ec light">
    <div class="inner t"><h2>Evidence Communities are public homes for a field's evidence</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
    <div class="inner"><ul>{COMMUNITIES.map((c) => <li><a href={c.url}><img src={`/img/art-scene-${c.key}-480.avif`} width="480" height="480" decoding="async" loading="lazy" alt="" /><b>{c.name}</b><span>{c.host}</span></a></li>)}</ul></div>
  </section>
</Base>
<style>
  .hero { padding: 128px 0 72px; background: #040b2e; color: #fff; } .c { display: grid; justify-items: center; gap: 16px; text-align: center; } h1 { max-width: 15em; font-weight: 500; font-size: clamp(38px, 5vw, 60px); letter-spacing: -.035em; line-height: 1.04; text-wrap: balance; } .c > p { font-size: 19px; line-height: 1.35; opacity: .86; } .c :global(.big) { width: min(100%, 720px); margin-top: 6px; } .field { margin-top: 48px; }
  .ec { padding: 64px 0 72px; background: var(--soft); color: var(--ink); } .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; } h2 { max-width: 20em; font-weight: 500; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -.03em; line-height: 1.1; text-wrap: balance; } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: 15px; transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; margin-top: 28px; } li { min-width: 0; } li a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; } li img { width: 100%; height: auto; aspect-ratio: 1; border-radius: 14px; object-fit: cover; margin-bottom: 6px; transition: filter .25s var(--ease); } li a:hover img { filter: brightness(1.15); } li b { font-weight: 500; font-size: 15px; line-height: 1.2; letter-spacing: -.01em; } li span { color: var(--t2); font: 400 12px/1.25 var(--mono); overflow: clip; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 1000px) { ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
