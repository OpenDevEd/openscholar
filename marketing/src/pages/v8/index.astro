---
// Hero to compare: the two names as wall-to-wall type on two bands, and the band you lean into takes the page. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import SiteGems from "../../components/SiteGems.astro";
import SiteWindow from "../../components/SiteWindow.astro";
---
<Base top="#01072c" title="Hero 8: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="band os">
      <h1><b>OpenScholar</b> <span>is where your team works through the evidence</span></h1>
      <div class="ask-w"><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
    </div>
    <div class="band ec light" data-sites>
      <h2><b>Evidence Communities</b> <span>are where anyone can read it</span></h2>
      <div class="pick"><SiteGems /></div>
      <div class="w"><SiteWindow /></div>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; --strip: calc(100vw - var(--pad) * 2); display: grid; grid-template-columns: minmax(0, 1fr); }
  .band { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: calc(var(--hu) * 18); padding-inline: var(--pad); overflow: clip; min-height: 0; }
  h1, h2 { display: grid; font-weight: 500; letter-spacing: -.02em; } h1 b, h2 b { font-weight: 500; line-height: .96; letter-spacing: -.055em; white-space: nowrap; } h1 span, h2 span { font-size: max(19px, calc(var(--hu) * 26)); letter-spacing: -.02em; line-height: 1.15; }
  h1 b { font-size: calc(var(--strip) / 5.32); background: url(/img/art-sea.avif) 50% 60% / 120% auto #3f6bff; background-blend-mode: screen; -webkit-background-clip: text; background-clip: text; color: transparent; } h2 b { font-size: calc(var(--strip) / 9.7); }
  .os { padding-top: 96px; padding-bottom: 32px; background: #01072c; color: #fff; } .os span { color: #a9bbe6; } .ask-w :global(.big) { width: 100%; } .ask-w :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .ec { padding-top: 32px; background: var(--soft); color: var(--ink); } .ec span { color: var(--t2); } .pick :global(.gems), .pick :global(.cap) { width: 100%; } .w { aspect-ratio: 16 / 10; margin-top: 8px; margin-bottom: -20px; border-radius: 14px 14px 0 0; overflow: clip; box-shadow: 0 0 0 1px var(--line), 0 36px 60px -30px rgb(10 26 63 / .6); }
  @media (min-width: 1000px) {
    .h { --hu: max(.62px, min(1px, 100svh / 900, 100vw / 1400)); --edge: max(var(--pad), calc(50vw - 624px)); --strip: calc(100vw - var(--edge) * 2); --upper: 54fr; --lower: 46fr; --pt: max(84px, calc(var(--hu) * 112)); height: 100svh; min-height: 620px; grid-template-rows: minmax(0, var(--upper)) minmax(0, var(--lower)); transition: grid-template-rows .75s .1s var(--ease); } .h:has(.ec:hover), .h:has(.ec:focus-within) { --upper: 44fr; --lower: 56fr; --fade: 0; }
    .band { padding-inline: var(--edge); } .os { align-content: start; padding-top: var(--pt); padding-bottom: 0; grid-template-columns: minmax(0, 1fr) calc(var(--hu) * 620); column-gap: calc(var(--hu) * 40); align-items: center; } .os h1 span, .ask-w { opacity: var(--fade, 1); transition: opacity .35s var(--ease); }
    .os h1 { display: contents; } .os h1 b { grid-column: 1 / -1; } .os h1 span { font-size: calc(var(--hu) * 30); max-width: 19em; text-wrap: balance; }
    .ec { padding-top: calc(var(--hu) * 22); grid-template-columns: calc(var(--hu) * 460) minmax(0, 1fr); column-gap: calc(var(--hu) * 40); grid-template-rows: auto auto 1fr; align-content: start; } .ec h2 { display: contents; } .ec h2 b { grid-column: 1 / -1; } .ec h2 span { grid-column: 1; font-size: calc(var(--hu) * 24); text-wrap: balance; } .pick { grid-column: 1; } .w { grid-area: 2 / 2 / span 2; aspect-ratio: auto; height: calc(var(--hu) * 400); margin: 0; }
  }
</style>
