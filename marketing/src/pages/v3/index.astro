---
// Hero to compare, after Typesafe AI on Mobbin: type alone on one strong colour, set out like a research paper, with the communities as its reference list. No images at all. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const COLS = [["Find", "Ask in plain language and keep control of the query. Search the whole literature, not the first page of it."], ["Screen", "Decide once, against your own criteria, and apply it to every paper. Check any decision and change it."], ["Extract", "Turn papers into a table you can check, with each value tied back to where it came from."]];
---
<Base top="#f98a76" title="Hero 3: OpenScholar" description="Hero option">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500&family=IBM+Plex+Mono&display=swap" rel="stylesheet" />
  <section class="bleed hero light">
    <div class="inner">
      <i class="m tl"></i><i class="m tr"></i>
      <h1>Evidence Work, Done Properly</h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      <div class="cols">
        {COLS.map(([h, t]) => <div><h3>{h}</h3><p>{t}</p></div>)}
        <pre aria-label="An example query">{`"peer tutoring"\nAND reading\nAND (primary\n  OR elementary)\nNOT "higher\n  education"`}</pre>
      </div>
    </div>
  </section>
  <section class="bleed ec light">
    <div class="inner g">
      <div class="t"><h2>Evidence Communities</h2><p>Public homes for a field's evidence, under their own name and address. <a href="/evidence-communities/">How they work</a></p></div>
      <ol>{COMMUNITIES.map((c, i) => <li><a href={c.url}><i>[{i + 1}]</i><span class="n"><b>{c.name}.</b> {c.text}. <u>{c.host}</u></span></a></li>)}</ol>
    </div>
  </section>
</Base>
<style>
  .ec { margin-top: calc(var(--gap) * -1); }
  h1, h2, h3 { font-family: "Schibsted Grotesk", var(--sans); font-weight: 500; }
  .hero { padding: 112px 0 72px; background: #f98a76; color: #24100c; } .inner { position: relative; } .m { display: none; position: absolute; top: -8px; width: 14px; height: 14px; border-top: 1.5px solid; } .tl { left: calc(var(--gap) + var(--pad)); border-left: 1.5px solid; } .tr { right: calc(var(--gap) + var(--pad)); border-right: 1.5px solid; }
  h1 { font-size: clamp(56px, 11vw, 148px); letter-spacing: -.05em; line-height: .9; text-align: center; text-wrap: balance; } .hero :global(.big) { width: min(100%, 820px); margin: 40px auto 0; border-radius: 4px; box-shadow: none; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; margin-top: 56px; } .cols > div { padding-left: 12px; border-left: 1.5px solid; } h3 { font: 400 13px/1 "IBM Plex Mono", var(--mono); } .cols p { margin-top: 24px; font-family: "Schibsted Grotesk", var(--sans); font-size: 18px; line-height: 1.22; } pre { margin: 0; font: 400 13px/1.35 "IBM Plex Mono", var(--mono); white-space: pre; }
  .ec { padding: 64px 0 88px; background: #fff7f2; color: #24100c; } .g { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; } h2 { font-size: clamp(36px, 4vw, 52px); letter-spacing: -.04em; line-height: 1; } .t p { margin-top: 14px; font-size: 17px; line-height: 1.35; } .t a { text-decoration: underline; text-underline-offset: 3px; }
  ol { display: grid; font-family: "IBM Plex Mono", var(--mono); } li + li { border-top: 1.5px solid rgb(36 16 12 / .16); } li a { display: grid; grid-template-columns: 36px minmax(0, 1fr); padding: 14px 0; font-size: 14px; line-height: 1.5; transition: background .15s var(--ease); } li a:hover { background: #ffe6dc; } li i { font-style: normal; color: #b4472f; } .n b { font-weight: 400; color: #24100c; font-family: "Schibsted Grotesk", var(--sans); font-size: 18px; line-height: 1.2; } li u { color: #b4472f; text-underline-offset: 3px; }
  @media (min-width: 1000px) { .m { display: block; } .cols { grid-template-columns: repeat(3, minmax(0, 1fr)) 170px; gap: 24px; } .g { grid-template-columns: 380px minmax(0, 1fr); gap: 64px; } }
</style>
