---
// Hero to compare: two arched doorways, and the one you lean towards opens wider. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import SiteGems from "../../components/SiteGems.astro";
import SiteWindow from "../../components/SiteWindow.astro";
---
<Base top="#0a1236" title="Hero 3: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="d os"><Art name="hero-stream" eager sizes="(max-width: 999px) 100vw, 60vw" /><div class="c">
      <h1>OpenScholar</h1><p>Where your team works through the evidence: find the literature, screen it and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div></div>
    <div class="d ec light" data-sites><div class="c">
      <h2>Evidence Communities</h2><p>Where anyone can read a field's evidence, each under its own name and address.</p>
      <div class="w"><SiteWindow /></div>
      <SiteGems />
      <a class="all" href="/evidence-communities/">How they work<Arrow /></a>
    </div></div>
  </section>
</Base>
<style>
  .h { --hu: 1px; display: grid; gap: 12px; padding: 88px 12px 0; background: #0a1236; }
  .d { position: relative; isolation: isolate; overflow: clip; display: grid; justify-items: center; padding: 64px 24px 40px; border-radius: 50% 50% 0 0 / 56px 56px 0 0; text-align: center; }
  .os { background: #01072c; color: #fff; padding-bottom: 56vw; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .22); } .os > :global(.art) { inset: auto 0 0; height: auto; aspect-ratio: 16 / 9; z-index: -1; -webkit-mask-image: linear-gradient(transparent, #000 28%); mask-image: linear-gradient(transparent, #000 28%); }
  .ec { background: var(--soft); color: var(--ink); }
  .c { display: grid; justify-items: center; align-content: start; gap: calc(var(--hu) * 14); width: min(100%, calc(var(--hu) * 560)); } h1, h2 { font-weight: 500; font-size: clamp(38px, 9vw, calc(var(--hu) * 60)); letter-spacing: -.035em; line-height: 1.04; } h2 { font-size: clamp(30px, 7.6vw, calc(var(--hu) * 44)); } .os p { opacity: .86; } p { max-width: 30em; font-size: max(15px, calc(var(--hu) * 18)); line-height: 1.35; } .ec p { color: var(--t2); font-size: max(14px, calc(var(--hu) * 16)); }
  .c :global(.big) { width: 100%; margin-top: 6px; } .c :global(.big input) { height: max(46px, calc(var(--hu) * 60)); }
  .w { width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; box-shadow: 0 0 0 1px var(--line), 0 24px 44px -28px rgb(10 26 63 / .6); } .ec :global(.gems), .ec :global(.cap) { width: 100%; text-align: left; }
  .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(13px, calc(var(--hu) * 15)); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  @media (min-width: 1000px) {
    .h { --hu: max(.62px, min(1px, 100svh / 900, 100vw / 1400)); --l: 56fr; --r: 44fr; height: 100svh; min-height: 620px; padding: calc(max(80px, var(--hu) * 84)) calc(var(--hu) * 16) 0; grid-template-columns: var(--l) var(--r); transition: grid-template-columns .7s var(--ease); } .h:has(.ec:hover) { --l: 42fr; --r: 58fr; } .h:has(.os:hover) { --l: 62fr; --r: 38fr; }
    .d { padding: calc(var(--hu) * 72) 32px 0; border-radius: 50% 50% 0 0 / calc(var(--hu) * 110) calc(var(--hu) * 110) 0 0; min-width: 0; } .os { padding-top: calc(var(--hu) * 150); }
    .c { width: calc(var(--hu) * 520); } .w { aspect-ratio: auto; height: calc(var(--hu) * 296); } h1 { font-size: calc(var(--hu) * 76); }
  }
</style>
