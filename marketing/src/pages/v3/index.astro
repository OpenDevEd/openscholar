---
// Hero to compare: the workspace in the night above; below it a small town in morning light, one glass pavilion per community, each with its name on a sign. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const SPOT = { aied: [10, 76.5], wi: [26, 67], eccar: [42, 60.5], tvet: [58, 59.5], aimea: [74.5, 65.5], usaid: [91, 75] };
---
<Base top="#01072c" title="Hero 3: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="os">
      <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="ec light">
      <div class="t"><h2><b>Evidence Communities</b> are where anyone can read it</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
      <div class="town"><Art name="hero-town" /><ul>{COMMUNITIES.map((c) => <li style={`--x:${SPOT[c.key][0]};--y:${SPOT[c.key][1]}`}><a href={c.url}><b>{c.name}</b><span>{c.host}</span></a></li>)}</ul></div>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; display: grid; grid-template-columns: minmax(0, 1fr); }
  h1, h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.06; text-wrap: balance; } h1 b, h2 b { font-weight: inherit; }
  .os { display: grid; justify-items: center; gap: calc(var(--hu) * 24); padding: 104px var(--pad) 32px; background: #01072c; color: #fff; text-align: center; } h1 { max-width: 15em; font-size: clamp(34px, 8.4vw, calc(var(--hu) * 56)); color: #a9bbe6; } h1 b { color: #fff; } .os :global(.big) { width: min(100%, calc(var(--hu) * 760)); } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .ec { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding: 32px var(--pad) 24px; background: var(--soft); color: var(--ink); overflow: clip; } .town { display: grid; gap: 12px; } .town > :global(.art) { position: relative; inset: auto; width: calc(100% + var(--pad) * 2); margin-inline: calc(var(--pad) * -1); height: auto; aspect-ratio: 16 / 9; } .town > :global(.art img) { position: static; }
  .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; } h2 { font-size: clamp(24px, 5.6vw, calc(var(--hu) * 32)); color: var(--t2); } h2 b { color: var(--ink); } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(14px, calc(var(--hu) * 15)); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  ul { display: grid; gap: 4px; } li a { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; background: #fff; box-shadow: 0 0 0 1px var(--line); transition: box-shadow .2s var(--ease); } li a:hover { box-shadow: 0 0 0 2px var(--brand); } li b { font-weight: 500; font-size: 15px; line-height: 1.2; letter-spacing: -.01em; } li span { color: var(--t2); font: 400 12px/1.3 var(--mono); }
  @media (min-width: 1000px) {
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); height: max(620px, calc(100svh - 32px)); grid-template-rows: auto minmax(0, 1fr); }
    .os { padding: max(88px, calc(var(--hu) * 100)) var(--edge) calc(var(--hu) * 40); gap: calc(var(--hu) * 24); }
    .ec { display: block; padding: calc(var(--hu) * 22) var(--edge) 0; } .t { position: relative; z-index: 1; } .town { --tw: min(100vw, (100svh - 32px) * 1.66); position: absolute; z-index: -1; left: 50%; bottom: 0; display: block; width: var(--tw); aspect-ratio: 16 / 9; translate: -50% 12%; } .town > :global(.art) { position: absolute; inset: 0; width: auto; margin: 0; aspect-ratio: auto; -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); } .town > :global(.art img) { position: absolute; }
    .town ul { position: absolute; inset: 0; display: block; } li { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%); width: calc(var(--hu) * 180); translate: -50% 0; } li a { padding: calc(var(--hu) * 8) calc(var(--hu) * 10); text-align: center; box-shadow: 0 0 0 1px var(--line), 0 14px 26px -16px rgb(10 26 63 / .55); } li a:hover { box-shadow: 0 0 0 2px var(--brand), 0 14px 26px -16px rgb(10 26 63 / .55); } li b { font-size: max(12px, calc(var(--hu) * 14)); } li span { font-size: max(10px, calc(var(--hu) * 11)); overflow: clip; text-overflow: ellipsis; white-space: nowrap; }
    .os :global(.big .mk), .os :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); }
  }
</style>
