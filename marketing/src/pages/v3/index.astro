---
// Hero to compare: a white page, a big plain sentence and the search box, with the real screen hanging into the navy band below. The communities are a plain list on daylight. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#ffffff" title="Hero 3: OpenScholar" description="Hero option">
  <section class="bleed hero light">
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p>Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="band"><div class="inner"><div class="w"><img src="/img/screens/screen-laptop-light.avif" width="1280" height="800" fetchpriority="high" alt="OpenScholar's screening table, with a decision on each paper against the criteria" /></div></div></div>
  </section>
  <section class="bleed ec light">
    <div class="inner g">
      <div class="t"><h2>Evidence Communities are public homes for a field's evidence</h2><p>Anyone can search and read them, each under its own name and address.</p><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
      <ul>{COMMUNITIES.map((c) => <li><a href={c.url}><img src={`/img/art-scene-${c.key}-480.avif`} width="480" height="480" decoding="async" loading="lazy" alt="" /><span class="n"><b>{c.name}</b><span>{c.host}</span></span><Arrow /></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 136px 0 0; background: #fff; color: var(--ink); } .c { display: grid; justify-items: center; gap: 20px; text-align: center; } h1 { max-width: 13em; font-weight: 500; font-size: clamp(42px, 6.4vw, 84px); letter-spacing: -.045em; line-height: 1; text-wrap: balance; } .c > p { max-width: 32em; font-size: 20px; line-height: 1.35; color: var(--t2); } .c :global(.big) { width: min(100%, 720px); margin-top: 8px; box-shadow: 0 0 0 1px var(--line2), 0 24px 40px -22px rgb(10 26 63 / .35); }
  .band { margin-top: 56px; padding-top: 0; background: linear-gradient(#fff 180px, #01072c 180px); } .w { border-radius: 16px 16px 0 0; overflow: clip; box-shadow: 0 0 0 1px var(--line2), 0 40px 70px -34px rgb(10 26 63 / .6); } .w img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 8.4; object-fit: cover; object-position: 0 0; max-width: none; }
  .ec { padding: 72px 0; background: var(--soft); color: var(--ink); } .g { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; } .t { display: grid; justify-items: start; align-content: start; gap: 14px; } h2 { font-weight: 500; font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -.03em; line-height: 1.08; text-wrap: balance; } .t p { font-size: 18px; line-height: 1.4; color: var(--t2); } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: 15px; transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  ul { display: grid; gap: 2px; margin-inline: -10px; } li a { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 10px; border-radius: 16px; transition: background .2s var(--ease), box-shadow .2s var(--ease); } li a:hover { background: #fff; box-shadow: 0 0 0 1px var(--line); } li a > img { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; } .n { display: grid; gap: 2px; min-width: 0; } .n b { font-weight: 500; font-size: 18px; line-height: 1.2; letter-spacing: -.015em; } .n span { color: var(--t2); font: 400 13px/1.3 var(--mono); overflow: clip; text-overflow: ellipsis; white-space: nowrap; } li a :global(i) { display: grid; color: var(--brand); transition: transform .25s var(--ease); } li a:hover :global(i) { transform: translateX(4px); }
  @media (min-width: 1000px) { .g { grid-template-columns: 420px minmax(0, 1fr); gap: 72px; } .t { position: sticky; top: 96px; } }
</style>
