---
// Hero to compare: OpenScholar and its search in the sky, a planet rising beneath it, and the communities standing along its bright horizon, following the curve. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { APP, COMMUNITIES } from "../../data/site.mjs";
const DROP = [128, 58, 16, 16, 58, 128];
---
<Base top="#02062c" title="Hero 3: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <img class="p" src="/img/art-hero-planet.avif" srcset="/img/art-hero-planet-960.avif 960w, /img/art-hero-planet.avif 1672w" sizes="max(1440px, 100vw)" width="1672" height="941" fetchpriority="high" alt="" />
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <div class="acts"><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /><a class="btn cta" href={APP}>Try OpenScholar<Arrow /></a></div>
    </div>
    <div class="inner">
      <ul>{COMMUNITIES.map((c, i) => <li style={`--d:${DROP[i]}px;--c:${c.color}`}><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b></a></li>)}</ul>
      <div class="cc"><h2>Evidence Communities are where anyone can read it</h2><a class="btn rose" href="/evidence-communities/">Explore communities<Arrow /></a></div>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 112px 0 40px; background: #02062c; text-align: center; } .p { position: absolute; z-index: -1; left: 50%; top: 280px; width: 190vw; height: auto; max-width: none; translate: -50% 0; }
  .c { display: grid; justify-items: center; gap: 22px; } h1 { max-width: 13em; font-size: clamp(38px, 4.6vw, 62px); } .acts { display: grid; justify-items: center; gap: 10px; width: 100%; } .acts :global(.big) { width: 100%; } .cta { height: 64px; padding-inline: 26px 12px; font-size: 18px; white-space: nowrap; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 56vw; } li { min-width: 0; } li a { display: grid; justify-items: center; gap: 8px; padding: 10px 6px; border-radius: 16px; transition: background .2s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 20%, transparent); } li img { width: 64px; height: 64px; object-fit: contain; filter: saturate(1.4) drop-shadow(0 0 12px color-mix(in srgb, var(--c) 50%, transparent)); transition: transform .35s var(--ease); } li a:hover img { transform: translateY(-4px) scale(1.06); } li b { font-weight: 500; font-size: 14.5px; line-height: 1.2; letter-spacing: -.005em; text-wrap: balance; }
  .cc { display: grid; justify-items: center; gap: 14px; margin-top: 24px; } h2 { max-width: 16em; font-size: clamp(24px, 2.2vw, 30px); letter-spacing: -.02em; line-height: 1.14; } .rose { --chip: #be123c; }
  @media (min-width: 1000px) { .hero { padding-top: 120px; padding-bottom: 48px; } .p { top: 38px; width: max(1440px, 100%); } .acts { grid-template-columns: minmax(0, 1fr) auto; width: min(100%, 820px); } ul { position: relative; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: start; margin-top: 96px; } li { margin-top: var(--d); } .cc { margin-top: -96px; } }
</style>
