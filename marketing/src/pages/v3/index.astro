---
// Hero to compare. The idea, from Equals: the product's own data is the picture. Every paper on one real question is a lit tile, rising across the page, with the first page of results picked out in amber. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { counts, firstPage } from "../../data/field.mjs";
const years = Array.from({ length: 2026 - 1972 + 1 }, (_, i) => 1972 + i);
const picks = (y) => firstPage.filter(([f]) => f === y).length;
const total = Object.values(counts).reduce((a, b) => a + b, 0);
---
<Base top="#040b2e" title="Hero 3: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <i class="field f-night" aria-hidden="true"></i>
    <div class="inner c">
      <h1>See the whole field before you read a page</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="sky" role="img" aria-label={`${total} papers on peer tutoring and reading, 1972 to 2026, rising steeply. The ten on the first page of results are a tiny part of them.`}>
      {years.map((y, i) => <div class="y" style={`--n:${(counts[y] ?? 0) - picks(y)};--p:${picks(y)};--i:${i}`}><i class="b"></i><i class="a"></i></div>)}
    </div>
    <div class="key inner"><span class="k1">The first page</span><span class="k2">The other {total - firstPage.length} papers on peer tutoring and reading</span></div>
  </section>
  <section class="panel comm" style="--tint:#be123c">
    <i class="field f-rose" aria-hidden="true"></i><Art name="globe" pos="100% 50%" />
    <div class="cc"><h2>Evidence Communities give your field a public home</h2><p class="lead">Your own name and address, kept current from your sources, for anyone to search and read.</p><a class="btn" href="/evidence-communities/">Explore Evidence Communities<Arrow /></a></div>
  </section>
</Base>
<style>
  .hero { padding: 128px 0 28px; background: #040b2e; } .hero > .field { position: absolute; inset: 0; z-index: -1; }
  .c { display: grid; justify-items: start; gap: 18px; } h1 { max-width: 12em; } .c :global(.big) { width: min(100%, 600px); margin-top: 6px; } .lead { max-width: 30em; }
  .sky { --t: 3px; display: flex; align-items: flex-end; gap: 1px; height: calc(var(--t) * 92 + 8px); margin-top: 32px; padding-inline: 8px; }
  .y { position: relative; flex: 1 1 0; display: flex; flex-direction: column-reverse; min-width: 0; height: 100%; animation: rise .9s var(--ease) calc(var(--i) * 18ms) backwards; transform-origin: 50% 100%; } @keyframes rise { from { transform: scaleY(0); } }
  .b, .a { display: block; flex: none; background-repeat: repeat-y; } .b { height: calc(var(--n) * var(--t)); background-image: repeating-linear-gradient(to top, #38bdf8 0 calc(var(--t) - 1px), transparent calc(var(--t) - 1px) var(--t)); filter: drop-shadow(0 0 5px rgb(56 189 248 / .55)); } .a { height: calc(var(--p) * var(--t)); background-image: repeating-linear-gradient(to top, #fbbf24 0 calc(var(--t) - 1px), transparent calc(var(--t) - 1px) var(--t)); filter: drop-shadow(0 0 7px rgb(251 191 36 / .95)); }
  .key { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 18px; font-size: 14px; color: #c8d3ee; } .k1, .k2 { display: inline-flex; align-items: center; gap: 8px; } .k1::before, .k2::before { content: ""; width: 14px; height: 4px; background: #fbbf24; } .k2::before { background: #38bdf8; }
  .comm { min-height: 380px; display: grid; align-items: center; padding: var(--pad); background: #520116; } .comm > .field { position: absolute; inset: 0; z-index: -2; } .comm > :global(.art) { z-index: -1; opacity: .8; } .cc { display: grid; justify-items: start; gap: 18px; max-width: 560px; } .comm :global(.btn) { --chip: var(--tint); }
  @media (min-width: 1000px) { .hero { padding-top: 128px; } .sky { --t: 6px; position: relative; margin-top: -188px; padding-inline: 16px; } .c { position: relative; z-index: 1; } }
</style>
