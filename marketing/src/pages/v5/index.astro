---
// Hero to compare: every community is its own world. Six planets hang in a row beneath the search box, each opening its community. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const SPOT = [[10.5, 55.5, 67], [26.5, 49.3, 60.8], [42.3, 46, 57.5], [57.8, 46, 57.5], [73.7, 48.6, 60.1], [89.5, 55.5, 67]];
---
<Base top="#02062c" title="Hero 5: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="stage">
      <img class="p" src="/img/art-space-worlds.avif" srcset="/img/art-space-worlds-960.avif 960w, /img/art-space-worlds.avif 1672w" sizes="min(1440px, 100vw)" width="1672" height="941" fetchpriority="high" alt="" />
      <ul>{COMMUNITIES.map((c, i) => <li style={`--x:${SPOT[i][0]};--y:${SPOT[i][1]};--cy:${SPOT[i][2]};--c:${c.color}`}><a href={c.url}><i class="pl" aria-hidden="true"></i><b>{c.name}</b></a></li>)}</ul>
      <h2>Evidence Communities are where anyone can read it</h2>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 112px 0 28px; background: #02062c; text-align: center; overflow: clip; }
  .c { position: relative; z-index: 1; display: grid; justify-items: center; gap: 22px; } h1 { max-width: 13em; font-size: clamp(38px, 4.6vw, 62px); } .c :global(.big) { width: min(100%, 720px); }
  .stage { position: relative; width: min(100vw, 1440px); margin: 8px auto 0; } .p { display: none; } h2 { padding: 16px var(--pad) 8px; font-size: 22px; letter-spacing: -.02em; line-height: 1.16; text-wrap: balance; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-inline: var(--pad); margin-top: 20px; } li { min-width: 0; } li a { display: grid; justify-items: center; gap: 8px; height: 100%; padding: 8px 4px 12px; border-radius: 16px; transition: background .2s var(--ease); } .pl { --s: 124px; --w: calc(var(--s) * 100 / 13); width: var(--s); height: var(--s); border-radius: 50%; background: url(/img/art-space-worlds-960.avif) no-repeat calc(var(--s) / 2 - var(--w) * var(--x) / 100) calc(var(--s) / 2 - var(--w) * .5625 * var(--cy) / 100) / var(--w) auto; } li a:hover { background: color-mix(in srgb, var(--c) 30%, transparent); } li b { font-weight: 500; font-size: 15px; line-height: 1.2; letter-spacing: -.005em; text-wrap: balance; }
  @media (min-width: 1000px) { .hero { padding-bottom: 0; } .stage { margin-top: -224px; margin-bottom: -90px; } .pl { display: none; } .p { display: block; position: relative; z-index: -1; width: 100%; height: auto; max-width: none; } ul { display: block; margin: 0; padding: 0; } li { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%); width: 15.5%; translate: -50% 0; } li a { display: grid; align-content: start; height: auto; padding: 86% 4px 8px; border-radius: 18px; box-shadow: none; background: none; } li a:hover { background: color-mix(in srgb, var(--c) 18%, transparent); } h2 { position: absolute; left: 0; right: 0; top: 85%; padding: 0; font-size: 24px; } }
</style>
