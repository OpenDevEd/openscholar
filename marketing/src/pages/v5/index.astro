---
// Hero to compare. The idea, from Vanta's split panels: let the site's own colours separate the products. Openscholar is blue like its sections, the communities are rose like theirs, two big panels side by side in the strip. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#ffffff" title="Hero 5: OpenScholar" description="Hero option">
  <section class="two">
    <div class="panel os">
      <i class="field f-ocean" aria-hidden="true"></i><Art name="sea" eager sizes="800px" />
      <div class="x"><h1>Where your team works through the evidence</h1><p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
    </div>
    <div class="panel ec" style="--tint:#be123c">
      <i class="field f-rose" aria-hidden="true"></i><Art name="pavilion" eager pos="60% 50%" sizes="700px" />
      <div class="x"><h2>Where anyone can read it</h2><p class="lead">Evidence Communities are public homes for a field's evidence, under their own name and address.</p>
        <ul>{COMMUNITIES.map((c) => <li><a href={c.url} style={`--c:${c.color}`}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><span>{c.name}</span><Arrow /></a></li>)}</ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .two { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); padding-top: 88px; } .panel { display: grid; min-height: 560px; } .panel > .field { position: absolute; inset: 0; z-index: -2; } .panel > :global(.art) { z-index: -1; }
  .os { background: #0b1f6b; } .ec { background: #520116; } .os > :global(.art)::after, .ec > :global(.art)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgb(5 15 60 / .72), rgb(5 15 60 / .28) 70%, transparent); } .ec > :global(.art)::after { background: linear-gradient(rgb(46 2 13 / .72), rgb(46 2 13 / .38)); }
  .x { display: grid; justify-items: start; align-content: start; gap: 16px; padding: var(--pad); } h1 { font-size: clamp(38px, 4.4vw, 60px); } h2 { font-size: clamp(32px, 3.2vw, 44px); } .x :global(.big) { width: 100%; margin-top: 8px; }
  ul { display: grid; width: 100%; margin-top: 6px; } li a { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 7px 8px 7px 2px; border-radius: 10px; font-size: 15px; line-height: 1.2; transition: background .2s var(--ease); } li a:hover { background: rgb(255 255 255 / .12); } li img { width: 34px; height: 34px; object-fit: contain; filter: saturate(1.4); } li a :global(i) { display: grid; opacity: .7; transition: transform .25s var(--ease), opacity .2s var(--ease); } li a:hover :global(i) { opacity: 1; transform: translateX(3px); }
  @media (min-width: 1000px) { .two { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); padding-top: 88px; } .panel { min-height: 660px; } .x { padding: 48px; } .os .x { align-content: end; height: 100%; } .os > :global(.art)::after { background: linear-gradient(transparent 20%, rgb(5 15 60 / .82) 62%); } }
</style>
