---
// Hero to compare: one command palette, like the one in the header but huge. Type and it searches with OpenScholar, or choose a community from the list beneath. Everything you can do is in one glass object over the ribbon. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { APP, COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#040b2e" title="Hero 5: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <Art name="dark-ribbon" eager pos="50% 100%" />
    <div class="inner c"><h1>The evidence workspace for research teams</h1></div>
    <div class="inner"><div class="pal">
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      <div class="grp os">
        <div class="say"><b>OpenScholar</b><span>Find the literature, screen it and extract the data, as a team</span></div>
        <a class="btn cta" href={APP}>Try OpenScholar<Arrow /></a>
      </div>
      <div class="grp ec">
        <div class="say"><b>Evidence Communities</b><span>Public homes for a field's evidence, open to anyone</span></div>
        <a class="btn cta rose" href="/evidence-communities/">Explore communities<Arrow /></a>
        <ul>{COMMUNITIES.map((c) => <li><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><span class="n"><b>{c.name}</b><span>{c.host}</span></span><Arrow /></a></li>)}</ul>
      </div>
    </div></div>
  </section>
</Base>
<style>
  .hero { padding: 116px 0 64px; background: #040b2e; } .hero > :global(.art) { z-index: -1; -webkit-mask-image: linear-gradient(transparent 26%, #000 58%); mask-image: linear-gradient(transparent 26%, #000 58%); }
  .c { display: grid; justify-items: center; text-align: center; } h1 { max-width: 15em; font-size: clamp(38px, 4.6vw, 62px); }
  .pal { display: grid; gap: 4px; width: min(100%, 980px); margin: 32px auto 0; padding: 10px; border-radius: 28px; background: rgb(6 12 48 / .74); -webkit-backdrop-filter: blur(26px) saturate(1.5); backdrop-filter: blur(26px) saturate(1.5); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(255 255 255 / .12), 0 50px 90px -30px rgb(0 6 30 / .95); } .pal :global(.big) { width: 100%; }
  .grp { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 10px 16px; padding: 16px 14px; } .os { border-radius: 16px; background: rgb(255 255 255 / .07); margin-top: 6px; } .say { display: grid; gap: 2px; min-width: 0; } .say b { font-weight: 500; font-size: 20px; letter-spacing: -.015em; line-height: 1.2; } .say span { font-size: 15px; line-height: 1.35; color: #c8d3ee; } .cta { justify-self: start; height: 52px; white-space: nowrap; } .rose { --chip: #be123c; }
  ul { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; margin: 6px -6px -8px; } li { min-width: 0; } li a { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 12px; height: 100%; padding: 8px 10px 8px 8px; border-radius: 12px; transition: background .15s var(--ease); } li a:hover { background: rgb(255 255 255 / .1); } li a > img { width: 40px; height: 40px; object-fit: contain; filter: saturate(1.4); } .n { display: grid; gap: 1px; min-width: 0; } .n b { font-weight: 500; font-size: 15px; line-height: 1.2; letter-spacing: -.005em; } .n span { font: 400 12px/1.25 var(--mono); color: #a9bbe6; overflow: clip; text-overflow: ellipsis; white-space: nowrap; } li a :global(i) { display: grid; opacity: .7; transition: transform .2s var(--ease), opacity .15s var(--ease); } li a:hover :global(i) { opacity: 1; transform: translateX(3px); }
  @media (min-width: 1000px) { .grp { grid-template-columns: minmax(0, 1fr) auto; padding: 16px 18px; } .cta { justify-self: end; } ul { grid-template-columns: 1fr 1fr; } }
</style>
