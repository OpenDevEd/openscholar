---
// Hero to compare: the rainbow glass arch you liked, framing the headline and the button to OpenScholar, with every community standing at its foot. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import Arrow from "../../components/Arrow.astro";
import { APP, COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#040b2e" title="Hero 5: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <Art name="arch" eager pos="50% 0" />
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <a class="btn cta" href={APP}>Try OpenScholar<Arrow /></a>
    </div>
    <div class="inner"><ul>{COMMUNITIES.map((c) => <li style={`--c:${c.color}`}><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b></a></li>)}</ul>
    <p class="note">Evidence Communities are public homes for a field's evidence, open to anyone. <a href="/evidence-communities/">Start your own</a></p></div>
  </section>
</Base>
<style>
  .hero { padding: 208px 0 36px; background: #02062c; text-align: center; } .hero > :global(.art) { inset: 0 0 auto; height: auto; aspect-ratio: 16 / 9; z-index: -1; }
  .c { display: grid; justify-items: center; gap: 18px; } h1 { max-width: 11em; font-size: clamp(38px, 4.6vw, 60px); } .lead { max-width: 24em; } .cta { height: 60px; padding-inline: 26px 10px; font-size: 18px; margin-top: 2px; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 8px; margin-top: 48px; } li { min-width: 0; } li a { display: grid; justify-items: center; gap: 10px; padding: 12px 8px; border-radius: 16px; transition: background .2s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 18%, transparent); } li img { width: 72px; height: 72px; object-fit: contain; filter: saturate(1.4) drop-shadow(0 0 12px color-mix(in srgb, var(--c) 50%, transparent)); } li b { font-weight: 500; font-size: 15px; line-height: 1.22; letter-spacing: -.005em; text-wrap: balance; }
  .note { margin-top: 20px; font-size: 15px; color: #c8d3ee; } .note a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 1000px) { .hero { padding-top: 250px; } .hero > :global(.art) { left: 50%; right: auto; width: 1500px; translate: -50% 0; } ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media (max-width: 999px) { .hero { padding-top: 56vw; } .hero > :global(.art) { width: 100%; } }
</style>
