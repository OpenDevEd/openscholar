---
// Hero to compare: one picture passing from night to morning, the workspace in the dark and the public pavilion in the light. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import SiteGems from "../../components/SiteGems.astro";
---
<Base top="#01072c" title="Hero 5: OpenScholar" description="Hero option">
  <section class="bleed h">
    <Art name="hero-dawn" eager pos="50% 100%" />
    <div class="side os">
      <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
      <p>Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="side ec light" data-sites>
      <h2><b>Evidence Communities</b> are where anyone can read it</h2>
      <p>Public homes for a field's evidence, each under its own name and address.</p>
      <SiteGems />
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; position: relative; display: grid; gap: 32px; padding: 104px var(--pad) 40vw; background: #01072c; color: #fff; overflow: clip; }
  .h > :global(.art) { inset: auto 0 0; height: auto; aspect-ratio: 16 / 9; z-index: -1; } .h { padding: 0 0 56vw; gap: 0; } .os { padding: 104px var(--pad) 32px; } .ec { padding: 32px var(--pad) 24px; background: var(--soft); } .side { display: grid; justify-items: start; align-content: start; gap: calc(var(--hu) * 16); min-width: 0; }
  h1, h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.06; text-wrap: balance; } h1 b, h2 b { font-weight: inherit; } h1 { font-size: clamp(34px, 8.4vw, calc(var(--hu) * 60)); color: #a9bbe6; } h1 b { color: #fff; } h2 { font-size: clamp(30px, 7vw, calc(var(--hu) * 46)); color: var(--t2); } h2 b { color: var(--ink); }
  p { font-size: max(15px, calc(var(--hu) * 18)); line-height: 1.35; } .os p { opacity: .88; } .ec { color: var(--ink); } .ec p { color: var(--t2); }
  .os :global(.big) { width: 100%; } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); } .ec :global(.gems), .ec :global(.cap) { width: 100%; }
  @media (min-width: 1000px) {
    .h { --hu: max(.62px, min(1px, 100svh / 900, 100vw / 1400)); --edge: max(var(--pad), calc(50vw - 624px)); height: 100svh; min-height: 620px; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: calc(var(--hu) * 88); padding: calc(max(96px, var(--hu) * 128)) var(--edge) 0; } .h > :global(.art) { inset: 0; height: auto; aspect-ratio: auto; } .h::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(243 246 251 / 0) 40%, #f3f6fb 56%); -webkit-mask-image: linear-gradient(#000 52%, transparent 72%); mask-image: linear-gradient(#000 52%, transparent 72%); } .os, .ec { padding: 0; background: none; } h2 { font-size: calc(var(--hu) * 42); } .ec { margin-top: calc(var(--hu) * -20); }
  }
</style>
