---
import Base from "../../layouts/Base.astro";
import Feature from "../../components/Feature.astro";
import Faq from "../../components/Faq.astro";
import Arrow from "../../components/Arrow.astro";
import DotMap from "../../components/DotMap.astro";
import { APP } from "../../data/site.mjs";
const steps = [["Name it", "Pick a name and reserve your address."], ["Connect sources", "Bring in a Zotero group, a saved search or an OpenScholar collection."], ["Make it yours", "Set your logo, colours, languages and the features readers get."], ["Go live", "Activate it. Later changes wait in a draft until you approve them."]];
const faq = [
  ["Who controls what gets published?", "Your team does. You choose the sources, AI can screen what comes in against your subject, and records your editors write wait as drafts until an editor or owner publishes them."],
  ["How does it stay current?", "Connected sources bring in new work, and AI can screen incoming records against your subject as they arrive."],
  ["Can readers trust the AI answers?", "Answers link to the record and the page they came from, and the assistant says when it couldn't read a document."],
  ["Can we use our own domain and languages?", "Libraries have their own address and branding, and can run in several languages, including right-to-left scripts."],
];
---
<Base title="Evidence Libraries: OpenScholar" description="A public, searchable home for your field's evidence, kept current and published under your own name.">
  <section class="panel hero">
    <img class="field" src="/img/field-rose.avif" width="1200" height="750" fetchpriority="high" alt="" />
    <div class="h-top"><h1>A public home for your field's evidence</h1><div class="h-side"><p class="lead">Publish a searchable, citable library under your own name, keep it current from your sources, and let anyone question it.</p><div class="acts"><a class="btn" href={`${APP}/evidence-libraries`}>Create your library<Arrow /></a><a class="btn ghost" href="https://wealth-inequality.openscholar.ai">See a live library</a></div></div></div>
    <a class="win shot" href="https://wealth-inequality.openscholar.ai" aria-label="Wealth Inequality and Social Mobility library"><img src="/img/lib-home.avif" width="1920" height="1150" fetchpriority="high" alt="The home page of a live Evidence Library" /></a>
  </section>
  <Feature field="ocean" title="Everything your readers need to use the evidence" text="Far more than a list of PDFs. Readers can search and filter the whole collection, read each record, cite and export it, and follow new work as it arrives." points={["Search with filters and record pages", "Citations and downloads for any result", "Digests of what's new"]} img="lib-search" w={1800} h={1128} alt="A library's search page with filters and records" />
  <Feature field="amber" flip title="Answers your readers can check" text="Anyone can ask the library a question and get an answer that links to the record and the page it came from. When a document can't be read, the answer says so." img="lib-evidence" w={1240} h={640} alt="A map of research clusters in a library about AI in education" />
  <section class="panel world"><img class="field" src="/img/field-night.avif" width="1200" height="750" loading="lazy" decoding="async" alt="" /><div class="w-top"><h2>Show where your field lives</h2><p class="lead">Every library can map the people and places behind its evidence, so readers can see who's working on what, and where.</p></div><DotMap /></section>
  <section class="steps"><h2>From first draft to live library</h2><ol>{steps.map(([t, d], i) => <li style={`--c:${["#2563eb", "#0e7490", "#047857", "#c2410c"][i]}`}><span>{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}</ol></section>
  <Faq items={faq} />
  <section class="panel close"><img class="field" src="/img/field-rose.avif" width="1200" height="750" loading="lazy" decoding="async" alt="" /><h2>Open your library</h2><a class="btn" href={`${APP}/evidence-libraries`}>Create your library<Arrow /></a></section>
</Base>
<style>
  .hero { padding: var(--pad) var(--pad) 0; } .h-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 48px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); } .h-side { display: grid; gap: 20px; } .acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .shot { display: block; border-radius: 16px 16px 0 0; margin-bottom: -2px; max-height: 620px; overflow: hidden; }
  .world { padding: var(--pad); } .w-top { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; margin-bottom: 28px; }
  .steps { padding: clamp(40px, 6vw, 72px) var(--pad) 8px; } .steps h2 { margin-bottom: 28px; } ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; } li span { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 14px; border-radius: 12px; background: var(--c); color: #fff; font-weight: 500; } li p { margin-top: 6px; color: var(--t2); }
  .close { display: grid; justify-items: center; gap: 24px; padding: clamp(48px, 7vw, 96px) var(--pad); text-align: center; } .close h2 { font-size: clamp(34px, 4.6vw, 60px); }
  @media (max-width: 900px) { .h-top, .w-top { grid-template-columns: minmax(0, 1fr); } ol { grid-template-columns: minmax(0, 1fr); } .steps { padding-inline: 8px; } }
</style>
