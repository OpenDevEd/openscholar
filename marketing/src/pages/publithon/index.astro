---
import Base from "../../layouts/Base.astro";
import Device from "../../components/Device.astro";
import Art from "../../components/Art.astro";
import Arrow from "../../components/Arrow.astro";
import Faq from "../../components/Faq.astro";
import Close from "../../components/Close.astro";
import { APP } from "../../data/site.mjs";
// What a publithon is and how to take part, for anyone invited to one. No event of its own: dates, topic and sponsor
// come later, when an event needs them. Sponsors write to us through the contact form's sponsor topic.
// The steps are /publish's own (publishReports.flow.overview), in the order the app takes them. Each has a glass
// emblem of the icon its step has in the app's step trail (PenLine, Hash, FileUp, FileText, ShieldCheck, BadgeCheck).
const steps = [
  ["sign", "#3b82f6", "Sign the agreement", "You keep the copyright and publish under CC BY 4.0."],
  ["doi", "#38bdf8", "Get your DOI", "Reserved the moment you sign. It goes live with the report."],
  ["upload", "#22d3ee", "Upload your PDF", "With one line naming the series and the DOI. We can add it for you."],
  ["details", "#34d399", "Check the details", "Title, authors, ORCID iDs, institutions and funders, read from the PDF."],
  ["checks", "#a3e635", "Automatic checks", "They look for that line and for anything published before."],
  ["live", "#fbbf24", "Go live", "Once the checks pass, the DOI is registered and the report has its own page."],
];
// A real DOI taken apart into the three parts people need: where it points from, whose it is, and which work.
// The prefix is shared dev's sandbox one (10.53832); production's goes here at launch. Positions are in the mono
// font's characters (Ubuntu Mono is half an em wide), so each label sits exactly at its part.
const parts = [
  { text: "https://doi.org/", c: "#7da7e6", at: 0, side: "below", name: "The link", note: "Opens wherever the work is kept now" },
  { text: "10.53832", c: "#34d399", at: 16, side: "above", name: "The prefix", note: "10 starts every DOI; 53832 is the publisher" },
  { text: "/openscholar-reports.r100230", c: "#fbbf24", at: 24, side: "below", name: "Your report", note: "This work and no other, for good" },
];
const gains = [
  ["Cited in one paste", "Reference managers turn the DOI into a full citation."],
  ["A link that lasts", "If the report's page ever moves, the DOI follows it."],
  ["Easier to find", "Its title, authors and funders go out with the DOI, where research indexes can pick them up."],
  ["Counted when cited", "Citations that use the DOI can be traced back to your work."],
];
// What a DOI takes on your own, each beside what Openscholar does instead, row for row (laid out like Ploy's and
// Zaro's before and after sections on Mobbin). Every right-hand row is something the publish flow does today.
const chores = [
  [["Find a publisher", "A journal or repository that issues DOIs, or join a registration agency yourself"], ["Openscholar Reports publishes it", "In its own series, under your name"]],
  [["Write up the metadata", "Title, authors, affiliations and funders, in the agency's format"], ["Read from your PDF", "You check the details and change anything"]],
  [["Stamp the PDF", "Put the DOI and the series line on it yourself"], ["Added for you", "On a last page, if your PDF doesn't have it"]],
  [["Check for earlier versions", "Make sure it hasn't been published before"], ["Checked automatically", "Against published work, before it goes live"]],
  [["Register and maintain it", "Deposit the DOI, and send corrections when something changes"], ["Registered for you", "When it goes live, with corrections sent on"]],
  [["Host the file", "Keep the PDF online, so the DOI always leads somewhere"], ["Its own page", "With the PDF to read and cite"]],
];
const faq = [
  ["What can I publish?", "Your own finished work as a PDF: a report, a working paper, a policy brief or a study. You keep the copyright, and it's published under CC BY 4.0."],
  ["What if it's already published?", "Suggest it to a community instead. Every upload is checked against work that's already published."],
  ["What does AI do here?", "It reads the title, authors, institutions and funders from your PDF, so you don't type them in. You check them and change anything before the report goes live."],
  ["Does anyone review my report first?", "No. Automatic checks look for the series line with your DOI and for anything published before, and once they pass, your report goes live straight away."],
  ["Can I run a publithon for my field?", "Yes. Tell us the topic and who you'd invite, and we'll plan it with you."],
];
---
<Base og="/og.jpg" top="#070b1a" title="Publithon: Openscholar" description="Publish your research at a publithon: bring a finished report or paper, and it goes live with its own DOI, under your name and open for anyone to read and cite.">
  <section class="bleed hero">
    <Art name="pub-rise" eager pos="70% 100%" class="h-art" />
    <div class="inner h-copy">
      <h1>Publish together</h1>
      <p class="lead">At a publithon, researchers publish their own work at the same time, each piece with its own DOI. Bring a finished report or paper, and it goes live under your name for anyone to read and cite.</p>
      <div class="acts"><a class="btn" href={`${APP}/publish`}>Publish your work<Arrow /></a><a class="btn ghost" href="#sponsor">Sponsor a publithon</a></div>
    </div>
  </section>

  {/* The steps, right under the hero and on the same night sky, one full screen. The icons are the picture: six
      emblems on one thread (after Giga's lit progress line, Mobbin). As the row comes on screen a light runs along
      it, each emblem pops alight as it passes, and the run ends on the DOI, typed out. After that the emblems drift,
      and a light keeps passing along the thread, each emblem answering as it goes by. */}
  <section class="bleed how" id="publish" aria-labelledby="how-h" data-how>
    <div class="inner how-in">
      <div class="how-head" data-in><h2 id="how-h">From PDF to DOI in a few clicks</h2><p class="lead">About five minutes from start to finish. Once the automatic checks pass, your report goes live straight away.</p></div>
      <ol class="road">
        <i class="thread" aria-hidden="true"><i></i><b></b></i>
        {steps.map(([id, c, t, d], i) => <li style={`--i:${i};--c:${c}`}><span class="em"><img src={`/img/step-${id}.avif`} width="400" height="400" loading="lazy" decoding="async" alt="" /></span><b>{t}</b><span class="d">{d}</span></li>)}
      </ol>
      <p class="arrive"><span class="a-doi">https://doi.org/10.53832/openscholar-reports.r100230</span></p>
    </div>
  </section>

  {/* What a DOI is: a real one labelled part by part, and the page its link opens, with what the DOI does beside it. */}
  <section class="doi" id="doi" aria-labelledby="doi-h">
    <div class="d-head"><h2 id="doi-h">What's a DOI?</h2><p class="lead">A DOI is a permanent ID for one piece of work. Its link always leads to that work, wherever it's kept, and it's what journals, libraries and reference managers use to cite it.</p></div>
    <div class="panel anat">
      <figure class="dia" data-in aria-label="The parts of a DOI">
        <p class="dstr">{parts.map((pt, i) => <span class="pt" style={`--c:${pt.c};--i:${i}`}>{pt.text}</span>)}</p>
        {parts.map((pt, i) => <figcaption class:list={["tag", pt.side]} style={`--c:${pt.c};--at:${pt.at};--i:${i}`}><b>{pt.name}</b><span>{pt.note}</span></figcaption>)}
      </figure>
      <div class="lands">
        <ul class="gains">{gains.map(([t, d], i) => <li style={`--i:${i}`}><b>{t}</b><span>{d}</span></li>)}</ul>
        <div class="d-shot" data-in><Device kind="laptop" name="r-page" theme="light" alt="The page a report's DOI opens, with its authors, topics, abstract and PDF" sizes="(max-width: 900px) 100vw, 720px" /></div>
      </div>
    </div>
  </section>

  {/* The paperwork a DOI takes on your own, crossed off row by row beside what's done for you instead. The picture
      over the two columns is the same story: the cold pile over "On your own", the sealed page over "With Openscholar". */}
  <section class="chores" id="done" aria-labelledby="ch-h">
    <div class="ch-head"><h2 id="ch-h">We do the paperwork</h2><p class="lead">On your own, a DOI means going through a journal or repository, or joining a registration agency and doing the rest yourself. Here it's done for you.</p></div>
    <div class="panel ch-table" data-in>
      <img class="ch-art" src="/img/art-pub-paperwork-wide.avif" srcset="/img/art-pub-paperwork-wide-960.avif 960w, /img/art-pub-paperwork-wide.avif 1672w" sizes="(max-width: 1280px) 100vw, 1280px" width="1672" height="941" loading="lazy" decoding="async" alt="" />
      <div class="ch-cols" role="table" aria-label="What a DOI takes on your own, and what Openscholar does instead">
        <div class="ch-row ch-th" role="row"><span role="columnheader">On your own</span><i class="ch-arrow" aria-hidden="true"><Arrow /></i><span role="columnheader">With Openscholar</span></div>
        {chores.map(([[wt, wd], [nt, nd]], i) => <div class="ch-row" role="row" style={`--i:${i}`}><span class="was" role="cell"><b>{wt}</b><span>{wd}</span></span><span class="now" role="cell"><b>{nt}</b><span>{nd}</span></span></div>)}
      </div>
    </div>
  </section>

  {/* Two doors: new work is published, work that's already out is suggested to a community. */}
  <section class="ways" id="ways" aria-labelledby="ways-h">
    <h2 id="ways-h">Two ways to take part</h2>
    <div class="doors">
      <a class="panel door d-new" href={`${APP}/publish`} data-in>
        <img class="d-art" src="/img/art-pub-new.avif" width="1024" height="1536" loading="lazy" decoding="async" alt="" />
        <span class="d-copy"><b>Your own new work</b><span>A report, paper or study you wrote, published with its own DOI.</span><span class="d-go">Publish it<Arrow /></span></span>
      </a>
      <a class="panel door d-gap" href={`${APP}/communities`} data-in>
        <img class="d-art" src="/img/art-pub-gap.avif" width="1024" height="1536" loading="lazy" decoding="async" alt="" />
        <span class="d-copy"><b>Work that's already out</b><span>A community on your topic is missing a paper? Suggest it, and its editors add it.</span><span class="d-go">Find a community<Arrow /></span></span>
      </a>
    </div>
  </section>

  {/* Sponsors: the world lights up from the medallion as the section arrives, then stays alive. The one picture is
      laid over itself in layers: unlit, lit, a ring of light that runs up the threads to the medallion, and two
      sets of places that glow and dim. */}
  <section class="bleed sponsor" id="sponsor" aria-labelledby="sp-h" data-sponsor>
    <div class="s-world" aria-hidden="true">
      {["dark", "lit", "pulse", "spark sa", "spark sb"].map((k) => <div class={`w w-${k}`}><img src="/img/art-pub-world.avif" srcset="/img/art-pub-world-960.avif 960w, /img/art-pub-world.avif 1672w" sizes="(max-width: 900px) 160vw, 1440px" width="1672" height="941" loading="lazy" decoding="async" alt="" /></div>)}
      <i class="w-sun"></i>
    </div>
    <div class="inner s-copy">
      <h2 id="sp-h" data-in>Sponsor a publithon</h2>
      <p class="lead" data-in style="--d:.1s">Back a publithon on a topic or a region you care about. We plan it with you, and afterwards you see every report it brought in and where its authors work.</p>
      <div data-in style="--d:.2s"><a class="btn" href="/contact/?topic=sponsor">Talk to us about sponsoring<Arrow /></a></div>
    </div>
  </section>

  <Faq items={faq} title="Questions about publithons" />
  <Close title="Give your work a DOI" art="close-green"><a slot="action" class="btn" href={`${APP}/publish`}>Publish your work<Arrow /></a></Close>
</Base>
<script>
  // The steps play once, when half the row of emblems is on screen. What keeps moving afterwards rests while the
  // section is off screen.
  const how = document.querySelector<HTMLElement>("[data-how]");
  if (how) {
    new IntersectionObserver(([e], io) => { if (!e.isIntersecting) return; io.disconnect(); how.classList.add("play"); }, { threshold: .5 }).observe(how.querySelector(".road")!);
    new IntersectionObserver(([e]) => how.classList.toggle("away", !e.isIntersecting)).observe(how);
  }
  // The sponsors' world lights once a third of it is on screen, and rests off screen too.
  const sponsor = document.querySelector<HTMLElement>("[data-sponsor]");
  if (sponsor) {
    new IntersectionObserver(([e], io) => { if (!e.isIntersecting) return; io.disconnect(); sponsor.classList.add("play"); }, { threshold: .35 }).observe(sponsor);
    new IntersectionObserver(([e]) => sponsor.classList.toggle("away", !e.isIntersecting)).observe(sponsor);
  }
</script>
<style>
  @keyframes up { from { opacity: 0; transform: translateY(20px); } }

  /* The sheets rise off the horizon behind the words; the words sit in the calm sky on the left. */
  .hero { background: var(--night); min-height: clamp(620px, 52vw, 760px); padding-block: clamp(150px, 13vw, 210px) clamp(120px, 12vw, 180px); }
  .hero > :global(.h-art) { -webkit-mask-image: linear-gradient(transparent, #000 12%); mask-image: linear-gradient(transparent, #000 12%); }
  .hero > :global(.h-art img) { animation: rise 2.6s var(--ease) both; } @keyframes rise { from { opacity: 0; transform: translateY(36px) scale(1.04); } }
  /* The words keep a calm night behind them wherever the art runs under them. */
  .hero::before, .sponsor::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, rgb(7 11 26 / .88), rgb(7 11 26 / .62) 36%, transparent 60%); }
  /* The Earth sinks into the same night the steps stand on, so the two read as one sky. */
  .hero::after { content: ""; position: absolute; inset: auto 0 0; height: 140px; z-index: -1; pointer-events: none; background: linear-gradient(transparent, var(--night)); }
  .h-copy { position: relative; display: grid; gap: 22px; justify-items: start; }
  .h-copy h1 { font-size: clamp(56px, 8.4vw, 128px); line-height: .94; letter-spacing: -.045em; max-width: 7em; }
  .h-copy .lead { max-width: 29em; color: rgb(255 255 255 / .86); }
  .h-copy > * { animation: up .9s var(--ease) both; } .h-copy > :nth-child(2) { animation-delay: .08s; } .h-copy > :nth-child(3) { animation-delay: .16s; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; }

  /* Two tall doors side by side, the art filling each and the words at its foot. */
  /* Dark blocks take the strip's full width, as the panels do; headings and text keep the margin. */
  .ways { display: grid; gap: clamp(20px, 2.4vw, 32px); padding-top: clamp(72px, 8vw, 120px); } .ways h2 { padding-inline: var(--pad); }
  .ways h2 { font-size: clamp(30px, 3.2vw, 44px); }
  .doors { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .door { display: grid; align-content: end; min-height: clamp(520px, 46vw, 660px); padding: clamp(24px, 3vw, 40px); color: #fff; }
  .d-new { --bg: #02261d; } .d-gap { --bg: #2a0410; }
  .d-art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1.2s var(--ease), filter .6s var(--ease); -webkit-mask-image: linear-gradient(#000 52%, transparent 92%); mask-image: linear-gradient(#000 52%, transparent 92%); filter: brightness(.86); }
  .door:hover .d-art { transform: scale(1.04); filter: none; }
  .d-copy { display: grid; gap: 10px; max-width: 26em; } .d-copy b { font-weight: 500; font-size: clamp(26px, 2.6vw, 36px); line-height: 1.08; letter-spacing: -.02em; } .d-copy > span:not(.d-go) { color: rgb(255 255 255 / .8); font-size: 17px; line-height: 1.45; }
  .d-go { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-weight: 500; font-size: 17px; } .d-go :global(i) { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: #fff; color: var(--ink); transition: transform .3s var(--ease); } .door:hover .d-go :global(i) { transform: translateX(4px); }

  /* A DOI labelled like a diagram: each label at its own part, joined to it by a short line in the part's colour. */
  .doi { display: grid; gap: clamp(28px, 3.4vw, 48px); padding-top: clamp(72px, 8vw, 120px); }
  .d-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; padding-inline: var(--pad); } .d-head h2 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -.035em; }
  .anat { --bg: var(--night); display: grid; gap: clamp(28px, 3vw, 44px); padding: var(--pad) var(--pad) 0; }
  .dia { --fs: clamp(18px, 2.85vw, 40px); --above: 64px; --below: 72px; position: relative; margin: 0; padding-block: var(--above) var(--below); font-size: var(--fs); }
  .dstr { margin: 0; font: 400 1em/1.1 var(--mono); letter-spacing: 0; white-space: nowrap; }
  .pt { position: relative; color: #fff; } .pt::after { content: ""; position: absolute; left: 1px; right: 1px; bottom: -10px; height: 4px; border-radius: 4px; background: var(--c); box-shadow: 0 0 16px color-mix(in srgb, var(--c) 70%, transparent); }
  .tag { position: absolute; left: calc(var(--at) * var(--fs) / 2); display: grid; gap: 2px; padding-left: 14px; font: 400 16px/1.35 var(--sans); white-space: nowrap; }
  .tag::before { content: ""; position: absolute; left: 0; width: 2px; border-radius: 2px; background: var(--c); }
  .tag b { font-weight: 500; font-size: 17px; color: var(--c); } .tag span { color: rgb(255 255 255 / .72); font-size: 15px; }
  /* The DOI line is var(--fs) * 1.1 tall; labels below start under its colour bar, labels above end over the text. */
  .tag.below { top: calc(var(--above) + var(--fs) * 1.1 + 20px); } .tag.below::before { top: -12px; bottom: 4px; }
  .tag.above { bottom: calc(var(--below) + var(--fs) * 1.1 + 6px); } .tag.above::before { top: 4px; bottom: -6px; }
  :global(.js) .dia[data-in] { opacity: 1; transform: none; } :global(.js) .dia:not(.in) .pt::after { transform: scaleX(0); } :global(.js) .dia:not(.in) .tag { opacity: 0; translate: 0 8px; }
  :global(.js) .dia.in .pt::after { transform-origin: left; transition: transform .7s var(--ease) calc(.15s + var(--i) * .35s); } :global(.js) .dia.in .tag { transition: opacity .5s var(--ease) calc(.4s + var(--i) * .35s), translate .6s var(--ease) calc(.4s + var(--i) * .35s); }
  /* Under the DOI, what it opens: the report's page rising out of the panel, and what the DOI does for it beside. */
  .lands { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(24px, 3.4vw, 56px); align-items: end; }
  .gains { display: grid; margin: 0; padding: 0 0 var(--pad); list-style: none; align-self: center; }
  .gains li { display: grid; gap: 4px; padding-block: 16px; border-top: 1px solid rgb(255 255 255 / .1); } .gains li:first-child { border-top: 0; padding-top: 0; }
  .gains b { font-weight: 500; font-size: 18px; letter-spacing: -.01em; } .gains span { color: rgb(255 255 255 / .62); font-size: 15px; line-height: 1.45; }
  .d-shot { margin-bottom: -7%; } .d-shot :global(.body) { padding: 0; border-radius: 14px 14px 0 0; background: none; box-shadow: 0 0 0 1px rgb(255 255 255 / .24), 0 -10px 70px -10px rgb(125 167 230 / .35), 0 40px 90px -30px #000; } .d-shot :global(.glass) { border-radius: 14px 14px 0 0; } .d-shot :global(.cam), .d-shot :global(.deck), .d-shot :global(.sheen) { display: none; }

  /* The paperwork: one table, its left column muted and crossed off row by row, its right column lit. */
  .chores { display: grid; gap: clamp(28px, 3.4vw, 48px); padding-top: clamp(72px, 8vw, 120px); }
  .ch-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; padding-inline: var(--pad); } .ch-head h2 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -.035em; }
  .ch-table { --bg: #010c28; display: grid; }
  .ch-art { display: block; width: 100%; aspect-ratio: 1672 / 640; object-fit: cover; object-position: 50% 70%; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  .ch-cols { display: grid; padding: 0 var(--pad) var(--pad); margin-top: clamp(-56px, -3vw, -24px); position: relative; }
  .ch-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(32px, 5vw, 80px); border-top: 1px solid rgb(255 255 255 / .1); }
  .ch-row > span { display: grid; gap: 4px; padding-block: 18px; } .ch-row b { font-weight: 500; font-size: clamp(17px, 1.5vw, 20px); letter-spacing: -.01em; width: fit-content; } .ch-row > span > span { font-size: 15px; line-height: 1.45; }
  .ch-th { border-top: 0; align-items: center; } .ch-th > span { padding-block: 0 14px; font-size: 14px; font-weight: 500; letter-spacing: .01em; color: rgb(255 255 255 / .6); } .ch-th > span:last-child { color: #ffd68c; }
  .ch-arrow { position: absolute; left: 50%; top: -6px; translate: -50% 0; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #fff; color: var(--ink); }
  .was b { color: rgb(255 255 255 / .62); } .was > span { color: rgb(255 255 255 / .42); }
  .now b { color: #fff; } .now > span { color: rgb(255 255 255 / .7); }
  /* The strike is drawn across each job's title, one row after another, as the table arrives. */
  .was b { background: linear-gradient(rgb(255 255 255 / .7), rgb(255 255 255 / .7)) no-repeat 0 55% / 100% 1.5px; }
  :global(.js) .ch-table[data-in] { opacity: 1; transform: none; }
  :global(.js) .ch-table:not(.in) .was b { background-size: 0 1.5px; } :global(.js) .ch-table.in .was b { transition: background-size .5s cubic-bezier(.65, 0, .35, 1) calc(.3s + var(--i) * .3s); }
  :global(.js) .ch-table:not(.in) .now { opacity: 0; translate: -10px 0; } :global(.js) .ch-table.in .now { transition: opacity .5s var(--ease) calc(.5s + var(--i) * .3s), translate .6s var(--ease) calc(.5s + var(--i) * .3s); }

  /* The steps: one full screen under the hero, flush with it so the two are one sky. A step lights every --dt, from --t0. */
  .how { --t0: .1s; --dt: .36s; background: var(--night); margin-top: calc(var(--gap) * -1); min-height: 100vh; min-height: 100svh; display: grid; align-items: center; padding-block: 112px 72px; }
  .how-in { display: grid; gap: clamp(40px, 4.6vw, 64px); }
  .how-head { display: grid; justify-items: center; gap: 14px; text-align: center; } .how-head h2 { font-size: clamp(32px, 3.6vw, 52px); line-height: 1.05; letter-spacing: -.03em; } .how-head .lead { max-width: 34em; color: rgb(255 255 255 / .76); }
  .road { --em: clamp(104px, 10.4vw, 150px); position: relative; isolation: isolate; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 clamp(8px, 1.2vw, 16px); margin: 0; padding: 0; list-style: none; }
  .thread { position: absolute; z-index: -1; top: calc(var(--em) / 2 - 1px); left: calc(100% / 12); right: calc(100% / 12); height: 2px; border-radius: 2px; background: rgb(255 255 255 / .1); }
  .thread > i { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(90deg, #3b82f6, #38bdf8, #22d3ee, #34d399, #a3e635, #fbbf24); box-shadow: 0 0 14px rgb(255 214 140 / .45); transform-origin: left; }
  /* The light that runs along the thread. */
