---
import Base from "../../layouts/Base.astro";
import Device from "../../components/Device.astro";
import Art from "../../components/Art.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import Faq from "../../components/Faq.astro";
import Close from "../../components/Close.astro";
import { APP } from "../../data/site.mjs";
// What a publithon is and how to take part, for anyone invited to one. No event of its own: dates, topic and sponsor
// come later, when an event needs them. Sponsors write to us through the contact form's sponsor topic.
// The steps are /publish's own (publishReports.flow.overview), in the order the app takes them, each with a glass
// emblem of the icon its step has in the app's step trail (PenLine, Hash, FileUp, FileText, ShieldCheck, BadgeCheck).
const steps = [
  ["sign", "#3b82f6", "Sign the agreement", "You keep the copyright and publish under CC BY 4.0."],
  ["doi", "#38bdf8", "Get your DOI", "Reserved the moment you sign. It goes live with the report."],
  ["upload", "#22d3ee", "Upload your PDF", "With one line naming the series and the DOI. We can add it for you."],
  ["details", "#34d399", "Check the details", "Title, authors, ORCID iDs, institutions and funders, read from the PDF."],
  ["checks", "#a3e635", "Automatic checks", "They look for that line and for anything published before."],
  ["live", "#fbbf24", "Go live", "Once the checks pass, the DOI is registered and the report has its own page."],
];
// A real DOI taken apart into the three parts people need: where it points from, whose it is, and which work.
// The prefix is shared dev's sandbox one (10.53832); production's goes here at launch. Positions are in the mono
// font's characters (Ubuntu Mono is half an em wide), so each label sits exactly at its part.
const parts = [
  { text: "https://doi.org/", c: "#7da7e6", at: 0, side: "below", name: "The link", note: "Opens wherever the work is kept now" },
  { text: "10.53832", c: "#34d399", at: 16, side: "above", name: "The prefix", note: "10 starts every DOI; 53832 is the publisher" },
  { text: "/openscholar-reports.r100230", c: "#fbbf24", at: 24, side: "below", name: "Your report", note: "This work and no other, for good" },
];
const gains = [
  ["cite", "Cited in one paste", "Reference managers turn the DOI into a full citation."],
  ["linkround", "A link that lasts", "If the report's page ever moves, the DOI follows it."],
  ["search", "Easier to find", "Its title, authors and funders go out with the DOI, where research indexes can pick them up."],
  ["graph", "Counted when cited", "Citations that use the DOI can be traced back to your work."],
];
// What Openscholar does in place of each job a DOI takes on your own. Every first line is something the publish
// flow does today (publishReports, convex/reports).
const chores = [
  ["buildings", "Published in its own series", "Instead of finding a journal or repository that issues DOIs, or joining a registration agency"],
  ["cite", "The details read from your PDF", "Instead of writing the title, authors, affiliations and funders in the agency's format"],
  ["pen", "The DOI line added for you", "Instead of putting the DOI and the series line into your PDF"],
  ["shield", "Checked against published work", "Instead of checking by hand that it hasn't come out before"],
  ["refresh", "Registered and kept up to date", "Instead of registering the DOI and sending corrections when something changes"],
  ["globe", "A page that keeps the PDF online", "Instead of finding somewhere the DOI can always lead"],
];
const faq = [
  ["What can I publish?", "Your own finished work as a PDF: a report, a working paper, a policy brief or a study. You keep the copyright, and it's published under CC BY 4.0."],
  ["What if it's already published?", "Suggest it to a community instead. Every upload is checked against work that's already published."],
  ["What does AI do here?", "It reads the title, authors, institutions and funders from your PDF, so you don't type them in. You check them and change anything before the report goes live."],
  ["Does anyone review my report first?", "No. Automatic checks look for the series line with your DOI and for anything published before, and once they pass, your report goes live straight away."],
  ["Can I run a publithon for my field?", "Yes. Tell us the topic and who you'd invite, and we'll plan it with you."],
];
---
<Base og="/og.jpg" top="#070b1a" title="Publithon: Openscholar" description="Publish your research at a publithon: bring a finished report or paper, and it goes live with its own DOI, under your name and open for anyone to read and cite.">
  <section class="bleed hero">
    <Art name="pub-rise" eager pos="70% 100%" class="h-art" />
    <div class="inner h-copy">
      <h1>Publish together</h1>
      <p class="lead">At a publithon, researchers publish their own work at the same time, each piece with its own DOI. Bring a finished report or paper, and it goes live under your name for anyone to read and cite.</p>
      <div class="acts"><a class="btn" href={`${APP}/publish`}>Publish your work<Arrow /></a><a class="btn ghost" href="#sponsor">Sponsor a publithon</a></div>
    </div>
  </section>

  {/* Two doors: new work is published, work that's already out is suggested to a community. */}
  <section class="ways" id="ways" aria-labelledby="ways-h">
    <h2 id="ways-h">Two ways to take part</h2>
    <div class="doors">
      <a class="panel door d-new" href={`${APP}/publish`} data-in>
        <img class="d-art" src="/img/art-pub-new.avif" width="1024" height="1536" loading="lazy" decoding="async" alt="" />
        <span class="d-copy"><b>Your own new work</b><span>A report, paper or study you wrote, published with its own DOI.</span><span class="go">Publish it<Arrow /></span></span>
      </a>
      <a class="panel door d-gap" href={`${APP}/communities`} data-in>
        <img class="d-art" src="/img/art-pub-gap.avif" width="1024" height="1536" loading="lazy" decoding="async" alt="" />
        <span class="d-copy"><b>Work that's already out</b><span>A community on your topic is missing a paper? Suggest it, and its editors add it.</span><span class="go">Find a community<Arrow /></span></span>
      </a>
    </div>
  </section>

  {/* What a DOI is: a real one labelled part by part, and the page its link opens, with what the DOI does beside it. */}
  <section class="doi" id="doi" aria-labelledby="doi-h">
    <div class="d-head"><h2 id="doi-h">What's a DOI?</h2><p class="lead">A DOI is a permanent ID for one piece of work. Its link always leads to that work, wherever it's kept, and it's what journals, libraries and reference managers use to cite it.</p></div>
    <div class="panel anat">
      <figure class="dia" data-in aria-label="The parts of a DOI">
        <p class="dstr">{parts.map((pt, i) => <span class="pt" style={`--c:${pt.c};--i:${i}`}>{pt.text}</span>)}</p>
        {parts.map((pt, i) => <figcaption class:list={["tag", pt.side]} style={`--c:${pt.c};--at:${pt.at};--i:${i}`}><b>{pt.name}</b><span>{pt.note}</span></figcaption>)}
      </figure>
      <div class="lands">
        <ul class="gains">{gains.map(([icon, t, d], i) => <li style={`--i:${i}`}><i><Icon name={icon} size={22} /></i><b>{t}</b><span>{d}</span></li>)}</ul>
        <div class="d-shot" data-in><Device kind="laptop" name="r-page" theme="light" alt="The page a report's DOI opens, with its authors, topics, abstract and PDF" sizes="(max-width: 900px) 100vw, 720px" /></div>
      </div>
    </div>
  </section>

  {/* The paperwork a DOI takes on your own: the pile beside one sealed page, and what's done for you in its place. */}
  <section class="panel chores" id="done" aria-labelledby="ch-h">
    <div class="ch-side">
      <img class="ch-art" src="/img/art-pub-paperwork.avif" width="1024" height="1536" loading="lazy" decoding="async" alt="" />
      <div class="ch-head"><h2 id="ch-h">We do the paperwork</h2><p class="lead">On your own, a DOI means going through a journal or repository, or joining a registration agency and doing the rest yourself. Here it's done for you.</p></div>
    </div>
    <ul class="ch-list" data-in>{chores.map(([icon, now, was], i) => <li style={`--i:${i}`}><i><Icon name={icon} size={22} /></i><b>{now}</b><span>{was}</span></li>)}</ul>
  </section>

  {/* The six steps on one thread, each with its icon from the app as a glass emblem. The thread fills from the first
      step to the last as the section arrives, and each emblem lights as it reaches it. */}
  <section class="bleed path" id="publish" aria-labelledby="path-h">
    <div class="inner p-head"><h2 id="path-h">What's left: a few clicks</h2><p class="lead">About ten minutes from start to finish. Once the automatic checks pass, your report goes live straight away.</p></div>
    <div class="inner p-run" data-in>
      <ol class="p-steps"><i class="thread" aria-hidden="true"><i></i></i>{steps.map(([id, c, t, d], i) => <li style={`--i:${i};--c:${c}`}><img src={`/img/step-${id}.avif`} width="264" height="264" loading="lazy" decoding="async" alt="" /><b>{t}</b><span>{d}</span></li>)}</ol>
    </div>
  </section>

  <section class="bleed sponsor" id="sponsor" aria-labelledby="sp-h">
    <Art name="pub-world" pos="60% 100%" class="s-art" />
    <div class="inner s-copy">
      <h2 id="sp-h">Sponsor a publithon</h2>
      <p class="lead">Back a publithon on a topic or a region you care about. We plan it with you, and afterwards you see every report it brought in and where its authors work.</p>
      <a class="btn" href="/contact/?topic=sponsor">Talk to us about sponsoring<Arrow /></a>
    </div>
  </section>

  <Faq items={faq} title="Questions about publithons" />
  <Close title="Give your work a DOI" art="close-green"><a slot="action" class="btn" href={`${APP}/publish`}>Publish your work<Arrow /></a></Close>
</Base>
<style>
  @keyframes up { from { opacity: 0; transform: translateY(20px); } }

  /* The sheets rise off the horizon behind the words; the words sit in the calm sky on the left. */
  .hero { background: var(--night); min-height: clamp(620px, 52vw, 760px); padding-block: clamp(150px, 13vw, 210px) clamp(120px, 12vw, 180px); }
  .hero > :global(.h-art) { -webkit-mask-image: linear-gradient(transparent, #000 12%); mask-image: linear-gradient(transparent, #000 12%); }
  .hero > :global(.h-art img) { animation: rise 2.6s var(--ease) both; } @keyframes rise { from { opacity: 0; transform: translateY(36px) scale(1.04); } }
  /* The words keep a calm night behind them wherever the art runs under them. */
  .hero::before, .sponsor::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, rgb(7 11 26 / .88), rgb(7 11 26 / .62) 36%, transparent 60%); }
  .h-copy { position: relative; display: grid; gap: 22px; justify-items: start; }
  .h-copy h1 { font-size: clamp(56px, 8.4vw, 128px); line-height: .94; letter-spacing: -.045em; max-width: 7em; }
  .h-copy .lead { max-width: 29em; color: rgb(255 255 255 / .86); }
  .h-copy > * { animation: up .9s var(--ease) both; } .h-copy > :nth-child(2) { animation-delay: .08s; } .h-copy > :nth-child(3) { animation-delay: .16s; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; }

  /* Two tall doors side by side, the art filling each and the words at its foot. */
  /* Dark blocks take the strip's full width, as the panels do; headings and text keep the margin. */
  .ways { display: grid; gap: clamp(20px, 2.4vw, 32px); padding-top: clamp(48px, 6vw, 88px); } .ways h2 { padding-inline: var(--pad); }
  .ways h2 { font-size: clamp(30px, 3.2vw, 44px); }
  .doors { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .door { display: grid; align-content: end; min-height: clamp(520px, 46vw, 660px); padding: clamp(24px, 3vw, 40px); color: #fff; }
  .d-new { --bg: #02261d; } .d-gap { --bg: #2a0410; }
  .d-art { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1.2s var(--ease), filter .6s var(--ease); -webkit-mask-image: linear-gradient(#000 52%, transparent 92%); mask-image: linear-gradient(#000 52%, transparent 92%); filter: brightness(.86); }
  .door:hover .d-art { transform: scale(1.04); filter: none; }
  .d-copy { display: grid; gap: 10px; max-width: 26em; } .d-copy b { font-weight: 500; font-size: clamp(26px, 2.6vw, 36px); line-height: 1.08; letter-spacing: -.02em; } .d-copy > span:not(.go) { color: rgb(255 255 255 / .8); font-size: 17px; line-height: 1.45; }
  .go { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-weight: 500; font-size: 17px; } .go :global(i) { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: #fff; color: var(--ink); transition: transform .3s var(--ease); } .door:hover .go :global(i) { transform: translateX(4px); }

  /* A DOI labelled like a diagram: each label at its own part, joined to it by a short line in the part's colour. */
  .doi { display: grid; gap: clamp(28px, 3.4vw, 48px); padding-top: clamp(72px, 8vw, 120px); }
  .d-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; padding-inline: var(--pad); } .d-head h2 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -.035em; }
  .anat { --bg: var(--night); display: grid; gap: clamp(28px, 3vw, 44px); padding: var(--pad) var(--pad) 0; }
  .dia { --fs: clamp(18px, 2.85vw, 40px); --above: 64px; --below: 72px; position: relative; margin: 0; padding-block: var(--above) var(--below); font-size: var(--fs); }
  .dstr { margin: 0; font: 400 1em/1.1 var(--mono); letter-spacing: 0; white-space: nowrap; }
  .pt { position: relative; color: #fff; } .pt::after { content: ""; position: absolute; left: 1px; right: 1px; bottom: -10px; height: 4px; border-radius: 4px; background: var(--c); box-shadow: 0 0 16px color-mix(in srgb, var(--c) 70%, transparent); }
  .tag { position: absolute; left: calc(var(--at) * var(--fs) / 2); display: grid; gap: 2px; padding-left: 14px; font: 400 16px/1.35 var(--sans); white-space: nowrap; }
  .tag::before { content: ""; position: absolute; left: 0; width: 2px; border-radius: 2px; background: var(--c); }
  .tag b { font-weight: 500; font-size: 17px; color: var(--c); } .tag span { color: rgb(255 255 255 / .72); font-size: 15px; }
  /* The DOI line is var(--fs) * 1.1 tall; labels below start under its colour bar, labels above end over the text. */
  .tag.below { top: calc(var(--above) + var(--fs) * 1.1 + 20px); } .tag.below::before { top: -12px; bottom: 4px; }
  .tag.above { bottom: calc(var(--below) + var(--fs) * 1.1 + 6px); } .tag.above::before { top: 4px; bottom: -6px; }
  :global(.js) .dia[data-in] { opacity: 1; transform: none; } :global(.js) .dia:not(.in) .pt::after { transform: scaleX(0); } :global(.js) .dia:not(.in) .tag { opacity: 0; translate: 0 8px; }
  :global(.js) .dia.in .pt::after { transform-origin: left; transition: transform .7s var(--ease) calc(.15s + var(--i) * .35s); } :global(.js) .dia.in .tag { transition: opacity .5s var(--ease) calc(.4s + var(--i) * .35s), translate .6s var(--ease) calc(.4s + var(--i) * .35s); }
  /* Under the DOI, what it opens: the report's page rising out of the panel, and what the DOI does for it beside. */
  .lands { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(24px, 3.4vw, 56px); align-items: end; }
  .gains { display: grid; gap: 22px; margin: 0; padding: 0 0 var(--pad); list-style: none; align-self: center; }
  .gains li { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 16px; row-gap: 2px; } .gains i { grid-row: span 2; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgb(255 214 140 / .12); color: #ffd68c; } .gains i :global(svg) { width: 22px; height: 22px; }
  .gains b { font-weight: 500; font-size: 18px; letter-spacing: -.01em; } .gains span { color: rgb(255 255 255 / .62); font-size: 15px; line-height: 1.45; }
  .d-shot { margin-bottom: -7%; } .d-shot :global(.body) { padding: 0; border-radius: 14px 14px 0 0; background: none; box-shadow: 0 0 0 1px rgb(255 255 255 / .24), 0 -10px 70px -10px rgb(125 167 230 / .35), 0 40px 90px -30px #000; } .d-shot :global(.glass) { border-radius: 14px 14px 0 0; } .d-shot :global(.cam), .d-shot :global(.deck), .d-shot :global(.sheen) { display: none; }

  /* The paperwork: the pile beside the one sealed page on the left with the heading over it, and on the right what's
     done for you, each line over the job it replaces. */
  .chores { --bg: #010c28; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); margin-top: clamp(48px, 6vw, 88px); }
  .ch-side { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 8px; padding: var(--pad) var(--pad) 0; }
  /* The picture runs to the panel's left and bottom edges and fades out at its top and into the list on the right. */
  .ch-art { order: 2; align-self: end; width: calc(100% + var(--pad) * 2); height: 100%; min-height: 300px; margin-inline: calc(var(--pad) * -1); object-fit: cover; object-position: 50% 82%; -webkit-mask-image: linear-gradient(transparent, #000 32%), linear-gradient(90deg, #000 70%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(transparent, #000 32%), linear-gradient(90deg, #000 70%, transparent); mask-composite: intersect; }
  .ch-head { display: grid; gap: 18px; } .ch-head h2 { font-size: clamp(40px, 4.6vw, 72px); line-height: 1; letter-spacing: -.035em; } .ch-head .lead { color: rgb(255 255 255 / .8); max-width: 26em; }
  .ch-list { display: grid; align-content: center; margin: 0; padding: var(--pad) var(--pad) var(--pad) 0; list-style: none; }
  .ch-list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 18px; row-gap: 3px; padding-block: 18px; border-top: 1px solid rgb(255 255 255 / .12); } .ch-list li:first-child { border-top: 0; }
  .ch-list i { grid-row: span 2; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: rgb(255 214 140 / .12); color: #ffd68c; } .ch-list i :global(svg) { width: 22px; height: 22px; }
  .ch-list b { font-weight: 500; font-size: clamp(18px, 1.6vw, 21px); letter-spacing: -.01em; } .ch-list span { color: rgb(255 255 255 / .58); font-size: 15px; line-height: 1.45; }
  :global(.js) .ch-list[data-in] { opacity: 1; transform: none; } :global(.js) .ch-list:not(.in) li { opacity: 0; translate: 16px 0; } :global(.js) .ch-list.in li { transition: opacity .6s var(--ease) calc(.1s + var(--i) * .12s), translate .7s var(--ease) calc(.1s + var(--i) * .12s); }

  /* The steps, on a thread that lights from the first to the last. */
  .path { background: var(--night); padding-block: clamp(72px, 8vw, 120px) clamp(56px, 6vw, 96px); margin-top: clamp(48px, 6vw, 88px); }
  .p-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; } .p-head h2 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -.035em; } .p-head .lead { color: rgb(255 255 255 / .78); }
  .p-run { display: grid; margin-top: clamp(40px, 5vw, 72px); }
  /* Six equal columns; the thread runs behind the emblems' middles, from the first column's centre to the last's. */
  .p-steps { --em: clamp(96px, 9vw, 132px); position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 clamp(10px, 1.4vw, 20px); }
  .thread { position: absolute; z-index: -1; top: calc(var(--em) / 2); left: calc(100% / 12); right: calc(100% / 12); height: 2px; border-radius: 2px; background: rgb(255 255 255 / .1); }
  .thread i { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(90deg, #3b82f6, #38bdf8, #22d3ee, #34d399, #a3e635, #fbbf24); box-shadow: 0 0 14px rgb(255 214 140 / .45); transform-origin: left; }
  .p-steps li { display: grid; justify-items: center; align-content: start; gap: 6px; text-align: center; }
  .p-steps img { width: var(--em); height: var(--em); margin-bottom: 10px; object-fit: contain; filter: drop-shadow(0 0 22px color-mix(in srgb, var(--c) 40%, transparent)); }
  .p-steps b { font-weight: 500; font-size: 17px; letter-spacing: -.01em; } .p-steps span { color: rgb(255 255 255 / .66); font-size: 14px; line-height: 1.4; max-width: 15em; }
  /* Arriving: the thread fills over 2.4 s and each step lights as the fill reaches its column. */
  :global(.js) .p-run[data-in] { opacity: 1; transform: none; }
  :global(.js) .p-run:not(.in) .thread i { transform: scaleX(0); } :global(.js) .p-run:not(.in) img { opacity: .25; filter: grayscale(1); transform: translateY(10px) scale(.92); } :global(.js) .p-run:not(.in) li > :not(img) { opacity: 0; translate: 0 10px; }
  :global(.js) .p-run.in .thread i { transition: transform 2.4s cubic-bezier(.45, 0, .2, 1) .2s; }
  :global(.js) .p-run.in img { transition: opacity .5s var(--ease) calc(.2s + var(--i) * .44s), filter .6s var(--ease) calc(.2s + var(--i) * .44s), transform .8s cubic-bezier(.34, 1.56, .64, 1) calc(.2s + var(--i) * .44s); }
  :global(.js) .p-run.in li > :not(img) { transition: opacity .6s var(--ease) calc(.35s + var(--i) * .44s), translate .7s var(--ease) calc(.35s + var(--i) * .44s); }
  .p-steps li:hover img { transform: translateY(-4px) rotate(-4deg); transition: transform .5s cubic-bezier(.34, 1.56, .64, 1); }

  /* Sponsors: the world lights up where the work comes from, and every thread leads to one medallion. */
  .sponsor { background: var(--night); min-height: clamp(560px, 50vw, 720px); padding-block: clamp(72px, 8vw, 120px); margin-top: 16px; display: grid; align-items: start; }
  .sponsor > :global(.s-art) { -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / .35), #000 45%); mask-image: linear-gradient(90deg, rgb(0 0 0 / .35), #000 45%); }
  .s-copy { position: relative; display: grid; gap: 20px; justify-items: start; } .s-copy h2 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -.035em; max-width: 6.5em; } .s-copy .lead { max-width: 30em; color: rgb(255 255 255 / .84); }

  @media (max-width: 900px) {
    .hero > :global(.h-art img), .sponsor > :global(.s-art img) { opacity: 1; }
    .hero { min-height: 0; padding-block: 120px 300px; } .hero::before { display: none; } .hero > :global(.h-art) { -webkit-mask-image: linear-gradient(transparent 46%, #000 72%); mask-image: linear-gradient(transparent 46%, #000 72%); } .sponsor::before { display: none; } .hero > :global(.h-art img) { object-position: 75% 100%; }
    .doors { grid-template-columns: minmax(0, 1fr); } .door { min-height: 480px; }
    .p-head, .d-head { grid-template-columns: minmax(0, 1fr); }
    .lands { grid-template-columns: minmax(0, 1fr); } .gains { padding-bottom: 0; } .d-shot { margin-bottom: -9%; }
    .chores { grid-template-columns: minmax(0, 1fr); } .ch-art { height: 320px; } .ch-list { padding: 0 var(--pad) var(--pad); }
    .p-steps { --em: 72px; grid-template-columns: minmax(0, 1fr); gap: 18px; }
