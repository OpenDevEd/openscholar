---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Arrow from "../../components/Arrow.astro";
import Globe from "../../components/Globe.astro";
import Art from "../../components/Art.astro";
import Device from "../../components/Device.astro";
import SourceGraph from "../../components/SourceGraph.astro";
import ReviewFlow from "../../components/ReviewFlow.astro";
import CommunityRing from "../../components/CommunityRing.astro";
import NameIt from "../../components/NameIt.astro";
import { APP } from "../../data/site.mjs";
const faq = [
  ["Who controls what gets published?", "Your team does. You choose the sources, AI can screen what comes in against your subject, and records your editors write wait as drafts until an editor or owner publishes them."],
  ["How does it stay current?", "Connected sources bring in new work, and AI can screen incoming records against your subject as they arrive."],
  ["Can readers trust the AI answers?", "Answers link to the record and the page they came from, and the assistant says when it couldn't read a document."],
  ["Can we use our own domain and languages?", "Communities have their own address and branding, and can run in several languages, including right-to-left scripts."],
];
---
<Base top="#2e020d" og="/og-communities.jpg" title="Evidence Communities: OpenScholar" description="A public, searchable home for your field's evidence, kept current and published under your own name.">
  <section class="bleed hero" style="--tint:#be123c">
    <Art name="pavilion" eager pos="100% 50%" />
    <div class="inner"><div class="h-copy"><h1>A public home for your field's evidence</h1><p class="lead">Build a searchable, citable community around your evidence, under your own name. Keep it current from your sources and let anyone question it.</p><div class="acts"><a class="btn" href={`${APP}/evidence-libraries`}>Create your community<Arrow /></a><a class="btn ghost" href="https://wealth-inequality.openscholar.ai">See a live community</a></div></div></div>
    <div class="inner stagehand" aria-hidden="true">
      <Device class="lap" kind="laptop" name="c-home" theme="dark" eager tilt sizes="(max-width: 900px) 59vw, 860px" />
      <Device class="tab" kind="tablet" name="c-map" theme="light" sizes="(max-width: 900px) 26vw, 400px" />
      <Device class="pho" kind="phone" name="c-search" theme="light" sizes="(max-width: 900px) 20vw, 200px" />
    </div>
  </section>
  <section class="bleed live" id="live"><div class="inner"><h2>Fields that already have a home here</h2></div><CommunityRing eager={false} /></section>
  <NameIt />
  <section class="panel readers" id="readers" style="--tint:#0e7490">
    <Art name="reader-cards" pos="50% 0" />
    <div class="r-head"><h2>Everything your readers need to use the evidence</h2><p class="lead">Far more than a list of PDFs. Readers can search and filter the whole collection, read each record, cite and export it, and follow new work in digests.</p></div>
    <div class="view" data-in><div class="wipe-wrap"><Device class="wipe" kind="laptop" name="c-search" theme="both" alt="A community's search page with filters and records, in light and dark" data-wipe sizes="(max-width: 900px) 59vw, 760px" /><i class="handle" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7 6-4 4 4 4M13 6l4 4-4 4" /></svg></i></div></div>
  </section>
  <section class="panel answers" id="answers" data-in>
    <Art name="ask-lantern" pos="50% 60%" />
    <div class="a-copy"><h2>Answers your readers can check</h2><p class="lead">Anyone can question the evidence in your community and get an answer that links to the record and the page it came from. When a document can't be read, the answer says so.</p></div>
    <div class="a-card" aria-hidden="true"><span class="a-q">Does peer tutoring help children read?</span><p>Pupils in a large trial in Scotland <u>did significantly better than control pupils</u> in both years.<sup>1</sup></p><div class="a-src"><b>1</b><span>Peer tutoring in reading in Scotland, page 3</span></div></div>
  </section>
  <section class="bleed world" id="map"><div class="inner w-top"><h2>Show where your field lives</h2><p class="lead">Every community can map the people and places behind its evidence, so readers can see who's working on what, and where.</p></div><div class="w-g"><Globe /></div></section>
  <section class="panel rev" id="review"><Art name="review-gates" pos="50% 40%" /><div class="r-copy"><h2>Your team decides what readers see</h2><p class="lead">Sources keep the community current, and what your team writes goes through review first. Creators submit, and editors publish or send back.</p></div><ReviewFlow /></section>
  <section class="bleed steps" id="steps">
    <div class="inner"><div class="st-head"><h2>From first draft to live community</h2><p class="lead">Name it and reserve your address. Connect the sources you already keep. Choose your logo, colours, languages and what readers get, then go live. Later changes wait in a draft until you approve them.</p></div><SourceGraph /></div>
  </section>
  <Faq items={faq} />
  <section class="bleed close" style="--tint:#be123c"><Art name="close-rose" pos="50% 100%" /><h2>Open your community</h2><a class="btn" href={`${APP}/evidence-libraries`}>Create your community<Arrow /></a></section>
</Base>
<style>
  .hero { background: #2e020d; padding-top: clamp(104px, 9vw, 136px); }
  .hero > :global(.art) { left: 25vw; right: -25vw; -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%); mask-image: linear-gradient(90deg, transparent, #000 24%); } .h-copy { display: grid; gap: 20px; justify-items: start; width: min(46%, 560px); } .h-copy > * { animation: up .9s var(--ease) both; } @keyframes up { from { opacity: 0; transform: translateY(20px); } } .acts { display: flex; flex-wrap: wrap; gap: 10px; } .h-copy h1 { font-size: clamp(40px, 4.6vw, 66px); }
  /* Three devices rise out of the globe and fan apart as the page opens. */
  .stagehand { position: relative; height: clamp(340px, 40vw, 520px); margin-top: clamp(28px, 3.4vw, 48px); margin-bottom: -60px; } .stagehand > :global(.dev) { position: absolute; }
  .stagehand :global(.lap) { left: 19%; top: 0; width: 62%; z-index: 2; animation: lift 1.1s var(--ease) both; } .stagehand :global(.tab) { left: 0; top: 64px; width: 30%; z-index: 1; animation: from-left 1.2s .1s var(--ease) both; } .stagehand :global(.pho) { right: 0; top: 56px; width: 21%; z-index: 3; animation: from-right 1.2s .15s var(--ease) both; }
  @keyframes lift { from { opacity: 0; transform: translateY(40px); } } @keyframes from-left { from { opacity: 0; transform: translate(14%, 30px) rotate(-3deg); } } @keyframes from-right { from { opacity: 0; transform: translate(-30%, 30px) rotate(3deg); } }
  .live { background: #040b2e; padding-block: clamp(72px, 8vw, 112px) clamp(32px, 4vw, 56px); text-align: center; } .live h2 { font-size: clamp(30px, 3.6vw, 52px); margin-inline: auto; }
  /* Move across the laptop to wipe it from light to dark. */
  .readers { display: grid; gap: clamp(24px, 3vw, 40px); padding: var(--pad); background: #032c42; } .readers > :global(.art) { inset: clamp(70px, 9vw, 120px) -4% 0; -webkit-mask-image: linear-gradient(transparent, #000 16%); mask-image: linear-gradient(transparent, #000 16%); } .readers > :global(.art img) { opacity: 1; } .r-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; } .wipe-wrap { position: relative; width: min(66%, 800px); margin-inline: auto; } @property --w { syntax: "<percentage>"; inherits: true; initial-value: 62%; }
  .wipe-wrap { cursor: ew-resize; } .wipe-wrap :global(.scr.dark) { clip-path: inset(0 0 0 var(--w)); transition: none; z-index: 1; }
  .handle { position: absolute; z-index: 3; top: 2.2%; height: 89%; left: calc(1.5% + var(--w) * .97); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 12px rgb(0 0 0 / .5); pointer-events: none; } .handle svg { max-width: none; height: auto; position: absolute; top: 50%; left: 50%; translate: -50% -50%; box-sizing: content-box; width: 20px; padding: 8px; border-radius: 50%; background: #fff; color: var(--ink); box-shadow: 0 6px 16px -4px rgb(4 8 30 / .6); }
  /* It sweeps across once on arrival so people see what it does. */
  :global(.view.in) .wipe-wrap:not(.held) { animation: sweep 2.2s var(--ease) .5s both; } @keyframes sweep { 0% { --w: 62%; } 40% { --w: 30%; } 100% { --w: 62%; } }
  /* The art carries the proof: a thread of light leaves the answer and ends on one bright line in the book. */
  .answers { position: relative; display: grid; align-content: space-between; gap: 28px; padding: var(--pad); min-height: clamp(600px, 52vw, 680px); background: #1e0802; } .a-copy { display: grid; gap: 18px; width: min(38%, 470px); }
  .a-card { position: relative; z-index: 1; width: min(42%, 470px); padding: 20px 22px; border-radius: 16px; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px rgb(10 26 63 / .08), 0 30px 60px -20px rgb(20 6 0 / .9), 0 0 70px rgb(251 191 36 / .2); } .a-q { display: inline-block; margin-bottom: 10px; padding: 7px 12px; border-radius: 10px; background: var(--soft); font-size: 14px; } .a-card p { font-size: clamp(18px, 1.7vw, 22px); line-height: 1.25; letter-spacing: -.015em; font-weight: 500; } .a-card u { text-decoration: none; background: linear-gradient(#fde68a, #fde68a) no-repeat 0 0 / 100% 100%; border-radius: 3px; padding-inline: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; } sup { color: var(--brand-dark); font-size: .6em; } .a-src { display: flex; align-items: center; gap: 8px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 14px; color: var(--t2); } .a-src b { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; background: var(--soft); color: var(--brand-dark); font-weight: 500; font-size: 12px; }
  /* The answer lands, then its words light up. */
  :global(.js) .answers[data-in] { opacity: 1; transform: none; } :global(.js) .answers .a-card { opacity: 0; translate: 0 22px; } :global(.js) .answers .a-card u { background-size: 0 100%; } :global(.js) .answers.in .a-card { opacity: 1; translate: 0 0; transition: opacity .7s var(--ease), translate .8s var(--ease); } :global(.js) .answers.in .a-card u { background-size: 100% 100%; transition: background-size .8s var(--ease) .7s; }
  .rev { display: grid; gap: clamp(20px, 2.6vw, 32px); padding: var(--pad); background: #02241b; } .rev > :global(.art) { -webkit-mask-image: linear-gradient(transparent 170px, #000 270px); mask-image: linear-gradient(transparent 170px, #000 270px); } .r-copy { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; } @media (max-width: 1100px) { .r-copy { grid-template-columns: minmax(0, 1fr); } .rev > :global(.art) { opacity: .35; } }
  /* No panel here: the type is the size of the field, and the world rises from the bottom edge. */
  .world { background: radial-gradient(ellipse 70% 60% at 50% 100%, #123a8c, transparent 70%), #020a2c; padding-block: clamp(72px, 8vw, 120px) 0; height: clamp(720px, 62vw, 1000px); overflow: clip; text-align: center; } .w-top { position: relative; z-index: 1; display: grid; justify-items: center; gap: 18px; } .w-top h2 { max-width: none; font-size: clamp(40px, 7.4vw, 112px); line-height: .98; letter-spacing: -.035em; } .w-top .lead { width: min(100%, 620px); } .w-g { position: absolute; left: 50%; top: clamp(300px, 27vw, 430px); width: min(92vw, 1180px); translate: -50% 0; }
  .steps { background: #3a0310; padding-block: clamp(56px, 7vw, 96px); } .st-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; margin-bottom: clamp(28px, 4vw, 56px); }
  .close { background: var(--night); display: grid; justify-items: center; align-content: start; gap: 24px; padding: clamp(64px, 8vw, 112px) var(--pad) max(160px, 28vw); text-align: center; } .close > :global(.art) { -webkit-mask-image: linear-gradient(transparent 30%, #000 52%); mask-image: linear-gradient(transparent 30%, #000 52%); } .close h2 { font-size: clamp(38px, 6.4vw, 92px); line-height: 1; letter-spacing: -.03em; }
  @media (max-width: 900px) { .hero { min-height: 0; } .h-copy { width: 100%; } .stagehand { height: 76vw; margin-bottom: -20px; } .stagehand :global(.lap) { left: 4%; width: 84%; } .stagehand :global(.tab) { display: none; } .stagehand :global(.pho) { right: 2%; top: 24%; width: 28%; } .wipe-wrap { width: 100%; } .r-head { grid-template-columns: minmax(0, 1fr); } .readers > :global(.art) { inset: 30% -30% 0; } .hero > :global(.art) { inset: auto -46% 0 -12%; height: min(112vw, 760px); -webkit-mask-image: linear-gradient(transparent, #000 34%); mask-image: linear-gradient(transparent, #000 34%); } .hero > :global(.art img) { opacity: .95; } .steps li:hover span { }  .world { height: auto; padding-bottom: 0; } .w-g { position: relative; left: auto; top: 0; translate: none; width: 130%; margin: 20px -15% -46%; } .a-copy, .a-card { width: 100%; } .answers { display: flex; flex-direction: column; gap: 0; min-height: 0; } .answers > :global(.art) { position: relative; inset: auto; order: 1; z-index: 0; height: min(66vw, 460px); margin: 8px calc(var(--pad) * -1) -56px; -webkit-mask-image: linear-gradient(transparent, #000 18%, #000 80%, transparent); mask-image: linear-gradient(transparent, #000 18%, #000 80%, transparent); } .answers > :global(.art img) { opacity: 1; object-position: 70% 50%; } .a-card { order: 2; } .st-head { grid-template-columns: minmax(0, 1fr); } }
</style>
