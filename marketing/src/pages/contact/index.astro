---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Arrow from "../../components/Arrow.astro";
import Art from "../../components/Art.astro";
import Icon from "../../components/Icon.astro";
import { APP } from "../../data/site.mjs";
const EMAIL = "habari@openscholar.ai";
// What people write to us about. Each topic asks for what it needs: a project where there is one, a country for the
// Southern plan, and a message labelled for the topic.
const topics = [
  { id: "community", icon: "layers", color: "#fb7185", title: "Start an Evidence Community", text: "A public home for your field's evidence", project: ["Your community", "What will it cover, who will read it, and where does its evidence come from today?"], message: ["Anything else", "Optional"] },
  { id: "team", icon: "team", color: "#38bdf8", title: "Bring your team", text: "Shared searches, screenings and extractions", project: ["Your project", "What is your team working on, and how many people are involved?"], message: ["Anything else", "Optional"] },
  { id: "southern", icon: "globe", color: "#34d399", title: "Southern plan", text: "For researchers in low- and middle-income countries", project: ["Your research", "What are you researching, and what do you want to use Openscholar for?"], country: true, org: "Institution", message: ["Anything else", "Optional"] },
  { id: "partner", icon: "buildings", color: "#fbbf24", title: "Research and partnerships", text: "Evidence work for your sector or programme", project: ["Your project", "What would you like to find out, and who is it for?"], message: ["Anything else", "Optional"] },
  { id: "account", icon: "key", color: "#7da7e6", title: "Help with your account", text: "Signing in, workspaces and access", message: ["What happened", "Tell us what you were trying to do and what happened instead.", true] },
  { id: "other", icon: "mail", color: "#ff9d36", title: "Something else", text: "Feedback, press or anything we missed", message: ["Message", "What's on your mind?", true] },
];
const first = topics[0];
const faq = [
  ["Can I try Openscholar before getting in touch?", "Yes. Get started and run your first search straight away. You don't need to talk to anyone first."],
  ["I found a mistake in a community's record", "Write to that community from its own Contact page. Messages there go to the people who look after it."],
  ["Where can I learn how something works?", "The documentation walks through searching, screening, extraction, the assistant, teams and communities, step by step."],
];
---
<Base top="#070b1a" title="Contact: Openscholar" description="Write to the team behind Openscholar about your research, your team or a community of your own.">
  <section class="bleed chero">
    <Art name="contact-letter" eager pos="100% 50%" class="c-art" sizes="(max-width: 900px) 132vw, 900px" />
    <div class="inner"><div class="c-copy"><h1>Let's talk about your evidence</h1><p class="lead">Questions about your research, your team or a community of your own. Write to us and someone on the team will read it.</p></div></div>
  </section>

  <section class="desk" aria-labelledby="desk-h">
    <form class="form" data-contact novalidate>
      <div class="topics" role="radiogroup" aria-labelledby="desk-h">
        <h2 id="desk-h">What can we help with?</h2>
        <span class="hl" aria-hidden="true"></span>
        {topics.map((t, i) => <label class="topic" style={`--c:${t.color}`} data-topic={JSON.stringify({ project: t.project ?? null, country: !!t.country, org: t.org ?? "Organisation", message: t.message })}><input type="radio" name="topic" value={t.id} checked={i === 0} /><i><Icon name={t.icon} size={22} /></i><span><b>{t.title}</b><em>{t.text}</em></span><span class="tick" aria-hidden="true"><Icon name="check" size={20} /></span></label>)}
      </div>
      <div class="fields">
        <div class="pair">
          <label class="f"><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label class="f"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <div class="pair">
          <label class="f"><span><span data-org>Organisation</span> <small>Optional</small></span><input name="org" autocomplete="organization" /></label>
          <div class="opt off" data-opt="country"><label class="f"><span>Country</span><input name="country" autocomplete="country-name" required disabled /></label></div>
        </div>
        <div class="opt" data-opt="project"><label class="f"><span data-project-label>{first.project[0]}</span><textarea name="project" rows="4" required placeholder={first.project[1]}></textarea></label></div>
        <label class="f"><span><span data-msg-label>{first.message[0]}</span> <small data-msg-optional>Optional</small></span><textarea name="message" rows="3" data-msg placeholder=""></textarea></label>
        <div class="send"><button class="btn brand" type="submit">Send message<Arrow /></button><p class="note">Replies come from {EMAIL}</p></div>
      </div>
      <div class="sent" data-sent hidden>
        <svg class="env" viewBox="0 0 220 160" fill="none" aria-hidden="true">
          <defs><linearGradient id="trail" x1="0" x2="1"><stop offset="0" stop-color="#2563eb" stop-opacity="0" /><stop offset=".35" stop-color="#22d3ee" /><stop offset=".6" stop-color="#34d399" /><stop offset=".8" stop-color="#fbbf24" /><stop offset="1" stop-color="#fb7185" /></linearGradient><linearGradient id="glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6ea" /><stop offset="1" stop-color="#ffd3a3" /></linearGradient></defs>
          <path class="trail" d="M6 150C56 150 92 128 128 92" stroke="url(#trail)" stroke-width="3" stroke-linecap="round" pathLength="1" />
          <g class="fly"><rect x="104" y="44" width="96" height="66" rx="10" fill="url(#glass)" stroke="#e0650a" stroke-width="2" /><path class="flap" d="M105 50 152 86l47-36" fill="#fff1df" stroke="#e0650a" stroke-width="2" stroke-linejoin="round" /></g>
        </svg>
        <h2 tabindex="-1" data-sent-h>Thanks, it's on its way</h2>
        <p>Replies go to <b data-sent-to></b>.</p>
        <button class="btn line" type="button" data-again>Write another</button>
      </div>
    </form>
  </section>

  <section class="panel mail" aria-labelledby="mail-h">
    <i class="field f-night" aria-hidden="true"></i><Art name="contact-window" pos="100% 60%" class="m-art" />
    <div class="m-copy"><h2 id="mail-h">Prefer email?</h2><p class="lead">Write to us from your own inbox. It reaches the same people.</p></div>
    <div class="cap">
      <i class="cap-ic"><Icon name="mail" size={22} /></i>
      <a class="cap-addr" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <button type="button" class="cap-btn" data-copy={EMAIL} aria-label={`Copy ${EMAIL}`}><span class="swap"><span class="a"><Icon name="copy" size={18} /><span class="t">Copy</span></span><span class="b"><Icon name="check" size={18} /><span class="t">Copied</span></span></span></button>
    </div>
  </section>

  <Faq items={faq} title="Before you write" />
  <section class="bleed close"><Art name="close-rose" pos="50% 100%" /><h2>Or start on your own</h2><a class="btn" href={APP}>Get started<Arrow /></a></section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  if (form) {
    const hl = form.querySelector<HTMLElement>(".hl")!, sent = form.querySelector<HTMLElement>("[data-sent]")!;
    const msg = form.querySelector<HTMLTextAreaElement>("[data-msg]")!, project = form.querySelector<HTMLTextAreaElement>("textarea[name=project]")!;
    const opt = (name: string, on: boolean) => {
      const el = form.querySelector<HTMLElement>(`[data-opt=${name}]`)!;
      el.classList.toggle("off", !on); el.querySelectorAll<HTMLInputElement>("input, textarea").forEach((f) => { f.disabled = !on; });
    };
    // The highlight slides to the chosen topic, and the fields below ask what that topic needs.
    const place = () => {
      const on = form.querySelector<HTMLInputElement>("input[name=topic]:checked")!.closest<HTMLElement>(".topic")!;
      hl.style.setProperty("--hy", `${on.offsetTop}px`); hl.style.setProperty("--hh", `${on.offsetHeight}px`); hl.style.setProperty("--hc", on.style.getPropertyValue("--c"));
      const t = JSON.parse(on.dataset.topic!);
      opt("project", !!t.project); opt("country", t.country);
      if (t.project) { form.querySelector("[data-project-label]")!.textContent = t.project[0]; project.placeholder = t.project[1]; }
      form.querySelector("[data-org]")!.textContent = t.org;
      const [label, ask, required] = t.message;
      form.querySelector("[data-msg-label]")!.textContent = label;
      form.querySelector<HTMLElement>("[data-msg-optional]")!.hidden = !!required;
      msg.required = !!required; msg.placeholder = required ? ask : ""; msg.rows = required ? 6 : 3;
    };
    form.addEventListener("change", (e) => { if ((e.target as HTMLInputElement).name === "topic") place(); });
    new ResizeObserver(() => { const on = form.querySelector<HTMLElement>("input[name=topic]:checked")!.closest<HTMLElement>(".topic")!; hl.style.setProperty("--hy", `${on.offsetTop}px`); hl.style.setProperty("--hh", `${on.offsetHeight}px`); }).observe(form.querySelector(".topics")!);
    place();
    // Mock: nothing is sent yet. The envelope seals and flies off, and the form gives way to a thank-you.
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.classList.add("tried"); form.querySelector<HTMLElement>(":invalid")?.focus(); return; }
      form.querySelector("[data-sent-to]")!.textContent = (form.elements.namedItem("email") as HTMLInputElement).value;
      form.style.setProperty("--fh", `${form.offsetHeight}px`);
      form.classList.add("done"); sent.hidden = false;
      form.querySelector<HTMLElement>("[data-sent-h]")!.focus({ preventScroll: true });
    });
    form.querySelector("[data-again]")!.addEventListener("click", () => { form.reset(); form.classList.remove("done", "tried"); sent.hidden = true; place(); form.querySelector<HTMLElement>("input[name=name]")!.focus(); });
  }
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  copy?.addEventListener("click", async () => { await navigator.clipboard.writeText(copy.dataset.copy!); copy.classList.add("ok"); setTimeout(() => copy.classList.remove("ok"), 1800); });
</script>

<style>
  /* The hero's height decides where the envelope sits: it stands between the header and the card that rises over the hero, whole at every width, with its ribbon fading out before the art's edge. */
  .chero { --rise: clamp(130px, 11vw, 170px); background: #070b1a; padding-block: clamp(140px, 12vw, 184px) calc(var(--rise) + clamp(56px, 5vw, 72px)); }
  .chero :global(.c-art) { inset: 28px auto calc(var(--rise) - 24px); right: max(-90px, calc(50vw - 780px)); aspect-ratio: 1672 / 941; height: auto; -webkit-mask-image: linear-gradient(90deg, transparent 6%, #000 36%, #000 86%, transparent), linear-gradient(#000 82%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent 6%, #000 36%, #000 86%, transparent), linear-gradient(#000 82%, transparent); mask-composite: intersect; }
  .chero :global(.c-art img) { object-position: 100% 50%; }
  .c-copy { position: relative; display: grid; gap: 20px; max-width: 600px; } .c-copy h1 { font-size: clamp(44px, 6vw, 88px); line-height: 1; letter-spacing: -.035em; } .c-copy .lead { max-width: 30em; color: rgb(255 255 255 / .86); }
  .c-copy > * { animation: c-up .8s var(--ease) both; } .c-copy > :nth-child(2) { animation-delay: .07s; } @keyframes c-up { from { opacity: 0; transform: translateY(18px); } }

  /* The form rises out of the hero onto the page. */
  .desk { position: relative; z-index: 1; margin-top: calc(clamp(130px, 11vw, 170px) * -1); animation: c-up .9s .14s var(--ease) both; }
  .form { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); padding: clamp(20px, 3vw, 40px); border-radius: var(--r); background: #fff; box-shadow: 0 0 0 1px var(--line), 0 40px 80px -40px rgb(7 11 26 / .55); }
  .topics { position: relative; display: grid; align-content: start; gap: 4px; min-width: 0; }
  .topics h2 { padding: 0 0 16px 12px; font-size: clamp(26px, 2.6vw, 34px); }
  .hl { position: absolute; left: 0; right: 0; top: 0; height: var(--hh, 0); border-radius: 16px; background: color-mix(in srgb, var(--hc, #fb7185) 13%, #fff); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--hc, #fb7185) 55%, #fff); transform: translateY(var(--hy, 0)); transition: transform .38s var(--ease), height .38s var(--ease), background-color .3s var(--ease), box-shadow .3s var(--ease); pointer-events: none; }
  .topic { position: relative; display: flex; align-items: center; gap: 14px; padding: 12px; border-radius: 16px; cursor: pointer; transition: background-color .15s var(--ease); }
  .topic:hover:not(:has(:checked)) { background: var(--soft); }
  .topic input { position: absolute; opacity: 0; pointer-events: none; }
  .topic:has(:focus-visible) { outline: 3px solid var(--brand-ink); outline-offset: 2px; }
  .topic > i { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: color-mix(in srgb, var(--c) 16%, #fff); color: color-mix(in srgb, var(--c) 72%, #171717); transition: background-color .25s var(--ease), color .25s var(--ease), transform .45s cubic-bezier(.34, 1.56, .64, 1); }
  .topic:has(:checked) > i { background: var(--c); color: #0b0f1a; transform: rotate(-8deg) scale(1.06); }
  .topic > span:not(.tick) { display: grid; gap: 2px; min-width: 0; } .topic b { font-weight: 500; font-size: 16px; line-height: 1.3; } .topic em { font-style: normal; font-size: 14px; line-height: 1.35; color: var(--t2); }
  .tick { flex: none; display: grid; margin-left: auto; color: color-mix(in srgb, var(--c) 75%, #171717); opacity: 0; transform: scale(.6); transition: opacity .2s var(--ease), transform .35s cubic-bezier(.34, 1.56, .64, 1); } .topic:has(:checked) .tick { opacity: 1; transform: none; }

  .fields { display: grid; gap: 14px; align-content: start; padding-top: 6px; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; } .pair:has(> .opt.off) { grid-template-columns: minmax(0, 1fr); } .pair > .opt.off { display: none; }
  /* A field a topic doesn't need folds away; the space it leaves closes as one movement. */
  .opt { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .4s var(--ease), opacity .25s var(--ease); } .opt > * { min-height: 0; overflow: hidden; padding: 2px; margin: -2px; } .opt.off { grid-template-rows: 0fr; opacity: 0; } .fields > .opt.off { margin-bottom: -14px; } .pair > .opt.off { visibility: hidden; transition: grid-template-rows .4s var(--ease), opacity .25s var(--ease), visibility 0s .4s; }
  .f { display: grid; gap: 7px; font-size: 14px; font-weight: 500; } .f small { font-weight: 400; color: var(--t3); font-size: 13px; margin-left: 4px; }
  .f input, .f textarea { width: 100%; font: 400 16px/1.45 var(--sans); color: var(--ink); padding: 12px 14px; border: 0; border-radius: 12px; background: var(--soft); box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s var(--ease), background-color .2s var(--ease); }
  .f input { height: 48px; } .f textarea { resize: vertical; min-height: 96px; } .f textarea::placeholder { color: var(--t3); }
  .f input:hover, .f textarea:hover { box-shadow: inset 0 0 0 1px var(--line2); }
  .f input:focus, .f textarea:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 1.5px var(--brand-deep), 0 0 0 4px color-mix(in srgb, var(--brand) 22%, transparent); }
  .tried .f :invalid { box-shadow: inset 0 0 0 1.5px #dc2626; }
  .send { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 4px; } .note { font-size: 14px; color: var(--t3); }

  /* Sent: the form fades back, and the envelope seals low on the left, then rises along a spectrum trail and settles. */
  .form.done { min-height: var(--fh); } .form.done > :not(.sent) { visibility: hidden; opacity: 0; transition: opacity .2s var(--ease), visibility 0s .2s; }
  .sent[hidden] { display: none; } .sent { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 12px; padding: 24px; text-align: center; } .sent h2 { outline: none; } .sent p { color: var(--t2); font-size: 17px; } .sent b { font-weight: 500; color: var(--ink); } .sent .btn { margin-top: 10px; }
  .env { width: 220px; height: 160px; overflow: visible; margin-bottom: 4px; }
  .flap { transform-origin: 152px 50px; transform-box: view-box; animation: seal .45s var(--ease) .1s both; } @keyframes seal { from { transform: scaleY(-1); } }
  .fly { transform-origin: 152px 77px; transform-box: view-box; animation: fly 1.1s var(--ease) .5s both; } @keyframes fly { from { transform: translate(-96px, 62px) rotate(-14deg) scale(.72); } 70% { transform: translate(4px, -4px) rotate(3deg); } }
  .trail { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1s var(--ease) .55s forwards; } @keyframes draw { to { stroke-dashoffset: 0; } }
  .sent > :not(.env) { animation: c-up .7s var(--ease) both; } .sent > h2 { animation-delay: .75s; } .sent > p { animation-delay: .83s; } .sent > .btn { animation-delay: .91s; }

  /* Email: one glass capsule holding the address and its copy button, beside the lit doorway. */
  .mail { display: grid; align-content: center; gap: 28px; min-height: clamp(340px, 32vw, 440px); padding: clamp(32px, 4.4vw, 64px) var(--pad); --bg: #070b1a; }
  .mail > :not(.field, .art) { max-width: 600px; } .mail :global(.m-art) { left: 30%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
  .m-copy { display: grid; gap: 12px; } .m-copy .lead { color: rgb(255 255 255 / .8); }
  .cap { display: flex; align-items: center; gap: 14px; width: fit-content; max-width: 100%; padding: 8px; border-radius: 20px; background: rgb(255 255 255 / .07); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .16), inset 0 0 0 1px rgb(255 255 255 / .12); }
  .cap-ic { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--brand); color: var(--brand-on); }
  .cap-addr { min-width: 0; font-size: clamp(18px, 1.8vw, 22px); font-weight: 500; letter-spacing: -.01em; color: #fff; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: text-decoration-color .2s var(--ease); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .cap-addr:hover { text-decoration-color: rgb(255 255 255 / .5); }
  .cap-btn { flex: none; height: 48px; padding-inline: 16px; margin-left: 10px; border: 0; border-radius: 14px; background: #fff; color: var(--ink); font: 500 15px/1 var(--sans); cursor: pointer; transition: background-color .15s var(--ease); } .cap-btn:hover { background: #ffe8d2; }
  .swap { display: grid; overflow: hidden; height: 20px; } .swap > span { grid-area: 1 / 1; display: flex; align-items: center; gap: 8px; transition: transform .3s var(--ease), opacity .3s var(--ease); } .swap .b { transform: translateY(100%); opacity: 0; color: #15803d; } .cap-btn.ok .a { transform: translateY(-100%); opacity: 0; } .cap-btn.ok .b { transform: none; opacity: 1; }

  .close { background: var(--night); display: grid; justify-items: center; align-content: start; gap: 24px; padding: clamp(64px, 8vw, 112px) var(--pad) max(160px, 28vw); text-align: center; } .close > :global(.art) { -webkit-mask-image: linear-gradient(transparent 30%, #000 52%); mask-image: linear-gradient(transparent 30%, #000 52%); } .close h2 { font-size: clamp(38px, 6.4vw, 92px); line-height: 1; letter-spacing: -.03em; }

  @media (max-width: 900px) { .form { grid-template-columns: minmax(0, 1fr); } .mail :global(.m-art) { left: 0; opacity: .35; } .chero :global(.c-art) { inset: 56px auto auto; right: -38vw; width: 132vw; height: auto; opacity: .5; } }
  @media (max-width: 560px) { .pair { grid-template-columns: minmax(0, 1fr); } .pair > .opt.off { display: none; } .topic em { display: none; } .cap { width: 100%; } .cap-ic { display: none; } .cap-addr { font-size: 17px; padding-left: 8px; } .cap-btn { margin-left: auto; padding-inline: 14px; } .cap-btn .t { display: none; } }
</style>
