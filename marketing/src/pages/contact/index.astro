---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Arrow from "../../components/Arrow.astro";
import Art from "../../components/Art.astro";
import Icon from "../../components/Icon.astro";
import { APP } from "../../data/site.mjs";
const EMAIL = "habari@openscholar.ai";
// What people write to us about. Each one asks its own question in the message box.
const topics = [
  { id: "community", icon: "globe", color: "#fb7185", title: "Start an Evidence Community", text: "A public home for your field's evidence", ask: "Tell us about your field, who would read it, and where its evidence lives today." },
  { id: "team", icon: "merge", color: "#38bdf8", title: "Bring your team", text: "Shared searches, screenings and extractions", ask: "Tell us what your team is working on and how you work together now." },
  { id: "account", icon: "key", color: "#7da7e6", title: "Help with your account", text: "Signing in, workspaces and access", ask: "Tell us what you were trying to do and what happened instead." },
  { id: "partner", icon: "thread", color: "#34d399", title: "Research and partnerships", text: "Evidence work for your sector or programme", ask: "Tell us about the project, the people involved and what you'd like to find out." },
  { id: "other", icon: "mail", color: "#ff9d36", title: "Something else", text: "Feedback, press or anything we missed", ask: "What's on your mind?" },
];
const faq = [
  ["Can I try Openscholar before getting in touch?", "Yes. Get started and run your first search straight away. You don't need to talk to anyone first."],
  ["I found a mistake in a community's record", "Write to that community from its own Contact page. Messages there go to the people who look after it."],
  ["Where can I learn how something works?", "The documentation walks through searching, screening, extraction, the assistant, teams and communities, step by step."],
];
---
<Base top="#070b1a" title="Contact: Openscholar" description="Write to the team behind Openscholar about your research, your team or a community of your own.">
  <section class="bleed chero">
    <Art name="contact-letter" eager pos="100% 50%" class="c-art" />
    <div class="inner"><div class="c-copy"><h1>Let's talk about your evidence</h1><p class="lead">Questions about your research, your team or a community of your own. Write to us and someone on the team will read it.</p></div></div>
  </section>

  <section class="desk" aria-labelledby="desk-h">
    <form class="form" data-contact novalidate>
      <div class="topics" role="radiogroup" aria-labelledby="desk-h">
        <h2 id="desk-h">What can we help with?</h2>
        <span class="hl" aria-hidden="true"></span>
        {topics.map((t, i) => <label class="topic" style={`--c:${t.color}`} data-ask={t.ask}><input type="radio" name="topic" value={t.id} checked={i === 0} /><i><Icon name={t.icon} /></i><span><b>{t.title}</b><em>{t.text}</em></span><svg class="tick" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg></label>)}
      </div>
      <div class="fields">
        <div class="pair">
          <label class="f"><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label class="f"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <label class="f"><span>Organisation <small>Optional</small></span><input name="org" autocomplete="organization" /></label>
        <label class="f grow"><span>Message</span><textarea name="message" rows="6" required placeholder={topics[0].ask}></textarea></label>
        <div class="send"><button class="btn brand" type="submit">Send message<Arrow /></button><p class="note">Replies come from {EMAIL}</p></div>
      </div>
      <div class="sent" data-sent hidden>
        <svg class="env" viewBox="0 0 220 160" fill="none" aria-hidden="true">
          <defs><linearGradient id="trail" x1="0" x2="1"><stop offset="0" stop-color="#2563eb" stop-opacity="0" /><stop offset=".35" stop-color="#22d3ee" /><stop offset=".6" stop-color="#34d399" /><stop offset=".8" stop-color="#fbbf24" /><stop offset="1" stop-color="#fb7185" /></linearGradient></defs>
          <path class="trail" d="M6 150C56 150 92 128 128 92" stroke="url(#trail)" stroke-width="3" stroke-linecap="round" pathLength="1" />
          <linearGradient id="glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6ea" /><stop offset="1" stop-color="#ffd3a3" /></linearGradient><g class="fly"><rect x="104" y="44" width="96" height="66" rx="10" fill="url(#glass)" stroke="#e0650a" stroke-width="2" /><path class="flap" d="M105 50 152 86l47-36" fill="#fff1df" stroke="#e0650a" stroke-width="2" stroke-linejoin="round" /></g>
        </svg>
        <h2 tabindex="-1" data-sent-h>Thanks, it's on its way</h2>
        <p>Replies go to <b data-sent-to></b>.</p>
        <button class="btn line" type="button" data-again>Write another</button>
      </div>
    </form>
  </section>

  <section class="panel mail" aria-label="Email us">
    <i class="field f-night" aria-hidden="true"></i><Art name="contact-window" pos="100% 60%" class="m-art" />
    <div class="m-copy"><h2>Prefer email?</h2><p class="lead">Write to us from your own inbox. It reaches the same people.</p></div>
    <div class="addr">
      <a href={`mailto:${EMAIL}`} class="big"><Icon name="mail" size={28} />{EMAIL}</a>
      <button type="button" class="copy" data-copy={EMAIL}><span class="roll" data-t="Copied"><span>Copy</span></span><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="c1" d="M7 7h9v9H7zM4 13V4h9" /><path class="c2" d="m4 10.5 4 4 8-9" /></svg></button>
    </div>
  </section>

  <Faq items={faq} title="Before you write" />
  <section class="bleed close"><Art name="close-rose" pos="50% 100%" /><h2>Or start on your own</h2><a class="btn" href={APP}>Get started<Arrow /></a></section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  if (form) {
    const box = form.querySelector("textarea")!, hl = form.querySelector<HTMLElement>(".hl")!, sent = form.querySelector<HTMLElement>("[data-sent]")!;
    // The highlight slides to the chosen topic, and the message box asks that topic's question.
    const place = () => {
      const on = form.querySelector<HTMLInputElement>("input[name=topic]:checked")!.closest<HTMLElement>(".topic")!;
      hl.style.setProperty("--hy", `${on.offsetTop}px`); hl.style.setProperty("--hh", `${on.offsetHeight}px`); hl.style.setProperty("--hc", on.style.getPropertyValue("--c"));
      box.placeholder = on.dataset.ask ?? "";
    };
    form.addEventListener("change", (e) => { if ((e.target as HTMLInputElement).name === "topic") place(); });
    new ResizeObserver(place).observe(form.querySelector(".topics")!);
    place();
    // Mock: nothing is sent yet. The envelope seals and flies off, and the form gives way to a thank-you.
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.classList.add("tried"); form.querySelector<HTMLElement>(":invalid")?.focus(); return; }
      form.querySelector("[data-sent-to]")!.textContent = (form.elements.namedItem("email") as HTMLInputElement).value;
      form.style.setProperty("--fh", `${form.offsetHeight}px`);
      form.classList.add("done"); sent.hidden = false;
      form.querySelector<HTMLElement>("[data-sent-h]")!.focus({ preventScroll: true });
    });
    form.querySelector("[data-again]")!.addEventListener("click", () => { form.reset(); form.classList.remove("done", "tried"); sent.hidden = true; place(); form.querySelector<HTMLElement>("input[name=name]")!.focus(); });
  }
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  copy?.addEventListener("click", async () => { await navigator.clipboard.writeText(copy.dataset.copy!); copy.classList.add("ok"); setTimeout(() => copy.classList.remove("ok"), 1800); });
</script>

<style>
  .chero { background: #070b1a; padding-block: clamp(132px, 12vw, 176px) clamp(170px, 15vw, 220px); }
  .chero :global(.c-art) { inset: auto; top: 24px; right: max(-120px, calc(50vw - 800px)); width: min(1060px, 76vw); aspect-ratio: 1672 / 941; -webkit-mask-image: linear-gradient(90deg, transparent 4%, #000 34%), linear-gradient(transparent, #000 14%, #000 82%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent 4%, #000 34%), linear-gradient(transparent, #000 14%, #000 82%, transparent); mask-composite: intersect; }
  .c-copy { display: grid; gap: 20px; max-width: 600px; } .c-copy h1 { font-size: clamp(44px, 6vw, 88px); line-height: 1; letter-spacing: -.035em; } .c-copy .lead { max-width: 30em; color: rgb(255 255 255 / .86); }
  .c-copy > * { animation: c-up .8s var(--ease) both; } .c-copy > :nth-child(2) { animation-delay: .07s; } @keyframes c-up { from { opacity: 0; transform: translateY(18px); } }

  /* The form rises out of the hero onto the page. */
  .desk { position: relative; z-index: 1; margin-top: calc(clamp(120px, 11vw, 170px) * -1); animation: c-up .9s .14s var(--ease) both; }
  .form { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); padding: clamp(20px, 3vw, 40px); border-radius: var(--r); background: #fff; box-shadow: 0 0 0 1px var(--line), 0 40px 80px -40px rgb(7 11 26 / .55); }
  .topics { position: relative; display: grid; align-content: start; gap: 4px; min-width: 0; }
  .topics h2 { padding: 0 0 16px 12px; font-size: clamp(26px, 2.6vw, 34px); }
  .hl { position: absolute; left: 0; right: 0; top: 0; height: var(--hh, 0); border-radius: 16px; background: color-mix(in srgb, var(--hc, #fb7185) 13%, #fff); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--hc, #fb7185) 55%, #fff); transform: translateY(var(--hy, 0)); transition: transform .38s var(--ease), height .38s var(--ease), background-color .3s var(--ease), box-shadow .3s var(--ease); pointer-events: none; }
  .topic { position: relative; display: flex; align-items: center; gap: 14px; padding: 12px; border-radius: 16px; cursor: pointer; transition: background-color .15s var(--ease); }
  .topic:hover:not(:has(:checked)) { background: var(--soft); }
  .topic input { position: absolute; opacity: 0; pointer-events: none; }
  .topic:has(:focus-visible) { outline: 3px solid var(--brand-ink); outline-offset: 2px; }
  .topic i { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: color-mix(in srgb, var(--c) 16%, #fff); color: color-mix(in srgb, var(--c) 70%, #171717); transition: background-color .25s var(--ease), color .25s var(--ease), transform .45s cubic-bezier(.34, 1.56, .64, 1); }
  .topic:has(:checked) i { background: var(--c); color: #0b0f1a; transform: rotate(-8deg) scale(1.06); }
  .topic span { display: grid; gap: 2px; min-width: 0; } .topic b { font-weight: 500; font-size: 16px; line-height: 1.3; } .topic em { font-style: normal; font-size: 14px; line-height: 1.35; color: var(--t2); }
  .tick { flex: none; margin-left: auto; color: color-mix(in srgb, var(--c) 75%, #171717); opacity: 0; transform: scale(.6); transition: opacity .2s var(--ease), transform .35s cubic-bezier(.34, 1.56, .64, 1); } .topic:has(:checked) .tick { opacity: 1; transform: none; }

  .fields { display: grid; gap: 14px; align-content: start; padding-top: 6px; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; }
  .f { display: grid; gap: 7px; font-size: 14px; font-weight: 500; } .f small { font-weight: 400; color: var(--t3); font-size: 13px; margin-left: 4px; }
  .f input, .f textarea { width: 100%; font: 400 16px/1.45 var(--sans); color: var(--ink); padding: 12px 14px; border: 0; border-radius: 12px; background: var(--soft); box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s var(--ease), background-color .2s var(--ease); }
  .f input { height: 48px; } .f textarea { resize: vertical; min-height: 168px; }
  .f textarea::placeholder { color: var(--t3); transition: opacity .2s var(--ease); }
  .f input:hover, .f textarea:hover { box-shadow: inset 0 0 0 1px var(--line2); }
  .f input:focus, .f textarea:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 1.5px var(--brand-deep), 0 0 0 4px color-mix(in srgb, var(--brand) 22%, transparent); }
  .tried .f :invalid { box-shadow: inset 0 0 0 1.5px #dc2626; }
  .send { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 4px; } .note { font-size: 14px; color: var(--t3); }

  /* Sent: the form fades back and the envelope seals and flies off along a spectrum trail. */
  .form.done { min-height: var(--fh); } .form.done > :not(.sent) { visibility: hidden; opacity: 0; transition: opacity .2s var(--ease), visibility 0s .2s; }
  .sent[hidden] { display: none; } .sent { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 12px; padding: 24px; text-align: center; } .sent h2 { outline: none; } .sent p { color: var(--t2); font-size: 17px; } .sent b { font-weight: 500; color: var(--ink); } .sent .btn { margin-top: 10px; }
  .env { width: 220px; height: 160px; overflow: visible; margin-bottom: 4px; }
  .flap { transform-origin: 152px 50px; transform-box: view-box; animation: seal .45s var(--ease) .1s both; } @keyframes seal { from { transform: scaleY(-1); } }
  /* Sealed low on the left, it rises along its trail and settles. */
  .fly { transform-origin: 152px 77px; transform-box: view-box; animation: fly 1.1s var(--ease) .5s both; } @keyframes fly { from { transform: translate(-96px, 62px) rotate(-14deg) scale(.72); } 70% { transform: translate(4px, -4px) rotate(3deg); } }
  .trail { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1s var(--ease) .55s forwards; } @keyframes draw { to { stroke-dashoffset: 0; } }
  .sent > :not(.env) { animation: c-up .7s var(--ease) both; } .sent > h2 { animation-delay: .75s; } .sent > p { animation-delay: .83s; } .sent > .btn { animation-delay: .91s; }

  .mail { display: grid; align-content: center; gap: 28px; min-height: clamp(340px, 32vw, 440px); padding: clamp(32px, 4.4vw, 64px) var(--pad); --bg: #070b1a; } .mail > :not(.field, .art) { max-width: 640px; } .mail :global(.m-art) { left: 30%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
  .m-copy { display: grid; gap: 12px; } .m-copy .lead { color: rgb(255 255 255 / .8); }
  .addr { display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; }
  .big { display: inline-flex; align-items: center; gap: 14px; font-size: clamp(24px, 3.2vw, 44px); font-weight: 500; letter-spacing: -.025em; white-space: nowrap; background: linear-gradient(90deg, #fff 0 40%, #ffd3a8 50%, #fff 60% 100%) 100% 0 / 260% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; transition: background-position 1s var(--ease); } .big :global(svg) { flex: none; color: var(--brand-bright); } .big:hover { background-position: 0 0; }
  .copy { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding-inline: 14px; border: 0; border-radius: 12px; background: rgb(255 255 255 / .12); color: #fff; font: 500 15px/1 var(--sans); cursor: pointer; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .2); transition: background-color .15s var(--ease); } .copy:hover { background: rgb(255 255 255 / .2); }
  .copy .c2 { opacity: 0; } .copy.ok .c1 { opacity: 0; } .copy.ok .c2 { opacity: 1; } .copy.ok .roll > span { transform: translateY(-100%); } .copy path { transition: opacity .2s var(--ease); }

  .close { background: var(--night); display: grid; justify-items: center; align-content: start; gap: 24px; padding: clamp(64px, 8vw, 112px) var(--pad) max(160px, 28vw); text-align: center; } .close > :global(.art) { -webkit-mask-image: linear-gradient(transparent 30%, #000 52%); mask-image: linear-gradient(transparent 30%, #000 52%); } .close h2 { font-size: clamp(38px, 6.4vw, 92px); line-height: 1; letter-spacing: -.03em; }

  @media (max-width: 900px) { .form { grid-template-columns: minmax(0, 1fr); } .mail :global(.m-art) { left: 0; opacity: .35; } .chero :global(.c-art) { top: 56px; right: -38vw; width: 132vw; opacity: .5; } }
  @media (max-width: 560px) { .pair { grid-template-columns: minmax(0, 1fr); } .topic em { display: none; } .big { font-size: 22px; white-space: normal; word-break: break-all; } }
</style>
