---
// Hero to compare: an open book. The dark page is the team's, the white page is public, and thumb tabs turn it to each community. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#0a1a4f" title="Hero 9: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="book" data-sites>
      <div class="page os">
        <Art name="hero-stream" eager sizes="(max-width: 999px) 100vw, 50vw" />
        <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
        <p>Find the literature, screen it against your criteria and extract the data you need.</p>
        <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      </div>
      <div class="page ec light">
        <div class="leaves">
          {COMMUNITIES.map((c, i) => (
            <a class:list={["leaf", { on: i === 0 }]} data-i={i} href={c.url} style={`--c:${c.color}`}>
              {i === 0 ? <h2><b>Evidence Communities</b> are where anyone can read it</h2> : <p class="h2" aria-hidden="true"><b>Evidence Communities</b> are where anyone can read it</p>}
              <span class="name">{c.name}<Arrow /></span>
              <span class="url">{c.host}</span>
              <img src={`/img/site-${c.key}.avif`} width="960" height="600" decoding="async" alt="" />
            </a>
          ))}
        </div>
        <div class="thumbs" data-tabs role="tablist" aria-label="Live Evidence Communities">
          {COMMUNITIES.map((c, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-label={c.name} style={`--c:${c.color}`}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /></button>)}
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  import { picker } from "../../scripts/picker.js";
  picker(document.querySelector("[data-sites]"));
</script>
<style>
  .h { --hu: 1px; display: grid; grid-template-columns: minmax(0, 1fr); padding: 88px 10px 0; background: #0a1a4f; overflow: clip; }
  .book { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; min-width: 0; }
  h1, h2, .h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.07; text-wrap: balance; } b { font-weight: inherit; }
  .os { position: relative; isolation: isolate; overflow: clip; display: grid; justify-items: start; align-content: start; gap: calc(var(--hu) * 16); padding: 32px 22px 52vw; border-radius: 16px 16px 0 0; background: #01072c; color: #fff; } .os > :global(.art) { inset: auto 0 0; height: auto; aspect-ratio: 16 / 9; z-index: -1; } h1 { font-size: clamp(32px, 8vw, calc(var(--hu) * 50)); color: #a9bbe6; } h1 b { color: #fff; } .os > p { font-size: max(15px, calc(var(--hu) * 18)); line-height: 1.35; opacity: .88; } .os :global(.big) { width: 100%; } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .ec { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); background: #fff; color: var(--ink); } .leaves { position: relative; display: grid; perspective: 2200px; min-height: 0; }
  .leaf { grid-area: 1 / 1; z-index: 2; display: grid; align-content: start; gap: calc(var(--hu) * 8); padding: 28px 22px 0; background: #fff; overflow: clip; transform-origin: 0 50%; transform: rotateY(-168deg); opacity: 0; visibility: hidden; pointer-events: none; transition: transform .85s cubic-bezier(.45, .05, .3, 1), opacity .3s .5s linear, visibility 0s .85s; backface-visibility: visible; } .leaf::after { content: ""; position: absolute; inset: 0; background: #eef1f7; transition: opacity 0s .36s; } .leaf.on::after { opacity: 0; transition: none; } .leaf.on { z-index: 1; transform: none; opacity: 1; visibility: visible; pointer-events: auto; transition: none; }
  h2, .h2 { font-size: clamp(28px, 7vw, calc(var(--hu) * 38)); color: var(--t2); } h2 b, .h2 b { color: var(--ink); } .name { display: inline-flex; align-items: center; gap: 8px; margin-top: calc(var(--hu) * 8); font-size: max(15px, calc(var(--hu) * 18)); font-weight: 500; letter-spacing: -.01em; } .name :global(i) { display: grid; color: var(--brand); transition: transform .25s var(--ease); } .leaf:hover .name :global(i) { transform: translateX(4px); } .url { color: var(--t2); font: 400 max(11px, calc(var(--hu) * 13))/1.2 var(--mono); }
  .leaf > img { display: block; width: 100%; height: auto; max-width: none; margin-top: calc(var(--hu) * 8); border-radius: 10px 10px 0 0; box-shadow: 0 0 0 1px var(--line), 0 24px 44px -28px rgb(10 26 63 / .6); }
  .thumbs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2px; padding: 6px; background: #fff; } .thumbs button { display: grid; place-items: center; height: 54px; border-radius: 10px; background: color-mix(in srgb, var(--c) 24%, #0a1236); transition: translate .35s var(--ease); } .thumbs img { width: 36px; height: 36px; object-fit: contain; filter: saturate(1.5); } .thumbs [aria-selected="true"] { translate: 0 -5px; }
  @media (prefers-reduced-motion: reduce) { .leaf { transition: opacity .3s linear, visibility 0s .3s; transform: none; } }
  @media (min-width: 1000px) {
    .h { --hu: max(.62px, min(1px, 100svh / 900, 100vw / 1400)); height: 100svh; min-height: 620px; padding: calc(max(84px, var(--hu) * 92)) 0 0; justify-items: center; }
    .book { position: relative; grid-template-columns: 1fr 1fr; width: min(100vw - 96px, calc(var(--hu) * 1320)); height: calc(100svh - max(84px, var(--hu) * 92) + 24px); gap: 0; filter: drop-shadow(0 40px 50px rgb(2 6 30 / .6)); }
    .os { padding: calc(var(--hu) * 56) calc(var(--hu) * 60) 0 calc(var(--hu) * 56); border-radius: 18px 0 0 0 / 22px 0 0 0; } .os::after { content: ""; position: absolute; inset: 0 0 0 auto; width: calc(var(--hu) * 80); background: linear-gradient(90deg, transparent, rgb(0 0 0 / .55)); pointer-events: none; }
    .ec { border-radius: 0 18px 0 0 / 0 22px 0 0; box-shadow: 3px -1px 0 #e9edf5, 6px -2px 0 #fff, 9px -3px 0 #e2e7f1, 12px -4px 0 #fff; } .ec::after { content: ""; position: absolute; z-index: 3; inset: 0 auto 0 0; width: calc(var(--hu) * 80); background: linear-gradient(270deg, transparent, rgb(10 18 54 / .16)); pointer-events: none; }
    .leaves { height: 100%; } .leaf { height: 100%; grid-template-rows: auto auto auto minmax(0, 1fr); padding: calc(var(--hu) * 56) calc(var(--hu) * 60) 0 calc(var(--hu) * 64); border-radius: inherit; overflow: clip; } .leaf > img { height: 100%; object-fit: cover; object-position: 0 0; }
    .thumbs { position: absolute; right: calc(var(--hu) * -46); top: calc(var(--hu) * 40); z-index: 4; grid-template-columns: 1fr; gap: calc(var(--hu) * 4); padding: 0; background: none; } .thumbs button { width: calc(var(--hu) * 46); height: calc(var(--hu) * 58); padding-left: calc(var(--hu) * 4); border-radius: 0 12px 12px 0; box-shadow: inset 6px 0 6px -4px rgb(0 0 0 / .35); transition: translate .35s var(--ease), background .25s var(--ease); } .thumbs img { width: calc(var(--hu) * 34); height: calc(var(--hu) * 34); } .thumbs [aria-selected="true"] { translate: calc(var(--hu) * 10) 0; background: color-mix(in srgb, var(--c) 40%, #0a1236); } .thumbs button:hover { translate: calc(var(--hu) * 6) 0; }
  }
</style>
