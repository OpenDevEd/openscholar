---
// Hero to compare: the communities climb across the page as six rising panels on a daylight plinth, and the workspace sits in the dark above the low steps. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import Fill from "../../components/Fill.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const RISE = [20, 30, 41, 62, 80, 100];
---
<Base top="#01072c" title="Hero 10: OpenScholar" description="Hero option">
  <section class="bleed h">
    <Art name="hero-deep" eager />
    <div class="os">
      <h1><Fill tex="sea" class="w">OpenScholar</Fill> <span>is where your team works through the evidence</span></h1>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <ul>{COMMUNITIES.map((c, i) => <li style={`--r:${RISE[i]}`}><a href={c.url}><img src={`/img/art-scene-${c.key}-960.avif`} width="960" height="960" decoding="async" alt="" /><span class="n"><Fill tex={`tx-${c.key}-960`} base={c.color}>{c.word}</Fill>{c.name !== c.word && <b>{c.name}</b>}</span></a></li>)}</ul>
    <div class="plinth light">
      <Art name="ec-light" />
      <h2><Fill tex="tx-glass" flat base="#0a1a4f" class="e">Evidence Communities</Fill> <span>are where anyone can read it</span></h2>
      <a class="all" href="/evidence-communities/">How they work<Arrow /></a>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); background: #01072c; color: #fff; overflow: clip; } .h > :global(.art) { inset: 0; z-index: -1; }
  .os { display: grid; justify-items: start; gap: calc(var(--hu) * 18); padding: 104px var(--pad) 32px; container-type: inline-size; } h1 { display: grid; gap: calc(var(--hu) * 10); font-weight: 500; } :global(.w) { font-size: calc((100cqw - var(--pad) * 2) / 5.35); } h1 span { font-size: max(22px, calc(var(--hu) * 32)); letter-spacing: -.025em; line-height: 1.12; color: #a9bbe6; text-wrap: balance; } .os :global(.big) { width: 100%; } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; } li a { position: relative; isolation: isolate; display: grid; align-content: end; height: 100%; aspect-ratio: 1; overflow: clip; color: #fff; } li img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 30%; transition: transform .7s var(--ease), filter .4s var(--ease); } li a::after { content: ""; position: absolute; inset: 40% 0 0; z-index: -1; background: linear-gradient(transparent, rgb(1 7 44 / .86)); } li a:hover img { transform: scale(1.05); filter: brightness(1.12); }
  .n { display: grid; gap: 3px; padding: 12px; container-type: inline-size; } .n :global(.fill) { font-size: 28px; } .n b { font-weight: 500; font-size: 12px; line-height: 1.2; text-wrap: balance; }
  .plinth { position: relative; isolation: isolate; overflow: clip; display: grid; justify-items: start; gap: 6px; padding: 24px var(--pad); background: var(--soft); color: var(--ink); container-type: inline-size; } .plinth > :global(.art) { inset: 0 -30% 0 0; z-index: -1; } h2 { display: grid; gap: 4px; font-weight: 500; } :global(.e) { --blend: normal; font-size: calc((100cqw - var(--pad) * 2) / 9.42); } h2 span { font-size: max(17px, calc(var(--hu) * 22)); color: var(--t2); letter-spacing: -.02em; } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(14px, calc(var(--hu) * 15)); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  @media (min-width: 1000px) {
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); --plinth: calc(var(--hu) * 112); height: max(620px, calc(100svh - 32px)); grid-template-rows: minmax(0, 1fr) var(--plinth); }
    .os { position: absolute; z-index: 1; left: var(--edge); top: max(88px, calc(var(--hu) * 92)); width: calc(var(--strip) * .49); padding: 0; } :global(.w) { font-size: calc(100cqw / 5.35); } .os :global(.big .mk), .os :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); }
    ul { grid-row: 1; align-self: end; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: end; height: calc(100% - max(72px, var(--hu) * 80)); padding: 0 2px; } li { height: calc(var(--r) * 1%); } li a { aspect-ratio: auto; border-radius: calc(var(--hu) * 12) calc(var(--hu) * 12) 0 0; } .n { padding: calc(var(--hu) * 14); } .n :global(.fill) { font-size: calc(100cqw / 5.9); } .n b { font-size: max(11px, calc(var(--hu) * 13)); }
    .plinth { grid-row: 2; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: calc(var(--hu) * 32); padding: 0 var(--edge); } h2 { grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: calc(var(--hu) * 20); } :global(.e) { font-size: calc(var(--hu) * 56); } h2 span { font-size: calc(var(--hu) * 24); }
  }
</style>
