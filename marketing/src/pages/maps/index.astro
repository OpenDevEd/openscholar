---
import Base from "../../layouts/Base.astro";
import Next from "../../components/Next.astro";
import top from "../../data/top-countries.json";
const n = (x) => x.toLocaleString("en-US");
const max = top[0].n;
---
<Base title="Globe: Evidence Library" description="Spin a globe of 9,988 real institutions and find any of them.">
  <section class="globe" data-globe>
    <canvas data-c tabindex="0" aria-label="A globe of research institutions. Drag it, or use the arrow keys, to turn it." role="application"></canvas>
    <div class="pin" data-pin hidden><i></i><span data-pin-t></span></div>
    <div class="left">
      <h1>Find any of 9,988 institutions</h1>
      <p class="lead">Each light is an institution behind one library's papers. Drag the Earth, or search for one.</p>
      <div class="find"><label class="sr" for="f">Find an institution</label><input id="f" data-find placeholder="University of Nairobi" autocomplete="off" /><ul data-hits></ul></div>
    </div>
    <ol class="rank" aria-label="Countries with the most institutions">{top.map((c) => <li><button type="button" data-fly={`${c.lon},${c.lat}`} data-label={c.name}><span>{c.name}</span><i style={`transform:scaleX(${c.n / max})`}></i><b class="mono">{n(c.n)}</b></button></li>)}</ol>
  </section>

  <section class="modes">
    <h2>Three ways to map a library</h2>
    <ol><li><b>Country focus</b><span>The countries its papers study, as a total or per million people</span></li><li><b>Author countries</b><span>Where its authors work</span></li><li><b>Author institutions</b><span>Each institution on the globe, ranked, with search</span></li></ol>
    <a href="https://wealth-inequality.openscholar.ai/map" class="shot"><img src="/img/live-wi-map.avif" width="1920" height="1200" loading="lazy" decoding="async" alt="A live library's country map coloured by resources per million people, with a ranked list" /></a>
  </section>

  <section class="chains">
    <img src="/img/evidence-chains-2000.avif" width="2000" height="1667" loading="lazy" decoding="async" alt="A map of 131,794 papers on AI in education by who cites whom, with checked reviews marked in red, orange and yellow" />
    <div><h2>And check what a review stands on</h2><p class="lead">On AI in education, a map of who cites whom across 131,794 papers shows what each of 484 reviews rests on, and flags the ones with broken evidence. Red is broken, orange questionable, yellow repairable. This map is built for that library, so it isn't on every library yet.</p><p><a class="btn quiet" href="https://aied.openscholar.ai/evidence">Open the evidence map</a></p></div>
  </section>
  <Next href="/features/" label="All features" text="Everything in one catalogue" />
</Base>
<script>
  import { createField, mulberry } from "../../scripts/field.js";
  const root = document.querySelector("[data-globe]"), canvas = root.querySelector("[data-c]"), pin = root.querySelector("[data-pin]"), pinT = root.querySelector("[data-pin-t]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches, rad = Math.PI / 180, R = 1.1, INST = 9988;
  let yaw = -0.3, pitch = 0.3, target = null, dragging = false, field = null, spin = !reduced, marker = null;
  const rot = () => { const cy = Math.cos(yaw), sy = Math.sin(yaw), cx = Math.cos(pitch), sx = Math.sin(pitch); return [cy, sx * sy, -cx * sy, 0, cx, sx, sy, -sx * cy, cx * cy]; };
  const apply = (m, p) => [m[0] * p[0] + m[3] * p[1] + m[6] * p[2], m[1] * p[0] + m[4] * p[1] + m[7] * p[2], m[2] * p[0] + m[5] * p[1] + m[8] * p[2]];
  const sphere = (lon, lat, r = R) => { const c = Math.cos(lat * rad); return [r * c * Math.sin(lon * rad), r * Math.sin(lat * rad), r * c * Math.cos(lon * rad)]; };
  const wide = () => innerWidth >= 900;
  (async () => {
    const earth = new Int16Array(await (await fetch("/data/earth.bin")).arrayBuffer());
    const land = (earth.length - 2 - INST * 2) / 2, count = INST + land, data = new Float32Array(count * 4), seeds = new Float32Array(count * 2), r = mulberry(5);
    for (let i = 0; i < count; i++) { const k = i < INST ? 2 + i * 2 : 2 + INST * 2 + (i - INST) * 2, p = sphere(earth[k] / 100, earth[k + 1] / 100); data.set([p[0], p[1], p[2], i < INST ? 0.62 : 0.34], i * 4); seeds[i * 2] = r(); }
    field = createField(canvas, { count, seeds, targets: [{ data, warm: 0 }, { data, warm: 0 }], sizeScale: 0.85 }); canvas.style.opacity = 1;
  })();
  let then = 0;
  const frame = (ms) => { requestAnimationFrame(frame); if (!field || document.hidden) return; const t = ms / 1000, dt = Math.min(0.05, t - then); then = t;
    if (target) { const k = 1 - Math.exp(-dt * 3.2); let d = ((target[0] - yaw + Math.PI) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2) - Math.PI; yaw += d * k; pitch += (target[1] - pitch) * k; if (Math.abs(d) < 0.002 && Math.abs(target[1] - pitch) < 0.002) target = null; }
    else if (spin && !dragging) yaw += dt * 0.05;
    const m = rot(), px = wide() ? 0 : 0, py = wide() ? 0 : 0.85, z = wide() ? 3.95 : 4.6; field.render({ a: 0, b: 1, mix: 0, time: reduced ? 0 : t, eye: [px, py, z], center: [px, py, 0], rotA: m, rotB: m, swirl: 0 });
    if (marker) { const q = apply(m, sphere(marker[0], marker[1], R * 1.005)), p = field.project(q[0], q[1], q[2]); pin.hidden = q[2] < 0.05 || !p; if (p) pin.style.transform = `translate(${p[0]}px, ${p[1]}px)`; }
  };
  requestAnimationFrame(frame);
  canvas.addEventListener("pointerdown", (e) => { dragging = true; spin = false; target = null; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener("pointermove", (e) => { if (!dragging) return; yaw += e.movementX * 0.005; pitch = Math.max(-1.3, Math.min(1.3, pitch + e.movementY * 0.005)); });
  addEventListener("pointerup", () => { dragging = false; });
  canvas.addEventListener("keydown", (e) => { const d = { ArrowLeft: [0.12, 0], ArrowRight: [-0.12, 0], ArrowUp: [0, 0.12], ArrowDown: [0, -0.12] }[e.key]; if (!d) return; e.preventDefault(); spin = false; target = null; yaw += d[0]; pitch = Math.max(-1.3, Math.min(1.3, pitch + d[1])); });
  const fly = (lon, lat, label) => { spin = false; if (reduced) { yaw = -lon * rad; pitch = lat * rad; target = null; } else target = [-lon * rad, lat * rad]; marker = [lon, lat]; pinT.textContent = label; pin.hidden = false; };
  root.querySelectorAll("[data-fly]").forEach((b) => b.addEventListener("click", () => { const [lon, lat] = b.dataset.fly.split(",").map(Number); fly(lon, lat, b.dataset.label); }));
  const find = root.querySelector("[data-find]"), hits = root.querySelector("[data-hits]"); let names = null, loading = null;
  const load = () => (loading ??= fetch("/data/institutions.json").then((r) => r.json()).then((d) => { names = Object.entries(d); }));
  const title = (s) => s.replace(/(^|[\s-])(\p{L})/gu, (m, a, b) => a + b.toUpperCase());
  find.addEventListener("focus", load, { once: true });
  find.addEventListener("input", async () => { await load(); const q = find.value.trim().toLowerCase(); hits.textContent = ""; if (q.length < 2) return; for (const [n, v] of names.filter(([k]) => k.includes(q)).slice(0, 6)) { const li = document.createElement("li"), b = document.createElement("button"); b.type = "button"; b.innerHTML = `<span></span><em class="mono"></em>`; b.firstChild.textContent = title(n); b.lastChild.textContent = v[2] || v[3]; b.addEventListener("click", () => { fly(v[0], v[1], title(n)); hits.textContent = ""; find.value = title(n); }); li.append(b); hits.append(li); } if (!hits.children.length) { const li = document.createElement("li"); li.className = "none"; li.textContent = "Not among this library's institutions"; hits.append(li); } });
</script>
<style is:global>
  [data-hits] button { display: flex; justify-content: space-between; gap: 12px; width: 100%; padding: 8px 12px; text-align: left; font-size: 14px; border-radius: 8px; } [data-hits] button:hover { background: var(--s2); } [data-hits] em { font-style: normal; white-space: nowrap; } [data-hits] .none { padding: 8px 12px; color: var(--t3); font-size: 14px; }
</style>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .globe { position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: radial-gradient(45% 60% at 50% 50%, #0a1635 0%, #000 72%); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease); cursor: grab; touch-action: none; }
  canvas:active { cursor: grabbing; }
  .left { position: absolute; left: var(--edge); top: 96px; width: min(22vw, 360px); pointer-events: none; }
  .left > * { pointer-events: auto; }
  h1 { font-size: clamp(34px, 3.4vw, 60px); } .lead { margin-block: 16px 20px; }
  .find input { width: 100%; height: 46px; padding-inline: 14px; background: rgb(11 12 15 / .8); border: 1px solid var(--line2); border-radius: 12px; font-size: 15px; outline-color: var(--ink); } .find input::placeholder { color: var(--t3); }
  .find ul { margin-top: 4px; background: rgb(11 12 15 / .92); border-radius: 12px; }
  .pin { position: absolute; left: 0; top: 0; pointer-events: none; } .pin i { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border: 1.5px solid #fff; border-radius: 50%; } .pin span { position: absolute; left: 14px; top: -11px; white-space: nowrap; padding: 2px 8px; background: var(--accent); border-radius: 6px; font-size: 13px; } [hidden] { display: none; }
  .rank { position: absolute; right: var(--edge); top: 50%; translate: 0 -50%; width: min(18vw, 280px); }
  .rank button { position: relative; display: grid; grid-template-columns: 1fr auto; width: 100%; padding: 7px 0 9px; font-size: 14px; text-align: left; color: var(--t2); transition: color .15s var(--ease); } .rank button:hover { color: #fff; }
  .rank i { position: absolute; left: 0; bottom: 3px; width: 100%; height: 2px; background: var(--ink); transform-origin: left; opacity: .75; } .rank b { font-weight: 400; }
  .modes { padding: 128px var(--edge) 64px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px 64px; }
  .modes h2 { grid-column: 1; } .modes ol { grid-column: 1; align-self: start; } .modes .shot { grid-column: 2; grid-row: 1 / 3; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); }
  .modes li { padding-block: 16px; border-top: 1px solid var(--line); } .modes b { display: block; font-weight: 300; font-size: 28px; letter-spacing: -.02em; } .modes span { color: var(--t2); font-size: 15px; }
  .chains { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: center; padding: 64px var(--edge) 128px; } .chains img { width: 100%; height: auto; } .chains .lead { margin-block: 24px; }
  @media (max-width: 900px) { .left { position: relative; left: auto; top: auto; width: auto; padding: 88px var(--edge) 0; pointer-events: auto; } .rank { display: none; } .globe { height: auto; min-height: 100svh; padding-bottom: 72vw; } .modes, .chains { grid-template-columns: minmax(0, 1fr); } .modes .shot { grid-column: 1; grid-row: auto; } }
</style>
