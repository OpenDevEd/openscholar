---
import Base from "../../layouts/Base.astro";
import { PRODUCTS, featureCount } from "../../data/features.mjs";
let no = 0;
---
<Base title="All features: OpenScholar and Evidence Library" description={`A searchable catalogue of all ${featureCount} features in OpenScholar and the Evidence Library.`}>
  <section class="cat">
    <div class="top">
      <h1><span class="big" data-num>{featureCount}</span> features</h1>
      <label class="find"><span class="sr">Find a feature</span><input type="search" data-find placeholder="Search the catalogue: PDF, Zotero, export" autocomplete="off" /></label>
    </div>
    {PRODUCTS.map((p) => (
      <section class="prod" data-product>
        <h2>{p.name}</h2>
        {p.groups.map((g) => (
          <section class="grp" id={g.id} data-group>
            <h3><a href={g.page}>{g.name}</a></h3>
            <ol>{g.items.map(([n, t]) => { no += 1; return <li data-text={`${n} ${t}`.toLowerCase()}><span class="mono">{String(no).padStart(3, "0")}</span><b>{n}</b><span class="d">{t}</span></li>; })}</ol>
          </section>
        ))}
      </section>
    ))}
    <p class="none" data-none hidden>Nothing matches. Try a shorter word.</p>
  </section>
</Base>
<script>
  const input = document.querySelector("[data-find]"), rows = [...document.querySelectorAll("[data-text]")], groups = [...document.querySelectorAll("[data-group]")], prods = [...document.querySelectorAll("[data-product]")], none = document.querySelector("[data-none]"), num = document.querySelector("[data-num]");
  input.addEventListener("input", () => { const q = input.value.trim().toLowerCase(); let n = 0; for (const r of rows) { const on = !q || r.dataset.text.includes(q); r.hidden = !on; n += on; } for (const g of groups) g.hidden = !g.querySelector("li:not([hidden])"); for (const p of prods) p.hidden = !p.querySelector("[data-group]:not([hidden])"); none.hidden = n > 0; num.textContent = n; });
</script>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .cat { padding: 96px var(--edge) 96px; }
  .top { position: sticky; top: 64px; z-index: 5; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; margin-inline: calc(var(--edge) * -1); padding: 16px var(--edge); background: rgb(0 0 0 / .94); }
  h1 { font-size: clamp(36px, 5vw, 80px); } .big { font-variant-numeric: tabular-nums; }
  input { width: min(460px, 86vw); height: 52px; padding-inline: 16px; background: var(--s1); border: 1px solid var(--line2); border-radius: 14px; font-size: 16px; outline-color: var(--ink); } input::placeholder { color: var(--t3); }
  .prod { margin-top: 64px; } .prod > h2 { font-size: clamp(44px, 9vw, 150px); margin-bottom: 40px; }
  .grp { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 24px; padding-block: 32px; border-top: 1px solid var(--line2); scroll-margin-top: 160px; }
  .grp h3 { font-weight: 300; font-size: clamp(20px, 2vw, 30px); line-height: 1.15; letter-spacing: -.02em; } .grp h3 a:hover { color: var(--ink); }
  li { display: grid; grid-template-columns: 44px minmax(0, 4fr) minmax(0, 8fr); gap: 16px; align-items: baseline; padding-block: 9px; transition: background-color .12s var(--ease); }
  li:hover { background: var(--s1); } li b { font-weight: 400; font-size: 15px; } .d { color: var(--t2); font-size: 14px; line-height: 20px; } li[hidden], .grp[hidden], .prod[hidden], .none[hidden] { display: none; }
  .none { color: var(--t2); margin-top: 48px; font-size: 20px; }
  @media (max-width: 800px) { .grp { grid-template-columns: minmax(0, 1fr); } li { grid-template-columns: 36px minmax(0, 1fr); } .d { grid-column: 2; } }
</style>
