---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import Cards from "../components/Cards.astro";
import AudienceArt from "../components/AudienceArt.astro";
import Art from "../components/Art.astro";
import Workspace from "../components/Workspace.astro";
import Table from "../components/Table.astro";
import Faq from "../components/Faq.astro";
import AskBar from "../components/AskBar.astro";
import Device from "../components/Device.astro";
import Icon from "../components/Icon.astro";
import Arrow from "../components/Arrow.astro";
import { APP } from "../data/site.mjs";
const teams = [
  ["ocean", "review", "Review teams", "Run systematic and scoping reviews with explicit criteria and data you can export.", "/#screening"],
  ["rose", "brief", "Policy and programme teams", "Get to a defensible answer quickly, with the sources behind it ready to share.", "/#trust"],
  ["emerald", "community", "Institutions and networks", "Give your field one trusted, public home for its evidence, under your own name.", "/evidence-communities/"],
];
const questions = [["Is this an intervention study?", 11, 1, 3], ["Is it about reading or literacy?", 15, 0, 0], ["Is it in primary school?", 13, 1, 1]];
const beams = [[348, -17.6, "Tutoring as a reading intervention for bilingual learners"], [392, -11.5, "Peer tutoring and children's e-book reading comprehension"], [435, -6.5, "Effect of peer tutoring in reading for boys in French immersion"], [481, -2, "Role of peer tutoring in urban primary school reading skills", true], [528, 2.2, "An online peer tutoring intervention to promote reading skills"], [573, 6.5, "Peer tutor-based Quranic learning in elementary schools"], [618, 11, "Applying peer-tutoring to spelling in an elementary classroom"]];
const faq = [
  ["What does the AI read?", "Screening and extraction work from each paper's title and abstract. The assistant can also read open-access PDFs and files you attach to a chat. Answers show how well they're grounded and link to their source where they can, and the assistant tells you when it couldn't read something."],
  ["Can we choose the model?", "Yes. Choose a preset, pick a model for each task, or use your own provider key."],
  ["Does it work with Zotero?", "Yes. OpenScholar can read your Zotero groups, collections and items, and an Evidence Community can publish from a Zotero group."],
  ["Can we take our data with us?", "Yes. Results, screenings and extractions all export, in formats including CSV, JSON and Excel."],
  ["Who can see our work?", "Members of an organization see its work. To bring someone in from outside, share a single item with them as a viewer or an editor."],
];
---
<Base title="OpenScholar: the evidence workspace for research teams" description="Know what the evidence says before anyone asks you to defend it. Find the literature, screen it against your criteria, extract the data and publish what you learn.">
  <section class="bleed hero">
    <div class="ribbon">
      <Art name="hero-stream" live eager />
      <a class="st1 station" href="#product" style="--z:18"><span class="st-q"><b>"peer tutoring"</b> <i>AND</i> <em>reading</em></span><span class="st-m"><b>829</b> papers<svg viewBox="0 0 76 22" width="76" height="22" aria-hidden="true">{[5, 6, 3, 5, 4, 6, 7, 6, 7, 6, 11, 8, 14, 6, 9, 8, 10, 22].map((h, i) => <rect x={i * 4.300} y={22 - h} width="3.200" height={h} rx=".8" fill={i === 17 ? "#2563eb" : "#bfdbfe"} />)}</svg></span></a>
      <a class="st2 station" href="#screening" style="--z:30"><span class="st-t">Is it about reading or literacy?</span><span class="st-v"><Icon name="check" size={14} />15 yes<i>0 unclear</i></span></a>
      <a class="st3 station" href="#extraction" style="--z:12"><span class="st-t">Who took part?</span><b class="st-a">294 students aged 11 to 13</b><span class="st-c"><u style="--w:90%"></u>90%</span></a>
      <a class="st4 station" href="#community" style="--z:24"><img src="/favicon.svg" width="20" height="20" alt="" /><span><b>Wealth Inequality</b><i>Updated every night</i></span></a>
    </div>
    <div class="inner">
      <div class="h-copy"><h1>Know what the evidence says before anyone asks you to defend it</h1><p class="lead">OpenScholar is the evidence workspace for research teams. Find the literature, screen it against your criteria, extract the data and publish what you learn.</p><AskBar id="ask-hero" class="big" typing /><a class="live" href="https://wealth-inequality.openscholar.ai">See a live community<Arrow /></a></div>
      <Workspace />
    </div>
  </section>

  <section class="who" id="who"><h2>For anyone whose work has to stand on the evidence</h2>
    <div class="teams">{teams.map(([f, k, t, d, href]) => <a class="panel edge" href={href}><i class={`field f-${f}`} aria-hidden="true"></i><AudienceArt kind={k} /><h3>{t}<Arrow /></h3><p>{d}</p></a>)}</div>
  </section>

  <Feature id="product" class="find" field="ocean" art="sea" chip="#0e7490" title="Start with the whole literature, not the first page of it" text="Ask in plain language. You get a query you can read and change, and a view of the whole field before you commit to reading any of it.">
    <Device class="slab" kind="tablet" name="search2" theme="dark" alt="Search results on a tablet, with an overview of the field and a chart of papers per year" tilt sizes="(max-width: 900px) 90vw, 620px" />
    <div class="over"><Cards kind="query" /></div>
  </Feature>

  <section class="bleed sieve" id="screening">
    <div class="scene" data-in>
      <Art name="pane" />
      <div class="s-head"><h2>Decide what counts once, then apply it to every paper</h2><p class="lead">Write your questions and what each answer is worth. AI answers for every paper, your rules decide what's included, and you can overrule any answer.</p></div>
      <div class="persp" aria-hidden="true"><div class="etched">
        <b>Your criteria</b>
        <ol>{questions.map(([q, y, u, n], i) => <li style={`--i:${i}`}><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri"><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol>
        <p>Included at 2 of 3 points</p>
      </div></div>
      <div class="tally-s" aria-hidden="true"><b>14</b><span>included</span><b class="amber">1</b><span>for you to decide</span></div>
      <ul class="beams" aria-label="Papers that met the criteria">{beams.map(([y, a, t, amber], i) => <li class:list={{ amber }} style={`--y:${y};--a:${a}deg;--i:${i}`}><Icon name={amber ? "flagq" : "check"} size={14} /><span>{t}</span></li>)}</ul>
    </div>
    <div class="s-small">
      <div class="frost rules"><b>Your criteria</b><ol>{questions.map(([q, y, u, n], i) => <li><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri"><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol><p>Included at 2 of 3 points</p></div>
      <div class="frost out"><div class="tally"><b>Included</b><span>14 of 15 papers</span></div><ul>{beams.slice(0, 5).map(([, , t, amber]) => <li class:list={{ maybe: amber }}><Icon name={amber ? "flagq" : "check"} size={16} /><span>{t}</span></li>)}</ul></div>
    </div>
  </section>

  <section class="panel band" id="extraction">
    <i class="field f-amber" aria-hidden="true"></i><Art name="grid" pos="100% 0" class="dim" style="--sc:109 29 1" />
    <div class="b-head stack"><h2>Stop retyping the literature into a spreadsheet</h2><p class="lead">Ask the same questions of every paper's abstract and get a table you can sort, check and export. Start with the answers the model is least sure of.</p></div>
    <Table />
  </section>

  <Feature id="assistant" class="ask-f" field="cobalt" art="gate" scrim="--sc:9 32 124;--dir:270deg" chip="#1d4ed8" flip title="Delegate the groundwork, not the decisions" text="Describe the review you need. The assistant searches, builds collections and runs jobs in your workspace, stops for your approval, and tells you which results to check by hand.">
    <Device class="hand" kind="phone" name="assistant" theme="dark" alt="The research assistant on a phone, listing which papers to check by hand" sizes="(max-width: 900px) 60vw, 280px" />
    <div class="over"><Cards kind="approve" /></div>
  </Feature>

  <section class="bleed trust" id="trust">
    <div class="inner t-head"><h2>Built for the moment someone asks how you know</h2><p class="lead">Follow a cited answer back through its sentence to its paper. Your criteria are written down, every change has a name beside it, and people make the final call.</p></div>
    <div class="wire" data-in>
      <Art name="thread" />
      <div class="inner trace" aria-hidden="true">
        <div class="t-a"><span>What is the sample size?</span><b>298 pupils</b><em>97% confidence</em></div>
        <div class="t-b"><p>A randomised trial was conducted in four Colombian elementary schools with eight classes, and <mark>298 third and fifth grade pupils</mark>.</p></div>
        <div class="t-c"><i class="sheet-mini"><u></u><u></u><u></u><u></u></i><div><b>Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia</b><span>Thurston, 2023</span></div></div>
      </div>
    </div>
  </section>

  <section class="panel publish" id="community" style="--tint:#be123c">
    <Art name="globe" pos="100% 50%" />
    <div class="p-copy"><h2>Turn your evidence into a living community</h2><p class="lead">Give your field a public home with your own branding and address. You choose the sources that keep it current, and readers can search it, explore it and ask it questions.</p><a class="btn" href="/evidence-communities/">Explore Evidence Communities<Arrow /></a></div>
    <div class="p-devices" data-in>
      <a class="p-lap" href="https://wealth-inequality.openscholar.ai" aria-label="Wealth Inequality and Social Mobility community"><Device kind="laptop" name="c-home" theme="light" alt="" tilt sizes="(max-width: 900px) 80vw, 620px" /></a>
      <Device class="p-ph" kind="phone" name="c-map" theme="dark" alt="" sizes="(max-width: 900px) 30vw, 170px" />
    </div>
  </section>

  <Faq items={faq} />

  <section class="bleed close"><Art name="dark-ribbon" pos="50% 100%" live /><div class="inner"><h2>Start with your next question</h2><AskBar id="ask-end" /></div></section>
</Base>
<style>
  .hero { color: var(--ink); background: #fff; padding-block: clamp(100px, 8.4vw, 124px) clamp(24px, 3vw, 40px); }
  .ribbon { position: absolute; z-index: -2; top: 0; right: 0; width: max(100vw, 1180px); aspect-ratio: 1672 / 941; }
  .ribbon :global(.art) { z-index: 0; -webkit-mask-image: linear-gradient(#000 84%, transparent); mask-image: linear-gradient(#000 84%, transparent); animation: unfurl 1.6s var(--ease) both; }
  @keyframes unfurl { from { clip-path: inset(0 0 100% 40%); } to { clip-path: inset(0 0 -2% -2%); } }
  .station { position: absolute; display: grid; gap: 6px; padding: 12px 14px; border-radius: 14px; background: rgb(255 255 255 / .84); -webkit-backdrop-filter: blur(16px) saturate(1.7); backdrop-filter: blur(16px) saturate(1.7); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .7), 0 0 0 1px var(--line), 0 22px 44px -20px rgb(10 26 63 / .5); font-size: 13px; line-height: 1.25; transform: translate(calc(var(--hx, 0) * var(--z) * 1px), calc(var(--hy, 0) * var(--z) * 1px)); transition: transform .5s var(--ease), box-shadow .25s var(--ease); animation: pop .8s var(--ease) both; }
  .station:hover { box-shadow: inset 0 0 0 1px #fff, 0 0 0 1px var(--line2), 0 28px 54px -18px rgb(10 26 63 / .6); }
  @keyframes pop { from { opacity: 0; scale: .92; } }
  .st1 { left: 58%; top: 12%; animation-delay: .5s; } .st2 { left: 78%; top: 39%; animation-delay: .75s; } .st3 { left: 53.500%; top: 48%; animation-delay: 1s; width: 216px; } .st4 { left: 75%; top: 72%; animation-delay: 1.25s; grid-template-columns: 20px auto; align-items: center; column-gap: 10px; }
  .st-q { font-size: 14px; font-weight: 500; white-space: nowrap; } .st-q b { font-weight: 500; padding: 1px 4px; border-radius: 4px; background: #ffe08a; } .st-q i { font-style: normal; color: var(--t3); } .st-q em { font-style: normal; padding: 1px 4px; border-radius: 4px; background: #a9d6ff; } .st-m { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; color: var(--t2); } .st-m > b { font-weight: 500; font-size: 18px; color: var(--ink); line-height: 1; margin-right: -8px; }
  .st-t { color: var(--t2); } .st-v { display: flex; align-items: center; gap: 6px; font-weight: 500; font-size: 15px; color: #047857; } .st-v i { margin-left: 8px; font-style: normal; font-weight: 400; font-size: 13px; color: var(--t3); }
  .st-a { font-weight: 500; font-size: 15px; } .st-c { display: flex; align-items: center; gap: 8px; font: 400 12px/1 var(--mono); color: #047857; } .st-c u { flex: 1; height: 5px; border-radius: 3px; background: linear-gradient(90deg, #059669 var(--w), var(--soft) 0); }
  .st4 b { display: block; font-weight: 500; font-size: 14px; } .st4 i { display: block; font-style: normal; color: var(--t2); }
  .h-copy { display: grid; gap: 18px; justify-items: start; width: min(47%, 620px); min-width: 0; margin-bottom: clamp(36px, 4.4vw, 60px); } .h-copy h1 { font-size: clamp(40px, 4.5vw, 64px); } .h-copy .lead { color: var(--t2); }
  .h-copy :global(.big) { width: 100%; box-shadow: 0 0 0 1px var(--line2), 0 24px 50px -22px rgb(37 99 235 / .55); background: #fff; } .h-copy :global(.big:focus-within) { box-shadow: 0 0 0 2px var(--brand), 0 24px 50px -22px rgb(37 99 235 / .55); }
  .live { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--brand-dark); } .live :global(i) { display: grid; transition: transform .25s var(--ease); } .live:hover :global(i) { transform: translateX(4px); }
  .h-copy > * { animation: rise .9s var(--ease) both; } .h-copy > :nth-child(2) { animation-delay: .08s; } .h-copy > :nth-child(3) { animation-delay: .16s; } .h-copy > :nth-child(4) { animation-delay: .22s; } .hero :global(.ws) { animation: rise 1s .28s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  .band { display: grid; gap: 28px; padding: var(--pad); } .b-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .stack { grid-template-columns: minmax(0, 1fr); width: min(52%, 600px); } .band :global(.art) { height: 440px; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  /* Find: a tablet standing off the panel's edge, with the query on top of it. */
  :global(.find) :global(.slab) { position: absolute; left: 8%; top: 56px; width: min(620px, 92%); } :global(.find) .over { position: absolute; left: -4%; bottom: 40px; width: min(360px, 62%); z-index: 2; } :global(.find) { min-height: 680px; }
  /* Assistant: the phone waits at the door with the approval beside it. */
  :global(.ask-f) :global(.hand) { position: absolute; left: 14%; top: 44px; width: 270px; } :global(.ask-f) .over { position: absolute; left: 50%; bottom: 64px; width: min(330px, 46%); z-index: 2; }
  /* Screening: your criteria are etched on the pane in the picture, and the papers that pass run along its beams. */
  .sieve { background: #02382b; --g: 2 44 34; }
  .s-head { --l: max(calc(var(--u) * 64), calc((100cqw - 1248px) / 2 + 32px)); position: absolute; z-index: 2; left: var(--l); top: calc(var(--u) * 56); width: calc(var(--u) * 640 - var(--l)); display: grid; gap: calc(var(--u) * 16); } .s-head h2 { font-size: max(26px, calc(var(--u) * 44)); } .s-head .lead { font-size: max(14px, calc(var(--u) * 19)); }
  .persp { position: absolute; z-index: 1; inset: 0; perspective: calc(var(--u) * 800); perspective-origin: calc(var(--u) * 836) calc(var(--u) * 522); pointer-events: none; }
  .etched { position: absolute; left: calc(var(--u) * 690); top: calc(var(--u) * 112); width: calc(var(--u) * 617); height: calc(var(--u) * 678); padding: calc(var(--u) * 60) calc(var(--u) * 40) calc(var(--u) * 50) calc(var(--u) * 44); transform-origin: 0 50%; transform: rotateY(41deg); display: flex; flex-direction: column; color: #fff; }
  .etched > b { font-weight: 500; font-size: calc(var(--u) * 44); letter-spacing: -.02em; margin-bottom: calc(var(--u) * 42); } .etched ol { display: grid; gap: calc(var(--u) * 34); } .etched li { display: grid; grid-template-columns: calc(var(--u) * 42) minmax(0, 1fr); gap: calc(var(--u) * 10) calc(var(--u) * 14); align-items: center; font-size: calc(var(--u) * 27); line-height: 1.2; } .etched .n { display: grid; place-items: center; width: calc(var(--u) * 42); height: calc(var(--u) * 42); border-radius: calc(var(--u) * 10); background: rgb(255 255 255 / .16); font-family: var(--mono); font-size: calc(var(--u) * 24); } .etched .tri { grid-column: 2; height: calc(var(--u) * 8); border-radius: 99px; } .etched p { margin-top: auto; padding-top: calc(var(--u) * 18); border-top: 1px solid rgb(255 255 255 / .22); font-size: calc(var(--u) * 24); opacity: .9; }
  .tri { display: flex; gap: 2px; overflow: hidden; } .tri .y { background: #34d399; } .tri .u { background: #fbbf24; } .tri .x { background: rgb(255 255 255 / .3); }
  .tally-s { position: absolute; z-index: 1; left: calc(var(--u) * 1280); top: calc(var(--u) * 96); display: grid; grid-template-columns: auto auto; gap: calc(var(--u) * 2) calc(var(--u) * 12); align-items: baseline; font-size: max(13px, calc(var(--u) * 18)); } .tally-s b { font: 400 max(30px, calc(var(--u) * 54))/1 var(--mono); letter-spacing: -.03em; color: #6ee7b7; } .tally-s b.amber { font-size: max(20px, calc(var(--u) * 32)); color: #fbbf24; }
  .beams { position: absolute; z-index: 1; inset: 0; pointer-events: none; } .beams li { position: absolute; left: calc(var(--u) * 1180); top: calc(var(--u) * var(--y)); display: flex; align-items: center; gap: calc(var(--u) * 8); width: calc(var(--u) * 480); font-size: max(11px, calc(var(--u) * 15)); line-height: 1.1; white-space: nowrap; transform-origin: 0 50%; transform: rotate(var(--a)); pointer-events: auto; } .beams li span { overflow: hidden; text-overflow: ellipsis; text-shadow: 0 1px 6px rgb(1 40 30 / .9); } .beams :global(svg) { flex: none; width: max(12px, calc(var(--u) * 16)); color: #6ee7b7; } .beams .amber :global(svg) { color: #fbbf24; } .beams .amber span { color: #fde68a; }
  .s-small { display: none; }
  /* The sentence lights up on the glass first, then papers run out along the beams one at a time. */
  .js .sieve .scene[data-in] { opacity: 1; transform: none; } .js .scene .etched > *, .js .scene .tally-s { opacity: 0; } .js .scene .beams li { opacity: 0; translate: calc(var(--u) * -60) 0; } .js .scene .etched .tri { transform: scaleX(0); transform-origin: left; }
  .js .scene.in .etched > *, .js .scene.in .tally-s { opacity: 1; transition: opacity .7s var(--ease) .2s; } .js .scene.in .etched .tri { transform: none; transition: transform .9s var(--ease) calc(.5s + var(--i, 0) * .14s); } .js .scene.in .beams li { opacity: 1; translate: 0 0; transition: opacity .6s var(--ease) calc(.9s + var(--i) * .1s), translate .9s var(--ease) calc(.9s + var(--i) * .1s); } .js .scene.in .tally-s { transition-delay: 1.5s; }
  .rules { padding: 18px 18px 14px; } .rules > b { display: block; font-weight: 500; font-size: 17px; margin-bottom: 12px; } .rules ol { display: grid; gap: 12px; } .rules li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 4px 10px; align-items: center; font-size: 14px; } .rules .n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: rgb(255 255 255 / .14); font: 400 13px/1 var(--mono); } .rules .tri { grid-column: 2; height: 5px; border-radius: 3px; } .rules p { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgb(255 255 255 / .14); font-size: 13px; opacity: .85; }
  .out { padding: 18px; } .tally { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; } .tally b { font-weight: 500; font-size: 17px; } .tally span { font: 400 13px/1 var(--mono); opacity: .85; } .out ul { display: grid; gap: 9px; font-size: 14px; line-height: 1.3; } .out li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; } .out li :global(svg) { margin-top: 1px; color: #6ee7b7; } .out .maybe :global(svg) { color: #fbbf24; }
  .who { padding: clamp(40px, 6vw, 72px) var(--pad) 8px; } .who h2 { max-width: 16em; margin-bottom: 28px; }
  .teams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-inline: calc(var(--pad) * -1); } .teams .panel { display: flex; flex-direction: column; gap: 10px; padding: 24px; } .teams :global(svg:not(h3 svg)) { margin-bottom: 14px; transition: transform .4s var(--ease); } .teams :global(.aud) { margin-bottom: 14px; transition: transform .4s var(--ease); } .teams .panel:hover :global(.aud), .teams .panel:hover > :global(svg) { transform: translateY(-4px); } .teams h3 { display: flex; justify-content: space-between; align-items: center; gap: 8px; } .teams h3 :global(i) { display: grid; place-items: center; width: 28px; height: 28px; transition: transform .3s var(--ease); } .teams .panel:hover h3 :global(i) { transform: translateX(4px); } .teams p { font-size: 16px; line-height: 1.4; }
  /* Trust: one line of light from the answer to the paper. It lights from the left when you arrive, and each card wakes as it gets there. */
  .trust { background: #00081a; padding-top: clamp(56px, 7vw, 96px); } .t-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .wire { position: relative; isolation: isolate; overflow: clip; display: grid; align-items: center; margin-top: -24px; min-height: clamp(460px, 44vw, 660px); } .wire :global(.art) { z-index: -1; -webkit-mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); mask-image: linear-gradient(transparent, #000 22%, #000 78%, transparent); }
  .wire::after { content: ""; position: absolute; z-index: -1; left: -220px; top: 50%; width: 220px; height: 3px; margin-top: -1.5px; background: linear-gradient(90deg, transparent, #fff 50%, transparent); animation: run 3.6s linear infinite; } @keyframes run { to { transform: translateX(calc(100vw + 220px)); } }
  .trace { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr); gap: clamp(40px, 5vw, 72px); align-items: stretch; width: 100%; }
  .t-a, .t-b, .t-c { display: flex; flex-direction: column; justify-content: center; min-height: 148px; padding: 18px 20px; border-radius: 16px; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px rgb(251 191 36 / .55), 0 24px 70px -18px rgb(251 191 36 / .4); transition: transform .3s var(--ease), box-shadow .3s var(--ease); } .t-a:hover, .t-b:hover, .t-c:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px rgb(251 191 36 / .9), 0 30px 80px -16px rgb(251 191 36 / .6); }
