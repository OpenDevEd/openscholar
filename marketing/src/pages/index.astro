---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import Cards from "../components/Cards.astro";
import AudienceArt from "../components/AudienceArt.astro";
import Art from "../components/Art.astro";
import Workspace from "../components/Workspace.astro";
import Table from "../components/Table.astro";
import Faq from "../components/Faq.astro";
import AskBar from "../components/AskBar.astro";
import Device from "../components/Device.astro";
import Icon from "../components/Icon.astro";
import Arrow from "../components/Arrow.astro";
import { APP } from "../data/site.mjs";
const teams = [
  ["ocean", "pane", "2 56 44", "review", "Review teams", "Run systematic and scoping reviews with explicit criteria and data you can export.", "/#screening"],
  ["rose", "thread", "2 10 34", "brief", "Policy and programme teams", "Get to a defensible answer quickly, with the sources behind it ready to share.", "/#trust"],
  ["emerald", "globe", "82 1 22", "community", "Institutions and networks", "Give your field one trusted, public home for its evidence, under your own name.", "/evidence-communities/"],
];
const questions = [["Is this an intervention study?", 11, 1, 3], ["Is it about reading or literacy?", 15, 0, 0], ["Is it in primary school?", 13, 1, 1]];
const beams = [[330, "Tutoring as a reading intervention for bilingual learners"], [387, "Peer tutoring and children's e-book reading comprehension"], [442, "Effect of peer tutoring in reading for boys in French immersion"], [494, "Role of peer tutoring in urban primary school reading skills", true], [551, "An online peer tutoring intervention to promote reading skills"], [605, "Peer tutor-based Quranic learning in elementary schools"], [661, "Applying peer-tutoring to spelling in an elementary classroom"]];
const faq = [
  ["What does the AI read?", "Screening and extraction work from each paper's title and abstract. The assistant can also read open-access PDFs and files you attach to a chat. Answers show how well they're grounded and link to their source where they can, and the assistant tells you when it couldn't read something."],
  ["Can we choose the model?", "Yes. Choose a preset, pick a model for each task, or use your own provider key."],
  ["Does it work with Zotero?", "Yes. OpenScholar can read your Zotero groups, collections and items, and an Evidence Community can publish from a Zotero group."],
  ["Can we take our data with us?", "Yes. Results, screenings and extractions all export, in formats including CSV, JSON and Excel."],
  ["Who can see our work?", "Members of an organization see its work. To bring someone in from outside, share a single item with them as a viewer or an editor."],
];
---
<Base title="OpenScholar: the evidence workspace for research teams" description="Know what the evidence says before anyone asks you to defend it. Find the literature, screen it against your criteria, extract the data and publish what you learn.">
  <section class="bleed hero">
    <div class="ribbon"><Art name="hero-pour" live eager /></div>
    <div class="inner h-grid">
      <div class="h-copy"><h1>Know what the evidence says before anyone asks you to defend it</h1><p class="lead">The evidence workspace for research teams. Find the literature, screen it against your criteria, extract the data and publish what you learn.</p><AskBar id="ask-hero" class="big" typing /><a class="live" href="https://wealth-inequality.openscholar.ai">See a live community<Arrow /></a></div>
      <Workspace />
    </div>
  </section>

  <section class="who" id="who"><h2>For anyone whose work has to stand on the evidence</h2>
    <div class="teams">{teams.map(([f, a, sc, k, t, d, href]) => <a class="panel edge" href={href}><i class={`field f-${f}`} aria-hidden="true"></i><Art name={a} class="card-art" style={`--sc:${sc}`} /><AudienceArt kind={k} /><h3>{t}<Arrow /></h3><p>{d}</p></a>)}</div>
  </section>

  <Feature id="product" class="find" field="ocean" art="sea" chip="#0e7490" title="Start with the whole literature, not the first page of it" text="Ask in plain language. You get a query you can read and change, and a view of the whole field before you commit to reading any of it.">
    <Device class="slab" kind="tablet" name="search3" theme="dark" alt="Search results on a tablet, with the query's terms highlighted in each paper" tilt sizes="(max-width: 900px) 90vw, 620px" />
    <div class="over"><Cards kind="query" /></div>
  </Feature>

  <section class="bleed sieve" id="screening">
    <div class="scene" data-in>
      <Art name="pane" />
      <div class="s-head"><h2>Decide what counts once, then apply it to every paper</h2><p class="lead">Write your questions and what each answer is worth. AI answers for every paper, your rules decide what's included, and you can overrule any answer.</p></div>
      <div class="persp" aria-hidden="true"><div class="etched">
        <b>Your criteria</b>
        <ol>{questions.map(([q, y, u, n], i) => <li style={`--i:${i}`}><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri"><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol>
        <p>Included at 2 of 3 points</p>
      </div></div>
      <div class="tally-s" aria-hidden="true"><b>14</b><span>included</span><b class="amber">1</b><span>for you to decide</span></div>
      <ul class="beams" aria-label="Papers that met the criteria">{beams.map(([y, t, amber], i) => <li class:list={{ amber }} style={`--y:${y};--i:${i}`}><Icon name={amber ? "flagq" : "check"} size={14} /><span>{t}</span></li>)}</ul>
    </div>
    <div class="s-small">
      <div class="frost rules"><b>Your criteria</b><ol>{questions.map(([q, y, u, n], i) => <li><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri"><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol><p>Included at 2 of 3 points</p></div>
      <div class="frost out"><div class="tally"><b>Included</b><span>14 of 15 papers</span></div><ul>{beams.slice(0, 5).map(([, t, amber]) => <li class:list={{ maybe: amber }}><Icon name={amber ? "flagq" : "check"} size={16} /><span>{t}</span></li>)}</ul></div>
    </div>
  </section>

  <section class="panel band" id="extraction">
    <i class="field f-amber" aria-hidden="true"></i><Art name="grid" pos="100% 0" class="dim" style="--sc:109 29 1" />
    <div class="b-head stack"><h2>Stop retyping the literature into a spreadsheet</h2><p class="lead">Ask the same questions of every paper's abstract and get a table you can sort, check and export. Start with the answers the model is least sure of.</p></div>
    <Table />
  </section>

  <Feature id="assistant" class="ask-f" field="cobalt" art="gate" scrim="--sc:9 32 124;--dir:270deg" chip="#1d4ed8" flip title="Delegate the groundwork, not the decisions" text="Describe the review you need. The assistant searches, builds collections and runs jobs in your workspace, stops for your approval, and tells you which results to check by hand.">
    <img class="asst-panel" src="/img/screens/panel-assistant-light.avif" width="880" height="1337" loading="lazy" decoding="async" alt="The research assistant's reply, listing which papers to check by hand and why" />
    <div class="over"><Cards kind="approve" /></div>
  </Feature>

  <section class="bleed trust" id="trust"><Art name="thread" />
    <div class="inner t-head"><h2>Built for the moment someone asks how you know</h2><p class="lead">Follow a cited answer back through its sentence to its paper. Your criteria are written down, every change has a name beside it, and people make the final call.</p></div>
    <div class="inner proof" data-in>
      <div class="proof-copy" aria-hidden="true"><span>What was the main finding?</span><b>Nearly all children showed improved reading fluency</b><em>93% confidence, grounded in the abstract</em></div>
      <svg class="tie" viewBox="0 0 160 700" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 132C96 132 64 606 160 606" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" pathLength="1" /></svg>
      <div class="proof-page"><img src="/img/screens/panel-citation-light.avif" width="880" height="1349" loading="lazy" decoding="async" alt="An extracted answer with its confidence and reasoning, above the paper's abstract with the source sentence highlighted" /></div>
          </div>
  </section>

  <section class="panel publish" id="community" style="--tint:#be123c">
    <Art name="globe" pos="100% 50%" />
    <div class="p-copy"><h2>Turn your evidence into a living community</h2><p class="lead">Give your field a public home with your own branding and address. You choose the sources that keep it current, and readers can search it, explore it and ask it questions.</p><a class="btn" href="/evidence-communities/">Explore Evidence Communities<Arrow /></a></div>
    <div class="p-devices" data-in>
      <a class="p-lap" href="https://wealth-inequality.openscholar.ai" aria-label="Wealth Inequality and Social Mobility community"><Device kind="laptop" name="c-home" theme="light" alt="" tilt sizes="(max-width: 900px) 80vw, 620px" /></a>
      <Device class="p-ph" kind="phone" name="c-home" theme="dark" alt="" sizes="(max-width: 900px) 30vw, 170px" />
    </div>
  </section>

  <Faq items={faq} />

  <section class="bleed close"><Art name="dark-ribbon" pos="50% 100%" live /><div class="inner"><h2>Start with your next question</h2><AskBar id="ask-end" /></div></section>
</Base>
<style>
  /* First screen: the words on the left, and the stream of papers pouring into a working product on the right. */
  .hero { color: var(--ink); background: #fff; padding-block: clamp(100px, 8vw, 116px) clamp(56px, 5vw, 72px); }
  .ribbon { position: absolute; z-index: -2; top: 0; right: 0; width: max(100vw, 1180px); aspect-ratio: 1672 / 941; }
  .ribbon :global(.art) { z-index: 0; animation: unfurl 1.6s var(--ease) both; } @keyframes unfurl { from { clip-path: inset(0 0 100% 40%); } to { clip-path: inset(0 0 -2% -2%); } }
  .h-grid { display: grid; grid-template-columns: minmax(0, 450px) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .h-copy { display: grid; gap: 18px; justify-items: start; min-width: 0; } .h-copy h1 { font-size: clamp(38px, 3.6vw, 54px); } .h-copy .lead { color: var(--t2); font-size: clamp(16px, 1.25vw, 18px); }
  .hero :global(.ws) { width: min(50vw, 900px); margin-top: clamp(96px, 11vw, 180px); }
  .h-copy :global(.big) { width: 100%; box-shadow: 0 0 0 1px var(--line2), 0 24px 50px -22px rgb(37 99 235 / .55); background: #fff; } .h-copy :global(.big:focus-within) { box-shadow: 0 0 0 2px var(--brand), 0 24px 50px -22px rgb(37 99 235 / .55); }
  .live { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--brand-dark); } .live :global(i) { display: grid; transition: transform .25s var(--ease); } .live:hover :global(i) { transform: translateX(4px); }
  .h-copy > * { animation: rise .9s var(--ease) both; } .h-copy > :nth-child(2) { animation-delay: .08s; } .h-copy > :nth-child(3) { animation-delay: .16s; } .h-copy > :nth-child(4) { animation-delay: .22s; } .hero :global(.ws) { animation: rise 1s .3s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  .band { display: grid; gap: 28px; padding: var(--pad); } .b-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .stack { grid-template-columns: minmax(0, 1fr); width: min(52%, 600px); } .band :global(.art) { height: 440px; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  /* Find: a tablet standing off the panel's edge, with the query on top of it. */
  :global(.find) :global(.slab) { position: absolute; left: 8%; top: 56px; width: min(620px, 92%); } :global(.find) .over { position: absolute; left: -4%; bottom: 40px; width: min(360px, 62%); z-index: 2; } :global(.find) { min-height: 680px; }
  /* Assistant: the phone waits at the door with the approval beside it. */
  :global(.ask-f) .asst-panel { position: absolute; left: 4%; top: 44px; width: min(390px, 52%); height: auto; border-radius: 18px; box-shadow: 0 0 0 1px rgb(255 255 255 / .3), 0 50px 90px -30px rgb(2 8 50 / .85); } :global(.ask-f) { min-height: 720px; } :global(.ask-f) .over { position: absolute; left: 59%; bottom: 44px; width: min(300px, 40%); z-index: 2; }
  /* Screening: your criteria are etched on the pane in the picture, and the papers that pass run along its beams. */
  .sieve { background: #02382b; --g: 2 44 34; }
  .s-head { --l: max(calc(var(--u) * 64), calc((100cqw - 1280px) / 2 + var(--gap) + var(--pad))); position: absolute; z-index: 2; left: var(--l); top: calc(var(--u) * 56); width: calc(var(--u) * 620 - var(--l)); display: grid; gap: calc(var(--u) * 16); } .s-head h2 { font-size: max(26px, calc(var(--u) * 44)); } .s-head .lead { font-size: max(14px, calc(var(--u) * 19)); }
  .persp { position: absolute; z-index: 1; inset: 0; perspective: calc(var(--u) * 800); perspective-origin: calc(var(--u) * 836) calc(var(--u) * 522); pointer-events: none; }
  .etched { position: absolute; left: calc(var(--u) * 690); top: calc(var(--u) * 112); width: calc(var(--u) * 617); height: calc(var(--u) * 678); padding: calc(var(--u) * 60) calc(var(--u) * 40) calc(var(--u) * 50) calc(var(--u) * 44); transform-origin: 0 50%; transform: rotateY(41deg); display: flex; flex-direction: column; color: #fff; }
  .etched > b { font-weight: 500; font-size: calc(var(--u) * 44); letter-spacing: -.02em; margin-bottom: calc(var(--u) * 42); } .etched ol { display: grid; gap: calc(var(--u) * 34); } .etched li { display: grid; grid-template-columns: calc(var(--u) * 42) minmax(0, 1fr); gap: calc(var(--u) * 10) calc(var(--u) * 14); align-items: center; font-size: calc(var(--u) * 27); line-height: 1.2; } .etched .n { display: grid; place-items: center; width: calc(var(--u) * 42); height: calc(var(--u) * 42); border-radius: calc(var(--u) * 10); background: rgb(255 255 255 / .16); font-family: var(--mono); font-size: calc(var(--u) * 24); } .etched .tri { grid-column: 2; height: calc(var(--u) * 8); border-radius: 99px; } .etched p { margin-top: auto; padding-top: calc(var(--u) * 18); border-top: 1px solid rgb(255 255 255 / .22); font-size: calc(var(--u) * 24); opacity: .9; }
  .tri { display: flex; gap: 2px; overflow: hidden; } .tri .y { background: #34d399; } .tri .u { background: #fbbf24; } .tri .x { background: rgb(255 255 255 / .3); }
  .tally-s { position: absolute; z-index: 1; left: calc(var(--u) * 1130); top: calc(var(--u) * 170); display: grid; grid-template-columns: auto auto; gap: calc(var(--u) * 2) calc(var(--u) * 12); align-items: baseline; font-size: max(13px, calc(var(--u) * 18)); } .tally-s b { font: 400 max(30px, calc(var(--u) * 54))/1 var(--mono); letter-spacing: -.03em; color: #6ee7b7; } .tally-s b.amber { font-size: max(20px, calc(var(--u) * 32)); color: #fbbf24; }
  .beams { position: absolute; z-index: 1; inset: 0; pointer-events: none; } .beams li { position: absolute; left: calc(var(--u) * 1130); top: calc(var(--u) * var(--y)); translate: 0 -50%; display: flex; align-items: center; gap: calc(var(--u) * 8); max-width: calc(var(--u) * 510); padding: calc(var(--u) * 7) calc(var(--u) * 12); border-radius: calc(var(--u) * 9); background: rgb(2 38 30 / .86); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14); font-size: max(11px, calc(var(--u) * 15)); line-height: 1.15; white-space: nowrap; pointer-events: auto; } .beams .amber { box-shadow: inset 0 0 0 1px rgb(251 191 36 / .6); } .beams li span { overflow: hidden; text-overflow: ellipsis; } .beams :global(svg) { flex: none; width: max(12px, calc(var(--u) * 16)); color: #6ee7b7; } .beams .amber :global(svg) { color: #fbbf24; } .beams .amber span { color: #fde68a; }
  .s-small { display: none; }
  /* The sentence lights up on the glass first, then papers run out along the beams one at a time. */
  .js .sieve .scene[data-in] { opacity: 1; transform: none; } .js .scene .etched > *, .js .scene .tally-s { opacity: 0; } .js .scene .beams li { opacity: 0; translate: calc(var(--u) * -60) -50%; } .js .scene .etched .tri { transform: scaleX(0); transform-origin: left; }
  .js .scene.in .etched > *, .js .scene.in .tally-s { opacity: 1; transition: opacity .6s var(--ease) .05s; } .js .scene.in .etched .tri { transform: none; transition: transform .9s var(--ease) calc(.25s + var(--i, 0) * .08s); } .js .scene.in .beams li { opacity: 1; translate: 0 -50%; transition: opacity .6s var(--ease) calc(.35s + var(--i) * .06s), translate .8s var(--ease) calc(.35s + var(--i) * .06s); } .js .scene.in .tally-s { transition-delay: .7s; }
  .rules { padding: 18px 18px 14px; } .rules > b { display: block; font-weight: 500; font-size: 17px; margin-bottom: 12px; } .rules ol { display: grid; gap: 12px; } .rules li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 4px 10px; align-items: center; font-size: 14px; } .rules .n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: rgb(255 255 255 / .14); font: 400 13px/1 var(--mono); } .rules .tri { grid-column: 2; height: 5px; border-radius: 3px; } .rules p { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgb(255 255 255 / .14); font-size: 13px; opacity: .85; }
  .out { padding: 18px; } .tally { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; } .tally b { font-weight: 500; font-size: 17px; } .tally span { font: 400 13px/1 var(--mono); opacity: .85; } .out ul { display: grid; gap: 9px; font-size: 14px; line-height: 1.3; } .out li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; } .out li :global(svg) { margin-top: 1px; color: #6ee7b7; } .out .maybe :global(svg) { color: #fbbf24; }
  .who { padding: clamp(40px, 6vw, 72px) var(--pad) 8px; } .who h2 { max-width: 16em; margin-bottom: 28px; }
  .teams { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr); gap: var(--gap); margin-inline: calc(var(--pad) * -1); } .teams .panel { display: flex; flex-direction: column; gap: 10px; padding: 24px; } .teams :global(.card-art)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgb(var(--sc) / .25), rgb(var(--sc) / .9) 58%); } .teams :global(.card-art img) { transition: transform .8s var(--ease); } .teams .panel:hover :global(.card-art img) { transform: scale(1.05); } .teams :global(svg:not(h3 svg)) { margin-bottom: 14px; transition: transform .4s var(--ease); } .teams :global(.aud) { margin-bottom: 14px; transition: transform .4s var(--ease); } .teams .panel:hover :global(.aud), .teams .panel:hover > :global(svg) { transform: translateY(-4px); } .teams h3 { display: flex; justify-content: space-between; align-items: center; gap: 8px; } .teams h3 :global(i) { display: grid; place-items: center; width: 28px; height: 28px; transition: transform .3s var(--ease); } .teams .panel:hover h3 :global(i) { transform: translateX(4px); } .teams p { font-size: 16px; line-height: 1.4; }
  /* Trust: the real citation view at its real size, and one thread of light from an answer to the sentence behind it. */
  .trust { background: #00081a; padding-block: clamp(56px, 7vw, 96px); } .trust > :global(.art) { z-index: -2; opacity: .5; -webkit-mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); } .t-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .proof { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) clamp(56px, 11vw, 160px) minmax(0, 460px); align-items: stretch; margin-top: clamp(28px, 4vw, 48px); }
  .proof-copy { display: grid; gap: 8px; padding: 24px 26px; border-radius: 18px; background: rgb(12 22 58 / .72); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(251 191 36 / .4); align-self: start; margin-top: 40px; } .proof-copy span { font-size: 15px; opacity: .8; } .proof-copy b { font-weight: 500; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.15; letter-spacing: -.02em; } .proof-copy em { font-style: normal; font: 400 14px/1.3 var(--mono); color: #6ee7b7; }
  .proof-page { position: relative; z-index: 1; border-radius: 16px; overflow: hidden; box-shadow: 0 0 120px 6px rgb(251 191 36 / .22), 0 40px 80px -30px #000; } .proof-page img { width: 100%; height: auto; }
  .tie { width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 2; } .tie path { stroke-dasharray: 1; filter: drop-shadow(0 0 6px #f59e0b); }
  .js .proof[data-in] { opacity: 1; transform: none; } .js .proof .proof-copy, .js .proof .proof-page { opacity: 0; } .js .proof .tie path { stroke-dashoffset: 1; } .js .proof.in .proof-copy { opacity: 1; transition: opacity .6s var(--ease); } .js .proof.in .proof-page { opacity: 1; transition: opacity .7s var(--ease) .15s; } .js .proof.in .tie path { stroke-dashoffset: 0; transition: stroke-dashoffset 1.2s cubic-bezier(.45, 0, .2, 1) .45s; }
  /* Community: a laptop on the globe and a phone in front of it, each on a different theme. */
  .publish { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: center; padding: 0 0 0 var(--pad); min-height: 660px; background: #520116; } .p-copy { display: grid; gap: 18px; justify-items: start; padding-block: var(--pad); max-width: 440px; } .publish :global(.btn) { --chip: var(--tint); } .publish > :global(.art) { z-index: -1; } .publish > :global(.art)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #520116 34%, rgb(82 1 22 / 0) 62%); }
  .p-devices { position: relative; height: 520px; } .p-lap { position: absolute; left: 0; top: 40px; width: 92%; display: block; } .p-devices :global(.p-ph) { position: absolute; right: 7%; bottom: -10px; width: 168px; }
  .close { background: var(--night); padding-block: clamp(64px, 8vw, 112px) max(160px, 28vw); text-align: center; } .close .inner { display: grid; justify-items: center; gap: 24px; } .close h2 { font-size: clamp(34px, 4.6vw, 60px); }
    @media (max-width: 1000px) { .sieve { padding: 48px calc(var(--gap) + 12px); background: linear-gradient(rgb(2 56 43 / .84), rgb(2 56 43 / .94)), url(/img/art-pane-960.avif) 50% 0 / cover no-repeat, #02382b; } .sieve .scene { aspect-ratio: auto; container-type: normal; } .sieve .scene > * { --u: .8px; } .sieve .scene > :global(.art) { display: none; } .js .sieve .scene { opacity: 1; } .s-head { position: static; width: auto; gap: 16px; } .s-head h2 { font-size: clamp(30px, 6vw, 40px); } .s-head .lead { font-size: 17px; } .persp, .tally-s, .beams { display: none; } .s-small { display: grid; gap: 12px; margin-top: 24px; } }
