---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import Literature from "../components/Literature.astro";
import Art from "../components/Art.astro";
import Workspace from "../components/Workspace.astro";
import HeroAsk from "../components/HeroAsk.astro";
import Table from "../components/Table.astro";
import Faq from "../components/Faq.astro";
import AssistantGate from "../components/AssistantGate.astro";
import AskBar from "../components/AskBar.astro";
import Device from "../components/Device.astro";
import Icon from "../components/Icon.astro";
import Arrow from "../components/Arrow.astro";
import { COMMUNITIES } from "../data/site.mjs";
const teams = [
  ["ocean", "review-card", "2 38 29", "screen-laptop-light-1000", 1000, 625, "Review teams", "Run systematic and scoping reviews with explicit criteria and data you can export.", "/#screening"],
  ["rose", "thread", "2 10 34", "panel-citation-light", 880, 1349, "Policy and programme teams", "Get to a defensible answer quickly, with the sources behind it ready to share.", "/#trust"],
  ["emerald", "globe", "82 1 22", "c-home-laptop-light-1000", 1000, 625, "Institutions and networks", "Give your field one trusted, public home for its evidence, under your own name.", "/evidence-communities/"],
];
const others = COMMUNITIES.filter((c) => c.key !== "wi");
const questions = [["Is this an intervention study?", 11, 1, 3], ["Is it about reading or literacy?", 15, 0, 0], ["Is it in primary school?", 13, 1, 1]];
const beams = [[287, "Tutoring as a reading intervention for bilingual learners", "yyy"], [350, "Peer tutoring and children's e-book reading comprehension", "yyy"], [414, "Effect of peer tutoring in reading for boys in French immersion", "yyy"], [477, "Role of peer tutoring in urban primary school reading skills", "yuy"], [541, "An online peer tutoring intervention to promote reading skills", "yyy"], [604, "Peer tutor-based Quranic learning in elementary schools", "yyy"], [667, "Applying peer-tutoring to spelling in an elementary classroom", "yyy"]];
const faq = [
  ["What does the AI read?", "Screening and extraction work from each paper's title and abstract. The assistant can also read open-access PDFs and files you attach to a chat. Answers show how well they're grounded and link to their source where they can, and the assistant tells you when it couldn't read something."],
  ["Can we choose the model?", "Yes. Choose a preset, pick a model for each task, or use your own provider key."],
  ["Does it work with Zotero?", "Yes. OpenScholar can read your Zotero groups, collections and items, and an Evidence Community can publish from a Zotero group."],
  ["Can we take our data with us?", "Yes. Results, screenings and extractions all export, in formats including CSV, JSON and Excel."],
  ["Who can see our work?", "Members of an organization see its work. To bring someone in from outside, share a single item with them as a viewer or an editor."],
];
---
<Base title="OpenScholar: the evidence workspace for research teams" description="The evidence workspace for research teams. Find the literature, screen it against your criteria, extract the data and publish what you learn.">
  <HeroAsk art="slot" look="slot" below="none" />

  <section class="tour" id="tour"><h2>Every step of the work, on every screen</h2><Workspace /></section>

  <section class="who" id="who"><h2>For anyone whose work has to stand on the evidence</h2>
    <div class="teams">{teams.map(([f, a, sc, img, w, h, t, d, href]) => <a class="panel edge" href={href}><i class={`field f-${f}`} aria-hidden="true"></i><Art name={a} class="card-art" style={`--sc:${sc}`} /><img class:list={["shot", { tall: h > w }]} src={`/img/screens/${img}.avif`} width={w} height={h} loading="lazy" decoding="async" alt="" /><h3>{t}<Arrow /></h3><p>{d}</p></a>)}</div>
  </section>

  <Feature id="product" class="find" field="ocean" art="sea" chip="#0e7490" title="Start with the whole literature, not the first page of it" text="Ask in plain language. You get a query you can read and change, and a view of the whole field before you commit to reading any of it.">
    <Literature />
  </Feature>

  <section class="bleed sieve" id="screening">
    <div class="inner s-head"><h2>Decide what counts once, then apply it to every paper</h2><p class="lead">Write your questions and what each answer is worth. AI answers for every paper, your rules decide what's included, and you can overrule any answer.</p></div>
    <div class="s-wrap"><div class="scene" data-in>
      <Art name="sieve-front" />
      <div class="pane-ui" data-pass>
        <b class="pt">Your criteria</b>
        <ol>{questions.map(([q, y, u, n], i) => <li style={`--i:${i}`}><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri" role="img" aria-label={`${y} yes, ${u} unclear, ${n} no`}><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol>
        <p class="pass">Included at <span class="marks3" role="group" aria-label="Pass mark">{[1, 2, 3].map((n) => <button type="button" aria-pressed={n === 2 ? "true" : "false"} data-n={n}>{n}</button>)}</span> of 3 points</p>
        <div class="wall15" aria-hidden="true">{Array.from({ length: 15 }, (_, i) => <i class:list={{ u: i === 9 }} style={`--i:${i}`}></i>)}</div>
        <div class="count" aria-live="polite"><span><b data-inc>14</b>included</span><span class="amber"><b data-dec>1</b>for you to decide</span></div>
      </div>
      <ul class="beams" aria-label="Papers that met the criteria">{beams.map(([y, t, marks], i) => <li class:list={{ amber: marks.includes("u") }} style={`--y:${y};--i:${i}`}><span class="tt">{t}</span><span class="marks" aria-hidden="true">{[...marks].map((m) => <i class={m}><Icon name={m === "y" ? "check" : "flagq"} size={12} /></i>)}</span></li>)}</ul>
    </div></div>
    <div class="s-small" data-pass>
      <div class="frost rules"><b>Your criteria</b><ol>{questions.map(([q, y, u, n], i) => <li><span class="n">{i + 1}</span><span class="q">{q}</span><span class="tri"><i style={`flex:${y}`} class="y"></i><i style={`flex:${u}`} class="u"></i><i style={`flex:${n}`} class="x"></i></span></li>)}</ol><p>Included at <span class="marks3" role="group" aria-label="Pass mark">{[1, 2, 3].map((n) => <button type="button" aria-pressed={n === 2 ? "true" : "false"} data-n={n}>{n}</button>)}</span> of 3 points</p></div>
      <div class="frost out"><div class="tally"><b>Included</b><span aria-live="polite"><span data-inc>14</span> of 15 papers</span></div><ul>{beams.slice(0, 5).map(([, t, marks]) => <li class:list={{ maybe: marks.includes("u") }}><Icon name={marks.includes("u") ? "flagq" : "check"} size={16} /><span>{t}</span></li>)}</ul></div>
    </div>
  </section>

  <section class="panel band" id="extraction">
    <i class="field f-amber" aria-hidden="true"></i><Art name="grid" pos="100% 0" class="dim" style="--sc:109 29 1" />
    <div class="b-head stack"><h2>Stop retyping the literature into a spreadsheet</h2><p class="lead">Ask the same questions of every paper's abstract and get a table you can sort, check and export. Start with the answers the model is least sure of.</p></div>
    <Table />
  </section>

  <AssistantGate />

  <section class="bleed trust" id="trust"><Art name="thread" />
    <div class="inner t-head"><h2>Built for the moment someone asks how you know</h2><p class="lead">Follow a cited answer back through its sentence to its paper. Your criteria are written down, every change has a name beside it, and people make the final call.</p></div>
    <div class="inner proof" data-in>
      <div class="proof-copy" aria-hidden="true"><span>What was the main finding?</span><b>Nearly all children showed improved reading fluency</b><em>93% confidence, grounded in the abstract</em></div>
      <svg class="tie" viewBox="0 0 160 700" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 350C90 350 70 606 160 606" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" pathLength="1" /></svg>
      <div class="proof-page"><img src="/img/screens/panel-citation-light.avif" width="880" height="1349" loading="lazy" decoding="async" alt="An extracted answer with its confidence and reasoning, above the paper's abstract with the source sentence highlighted" /></div>
          </div>
  </section>

  <section class="panel publish" id="community" style="--tint:#be123c">
    <Art name="globe" pos="100% 50%" />
    <div class="p-copy"><h2>Turn your evidence into a living community</h2><p class="lead">Give your field a public home with your own branding and address. You choose the sources that keep it current, and readers can search it, explore it and ask it questions.</p><a class="btn" href="/evidence-communities/">Explore Evidence Communities<Arrow /></a></div>
    <div class="p-devices" data-in>
      <a class="p-lap" href="/evidence-communities/#live" aria-label="See the live communities"><Device kind="laptop" name="c-home" theme="light" alt="" tilt sizes="(max-width: 900px) 53vw, 620px">{others.map((c, i) => <img class="cyc" src={`/img/site-${c.key}.avif`} width="960" height="600" loading="lazy" decoding="async" alt="" style={`--i:${i}`} />)}</Device></a>
      <Device class="p-ph" kind="phone" name="c-home" theme="dark" alt="" sizes="(max-width: 900px) 20vw, 170px" />
    </div>
  </section>

  <Faq items={faq} />

  <section class="bleed close"><Art name="dark-ribbon" pos="50% 100%" /><div class="inner"><h2>Start with your next question</h2><AskBar id="ask-end" label="Ask your next question" /></div></section>
</Base>
<script>
  // Move the pass mark and every paper is decided again: your rule, not the model's, draws the line.
  const STATES = { 1: { inc: 15, dec: 0, out: [], amber: null }, 2: { inc: 14, dec: 1, out: [], amber: 9 }, 3: { inc: 10, dec: 1, out: [2, 6, 11, 13], amber: 9 } };
  for (const pane of document.querySelectorAll("[data-pass]")) {
    const cells = [...pane.querySelectorAll(".wall15 i")], marks = [...pane.querySelectorAll("[data-n]")], beam = pane.parentElement.querySelector(".beams .amber"), inc = pane.querySelector("[data-inc]"), dec = pane.querySelector("[data-dec]");
    marks.forEach((m) => m.addEventListener("click", () => { const n = +m.dataset.n, st = STATES[n]; marks.forEach((x) => x.setAttribute("aria-pressed", String(x === m))); inc.textContent = st.inc; if (dec) { dec.textContent = st.dec; dec.parentElement.classList.toggle("none", !st.dec); beam.classList.toggle("settled", !st.dec); } cells.forEach((c, i) => { c.classList.toggle("u", i === st.amber); c.classList.toggle("x", st.out.includes(i)); }); }));
  }
</script>
<style>
  /* The dark carries on from the hero, and the devices glow against it, before the page opens up to white. */
  .tour { --bg: #040b2e; position: relative; overflow: clip; margin-top: calc(var(--gap) * -1); display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(20px, 2.6vw, 36px); width: 100vw; margin-inline: calc(50% - 50vw); padding: clamp(32px, 4vw, 56px) calc(var(--gap) + var(--pad)) clamp(40px, 4.4vw, 64px); background: var(--bg); color: #fff; border-radius: 0 0 clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px); text-align: center; scroll-margin-top: 64px; } .tour h2 { margin-inline: auto; font-size: clamp(30px, 3.6vw, 52px); } .tour :global(.ws) { width: min(100%, calc((100svh - 190px) * 1.733)); max-width: 1248px; margin-inline: auto; }
  .band { display: grid; gap: 28px; padding: var(--pad); } .b-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .stack { grid-template-columns: minmax(0, 1fr); width: min(52%, 600px); } .band :global(.art) { height: 440px; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  /* Find: the field for one real query, floating on the sea. */
  :global(.find) :global(.view) { display: grid; align-items: center; padding-right: var(--pad); }
  /* Screening: straight on and calm. Your criteria sit on the pane in the picture, scattered papers arrive on its left, and the ones that pass leave along its beams. */
  .sieve { background: #021f18; padding-top: clamp(56px, 7vw, 96px); --g: 2 44 34; }
  .s-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; margin-bottom: -24px; position: relative; z-index: 1; }
  .s-wrap { width: min(100%, 1560px); margin-inline: auto; } .scene :global(.art) { -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent), linear-gradient(transparent, #000 10%, #000 88%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent), linear-gradient(transparent, #000 10%, #000 88%, transparent); mask-composite: intersect; }
  .pane-ui { position: absolute; z-index: 1; left: calc(var(--u) * 640); top: calc(var(--u) * 108); width: calc(var(--u) * 394); height: calc(var(--u) * 720); padding: calc(var(--u) * 40) calc(var(--u) * 32) calc(var(--u) * 36); display: flex; flex-direction: column; }
  .pt { font-weight: 500; font-size: calc(var(--u) * 28); letter-spacing: -.015em; margin-bottom: calc(var(--u) * 30); } .pane-ui ol { display: grid; gap: calc(var(--u) * 28); } .pane-ui li { display: grid; grid-template-columns: calc(var(--u) * 30) minmax(0, 1fr); gap: calc(var(--u) * 10) calc(var(--u) * 12); align-items: center; font-size: max(12px, calc(var(--u) * 18)); line-height: 1.25; } .pane-ui .n { display: grid; place-items: center; width: calc(var(--u) * 30); height: calc(var(--u) * 30); border-radius: calc(var(--u) * 8); background: rgb(255 255 255 / .12); font-family: var(--mono); font-size: calc(var(--u) * 16); } .pane-ui .tri { grid-column: 2; height: calc(var(--u) * 6); border-radius: 99px; }
  .marks3 { display: inline-flex; gap: 2px; margin-inline: 3px; vertical-align: middle; } .marks3 button { display: grid; place-items: center; min-width: 26px; height: 26px; border-radius: 7px; background: rgb(255 255 255 / .1); color: rgb(255 255 255 / .8); font: 400 max(12px, calc(var(--u) * 15))/1 var(--mono); transition: background-color .15s var(--ease), color .15s var(--ease); } .marks3 button:not([aria-pressed="true"]):hover { background: rgb(255 255 255 / .22); color: #fff; } .marks3 [aria-pressed="true"] { background: #6ee7b7; color: #02261d; } :global(html:not(.has-js)) .marks3 button:not([aria-pressed="true"]) { display: none; } .wall15 .x { background: rgb(255 255 255 / .16); } .count .none { opacity: .4 !important; } .beams .settled { box-shadow: inset 0 0 0 1px rgb(110 231 183 / .28); } .beams .settled :global(.u) { background: rgb(52 211 153 / .2); color: #6ee7b7; }
  .pass { margin-top: calc(var(--u) * 32); padding-top: calc(var(--u) * 16); border-top: 1px solid rgb(255 255 255 / .16); font-size: max(12px, calc(var(--u) * 16)); opacity: .82; }
  .count { margin-top: auto; display: grid; gap: calc(var(--u) * 6); font-size: max(12px, calc(var(--u) * 17)); } .count span { display: flex; align-items: baseline; gap: calc(var(--u) * 12); } .count b { font: 400 calc(var(--u) * 64)/1 var(--mono); letter-spacing: -.03em; color: #6ee7b7; } .count .amber b { font-size: calc(var(--u) * 34); color: #fbbf24; }
  .wall15 { display: grid; grid-template-columns: repeat(5, 1fr); gap: calc(var(--u) * 6); margin-top: calc(var(--u) * 26); } .wall15 i { height: calc(var(--u) * 26); border-radius: calc(var(--u) * 6); background: #34d399; opacity: .85; } .wall15 .u { background: #fbbf24; } .js .scene .wall15 i { opacity: 0; transform: scale(.7); } .js .scene.in .wall15 i { opacity: .85; transform: none; transition: opacity .35s var(--ease) calc(.4s + var(--i) * 35ms), transform .4s var(--ease) calc(.4s + var(--i) * 35ms), background-color .3s var(--ease); }
  .tri { display: flex; gap: 2px; overflow: hidden; } .tri .y { background: #34d399; } .tri .u { background: #fbbf24; } .tri .x { background: rgb(255 255 255 / .3); }
  .beams { position: absolute; z-index: 1; inset: 0; pointer-events: none; } .beams li { position: absolute; left: calc(var(--u) * 1078); top: calc(var(--u) * var(--y)); translate: 0 -50%; display: flex; align-items: center; gap: calc(var(--u) * 10); max-width: calc(var(--u) * 540); padding: calc(var(--u) * 6) calc(var(--u) * 8) calc(var(--u) * 6) calc(var(--u) * 12); border-radius: calc(var(--u) * 10); background: #03332a; box-shadow: inset 0 0 0 1px rgb(110 231 183 / .28); font-size: max(11px, calc(var(--u) * 15)); line-height: 1.15; white-space: nowrap; pointer-events: auto; transition: background-color .15s var(--ease); } .beams li:hover { background: #05453a; } .beams .amber { box-shadow: inset 0 0 0 1px rgb(251 191 36 / .6); } .tt { overflow: hidden; text-overflow: ellipsis; }
  .marks { flex: none; display: flex; gap: calc(var(--u) * 3); } .marks i { display: grid; place-items: center; width: calc(var(--u) * 20); height: calc(var(--u) * 20); border-radius: calc(var(--u) * 6); background: rgb(52 211 153 / .2); color: #6ee7b7; } .marks i :global(svg) { width: 70%; height: 70%; } .marks .u { background: rgb(251 191 36 / .2); color: #fbbf24; }
  .s-small { display: none; }
  /* Criteria appear first, then papers run out along the beams, one after another. */
  .js .sieve .scene[data-in] { opacity: 1; transform: none; } .js .scene .pane-ui > * { opacity: 0; } .js .scene .beams li { opacity: 0; translate: calc(var(--u) * -50) -50%; } .js .scene .pane-ui .tri { transform: scaleX(0); transform-origin: left; }
  .js .scene.in .pane-ui > * { opacity: 1; transition: opacity .5s var(--ease) .05s; } .js .scene.in .pane-ui .tri { transform: none; transition: transform .8s var(--ease) calc(.2s + var(--i, 0) * .08s); } .js .scene.in .beams li { opacity: 1; translate: 0 -50%; transition: opacity .5s var(--ease) calc(.35s + var(--i) * .06s), translate .7s var(--ease) calc(.35s + var(--i) * .06s), background-color .15s var(--ease); }
  .rules { padding: 18px 18px 14px; } .rules > b { display: block; font-weight: 500; font-size: 17px; margin-bottom: 12px; } .rules ol { display: grid; gap: 12px; } .rules li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 4px 10px; align-items: center; font-size: 14px; } .rules .n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: rgb(255 255 255 / .14); font: 400 13px/1 var(--mono); } .rules .tri { grid-column: 2; height: 5px; border-radius: 3px; } .rules p { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgb(255 255 255 / .14); font-size: 13px; opacity: .85; }
  .out { padding: 18px; } .tally { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; } .tally b { font-weight: 500; font-size: 17px; } .tally span { font: 400 13px/1 var(--mono); opacity: .85; } .out ul { display: grid; gap: 9px; font-size: 14px; line-height: 1.3; } .out li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 8px; } .out li :global(svg) { margin-top: 1px; color: #6ee7b7; } .out .maybe :global(svg) { color: #fbbf24; }
  .who { padding: clamp(8px, 2vw, 24px) var(--pad) 8px; } .who h2 { max-width: 16em; margin-bottom: 28px; }
  /* Three doors into the product: whichever you're on opens wide and shows its real screen. Only the first frame's widths are set, so it never lays out twice. */
  .teams { display: flex; gap: var(--gap); margin-inline: calc(var(--pad) * -1); height: 540px; }
  .teams a { --o: 0; position: relative; flex: 1 1 0; min-width: 0; display: block; overflow: clip; transition: flex-grow .6s var(--ease); } @media (min-width: 901px) { .teams a:first-child { --o: 1; flex-grow: 2.7; } .teams:has(a:is(:hover, :focus-visible)) a { --o: 0; flex-grow: 1; } .teams a:is(:hover, :focus-visible), .teams:has(a:is(:hover, :focus-visible)) a:is(:hover, :focus-visible) { --o: 1; flex-grow: 2.7; } }
  .teams :global(.card-art)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgb(var(--sc) / 0) 30%, rgb(var(--sc) / .96) 76%); } .teams :global(.card-art img) { transition: transform .8s var(--ease); } .teams a:hover :global(.card-art img) { transform: scale(1.04); }
  .shot { position: absolute; left: 20px; top: 20px; width: 620px; max-width: none; height: 372px; object-fit: cover; object-position: top left; border-radius: 12px; box-shadow: 0 0 0 1px rgb(255 255 255 / .28), 0 30px 60px -24px rgb(0 0 0 / .8); opacity: var(--o); translate: 0 calc((1 - var(--o)) * 14px); transition: opacity .35s var(--ease), translate .5s var(--ease); } .shot.tall { width: 450px; }
  .teams h3 { position: absolute; left: 24px; bottom: 76px; display: flex; align-items: flex-end; gap: 6px; width: min(222px, calc(100% - 36px)); font-size: clamp(19px, 1.6vw, 22px); line-height: 1.2; } .teams h3 { justify-content: space-between; } .teams h3 :global(i) { flex: none; display: grid; place-items: center; width: 24px; height: 24px; transition: transform .3s var(--ease); } .teams a:hover h3 :global(i) { transform: translateX(4px); }
  .teams p { position: absolute; left: 24px; bottom: 22px; width: min(460px, calc(100vw - 96px)); font-size: 16px; line-height: 1.4; opacity: var(--o); translate: 0 calc((1 - var(--o)) * 8px); transition: opacity .35s var(--ease), translate .45s var(--ease); }
  /* Trust: the real citation view at its real size, and one thread of light from an answer to the sentence behind it. */
  .trust { background: #00081a; padding-block: clamp(64px, 8vw, 120px) clamp(56px, 7vw, 96px); } .trust > :global(.art) { z-index: -2; opacity: .5; -webkit-mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); } .t-head { display: grid; gap: clamp(16px, 2vw, 28px); } .t-head h2 { max-width: none; font-size: clamp(40px, 7.4vw, 112px); line-height: .98; letter-spacing: -.035em; } .t-head .lead { justify-self: end; width: min(100%, 560px); }
  .proof { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) clamp(56px, 11vw, 160px) minmax(0, 460px); align-items: stretch; margin-top: clamp(28px, 4vw, 48px); }
  .proof-copy { display: grid; gap: 8px; padding: 24px 26px; border-radius: 18px; background: rgb(12 22 58 / .72); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22), inset 0 0 0 1px rgb(251 191 36 / .4); align-self: center; } .proof-copy span { font-size: 15px; opacity: .8; } .proof-copy b { font-weight: 500; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.15; letter-spacing: -.02em; } .proof-copy em { font-style: normal; font: 400 14px/1.3 var(--mono); color: #6ee7b7; }
