---
import Base from "../layouts/Base.astro";
import meta from "../data/field-meta.json";
import papers from "../data/extraction.json";
import { APP, LIBRARIES } from "../data/site.mjs";
const yearMax = Math.max(...meta.years.map((y) => y[1]));
const yearTicks = meta.years.filter(([y]) => y % 3 === 2 || y === 2026);
const n = (x) => x.toLocaleString("en-US");
const CH = ["Read", "Ask", "Overview", "Screen", "Extract", "Assistant", "Publish", "Begin"];
const steps = ["Searched for peer tutoring trials", "Made a collection, saved 3 papers", "Screening started, after you allowed it", "Extraction started, after you allowed it", "Read the results and wrote them up"];
const rowsShown = papers.slice(0, 5);
const deeper = [
  ["/search/", "Search", "Try a real search against 329 million works"],
  ["/screening/", "Screening", "Change the rules and watch a stream of papers split"],
  ["/extraction/", "Extraction", "Click any answer and see the sentence behind it"],
  ["/assistant/", "Assistant", "Run a whole review and press Allow yourself"],
  ["/workspaces/", "Teams", "See your work the way each person sees it"],
  ["/evidence-libraries/", "Evidence Libraries", "Design a library and watch it change as you type"],
  ["/maps/", "Globe", "Spin the Earth and find any of 9,988 institutions"],
  ["/features/", "All features", "Every feature, in one searchable catalogue"],
];
---
<Base title="OpenScholar: read everything, keep what holds up" description="OpenScholar searches 329 million works, reads them against your questions, and publishes what holds up as an Evidence Library anyone can search.">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <nav class="rail" data-rail aria-label="Chapters">{CH.map((c, i) => <a href={`#ch${i}`}><span>{c}</span></a>)}</nav>
  <div hidden data-year-max={yearMax}></div>

  <section class="ch hero" id="ch0" data-ch="0">
    <div class="pin">
      <div class="copy" data-copy>
        <h1>Read everything.<br />Keep what holds up.</h1>
        <div class="hero-foot">
          <p class="lead">OpenScholar searches 329 million works, reads them against your questions, and publishes what holds up as a library anyone can search.</p>
          <div class="acts"><a class="btn primary" href={APP}>Start with a question</a><a class="btn quiet" href="/features/">Every feature</a></div>
        </div>
        <p class="mono cap" data-cap>Each light is a real paper on AI in education, {n(meta.n)} of them. The oldest sit at the centre, this year's at the rim.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch1" data-ch="1">
    <div class="pin end">
      <div class="copy narrow" data-copy>
        <h2>Ask, and one part of the sky lights up</h2>
        <div class="q"><span class="q-t" data-typed='ChatGPT and generative AI'></span><i></i></div>
        <p class="lead">Type a question or an exact query. Here it lights one topic area of the map, 21,805 papers.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch2" data-ch="2">
    <div class="pin">
      <div class="copy narrow" data-copy>
        <h2>Then it reads the whole result</h2>
        <p class="lead">An AI overview counts everything and reads the most cited, so you see the shape of a field before the first paper. These bars are the same papers, stacked by year.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch3" data-ch="3">
    <div class="pin top-left">
      <div class="copy" data-copy>
        <h2>Your questions are the gates</h2>
        <p class="lead wide">A model answers yes or no for every paper. Your points decide who carries on.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch4" data-ch="4">
    <div class="pin">
      <div class="copy narrow small" data-copy>
        <h2>What's left becomes data</h2>
        <p class="lead">Ask the same questions of every paper. Each answer carries a confidence score and the sentence it came from.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch5" data-ch="5">
    <div class="pin center">
      <div class="copy chat" data-copy>
        <h2>Or just ask for the review</h2>
        <ol class="steps">{steps.map((s) => <li data-step><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10.5 8 14.5 16 5.5" /></svg>{s}</li>)}</ol>
        <p class="lead">The assistant has the same 190 actions as the app. It stops and asks before it runs a job.</p>
      </div>
    </div>
  </section>

  <section class="ch" id="ch6" data-ch="6">
    <div class="pin">
      <div class="copy narrow" data-copy>
        <h2>Publish it for the world to read</h2>
        <p class="lead">An Evidence Library is a public site with its own address, search, maps, AI answers and digests. The lights are 9,988 institutions behind one of them.</p>
        <ul class="libs">{LIBRARIES.map((l) => <li><a href={l.href}><span>{l.name}</span><b class="mono">{l.records}</b></a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="ch last" id="ch7" data-ch="7">
    <div class="pin bottom">
      <div class="copy begin" data-copy>
        <h2>Start with a question</h2>
        <div class="acts"><a class="btn primary" href={APP}>Open OpenScholar</a></div>
      </div>
    </div>
  </section>

  <div class="labels" aria-hidden="true">
    {yearTicks.map(([y, c]) => <span class="lab tick" data-year={y} data-count={c}>{y}</span>)}
    {meta.years.filter(([y]) => y >= 2024).map(([y, c]) => <span class="lab count" data-year={y} data-count={c} data-at="top">{n(c)}{y === 2026 ? " so far" : ""}</span>)}
    {["Is it a randomised trial?", "Is it about primary school?", "Does it measure reading?"].map((g) => <span class="lab gate" data-gate>{g}</span>)}
    {["Sample size", "Design", "Effect size"].map((h, c) => <span class="lab head" data-cell data-r="-1" data-c={c}>{h}</span>)}
    {rowsShown.flatMap((p, r) => [p.size, p.design, p.effect].map((cell, c) => <span class:list={["lab val", { dim: cell.at < 0, big: c === 0 }]} data-cell data-r={r} data-c={c}>{cell.value}</span>))}
    {rowsShown.map((p, r) => <span class="lab row" data-cell data-r={r} data-c="-1">{p.title}</span>)}
  </div>

  <section class="deep">
    <h2>Now try it yourself</h2>
    <ul>{deeper.map(([href, t, d]) => <li><a href={href}><b>{t}</b><span>{d}</span></a></li>)}</ul>
  </section>
</Base>
<script>
  import "../scripts/home.js";
</script>
<style>
  .field { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.4s var(--ease); pointer-events: none; }
  .ch { position: relative; height: 200vh; height: 200svh; pointer-events: none; }
  .hero { height: 160svh; }
  .last { height: 170svh; }
  .pin { position: sticky; top: 0; height: 100svh; padding: 96px var(--edge) 40px; display: flex; align-items: center; }
  .copy { pointer-events: auto; will-change: opacity, transform; }
  .narrow { max-width: min(36vw, 560px); }
  .narrow .lead, .narrow .q { margin-top: 24px; }
  .small { max-width: 25vw; } .small h2 { font-size: clamp(32px, 3.4vw, 56px); }
  .wide { max-width: 44rem; margin-top: 16px; }
  .end { justify-content: flex-end; } .end .copy { padding: 32px; margin: -32px; background: radial-gradient(closest-side, rgb(0 0 0 / .78) 55%, transparent); }
  .top-left { align-items: flex-start; }
  .center { justify-content: center; text-align: center; }
  .bottom { align-items: flex-end; justify-content: center; text-align: center; padding-bottom: 96px; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; }
  .begin .acts { justify-content: center; margin-top: 24px; }

  .hero .pin { align-items: flex-end; padding-bottom: 32px; }
  .hero .copy { width: 100%; }
  .hero h1 { text-shadow: 0 0 40px #000; }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; margin-top: 32px; }
  .hero-foot .lead { max-width: 38rem; }
  .cap { margin-top: 24px; }

  .q { display: flex; align-items: center; height: 56px; padding-inline: 16px; border: 1px solid var(--line2); border-radius: 12px; background: rgb(0 0 0 / .6); font: 400 18px var(--mono); color: var(--pale); }
  .q i { width: 2px; height: 22px; margin-left: 2px; background: var(--pale); }

  .chat h2 { margin-bottom: 32px; }
  .steps { display: grid; gap: 10px; width: min(460px, 86vw); margin-inline: auto; text-align: left; }
  .steps li { display: flex; align-items: center; gap: 12px; font-size: 16px; color: var(--t3); transition: color .25s var(--ease); }
  .steps svg { flex: none; opacity: .25; transition: opacity .25s var(--ease), color .25s var(--ease); }
  .steps li[data-done] { color: var(--t1); }
  .steps li[data-done] svg { opacity: 1; color: var(--good); }
  .chat .lead { margin: 32px auto 0; max-width: 32rem; }

  .libs { margin-top: 28px; }
  .libs a { display: flex; justify-content: space-between; gap: 16px; padding-block: 10px; border-top: 1px solid var(--line); font-size: 15px; transition: color .15s var(--ease); }
  .libs a:hover { color: var(--ink); }
  .libs b { font-weight: 400; flex: none; }

  .labels { position: fixed; inset: 0; pointer-events: none; overflow: hidden; }
  .lab { position: absolute; left: 0; top: 0; opacity: 0; visibility: hidden; white-space: nowrap; }
  .lab > * { position: relative; }
  .tick { font: 400 13px var(--mono); color: var(--t2); margin: 4px 0 0 -16px; }
  .count { font: 400 14px var(--mono); color: var(--t1); margin: -18px 0 0 -30px; }
  .gate { font-size: 16px; color: var(--t1); margin: -36px 0 0 -90px; width: 180px; text-align: center; }
  .head { font-size: 14px; color: var(--t2); margin: -8px 0 0 -40px; }
  .val { font-size: 14px; margin: -10px 0 0 -48px; color: var(--t1); width: 110px; white-space: normal; text-align: left; line-height: 18px; }
  .val.big { font-size: 30px; font-weight: 300; margin: -18px 0 0 -30px; line-height: 36px; }
  .val.dim { color: var(--t3); }
  .row { font-size: 13px; color: var(--t2); width: 210px; white-space: normal; line-height: 17px; text-align: right; margin: -24px 0 0 -224px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .rail { position: fixed; right: 16px; top: 50%; translate: 0 -50%; z-index: 20; display: grid; gap: 2px; }
  .rail a { display: flex; align-items: center; justify-content: flex-end; gap: 10px; height: 22px; font-size: 12px; color: transparent; transition: color .15s var(--ease); }
  .rail a::after { content: ""; width: 14px; height: 1px; background: var(--t3); transition: width .2s var(--ease), background-color .2s var(--ease); }
  .rail a[data-on] { color: var(--t2); }
  .rail a[data-on]::after { width: 28px; background: var(--t1); }
  .rail a:hover { color: var(--t1); }

  .deep { position: relative; background: #000; padding: 128px var(--edge) 96px; }
  .deep ul { margin-top: 48px; }
  .deep a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; gap: 24px; padding-block: 18px; border-top: 1px solid var(--line); transition: padding-left .25s var(--ease), color .15s var(--ease); }
  .deep a:hover { color: var(--ink); }
  .deep b { font-weight: 300; font-size: clamp(30px, 4vw, 60px); line-height: 1.1; letter-spacing: -.03em; }
  .deep span { color: var(--t2); font-size: clamp(15px, 1.3vw, 19px); font-weight: 300; }

  @media (max-width: 899px) {
    .rail, .labels { display: none; }
    .narrow { max-width: none; }
    .pin { align-items: flex-end; padding-bottom: 32px; }
    .top-left { align-items: flex-start; }
    .center { align-items: flex-end; }
    .deep a { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .ch .copy { background: linear-gradient(transparent, rgb(0 0 0 / .72) 24px); padding-top: 24px; }
    .hero .copy { background: none; }
  }
</style>
