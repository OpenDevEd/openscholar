---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import Cards from "../components/Cards.astro";
import AudienceArt from "../components/AudienceArt.astro";
import SieveWall from "../components/SieveWall.astro";
import Table from "../components/Table.astro";
import Faq from "../components/Faq.astro";
import AskBar from "../components/AskBar.astro";
import Arrow from "../components/Arrow.astro";
import { APP } from "../data/site.mjs";
const teams = [
  ["ocean", "review", "Review teams", "Run systematic and scoping reviews with explicit criteria and data you can export."],
  ["rose", "brief", "Policy and programme teams", "Get to a defensible answer quickly, with the sources behind it ready to share."],
  ["emerald", "library", "Institutions and networks", "Give your field one trusted, public home for its evidence, under your own name."],
];
const faq = [
  ["What does the AI read?", "Screening and extraction work from each paper's title and abstract. The assistant can also read open-access PDFs and files you attach to a chat. Answers show how well they're grounded and link to their source where they can, and the assistant tells you when it couldn't read something."],
  ["Can we choose the model?", "Yes. Choose a preset, pick a model for each task, or use your own provider key."],
  ["Does it work with Zotero?", "Yes. OpenScholar can read your Zotero groups, collections and items, and an Evidence Library can publish from a Zotero group."],
  ["Can we take our data with us?", "Yes. Results, screenings and extractions all export, in formats including CSV, JSON and Excel."],
  ["Who can see our work?", "Members of an organization see its work. To bring someone in from outside, share a single item with them as a viewer or an editor."],
];
---
<Base title="OpenScholar: the evidence workspace for research teams" description="Know what the evidence says before anyone asks you to defend it. Find the literature, screen it against your criteria, extract the data and publish what you learn.">
  <section class="panel hero">
    <i class="field f-cobalt" aria-hidden="true"></i>
    <div class="h-top"><h1>Know what the evidence says before anyone asks you to defend it</h1><div class="h-side"><p class="lead">OpenScholar is the evidence workspace for research teams. Find the literature, screen it against your criteria, extract the data and publish what you learn.</p><div class="acts"><a class="btn" href={APP}>Get started<Arrow /></a><a class="btn ghost" href="https://wealth-inequality.openscholar.ai">See a live library</a></div></div></div>
    <div class="win shot"><img src="/img/shot-search.avif" width="1800" height="1128" fetchpriority="high" alt="OpenScholar's search results, with an AI overview of the field and query terms highlighted in each paper" /></div>
  </section>

  <section class="who" id="who"><h2>For anyone whose work has to stand on the evidence</h2>
    <div class="teams">{teams.map(([f, k, t, d]) => <article class="panel"><i class={`field f-${f}`} aria-hidden="true"></i><AudienceArt kind={k} /><h3>{t}</h3><p>{d}</p></article>)}</div>
  </section>

  <Feature id="product" field="ocean" chip="#0e7490" title="Start with the whole literature, not the first page of it" text="Ask in plain language. You get a query you can read and change, and a view of the whole field before you commit to reading any of it." img="shot-search2" w={1800} h={1111} alt="Results for a search, with an overview of the field and highlighted terms"><Cards kind="query" /></Feature>

  <section class="panel band" id="screening">
    <i class="field f-emerald" aria-hidden="true"></i>
    <div class="b-head"><h2>Decide what counts once, then apply it to every paper</h2><p class="lead">Write your questions and what each answer is worth. AI answers for every paper, your rules decide what's included, and you can overrule any answer.</p></div>
    <div class="flow"><Cards kind="rule" /><svg class="pipe" viewBox="0 0 60 120" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 60H60" stroke="#fff" stroke-width="2" stroke-dasharray="3 6" vector-effect="non-scaling-stroke" /></svg><div class="stream"><SieveWall /><div class="legend" aria-hidden="true"><span><i style="background:rgb(255 255 255 / .3)"></i>Not included</span><span><i style="background:#fde68a"></i>Unclear, for you to decide</span><span><i style="background:#fff"></i>Included</span></div></div></div>
  </section>

  <section class="panel band" id="extraction">
    <i class="field f-amber" aria-hidden="true"></i>
    <div class="b-head"><h2>Stop retyping the literature into a spreadsheet</h2><p class="lead">Ask the same questions of every paper's abstract and get a table you can sort, check and export. Start with the answers the model is least sure of.</p></div>
    <Table />
  </section>

  <Feature id="assistant" field="cobalt" chip="#1d4ed8" flip narrow title="Delegate the groundwork, not the decisions" text="Describe the review you need. The assistant searches, builds collections and runs jobs in your workspace, stops for your approval, and tells you which results to check by hand." img="shot-assistant" w={880} h={1010} alt="The research assistant listing which papers to check by hand after an extraction"><Cards kind="approve" /></Feature>

  <section class="panel trust">
    <i class="field f-night" aria-hidden="true"></i>
    <div class="t-head"><h2>Built for the moment someone asks how you know</h2><p class="lead">Follow an answer back through its sentence to its paper. Your criteria are written down, every change has a name beside it, and people make the final call.</p></div>
    <div class="trace" aria-hidden="true">
      <div class="t-a"><span>What is the sample size?</span><b>298 pupils</b></div>
      <svg viewBox="0 0 120 60" preserveAspectRatio="none" fill="none"><path d="M0 30H120" stroke="#fbbf24" stroke-width="2" stroke-dasharray="4 5" vector-effect="non-scaling-stroke" /></svg>
      <div class="t-b">A randomised trial was conducted in four Colombian elementary schools with eight classes, and <mark>298 third and fifth grade pupils</mark>.</div>
      <svg viewBox="0 0 120 60" preserveAspectRatio="none" fill="none"><path d="M0 30H120" stroke="#fbbf24" stroke-width="2" stroke-dasharray="4 5" vector-effect="non-scaling-stroke" /></svg>
      <div class="t-c"><b>Results from a Phase 2 exploratory trial of Paired Reading in Spanish language in Colombia</b><span>Thurston, 2023</span></div>
    </div>
  </section>

  <section class="panel publish" id="library" style="--tint:#be123c">
    <i class="field f-rose" aria-hidden="true"></i>
    <div class="p-copy"><h2>Publish your evidence as a living library</h2><p class="lead">Give your field a public home with your own branding and address. You choose the sources that keep it current, and readers can search it, explore it and ask it questions.</p><a class="btn" href="/evidence-libraries/">Explore Evidence Libraries<Arrow /></a></div>
    <div class="p-shots"><a class="win a" href="https://wealth-inequality.openscholar.ai" aria-label="Wealth Inequality and Social Mobility library"><img src="/img/lib-plate.avif" width="1000" height="782" loading="lazy" decoding="async" alt="" /></a><a class="win b" href="https://aied.openscholar.ai" aria-label="Artificial Intelligence in Education library"><img src="/img/lib-evidence.avif" width="1240" height="640" loading="lazy" decoding="async" alt="" /></a></div>
  </section>

  <Faq items={faq} />

  <section class="panel close"><i class="field f-cobalt" aria-hidden="true"></i><h2>Start with your next question</h2><AskBar id="ask-end" /></section>
</Base>
<style>
  .hero { padding: var(--pad) var(--pad) 0; }
  .h-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 48px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); } .h-side { display: grid; gap: 20px; } .acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .shot { border-radius: 16px 16px 0 0; margin-bottom: -2px; max-height: 620px; overflow: hidden; } .shot img { width: 139%; margin-left: -39%; max-width: none; }
  .band { display: grid; gap: 28px; padding: var(--pad); } .b-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .flow { display: grid; grid-template-columns: minmax(0, 340px) 60px minmax(0, 1fr); align-items: center; } .pipe { width: 100%; height: 120px; } .stream { min-width: 0; } .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; font-size: 14px; } .legend span { display: inline-flex; align-items: center; gap: 7px; } .legend i { width: 12px; height: 12px; border-radius: 3px; }
  .who { padding: clamp(40px, 6vw, 72px) var(--pad) 8px; } .who h2 { max-width: 16em; margin-bottom: 28px; }
  .teams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-inline: calc(var(--pad) * -1); } .teams .panel { display: flex; flex-direction: column; gap: 10px; padding: 24px; } .teams :global(svg) { margin-bottom: 14px; } .teams p { font-size: 16px; line-height: 1.4; }
  .trust { padding: var(--pad); display: grid; gap: 36px; } .t-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 16px 48px; align-items: end; }
  .trace { display: grid; grid-template-columns: minmax(0, 3fr) 48px minmax(0, 5fr) 48px minmax(0, 4fr); align-items: center; } .trace > svg { width: 100%; height: 60px; }
  .t-a, .t-b, .t-c { padding: 18px 20px; border-radius: 14px; background: #fff; color: var(--ink); } .t-a span, .t-c span { display: block; font-size: 14px; color: var(--t2); } .t-a b { display: block; margin-top: 4px; font-weight: 500; font-size: 26px; letter-spacing: -.02em; } .t-b { font-size: 16px; line-height: 1.45; color: var(--t2); } .t-b mark { background: #fde68a; color: var(--ink); border-radius: 3px; padding-inline: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; } .t-c b { display: block; font-weight: 500; line-height: 1.3; margin-bottom: 4px; }
  .publish { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: center; padding: var(--pad); min-height: 560px; } .p-copy { display: grid; gap: 18px; justify-items: start; } .publish :global(.btn) { --chip: var(--tint); }
  .p-shots { position: relative; height: 440px; } .p-shots .win { position: absolute; display: block; transition: transform .3s var(--ease); } .p-shots .win:hover { transform: translateY(-6px); z-index: 2; } .a { left: 0; top: 0; width: 66%; z-index: 1; } .b { right: 0; bottom: 0; width: 66%; }
  .close { display: grid; justify-items: center; gap: 24px; padding: clamp(48px, 7vw, 96px) var(--pad); text-align: center; } .close h2 { font-size: clamp(34px, 4.6vw, 60px); }
  @media (max-width: 900px) { .h-top, .publish, .t-head { grid-template-columns: minmax(0, 1fr); } .shot img { width: 190%; margin-left: -53%; } .b-head, .flow { grid-template-columns: minmax(0, 1fr); } .pipe { display: none; } .stream { margin-top: 16px; } .who { padding-inline: 8px; } .teams { grid-template-columns: minmax(0, 1fr); margin-inline: -8px; } .trace { grid-template-columns: minmax(0, 1fr); gap: 0; } .trace > svg { width: 2px; height: 24px; margin-inline: 24px; overflow: visible; } .trace > svg path { d: path("M1 0V60"); } .p-shots { height: 76vw; } }
</style>
