---
// Hero to compare: one scene cut at the water's surface. The public places stand in daylight above; the team's work goes on in the deep below. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import Fill from "../../components/Fill.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const X = [9.5, 26.2, 42.3, 58.2, 74.4, 90.7];
---
<Base top="#eaf0f9" title="Hero 6: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="sky light">
      <h2><Fill tex="tx-glass" flat class="e">Evidence Communities</Fill> <span>are where anyone can read it</span></h2>
      <a class="all" href="/evidence-communities/">How they work<Arrow /></a>
    </div>
    <div class="scene">
      <img class="pic" src="/img/art-hero-surface.avif" srcset="/img/art-hero-surface-960.avif 960w, /img/art-hero-surface.avif 1672w" sizes="100vw" width="1672" height="941" fetchpriority="high" alt="" />
      <ul>{COMMUNITIES.map((c, i) => <li style={`--x:${X[i]}`}><a href={c.url}><b>{c.name}</b><span>{c.host}</span></a></li>)}</ul>
    </div>
    <div class="os">
      <h1><Fill tex="sea" class="w">OpenScholar</Fill> <span>is where your team works through the evidence</span></h1>
      <div class="ask-w"><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); background: #01072c; overflow: clip; }
  .sky { display: grid; justify-items: start; gap: 6px; padding: 96px var(--pad) 8px; background: #eaf0f9; color: var(--ink); container-type: inline-size; } h2 { display: grid; gap: 4px; width: 100%; font-weight: 500; } :global(.e) { font-size: calc((100cqw - var(--pad) * 2) / 9.42); --blend: normal; } h2 span { font-size: max(19px, calc(var(--hu) * 24)); letter-spacing: -.02em; line-height: 1.15; color: var(--t2); } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(14px, calc(var(--hu) * 15)); transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  .scene { position: relative; } .pic { display: block; width: 100%; height: auto; aspect-ratio: 16 / 6.4; max-width: none; object-fit: cover; object-position: 50% 24%; } ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; padding: 4px 8px 0; background: #01072c; } li a { display: grid; gap: 2px; padding: 10px; border-radius: 12px; color: #fff; transition: background .2s var(--ease); } li a:hover { background: rgb(255 255 255 / .1); } li b { font-weight: 500; font-size: 14px; line-height: 1.2; letter-spacing: -.005em; text-wrap: balance; } li span { color: #a9bbe6; font: 400 11px/1.25 var(--mono); overflow: clip; text-overflow: ellipsis; white-space: nowrap; }
  .os { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--hu) * 16); padding: 24px var(--pad) 32px; color: #fff; container-type: inline-size; } h1 { display: grid; gap: calc(var(--hu) * 10); font-weight: 500; } :global(.w) { font-size: calc((100cqw - var(--pad) * 2) / 5.35); } h1 span { font-size: max(21px, calc(var(--hu) * 30)); letter-spacing: -.02em; line-height: 1.15; color: #a9bbe6; text-wrap: balance; } .ask-w :global(.big) { width: 100%; } .ask-w :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  @media (min-width: 1000px) {
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); --H: max(620px, calc(100svh - 32px)); --bw: min(100vw, var(--H) * 1.7); display: block; height: var(--H); background: linear-gradient(#e9eff9 calc(var(--bw) * .2756), #01072c 0); }
    .pic { aspect-ratio: 16 / 9; -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); } .scene { position: absolute; z-index: -1; left: 50%; top: 0; width: var(--bw); aspect-ratio: 16 / 9; translate: -50% 0; }
    .sky { position: absolute; left: 0; right: 0; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: flex-end; gap: calc(var(--hu) * 24); padding: max(82px, calc(var(--hu) * 86)) var(--edge) 0; background: none; pointer-events: none; } .sky > * { pointer-events: auto; } h2 { width: auto; grid-template-columns: auto auto; align-items: end; column-gap: calc(var(--hu) * 24); } :global(.e) { font-size: calc(var(--hu) * 92); } h2 span { max-width: 9em; padding-bottom: calc(var(--hu) * 8); font-size: calc(var(--hu) * 26); text-wrap: balance; } .all { padding-bottom: calc(var(--hu) * 14); white-space: nowrap; }
    ul { position: absolute; inset: 0; display: block; padding: 0; background: none; } li { position: absolute; left: calc(var(--x) * 1%); top: 22%; bottom: 40%; width: 15%; translate: -50% 0; } li a { position: absolute; inset: 0; align-content: end; justify-items: center; padding: calc(var(--hu) * 8); text-align: center; border-radius: calc(var(--hu) * 16); } li b { font-size: max(12px, calc(var(--hu) * 14)); } li span { font-size: max(10px, calc(var(--hu) * 11)); max-width: 100%; }
    .os { position: absolute; left: var(--edge); right: var(--edge); bottom: calc(var(--hu) * 26); grid-template-columns: minmax(0, 1fr) calc(var(--hu) * 620); column-gap: calc(var(--hu) * 40); align-items: center; padding: 0; } .os h1 { display: contents; } :global(.w) { grid-column: 1 / -1; font-size: calc(100cqw / 5.35); } .os :global(.big .mk), .os :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); }
  }
</style>
