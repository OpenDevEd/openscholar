---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
const colors = [
  { name: "Brand orange", value: "#ED7B15", note: "Actions and highlights", class: "orange", text: "#361307" },
  { name: "Blue", value: "#2563EB", note: "Supporting blue", class: "blue", text: "#fff" },
  { name: "Night blue", value: "#070B1A", note: "Dark backgrounds", class: "night", text: "#fff" },
  { name: "Light blue", value: "#7DA7E6", note: "Assistant sections and accents", class: "light-blue", text: "#070b1a" },
  { name: "Globe orange", value: "#FF6B35", note: "The sea in our mark", class: "globe", text: "#361307" },
  { name: "Cream", value: "#FFF1E0", note: "The land in our mark", class: "cream", text: "#361307" },
  { name: "Ink", value: "#171717", note: "Text on light backgrounds", class: "ink", text: "#fff" },
  { name: "White", value: "#FFFFFF", note: "Light backgrounds", class: "white", text: "#171717" },
];
---
<Base top="#070b1a" title="Branding: Openscholar" description="Openscholar logos, brand colors, Ubuntu typography and a downloadable brand guide.">
  <section class="panel bleed brand-hero" aria-labelledby="brand-title">
    <div class="inner brand-hero-content">
    <div class="hero-copy rises">
      <h1 id="brand-title">The Openscholar<br /><span>brand.</span></h1>
      <p class="lead">Our logo, colors and type.<br />For the work you put out into the world.</p>
      <p class="print-draft">Draft brand guidelines / November 2026</p>
      <div class="hero-actions"><a class="btn brand" href="#logos">Get the logos<i><Arrow /></i></a><a class="guide-link" href="/branding/openscholar-brand-guide.pdf" download>Brand guide PDF<Icon name="cite" size={18} /></a></div>
    </div>
    <div class="hero-art rise" aria-label="Openscholar globe mark">
      <div class="mark-grid"><div class="mark-axis horizontal"></div><div class="mark-axis vertical"></div><img src="/branding/openscholar-mark-dark.svg" width="384" height="384" alt="The orange Earth facing Africa, inside an orbit with five connected nodes" /></div>
      <span class="art-caption">A world of connected research</span>
    </div>
    <nav class="brand-index" aria-label="Brand guide sections"><a href="#logos">Logo files<Arrow /></a><a href="#spacing">Space &amp; size<Arrow /></a><a href="#colors">Colors<Arrow /></a><a href="#typography">Typography<Arrow /></a><a href="#usage">Using the brand<Arrow /></a></nav>
    </div>
  </section>

  <section id="logos" class="brand-section" aria-labelledby="logos-title">
    <div class="section-head"><h2 id="logos-title">The logo</h2><p>Use the full logo when you have room.<br />Use the mark where space is tight.</p></div>
    <div class="logo-preview" data-logo-preview data-theme="light">
      <div class="preview-toolbar"><span>Logo preview</span><div class="background-controls" role="group" aria-label="Preview background"><button type="button" data-background="light" aria-pressed="true"><Icon name="sun" size={16} />Light</button><button type="button" data-background="dark" aria-pressed="false"><Icon name="moon" size={16} />Dark</button></div></div>
      <div class="logo-stage"><img class="full-logo" data-full-logo src="/branding/openscholar-logo-light.svg" width="626" height="128" alt="Openscholar full logo" /><div class="separate-mark"><img data-mark-logo src="/branding/openscholar-mark-light.svg" width="104" height="104" alt="Openscholar mark" /></div></div>
      <div class="download-rows"><div><span>Full logo</span><div><a data-logo-download="logo" data-format="svg" href="/branding/openscholar-logo-light.svg" download>SVG<Arrow /></a><a data-logo-download="logo" data-format="png" href="/branding/openscholar-logo-light.png" download>PNG<Arrow /></a></div></div><div><span>Mark only</span><div><a data-logo-download="mark" data-format="svg" href="/branding/openscholar-mark-light.svg" download>SVG<Arrow /></a><a data-logo-download="mark" data-format="png" href="/branding/openscholar-mark-light.png" download>PNG<Arrow /></a></div></div></div>
    </div>
    <p class="asset-note">SVG scales to any size. PNG has a transparent background. Choose the version for your background before downloading.</p>
  </section>

  <section id="spacing" class="brand-section spacing-section" aria-labelledby="spacing-title">
    <div class="section-head"><h2 id="spacing-title">Room to breathe</h2><p>Keep the logo clear and readable.<br />These are the proposed size and spacing rules.</p></div>
    <div class="size-layout">
      <figure class="clear-space"><div class="space-frame"><span class="space-label">¼ mark height</span><img src="/branding/openscholar-logo-light.svg" width="470" height="96" alt="Full logo surrounded by clear space equal to a quarter of the mark's height" /></div><figcaption>Leave at least a quarter of the mark's height clear on every side.</figcaption></figure>
      <div class="minimum-sizes"><div><span class="minimum-label">Full logo</span><img src="/branding/openscholar-logo-light.svg" width="160" height="33" alt="Full logo at the proposed minimum width" /><span class="measure">160 px wide <span>Digital minimum</span></span></div><div><span class="minimum-label">Mark only</span><img src="/branding/openscholar-mark-light.svg" width="32" height="32" alt="Mark at the proposed minimum size" /><span class="measure">32 px <span>Digital minimum</span></span></div></div>
    </div>
  </section>

  <section id="colors" class="brand-section" aria-labelledby="colors-title">
    <div class="section-head"><h2 id="colors-title">The colors</h2><p>Orange and blue, with light and dark backgrounds.<br /><span class="copy-instruction">Click a value to copy it.</span></p></div>
    <div class="color-palette">{colors.map((c) => <button type="button" class:list={["color-swatch", c.class]} data-copy={c.value} style={`--swatch:${c.value};--swatch-text:${c.text}`} aria-label={`Copy ${c.name} color ${c.value}`}><span class="swatch-name">{c.name}</span><span class="swatch-meta"><span>{c.note}</span><code>{c.value}<Icon name="copy" size={16} /></code></span></button>)}</div>
    <div class="contrast-note"><span class="contrast-example">Aa</span><p>Use dark text on orange. For orange text on white, use <button class="inline-copy" data-copy="#B2440A" type="button" aria-label="Copy accessible orange #B2440A">#B2440A<Icon name="copy" size={14} /></button>.</p></div>
    <p class="copy-feedback" data-copy-feedback role="status" aria-live="polite"></p>
  </section>

  <section id="typography" class="panel type-section" aria-labelledby="type-title">
    <div class="type-top"><div><h2 id="type-title">Ubuntu.<br /><span>Open by design.</span></h2><p>Our typeface for the name, headings and body.<br />Use regular for reading and medium for emphasis.</p></div><span class="type-specimen" aria-hidden="true">Ag</span></div>
    <div class="font-samples"><div><span>Regular / 400</span><p>Research worth sharing.</p></div><div><span>Medium / 500</span><p>Knowledge worth opening.</p></div></div>
    <div class="type-bottom"><p>Ubuntu Mono for code and technical values.</p><a href="https://fonts.google.com/specimen/Ubuntu" target="_blank" rel="noreferrer">Get Ubuntu<Arrow /></a></div>
  </section>

  <section id="usage" class="brand-section" aria-labelledby="usage-title">
    <div class="section-head"><h2 id="usage-title">Keep it recognisable</h2><p>Use the original files.<br />Let the mark and the name stay themselves.</p></div>
    <div class="usage-examples">
      <figure><div class="usage-picture good"><img src="/branding/openscholar-logo-dark.svg" width="300" height="61" alt="Correct logo with its original proportions" /></div><figcaption><Icon name="check" />Keep the original proportions and colors.</figcaption></figure>
      <figure><div class="usage-picture stretched"><img src="/branding/openscholar-logo-light.svg" width="300" height="61" alt="Incorrect logo stretched vertically" /></div><figcaption><Icon name="cross" />Don't stretch, rotate or rearrange the logo.</figcaption></figure>
      <figure><div class="usage-picture recolored"><img src="/branding/openscholar-logo-light.svg" width="300" height="61" alt="Incorrect logo recolored purple" /></div><figcaption><Icon name="cross" />Don't recolor it or add visual effects.</figcaption></figure>
    </div>
    <div class="brand-name"><p>Write it <strong>Openscholar.</strong></p><span>One word. A capital O. A lowercase s.</span></div>
  </section>

  <section class="panel guide-section" aria-labelledby="guide-title"><div class="guide-cover" aria-hidden="true"><img src="/branding/openscholar-mark-dark.svg" width="80" height="80" alt="" /><span>Openscholar<br />Brand guide</span><small>Logo / Color / Type</small></div><div class="guide-copy"><h2 id="guide-title">Take the guide<br />with you.</h2><p>The essentials in a PDF for your next presentation, project or partnership.</p><a class="btn brand" href="/branding/openscholar-brand-guide.pdf" download>Download the guide<i><Arrow /></i></a><span class="guide-draft">Draft guidelines for review</span></div></section>
</Base>

<script>
  const preview = document.querySelector<HTMLElement>("[data-logo-preview]");
  const fullLogo = document.querySelector<HTMLImageElement>("[data-full-logo]");
  const markLogo = document.querySelector<HTMLImageElement>("[data-mark-logo]");
  document.querySelectorAll<HTMLButtonElement>("[data-background]").forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.dataset.background;
      if (!preview || !fullLogo || !markLogo) return;
      preview.dataset.theme = theme;
      fullLogo.src = `/branding/openscholar-logo-${theme}.svg`;
      markLogo.src = `/branding/openscholar-mark-${theme}.svg`;
      document.querySelectorAll("[data-background]").forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      document.querySelectorAll<HTMLAnchorElement>("[data-logo-download]").forEach((link) => {
        link.href = `/branding/openscholar-${link.dataset.logoDownload}-${theme}.${link.dataset.format}`;
      });
    });
  });
  const feedback = document.querySelector<HTMLElement>("[data-copy-feedback]");
  let feedbackTimer: number | undefined;
  addEventListener("pagehide", () => {
    window.clearTimeout(feedbackTimer);
    feedback?.removeAttribute("data-visible");
  });
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!feedback) return;
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        feedback.textContent = `Copied ${button.dataset.copy}`;
      } catch {
        feedback.textContent = `Copy this value: ${button.dataset.copy}`;
      }
      window.clearTimeout(feedbackTimer);
      feedback.dataset.visible = "true";
      feedbackTimer = window.setTimeout(() => feedback.removeAttribute("data-visible"), 3000);
    });
  });
</script>

<style>
  .brand-hero { border-radius: 0; background: radial-gradient(ellipse at 82% 40%, #382119 0, #151321 35%, #070b1a 70%); }
  .brand-hero-content { display: grid; grid-template-columns: 1.05fr 1fr; padding-top: 160px; }
  .hero-copy { position: relative; z-index: 1; display: grid; align-content: center; gap: 24px; padding-bottom: 64px; }
  .hero-copy h1 { font-size: clamp(46px, 5.6vw, 80px); line-height: 1.02; letter-spacing: -.045em; }
  .hero-copy h1 span { color: #ff9d36; } .hero-copy .lead { color: #d9d5d2; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 8px; }
  .guide-link { display: flex; align-items: center; gap: 9px; font-size: 15px; } .guide-link:hover { color: #ff9d36; }
  .hero-art { display: grid; align-content: center; justify-items: center; padding-bottom: 45px; min-width: 0; }
  .mark-grid { position: relative; display: grid; place-items: center; width: min(100%, 390px); aspect-ratio: 1; background: repeating-linear-gradient(90deg, transparent 0 47px, #ffffff07 47px 48px), repeating-linear-gradient(0deg, transparent 0 47px, #ffffff07 47px 48px); border: 1px solid #ffffff12; border-radius: 50%; }
  .mark-grid::before { content: ""; position: absolute; inset: 14%; border: 1px solid #ffffff18; border-radius: 50%; }
  .mark-grid img { position: relative; width: 88%; height: auto; animation: brand-float 7s ease-in-out infinite; filter: drop-shadow(0 26px 28px #0006); }
  .mark-axis { position: absolute; background: #ffffff18; } .horizontal { left: -8%; right: -8%; height: 1px; } .vertical { top: -8%; bottom: -8%; width: 1px; }
  .art-caption { font-size: 13px; color: #b7aca6; margin-top: 26px; }
  .brand-index { grid-column: 1 / -1; display: flex; justify-content: space-between; border-top: 1px solid #ffffff20; padding-block: 24px; gap: 20px; }
  .brand-index a { display: flex; align-items: center; gap: 16px; font-size: 15px; color: #ddd6d0; } .brand-index a svg { width: 14px; opacity: .5; } .brand-index a:hover { color: #ff9d36; }
  .brand-section { position: relative; padding: 64px var(--pad) 24px; background: #fff; scroll-margin-top: 88px; }
  .section-head { display: flex; justify-content: space-between; align-items: start; gap: 30px; margin-bottom: 34px; }
  .section-head h2 { font-size: clamp(30px, 3vw, 44px); } .section-head p { color: var(--t2); max-width: 360px; font-size: 16px; }
  .logo-preview { border-radius: 22px; overflow: hidden; background: #f5f4f1; color: #171717; transition: background-color .35s var(--ease), color .35s var(--ease); }
  .logo-preview[data-theme="dark"] { background: #070b1a; color: #f5f5f5; }
  .print-draft { display: none; }
  .logo-preview[data-theme="dark"] { background: #070b1a; color: #f5f5f5; }
  .preview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 20px 24px; font-size: 13px; }
  .background-controls { display: flex; padding: 4px; border-radius: 12px; background: #80808016; gap: 2px; }
  .background-controls button { display: flex; align-items: center; gap: 7px; height: 34px; padding-inline: 12px; border-radius: 8px; font-size: 13px; }
  .background-controls [aria-pressed="true"] { background: #fff; color: #171717; box-shadow: 0 1px 4px #0001; }
  .logo-stage { display: grid; grid-template-columns: 3fr 1fr; align-items: center; gap: 40px; min-height: 220px; padding: 35px 6%; }
  .full-logo { width: min(100%, 530px); height: auto; } .separate-mark { display: grid; place-items: center; border-left: 1px solid #80808030; min-height: 128px; }
  .download-rows { display: grid; grid-template-columns: 3fr 1fr; gap: 40px; padding: 22px 6%; border-top: 1px solid #80808030; font-size: 14px; }
  .download-rows > div { display: flex; align-items: center; justify-content: space-between; gap: 16px; } .download-rows > div > div { display: flex; gap: 16px; } .download-rows a { display: flex; align-items: center; gap: 7px; padding-block: 6px; } .download-rows a svg { width: 13px; } .download-rows a:hover { text-decoration: underline; }
  .asset-note { font-size: 13px; color: var(--t3); margin-top: 16px; }
  .size-layout { display: grid; grid-template-columns: 1.45fr 1fr; gap: 32px; }
  .clear-space { display: grid; align-content: center; padding: 48px 28px 20px; background: #faf6ef; border-radius: 20px; }
  .space-frame { position: relative; padding: 24px; border: 1px dashed #a9622e; } .space-frame img { width: 100%; height: auto; outline: 1px solid #b0784530; }
  .space-label { position: absolute; top: -25px; right: 0; font: 12px var(--mono); color: #8b4b21; }
  figcaption { font-size: 14px; color: var(--t2); } .clear-space figcaption { margin-top: 24px; }
  .minimum-sizes { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: 24px; padding: 24px 0; } .minimum-sizes > div { display: grid; gap: 28px; } .minimum-sizes img { height: 33px; width: auto; }
  .minimum-label { color: var(--t2); font-size: 14px; } .measure { font: 14px var(--mono); } .measure span { display: block; font: 12px var(--sans); color: var(--t3); margin-top: 6px; }
  .color-palette { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .color-swatch { position: relative; display: flex; flex-direction: column; align-items: start; justify-content: space-between; min-height: 190px; border-radius: 18px; padding: 22px; text-align: left; background: var(--swatch); color: var(--swatch-text); transition: translate .25s var(--ease); } .color-swatch:hover { translate: 0 -4px; } .color-swatch.orange, .color-swatch.night { grid-column: span 2; min-height: 250px; }
  .swatch-name { font-size: 18px; font-weight: 500; } .orange .swatch-name, .night .swatch-name { font-size: 28px; }
  .color-swatch.blue { grid-column: span 2; min-height: 250px; }
  .color-swatch.night, .color-swatch.light-blue { grid-column: span 2; min-height: 190px; }
  .blue .swatch-name, .light-blue .swatch-name { font-size: 28px; }
  .swatch-meta { display: grid; gap: 8px; width: 100%; } .swatch-meta > span { font-size: 12px; } code { display: flex; align-items: center; justify-content: space-between; gap: 8px; font: 13px var(--mono); } .white { box-shadow: inset 0 0 0 1px #0002; }
  .contrast-note { display: flex; align-items: center; gap: 18px; margin-top: 22px; color: var(--t2); font-size: 14px; } .contrast-example { display: grid; place-items: center; flex: none; width: 64px; height: 48px; background: var(--brand); color: #361307; border-radius: 10px; font-size: 26px; font-weight: 500; } .inline-copy { display: inline-flex; align-items: center; gap: 5px; color: #b2440a; font-family: var(--mono); }
  .copy-feedback { position: fixed; z-index: 100; bottom: 24px; left: 50%; translate: -50% 8px; max-width: calc(100vw - 32px); padding: 12px 20px; border-radius: 12px; background: #171717; color: #fff; box-shadow: 0 4px 28px #0003; font-size: 14px; text-align: center; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .18s var(--ease), translate .18s var(--ease), visibility 0s .18s; }
  .copy-feedback[data-visible] { opacity: 1; visibility: visible; translate: -50% 0; transition-delay: 0s; }
  .type-section { padding: 60px var(--pad) 30px; margin-top: 40px; background: #070b1a; }
  .type-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; } .type-top h2 { font-size: clamp(40px, 4.7vw, 64px); } .type-top h2 span { color: #ff9d36; } .type-top p { color: #c0c2ca; margin-top: 22px; }
  .type-specimen { font-size: clamp(140px, 20vw, 260px); font-weight: 500; color: #fff1e0; line-height: 1; letter-spacing: -.09em; padding-right: 20px; }
  .font-samples { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; padding-block: 42px; } .font-samples span { color: #969aa6; font: 13px var(--mono); } .font-samples p { font-size: clamp(20px, 2.1vw, 30px); margin-top: 12px; } .font-samples > :last-child p { font-weight: 500; }
  .type-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 22px; border-top: 1px solid #ffffff26; font: 13px var(--mono); color: #c0c2ca; } .type-bottom a { display: flex; align-items: center; gap: 12px; font: 15px var(--sans); color: #fff; white-space: nowrap; }
  .usage-examples { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } .usage-picture { display: grid; place-items: center; min-height: 160px; padding: 24px; border-radius: 18px; background: #f5f4f1; } .usage-picture img { width: 100%; height: auto; } .usage-picture.good { background: #070b1a; } .stretched img { transform: scaleY(1.6); } .recolored img { filter: hue-rotate(230deg); } .usage-examples figcaption { display: flex; align-items: start; gap: 8px; padding-top: 16px; } .usage-examples figcaption svg { flex: none; width: 18px; margin-top: 2px; }
  .brand-name { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); } .brand-name p { font-size: 26px; } .brand-name strong { font-weight: 500; } .brand-name > span { color: var(--t2); font-size: 14px; }
  .guide-section { display: flex; align-items: center; justify-content: center; gap: 90px; padding: 64px var(--pad); margin-block: 32px clamp(40px, 6vw, 80px); background: #f4eadb; color: #171717; } .guide-cover { display: grid; gap: 26px; align-content: space-between; width: 230px; min-height: 296px; padding: 28px; border-radius: 3px 12px 12px 3px; background: #070b1a; color: #fff1e0; box-shadow: -5px 0 0 #433a32, 0 18px 34px #36200c25; rotate: -6deg; } .guide-cover > span { font-size: 26px; line-height: 1.15; } .guide-cover small { font: 10px var(--mono); color: #c8a98b; } .guide-copy { max-width: 400px; } .guide-copy p { color: var(--t2); margin: 18px 0 24px; } .guide-draft { display: block; color: var(--t3); font-size: 12px; margin-top: 12px; }
  @keyframes brand-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }
  @media (max-width: 1000px) { .hero-actions { gap: 18px; } .size-layout { grid-template-columns: 1fr; } .minimum-sizes { padding: 8px 20px; } .download-rows { grid-template-columns: 1fr 1fr; } .color-swatch { padding: 18px; } .brand-index { gap: 16px; flex-wrap: wrap; } .brand-index a { gap: 8px; } }
  @media (max-width: 640px) { .brand-hero-content { grid-template-columns: 1fr; padding-top: 132px; } .hero-copy { padding-bottom: 22px; gap: 20px; } .hero-copy h1 { font-size: 52px; } .hero-actions { align-items: start; flex-direction: column; } .hero-art { padding: 16px 18px 30px; } .mark-grid { max-width: 250px; } .art-caption { font-size: 12px; margin-top: 18px; } .brand-index { display: grid; grid-template-columns: 1fr 1fr; padding-block: 22px; row-gap: 18px; } .brand-index a { justify-content: space-between; font-size: 13px; } .brand-section { padding-block: 40px 12px; } .section-head { display: grid; gap: 16px; margin-bottom: 24px; } .preview-toolbar { padding: 16px; } .preview-toolbar > span { font-size: 12px; } .background-controls button { padding-inline: 9px; } .logo-stage { grid-template-columns: 1fr; padding: 30px 24px; gap: 34px; } .separate-mark { border: 0; min-height: 72px; } .separate-mark img { width: 72px; } .download-rows { grid-template-columns: 1fr; gap: 14px; padding: 16px 20px; } .clear-space { padding: 44px 16px 20px; } .space-frame { padding: 16px; } .minimum-sizes { gap: 20px; padding-inline: 0; } .minimum-sizes > div { gap: 20px; } .color-palette { grid-template-columns: repeat(2, minmax(0, 1fr)); } .color-swatch.orange, .color-swatch.night { min-height: 190px; } .color-swatch { min-height: 175px; padding: 18px 14px; } .swatch-name { font-size: 17px; } .swatch-meta code { font-size: 12px; } .contrast-note { align-items: start; } .type-section { margin-top: 24px; padding-block: 36px 24px; } .type-top { display: grid; } .type-top h2 { font-size: 44px; } .type-specimen { font-size: 160px; padding: 20px 0 0; } .font-samples { grid-template-columns: 1fr; gap: 26px; padding-block: 30px; } .type-bottom { align-items: start; flex-direction: column; gap: 16px; } .usage-examples { grid-template-columns: 1fr; gap: 26px; } .usage-picture { padding-inline: 30px; min-height: 144px; } .brand-name { align-items: start; flex-direction: column; gap: 10px; margin-top: 32px; } .brand-name p { font-size: 24px; } .guide-section { flex-direction: column; gap: 40px; padding-block: 48px 36px; } .guide-cover { width: 210px; min-height: 260px; } .guide-copy { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .mark-grid img { animation: none; } .copy-feedback { transition: none; } .color-swatch, .logo-preview { transition: none; } }
  @media (max-width: 640px) { .color-swatch.blue, .color-swatch.light-blue { min-height: 190px; } }
