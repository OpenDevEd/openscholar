---
import Base from "../layouts/Base.astro";
import AskBar from "../components/AskBar.astro";
import Sticker from "../components/Sticker.astro";
---
<Base title="Not found: OpenScholar" description="That page isn't here. Ask a question instead.">
  <section class="b lost"><Sticker name="glass" size={170} class="g" /><h1>Nothing on this page</h1><p class="lead">Ask a question instead, or head <a class="pen" href="/">back to the start</a>.</p><AskBar id="ask-lost" /></section>
</Base>
<style>
  .lost { background: var(--sun); display: grid; justify-items: center; gap: 20px; padding-block: clamp(64px, 9vw, 120px); text-align: center; min-height: 560px; align-content: center; } .lost :global(.g) { rotate: -12deg; }
</style>
