---
import Base from "../layouts/Base.astro";
import AskBar from "../components/AskBar.astro";
import Art from "../components/Art.astro";
---
<Base title="Not found: OpenScholar" description="That page isn't here.">
  <section class="bleed lost"><Art name="door-front" pos="40% 50%" eager /><h1>That page isn't here</h1><p class="lead">Search the research instead, or head <a href="/">back to the start</a>.</p><AskBar id="ask-lost" /></section>
</Base>
<style>.lost > :global(.art) { left: 10%; right: -10%; opacity: .42; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%); mask-image: linear-gradient(90deg, transparent, #000 12%); } .lost { background: #000a34; display: grid; justify-items: center; align-content: center; gap: 20px; min-height: 720px; padding: 120px var(--pad) 240px; text-align: center; } .lead a { text-decoration: underline; text-underline-offset: 3px; }</style>
