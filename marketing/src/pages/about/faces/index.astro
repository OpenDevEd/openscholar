---
// Concept B: faces first. Big portraits on white, each with a name, a role and a place.
import Base from "../../../layouts/Base.astro";
import Close from "../../../components/Close.astro";
import Arrow from "../../../components/Arrow.astro";
import AboutSwitch from "../../../components/AboutSwitch.astro";
import { ORGS, TEAM, PLACES, flag } from "../../../data/team.mjs";
---
<Base top="#ffffff" title="About: Openscholar" description="The people who make Openscholar, where they work, and the two organisations behind it.">
  <section class="fhero">
    <h1>The people behind Openscholar</h1>
    <div class="f-side"><p class="lead">One team from <a href={ORGS.ode.url}>{ORGS.ode.name}</a> and <a href={ORGS.ekitabu.url}>{ORGS.ekitabu.name}</a>.</p>
      <ul class="chips" aria-label="Where we work">{PLACES.map((pl) => <li><img src={flag(pl.cc)} width="18" height="13" alt="" />{pl.place}</li>)}</ul></div>
  </section>
  <ul class="grid">{TEAM.map((m, i) => <li style={`--i:${i}`}>
    <div class="ph"><img src={`/img/team/${m.key}.avif`} width="480" height="600" alt={m.name} loading={i < 5 ? "eager" : "lazy"} /></div>
    <b>{m.name}</b><em>{m.role}</em>
    <span class="meta"><span class="pl"><img src={flag(m.cc)} width="16" height="12" alt="" />{m.place}</span><a href={ORGS[m.org].url}>{ORGS[m.org].short}</a></span>
  </li>)}</ul>
  <Close title="Talk to the team"><a slot="action" class="btn" href="/contact/">Get in touch<Arrow /></a></Close>
  <AboutSwitch />
</Base>
<style>
  .fhero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 48px; align-items: end; padding: clamp(130px, 11vw, 168px) var(--pad) clamp(32px, 4vw, 48px); background: #fff; }
  .fhero h1 { font-size: clamp(44px, 6.4vw, 96px); line-height: .98; letter-spacing: -.04em; }
  .f-side { display: grid; gap: 18px; } .f-side .lead { color: var(--t2); } .f-side a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 4px; } .f-side a:hover { text-decoration-color: currentColor; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; } .chips li { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding-inline: 10px; border-radius: 10px; background: var(--soft); font-size: 14px; } .chips img { border-radius: 2px; }
  .grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 36px 16px; padding: 0 var(--pad) clamp(64px, 8vw, 112px); background: #fff; }
  .ph { overflow: hidden; border-radius: 20px; aspect-ratio: 4 / 5; margin-bottom: 14px; background: var(--soft); } .ph img { width: 100%; height: 100%; object-fit: cover; transition: scale .6s var(--ease); } li:hover .ph img { scale: 1.04; }
  .grid b { display: block; font-weight: 500; font-size: 18px; letter-spacing: -.01em; } .grid em { display: block; font-style: normal; font-size: 15px; line-height: 1.35; color: var(--t2); min-height: 2.7em; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; font-size: 14px; color: var(--t3); } .meta .pl { display: inline-flex; align-items: center; gap: 6px; } .meta img { border-radius: 2px; }
  .meta a { text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px; } .meta a:hover { color: var(--ink); }
  :global(.js) .grid li { animation: f-up .8s var(--ease) calc(var(--i) * 50ms) both; } @keyframes f-up { from { opacity: 0; transform: translateY(18px); } }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .fhero { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 620px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 10px; } .ph { border-radius: 16px; } .grid b { font-size: 16px; } .grid em { font-size: 14px; } .meta { flex-direction: column; align-items: start; gap: 4px; } }
</style>
