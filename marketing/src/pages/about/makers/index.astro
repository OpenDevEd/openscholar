---
// Concept C: the two organisations. Each gets its own panel with what it is, where it is, and its people.
import Base from "../../../layouts/Base.astro";
import Close from "../../../components/Close.astro";
import Arrow from "../../../components/Arrow.astro";
import AboutSwitch from "../../../components/AboutSwitch.astro";
import { ORGS, TEAM, flag } from "../../../data/team.mjs";
const COLS = [["ode", "f-steel"], ["ekitabu", "f-ocean"]];
---
<Base top="#070b1a" title="About: Openscholar" description="The people who make Openscholar, where they work, and the two organisations behind it.">
  <section class="bleed ohero"><div class="inner o-copy"><h1>Openscholar is made by two organisations</h1><p class="lead">One team, working across Africa, Europe and North America.</p></div></section>
  <div class="orgs">{COLS.map(([id, field]) => { const o = ORGS[id], people = TEAM.filter((m) => m.org === id); return <section class="panel org" aria-labelledby={`o-${id}`}>
    <i class:list={["field", field]} aria-hidden="true"></i>
    <div class="o-top"><h2 id={`o-${id}`}>{o.name}</h2><p>{o.line}</p>
      <ul class="base" aria-label="Offices">{o.base.map(([cc, city]) => <li><img src={flag(cc)} width="18" height="13" alt="" />{city}</li>)}</ul>
      <a class="btn ghost" href={o.url}>{o.url.replace("https://www.", "")}<Arrow /></a></div>
    <ul class="ppl">{people.map((m) => <li><img class="av" src={`/img/team/${m.key}.avif`} width="52" height="52" alt="" loading="lazy" /><span class="who"><b>{m.name}</b><em>{m.role}</em><span class="pl"><img src={flag(m.cc)} width="18" height="13" alt="" />{m.place}</span></span></li>)}</ul>
  </section>; })}</div>
  <Close title="Talk to the team"><a slot="action" class="btn" href="/contact/">Get in touch<Arrow /></a></Close>
  <AboutSwitch />
</Base>
<style>
  .ohero { background: radial-gradient(ellipse 50% 80% at 50% 100%, #10204a, transparent 70%), #070b1a; padding-block: clamp(130px, 11vw, 168px) clamp(56px, 6vw, 88px); }
  .o-copy { display: grid; gap: 18px; justify-items: center; text-align: center; } .o-copy h1 { max-width: 13em; } .o-copy .lead { color: rgb(255 255 255 / .8); }
  .orgs { display: grid; gap: var(--gap); }
  /* Each organisation: what it is on the left, its people on the right, so a short list never leaves a hole. */
  .org { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 28px clamp(32px, 5vw, 72px); align-items: start; padding: clamp(28px, 3.4vw, 48px); }
  .o-top { display: grid; gap: 16px; justify-items: start; } .o-top h2 { font-size: clamp(28px, 3vw, 40px); } .o-top p { max-width: 30em; color: rgb(255 255 255 / .82); }
  .base { display: flex; flex-wrap: wrap; gap: 6px; } .base li { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding-inline: 10px; border-radius: 10px; background: rgb(255 255 255 / .1); font-size: 14px; } .base img, .pl img { border-radius: 2px; }
  .ppl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; align-content: start; } .ppl li { display: flex; align-items: center; gap: 14px; padding-block: 12px; border-top: 1px solid rgb(255 255 255 / .14); }
  .av { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; flex: none; box-shadow: 0 0 0 2px rgb(255 255 255 / .2); }
  .who { display: grid; min-width: 0; } .ppl b { font-weight: 500; font-size: 17px; } .ppl em { font-style: normal; font-size: 14px; line-height: 1.35; color: rgb(255 255 255 / .7); }
  .pl { display: inline-flex; align-items: center; gap: 7px; margin-top: 2px; font-size: 14px; color: rgb(255 255 255 / .82); }
  @media (max-width: 1000px) { .org { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .ppl { grid-template-columns: minmax(0, 1fr); } }
</style>
