---
// One person's page: who they are, where they are, where else to find them, what they've published, and the organisation
// they work for. Everything on it is what their own organisation's page and their own public profiles already say
// (src/data/team.mjs).
import Base from "../../../layouts/Base.astro";
import Portrait from "../../../components/Portrait.astro";
import TeamGrid from "../../../components/TeamGrid.astro";
import OrgPanel from "../../../components/OrgPanel.astro";
import Mark from "../../../components/Mark.astro";
import Close from "../../../components/Close.astro";
import Arrow from "../../../components/Arrow.astro";
import { ORGS, TEAM, PLACE, LINK_NAMES, CLOCK_JS } from "../../../data/team.mjs";
export function getStaticPaths() { return TEAM.map((m) => ({ params: { person: m.slug }, props: { m } })); }
const { m } = Astro.props, p = PLACE[m.place], org = ORGS[m.org], pubs = m.pubs ?? [];
// Their own links first, then their page on their organisation's site.
const links = [...m.links.map(([kind, url, label]) => ({ kind, url, label: label ?? LINK_NAMES[kind] })), { kind: "web", url: m.source, label: org.host }];
const person = { "@context": "https://schema.org", "@type": "Person", name: m.name, jobTitle: m.role, url: `https://openscholar.ai/about/${m.slug}/`, image: `https://openscholar.ai/img/team/${m.key}.avif`, worksFor: { "@type": "Organization", name: org.name, url: org.url }, sameAs: [...m.links.map((l) => l[1]), m.source] };
// A bio opens on its first sentence, set large, and the rest follows as text.
const cut = m.bio ? m.bio[0].indexOf(". ") + 1 : 0, opening = m.bio && (cut ? m.bio[0].slice(0, cut) : m.bio[0]), rest = m.bio ? [cut ? m.bio[0].slice(cut + 1) : "", ...m.bio.slice(1)].filter(Boolean) : [];
// The newest publications with covers stand in front, as covers; the others follow as a list, six at first.
const front = pubs.filter((b) => b.cover).slice(0, 4), others = pubs.filter((b) => !front.includes(b)), FIRST = 6;
---
<Base top={p.bg} title={`${m.name}: Openscholar`} description={`${m.name}, ${m.role} at ${org.name}, part of the team behind Openscholar.`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <section class="bleed ph" style={`--bg:${p.bg};--glow:${p.glow}`}>
    <div class="ph-art" aria-hidden="true"><img src={`/img/art-place-${p.id}.avif`} srcset={`/img/art-place-${p.id}-960.avif 960w, /img/art-place-${p.id}.avif 1672w`} sizes="(max-width: 1000px) 100vw, 1000px" width="1672" height="941" alt="" fetchpriority="high" /><i class="glint"></i></div>
    <div class="inner ph-in">
      <div class="ph-face"><Portrait person={m} eager clock /></div>
      <div class="ph-copy">
        <a class="back" href="/about/"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10H4M9 5l-5 5 5 5" /></svg>The team</a>
        <h1>{m.name}{m.suffix && <small>{m.suffix}</small>}</h1>
        <p class="role">{m.role}</p>
        <a class="org" href={org.url}>{org.name}</a>
        <ul class="links" aria-label={`Where to find ${m.name}`}>{links.map((l) => <li><a href={l.url} rel="me noopener"><Mark kind={l.kind} size={18} />{l.label}</a></li>)}</ul>
      </div>
    </div>
    <script is:inline set:html={CLOCK_JS} />
  </section>
  <div class="pb">
    {m.quote ? <figure class="quote"><svg class="qm" viewBox="0 0 48 36" width="56" height="42" aria-hidden="true"><path fill="currentColor" d="M0 36V21.6C0 9.2 6.6 1.8 19.2 0l1.6 5.4C13.6 7 10.6 10.6 10.2 16h9v20Zm27.2 0V21.6C27.2 9.2 33.8 1.8 46.4 0L48 5.4C40.8 7 37.8 10.6 37.4 16h9v20Z" /></svg><blockquote>{m.quote}</blockquote><figcaption>From <a href={m.source}>{org.host}/team</a></figcaption></figure>
      : <section class="bio"><p class="first" set:html={opening} />{rest.length > 0 && <div class="rest">{rest.map((text) => <p set:html={text} />)}</div>}<p class="src">From <a href={m.source}>{org.host}</a></p></section>}
    {pubs.length > 0 && <section class="pubs" aria-labelledby="pubs-h">
      <h2 id="pubs-h">Publications</h2>
      {front.length > 0 && <ul class="front">{front.map((b) => <li><a href={b.url} rel="noopener"><span class="cover"><img src={`/img/team/pub-${b.cover}.avif`} width="200" height="267" alt="" loading="lazy" /></span><span class="ty">{b.type}<i>{b.year}</i></span><b>{b.title}</b><em>{b.by}</em></a></li>)}</ul>}
      {others.length > 0 && <ol>{others.slice(0, FIRST).map((b) => <li><a href={b.url} rel="noopener">{b.cover ? <img class="cv" src={`/img/team/pub-${b.cover}.avif`} width="48" height="64" alt="" loading="lazy" /> : <i class="cv none"></i>}<span class="tx"><b>{b.title}</b><em>{b.by}</em></span><span class="ty">{b.type}</span><span class="yr">{b.year}</span></a></li>)}</ol>}
      {others.length > FIRST && <details><summary><span class="btn line">All {pubs.length} publications<svg class="chev" width="12" height="12" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 3.5 3 3 3-3" /></svg></span></summary>
        <ol>{others.slice(FIRST).map((b) => <li><a href={b.url} rel="noopener">{b.cover ? <img class="cv" src={`/img/team/pub-${b.cover}.avif`} width="48" height="64" alt="" loading="lazy" /> : <i class="cv none"></i>}<span class="tx"><b>{b.title}</b><em>{b.by}</em></span><span class="ty">{b.type}</span><span class="yr">{b.year}</span></a></li>)}</ol></details>}
    </section>}
  </div>
  <div class="works"><OrgPanel id={m.org} except={m.key} /></div>
  <section class="more" aria-labelledby="more-h"><h2 id="more-h">More of the team</h2><TeamGrid people={TEAM.filter((x) => x !== m)} /></section>
  <Close title="Talk to the team"><a slot="action" class="btn" href="/contact/">Get in touch<Arrow /></a></Close>
</Base>
<style>
  /* The head of the page: the person's frame, their name and links, and their place's glass model on the right. The frame
     hangs a little below the head, over the white page, so the head only clips sideways. */
  .ph { --hang: 64px; overflow: visible; overflow-x: clip; background: var(--bg); padding-block: clamp(104px, 8.4vw, 128px) clamp(40px, 4.4vw, 56px); }
  .ph-art { position: absolute; right: 0; bottom: 0; z-index: -1; height: 88%; aspect-ratio: 1672 / 941; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 34%, #000 60%), linear-gradient(transparent, #000 24%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent 34%, #000 60%), linear-gradient(transparent, #000 24%); mask-composite: intersect; animation: ph-art 1.4s .1s var(--ease) both; } .ph-art img { width: 100%; height: 100%; transform-origin: 70% 100%; animation: ph-breathe 24s ease-in-out infinite alternate; } @keyframes ph-art { from { opacity: 0; transform: translateX(28px); } } @keyframes ph-breathe { to { transform: scale(1.05); } }
  /* A band of light crosses the glass once the page is in, and again now and then. */
  .glint { position: absolute; inset: 0; background: linear-gradient(105deg, transparent 46%, rgb(255 255 255 / .22) 50%, transparent 54%); background-size: 300% 100%; mix-blend-mode: overlay; animation: glint 9s 1.2s var(--ease) infinite; } @keyframes glint { from { background-position: 130% 0; } 30%, to { background-position: -30% 0; } }
  .ph-in { display: grid; grid-template-columns: 320px minmax(0, 460px); gap: clamp(28px, 3.4vw, 52px); align-items: center; }
  /* On the page's own colour the frame is a shade lighter, and the place stands to the right, so not behind the shoulders too. */
  .ph-face { align-self: end; margin-bottom: calc(-1 * var(--hang) - clamp(40px, 4.4vw, 56px)); animation: ph-up .8s var(--ease) both; } .ph-face :global(.pf) { --base: color-mix(in srgb, var(--bg) 80%, #fff); border-radius: 26px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .2), 0 0 0 6px color-mix(in srgb, var(--glow) 14%, transparent), 0 40px 60px -30px rgb(0 0 0 / .7); } .ph-face :global(.pf-art) { display: none; }
  .ph-copy { display: grid; justify-items: start; padding-bottom: 8px; } .ph-copy > * { animation: ph-up .8s var(--ease) both; } .ph-copy > :nth-child(2) { animation-delay: .04s; } .ph-copy > :nth-child(3) { animation-delay: .08s; } .ph-copy > :nth-child(4) { animation-delay: .12s; } .ph-copy > :nth-child(5) { animation-delay: .16s; } @keyframes ph-up { from { opacity: 0; transform: translateY(18px); } }
  .back { display: inline-flex; align-items: center; gap: 8px; height: 40px; margin: 0 0 14px -12px; padding-inline: 12px 14px; border-radius: 12px; font-size: 15px; color: rgb(255 255 255 / .8); transition: background-color .2s var(--ease), color .2s var(--ease); } .back svg { transition: translate .25s var(--ease); } .back:hover { background: rgb(255 255 255 / .1); color: #fff; } .back:hover svg { translate: -3px 0; }
  .ph-copy h1 { font-size: clamp(40px, 4.8vw, 68px); line-height: 1; letter-spacing: -.04em; } .ph-copy h1 small { margin-left: .4em; font-size: .34em; font-weight: 400; letter-spacing: 0; color: rgb(255 255 255 / .66); }
  .role { margin-top: 16px; font-size: clamp(19px, 1.7vw, 23px); line-height: 1.25; letter-spacing: -.01em; }
  .org { margin-top: 4px; font-size: 17px; color: rgb(255 255 255 / .78); text-decoration: underline; text-decoration-color: rgb(255 255 255 / .3); text-underline-offset: 4px; transition: color .15s var(--ease), text-decoration-color .15s var(--ease); } .org:hover { color: #fff; text-decoration-color: currentColor; }
  /* Where else to find them: one chip a link, its service's own mark first. */
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; } .links a { display: inline-flex; align-items: center; gap: 9px; height: 42px; padding-inline: 13px 15px; border-radius: 13px; background: rgb(255 255 255 / .1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .16); font-size: 15px; white-space: nowrap; transition: background-color .2s var(--ease), color .2s var(--ease), translate .2s var(--ease); } .links a:hover { background: #fff; color: var(--ink); translate: 0 -2px; } .links :global(svg) { flex: none; }
  /* What they say about themselves: the first sentence large, the rest in a column beside the frame's foot. */
  .pb { display: grid; gap: clamp(48px, 6vw, 80px); padding: clamp(48px, 7.4vw, 104px) var(--pad) clamp(56px, 7vw, 96px); }
  .bio { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; max-width: 60em; } .bio :global(a), figcaption a { text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px; transition: text-decoration-color .15s var(--ease); } .bio :global(a):hover, figcaption a:hover { text-decoration-color: currentColor; }
  .first { max-width: 26em; font-size: clamp(24px, 2.9vw, 38px); line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .rest { display: grid; gap: 1em; max-width: 44em; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--t2); } .rest :global(a) { color: var(--ink); }
  .src, figcaption { font-size: 14px; line-height: 1.4; color: var(--t3); }
  .quote { display: grid; gap: 20px; max-width: 34em; } .qm { color: var(--brand); } blockquote { font-size: clamp(26px, 3.2vw, 44px); line-height: 1.16; letter-spacing: -.028em; text-wrap: balance; }
  .pubs h2 { margin-bottom: clamp(20px, 2.4vw, 32px); }
  /* The newest stand in front as covers, leaning as you reach for one. */
  .front { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px clamp(16px, 2.4vw, 32px); margin-bottom: clamp(32px, 4vw, 48px); } .front a { display: grid; align-content: start; gap: 6px; }
  .cover { display: block; margin-bottom: 10px; padding: clamp(16px, 2vw, 28px) clamp(20px, 3vw, 44px) 0; border-radius: 18px; background: linear-gradient(var(--soft), #ebebeb); overflow: hidden; } .cover img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 0; border-radius: 4px 4px 0 0; box-shadow: 0 0 0 1px var(--line), 0 18px 30px -12px rgb(0 0 0 / .4); transform-origin: 50% 100%; transition: translate .45s var(--ease), rotate .45s var(--ease); translate: 0 10px; } .front a:hover .cover img { translate: 0 0; rotate: -2.5deg; }
  .front .ty { display: flex; gap: 8px; align-items: center; width: fit-content; } .front .ty i { font: 400 13px/1 var(--mono); font-style: normal; color: var(--t3); } .front b { font-weight: 500; font-size: 16px; line-height: 1.32; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; } .front em { overflow: hidden; font-style: normal; font-size: 14px; white-space: nowrap; text-overflow: ellipsis; color: var(--t3); } .front a:hover b { text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px; }
  .pubs ol > li { border-top: 1px solid var(--line); } .pubs ol:last-of-type > li:last-child, .pubs > ol > li:last-child { border-bottom: 1px solid var(--line); }
  @supports (animation-timeline: view()) { .pubs li { animation: pub-in linear both; animation-range: entry 0% entry 80%; } .pubs li { animation-timeline: view(); } @keyframes pub-in { from { opacity: 0; translate: 0 24px; } } }
  .pubs ol a { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto 3.2em; gap: 16px; align-items: center; padding-block: 14px; } .pubs ol a:hover b { text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px; }
  .cv { width: 48px; height: 64px; border-radius: 4px; object-fit: cover; object-position: 50% 0; box-shadow: 0 0 0 1px var(--line), 0 6px 12px -8px rgb(0 0 0 / .4); transition: translate .3s var(--ease), rotate .3s var(--ease); } .pubs ol a:hover .cv { translate: 0 -2px; rotate: -2deg; }
  /* No cover: a plain page with a few lines on it. */
  .cv.none { display: block; background: linear-gradient(var(--line2), var(--line2)) 9px 14px / 22px 2px no-repeat, linear-gradient(var(--line), var(--line)) 9px 24px / 30px 2px no-repeat, linear-gradient(var(--line), var(--line)) 9px 31px / 30px 2px no-repeat, linear-gradient(var(--line), var(--line)) 9px 38px / 18px 2px no-repeat, var(--soft); }
  .tx { display: grid; gap: 2px; min-width: 0; } .tx b { font-weight: 500; font-size: 16px; line-height: 1.35; } .tx em { overflow: hidden; font-style: normal; font-size: 14px; white-space: nowrap; text-overflow: ellipsis; color: var(--t3); }
  .ty { height: 26px; padding-inline: 9px; border-radius: 8px; background: var(--soft); font-size: 13px; line-height: 26px; white-space: nowrap; color: var(--t2); } .yr { font: 400 14px/1 var(--mono); text-align: right; color: var(--t3); }
  summary { display: block; width: fit-content; margin-top: 20px; cursor: pointer; list-style: none; } summary::-webkit-details-marker { display: none; } summary .btn { gap: 10px; height: 46px; } .chev { transition: rotate .3s var(--ease); } details[open] .chev { rotate: 180deg; } details > ol { margin-top: 20px; }
  .more { padding: clamp(64px, 8vw, 112px) var(--pad) clamp(56px, 7vw, 96px); } .more h2 { margin-bottom: clamp(24px, 3vw, 40px); }
  /* Narrower: the frame above the words, and the glass model as a quiet backdrop along the foot. */
  @media (max-width: 1000px) {
    .ph { --hang: 0px; } .ph-in { grid-template-columns: minmax(0, 1fr); justify-items: center; } .ph-face { width: min(100%, 280px); margin-bottom: 0; } .ph-copy { justify-items: center; text-align: center; } .back { margin-left: 0; } .links { justify-content: center; }
    .ph-art { left: 0; height: auto; aspect-ratio: auto; top: 30%; opacity: .32; -webkit-mask-image: linear-gradient(transparent, #000 40%); mask-image: linear-gradient(transparent, #000 40%); } .ph-art img { object-fit: cover; object-position: 78% 100%; } .glint { display: none; }
    .front { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) { .pubs ol a { grid-template-columns: 48px minmax(0, 1fr) auto; } .pubs ol .ty { display: none; } .tx em { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; } }
</style>
