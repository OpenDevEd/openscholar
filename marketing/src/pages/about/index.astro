---
// Who makes Openscholar and where they are: the globe with the team on it over a row of the places they work in, everyone
// as a card that opens their own page, what they've published on a shelf, and the two organisations they work for.
import "../../styles/about.css";
import TRAVEL_JS from "../../scripts/travel.js?raw";
import Base from "../../layouts/Base.astro";
import TeamEarth from "../../components/TeamEarth.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import TeamShelf from "../../components/TeamShelf.astro";
import OrgPanel from "../../components/OrgPanel.astro";
import Close from "../../components/Close.astro";
import Arrow from "../../components/Arrow.astro";
import { ORGS, TEAM } from "../../data/team.mjs";
import { EARTH_PRELOAD_JS } from "../../data/site.mjs";
---
<Base top="#070b1a" title="About: Openscholar" description="The people who make Openscholar, where they work, and the two organisations behind it.">
  {/* The planet's maps are asked for as the page arrives, as on the home page, so the globe is there sooner. */}
  <Fragment slot="head"><script is:inline set:html={EARTH_PRELOAD_JS} /><script is:inline set:html={TRAVEL_JS} /></Fragment>
  <TeamEarth />
  <section class="team" id="team" aria-labelledby="team-h">
    <h2 id="team-h">The team</h2>
    <TeamGrid people={TEAM} />
  </section>
  <TeamShelf />
  <section class="orgs" id="makers" aria-labelledby="orgs-h">
    <h2 id="orgs-h">Made by two organisations</h2>
    <div class="pair">
      {Object.keys(ORGS).map((id) => <OrgPanel id={id} />)}
      {/* Where the two meet: the mark of what they make together. */}
      <span class="seal" aria-hidden="true"><img src="/favicon-dark.svg" width="44" height="44" alt="" loading="lazy" /></span>
    </div>
  </section>
  <Close title="Talk to the team"><a slot="action" class="btn" href="/contact/">Get in touch<Arrow /></a></Close>
</Base>
<style>
  .team { padding: clamp(56px, 7vw, 96px) var(--edge) clamp(48px, 6vw, 80px); } .team h2 { margin-bottom: clamp(24px, 3vw, 40px); }
  .orgs { padding-block: clamp(56px, 7vw, 96px); } .orgs h2 { margin-bottom: clamp(24px, 3vw, 40px); padding-inline: var(--edge); }
  /* The two organisations with Openscholar's mark on the seam between them: side by side as equals where there is room
     (1180 px up), one above the other under that. The mark is placed from the first panel's edge, so it is on the seam
     whatever size either panel has. Both of the grid area's end lines are
     given: left to themselves they are the foot of the whole pair. */
  .pair { position: relative; display: grid; gap: var(--gap); container-type: inline-size; }
  /* The two are the same height wherever the picture stands beside the words, whichever has more to say. */
  @media (min-width: 761px) { .pair { grid-auto-rows: 1fr; } }
  @media (min-width: 1180px) { .pair { grid-template-columns: repeat(2, minmax(0, 1fr)); --logo-box: 58px; } }
  .seal { position: absolute; grid-area: 1 / 1 / 2 / 2; left: 50%; top: 100%; z-index: 2; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(#171c2b, #0b0f1a); color: #fff; box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1), 0 0 0 6px #fff, 0 20px 40px -14px rgb(4 7 16 / .6); translate: -50% calc(-50% + var(--gap) / 2); }
  .seal img { animation: seal 9s ease-in-out infinite alternate; } @keyframes seal { from { rotate: -8deg; } to { rotate: 8deg; } } .orgs:global(.away) .seal img { animation-play-state: paused; }
  @media (max-width: 900px) { .seal { width: 64px; height: 64px; } .seal img { width: 34px; height: 34px; } }
  /* On a phone the second organisation's logo starts under the middle of the seam, so the mark stands to the right of it. */
  @media (max-width: 700px) { .seal { left: auto; right: 28px; translate: 0 calc(-50% + var(--gap) / 2); } }
  /* Side by side, the seam is upright. The mark stands on it where the two pictures begin, under the words and buttons of
     both: a panel is half the pair less half the gap, its picture 9/21 of that tall, and the mark's top touches that line. It casts no shadow there: one would fall down the
     white of the seam. */
  @media (min-width: 1180px) { .seal { left: 100%; top: calc(100% - (50cqw - var(--gap) / 2) * 9 / 21 + 48px); translate: calc(-50% + var(--gap) / 2) -50%; box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1), 0 0 0 6px #fff; } }
</style>
