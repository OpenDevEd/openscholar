---
// Who makes Openscholar and where they are: the globe with the team on it over a row of the places they work in, everyone
// as a card that opens their own page, what they've published on a shelf, and the two organisations they work for.
import "../../styles/about.css";
import TRAVEL_JS from "../../scripts/travel.js?raw";
import Base from "../../layouts/Base.astro";
import TeamEarth from "../../components/TeamEarth.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import TeamShelf from "../../components/TeamShelf.astro";
import OrgPanel from "../../components/OrgPanel.astro";
import Close from "../../components/Close.astro";
import Arrow from "../../components/Arrow.astro";
import { ORGS, TEAM } from "../../data/team.mjs";
import { EARTH_PRELOAD_JS } from "../../data/site.mjs";
import markFile from "../../data/mark.svg?raw";
const MARK = markFile.replace(/<\/?svg[^>]*>/g, "");
---
<Base top="#070b1a" title="About: Openscholar" description="The people who make Openscholar, where they work, and the two organisations behind it.">
  {/* The planet's maps are asked for as the page arrives, as on the home page, so the globe is there sooner. */}
  <Fragment slot="head"><script is:inline set:html={EARTH_PRELOAD_JS} /><script is:inline set:html={TRAVEL_JS} /></Fragment>
  <TeamEarth />
  <section class="team" id="team" aria-labelledby="team-h">
    <h2 id="team-h">The team</h2>
    <TeamGrid people={TEAM} />
  </section>
  <TeamShelf />
  <section class="orgs" id="makers" aria-labelledby="orgs-h">
    <h2 id="orgs-h">Made by two organisations</h2>
    <div class="pair">
      {Object.keys(ORGS).map((id) => <OrgPanel id={id} />)}
      {/* Where the two meet: the mark of what they make together. */}
      <span class="seal" aria-hidden="true"><svg viewBox="0 0 64 64" width="44" height="44" set:html={MARK} /></span>
    </div>
  </section>
  <Close title="Talk to the team"><a slot="action" class="btn" href="/contact/">Get in touch<Arrow /></a></Close>
</Base>
<style>
  .team { padding: clamp(56px, 7vw, 96px) var(--edge) clamp(48px, 6vw, 80px); } .team h2 { margin-bottom: clamp(24px, 3vw, 40px); }
  .orgs { padding-block: clamp(56px, 7vw, 96px); } .orgs h2 { margin-bottom: clamp(24px, 3vw, 40px); padding-inline: var(--edge); }
  /* The two organisations one above the other, with Openscholar's mark on the seam between them. */
  .pair { position: relative; display: grid; gap: var(--gap); }
  .seal { position: absolute; left: 50%; top: 50%; z-index: 2; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(#171c2b, #0b0f1a); color: #fff; box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 0 0 1px rgb(255 255 255 / .1), 0 0 0 6px #fff, 0 20px 40px -14px rgb(4 7 16 / .6); translate: -50% -50%; }
  .seal svg { overflow: visible; animation: seal 9s ease-in-out infinite alternate; } @keyframes seal { from { rotate: -8deg; } to { rotate: 8deg; } }
  @media (max-width: 900px) { .seal { width: 64px; height: 64px; } .seal svg { width: 34px; height: 34px; } }
</style>
