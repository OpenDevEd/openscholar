---
// Hero to compare: the site's real Earth, every research institution lit, rising under the search box, with the communities standing along its limb. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Globe from "../../components/Globe.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const DROP = [214, 68, 0, 0, 68, 214];
---
<Base top="#020a2c" title="Hero 1: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="earth"><Globe /></div>
    <div class="inner ec">
      <h2>Evidence Communities are where anyone can read it</h2>
      <ul>{COMMUNITIES.map((c, i) => <li style={`--d:${DROP[i]}px;--c:${c.color}`}><a href={c.url}><img src={`/img/comm-${c.key}.avif`} width="280" height="280" decoding="async" alt="" /><b>{c.name}</b></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 112px 0 32px; background: radial-gradient(ellipse 70% 60% at 50% 100%, #123a8c, transparent 70%), #020a2c; text-align: center; }
  .c { position: relative; z-index: 1; display: grid; justify-items: center; gap: 16px; } h1 { max-width: 13em; font-size: clamp(38px, 4.6vw, 62px); } .lead { opacity: .9; } .c :global(.big) { width: min(100%, 720px); margin-top: 6px; }
  .earth { width: 130vw; margin: 28px -15vw -86vw; } .ec { position: relative; z-index: 1; display: grid; gap: 14px; } h2 { font-size: clamp(22px, 2vw, 26px); letter-spacing: -.02em; line-height: 1.16; text-wrap: balance; text-shadow: 0 1px 14px #020a2c; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } li { min-width: 0; } li a { display: grid; justify-items: center; align-content: start; gap: 6px; height: 100%; padding: 12px 8px; border-radius: 16px; transition: background .2s var(--ease); } li a:hover { background: color-mix(in srgb, var(--c) 24%, transparent); } li img { width: 60px; height: 60px; object-fit: contain; filter: saturate(1.4) drop-shadow(0 0 12px color-mix(in srgb, var(--c) 55%, transparent)); transition: transform .35s var(--ease); } li a:hover img { transform: scale(1.1); } li b { font-weight: 500; font-size: 14.5px; line-height: 1.2; letter-spacing: -.005em; text-wrap: balance; text-shadow: 0 1px 10px #020a2c, 0 0 3px #020a2c; }
  @media (min-width: 1000px) { .hero { height: 880px; overflow: clip; } .earth { position: absolute; z-index: 0; left: 50%; top: 500px; width: 1500px; margin: 0; translate: -50% 0; } .ec { position: absolute; left: 0; right: 0; top: 436px; display: block; } ul { grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: start; gap: 12px; } li { margin-top: var(--d); } li a { height: auto; } h2 { position: absolute; left: 50%; top: 118px; width: 520px; translate: -50% 0; } }
</style>
