---
// Hero to compare: the workspace above with its search box and a lens that sorts the literature, and a plain daylight directory of every community below it. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
---
<Base top="#01072c" title="Hero 1: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="os">
      <Art name="hero-lens" eager pos="100% 50%" />
      <div class="c">
        <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
        <p>Find the literature, screen it against your criteria and extract the data you need.</p>
        <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      </div>
    </div>
    <div class="ec light">
      <div class="t"><h2><b>Evidence Communities</b> are where anyone can read it</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
      <ul>{COMMUNITIES.map((c) => <li><a href={c.url}><img src={`/img/art-field-${c.key}-480.avif`} width="480" height="480" decoding="async" alt="" /><b>{c.name}</b><span>{c.host}</span></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; display: grid; grid-template-columns: minmax(0, 1fr); }
  h1, h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.06; text-wrap: balance; } h1 b, h2 b { font-weight: inherit; }
  .os { position: relative; isolation: isolate; overflow: clip; padding: 104px var(--pad) 44vw; background: #01072c; color: #fff; } .os > :global(.art) { inset: auto 0 0; height: auto; aspect-ratio: 16 / 9; z-index: -1; }
  .c { display: grid; justify-items: start; gap: calc(var(--hu) * 18); } h1 { font-size: clamp(34px, 8.4vw, calc(var(--hu) * 64)); color: #a9bbe6; } h1 b { color: #fff; } .c p { font-size: max(15px, calc(var(--hu) * 19)); line-height: 1.35; opacity: .86; } .c :global(.big) { width: 100%; } .c :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .ec { padding: 32px var(--pad) 24px; background: var(--soft); color: var(--ink); }
  .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; } h2 { font-size: clamp(24px, 5.6vw, calc(var(--hu) * 32)); color: var(--t2); } h2 b { color: var(--ink); } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: max(14px, calc(var(--hu) * 15)); transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  ul { display: grid; gap: 2px; margin-top: 16px; }
  li a { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 12px; align-items: center; padding: 8px; border-radius: 12px; transition: background .2s var(--ease); } li a:hover { background: #fff; box-shadow: 0 0 0 1px var(--line); } li img { grid-row: 1 / span 2; width: 44px; height: 44px; border-radius: 10px; object-fit: cover; } li b { font-weight: 500; font-size: 15px; line-height: 1.2; letter-spacing: -.01em; } li span { color: var(--t2); font: 400 12px/1.3 var(--mono); overflow: clip; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 1000px) {
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); height: max(620px, calc(100svh - 32px)); grid-template-rows: minmax(0, 1fr) auto; }
    .os { display: grid; align-items: center; padding: max(84px, calc(var(--hu) * 80)) var(--edge) calc(var(--hu) * 24); } .os > :global(.art) { inset: calc(var(--hu) * 76) -3% 0 40%; aspect-ratio: auto; height: auto; -webkit-mask-image: linear-gradient(90deg, transparent 6%, #000 34%); mask-image: linear-gradient(90deg, transparent 6%, #000 34%); }
    .c { width: calc(var(--hu) * 720); }
    .ec { padding: calc(var(--hu) * 26) var(--edge) calc(var(--hu) * 24); }
    ul { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: calc(var(--hu) * 8); margin-top: calc(var(--hu) * 16); margin-inline: calc(var(--hu) * -10); }
    li a { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; row-gap: calc(var(--hu) * 6); height: 100%; padding: calc(var(--hu) * 10); } li img { grid-row: auto; width: calc(var(--hu) * 64); height: calc(var(--hu) * 64); } li b { font-size: max(13px, calc(var(--hu) * 16)); } li span { font-size: max(11px, calc(var(--hu) * 12)); }
    .c :global(.big .mk), .c :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); }
  }
</style>
