---
// Hero to compare. The idea, from Greptile: one huge object tells the story. Here one question goes into a glass prism and comes out as the site's own colours, one for each part of the product. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
const RAYS = [["#22d3ee", "/#product", "Find", "Start with the whole literature"], ["#34d399", "/#screening", "Screen", "Decide what counts, once"], ["#fbbf24", "/#extraction", "Extract", "From papers to a table you can check"], ["#60a5fa", "/#assistant", "Assistant", "Delegate the groundwork"], ["#fb7185", "/evidence-communities/", "Communities", "Give your field a public home"]];
---
<Base top="#040b2c" title="Hero 1: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <img class="p" src="/img/art-hero-prism.avif" srcset="/img/art-hero-prism-960.avif 960w, /img/art-hero-prism.avif 1672w" sizes="100vw" width="1672" height="941" fetchpriority="high" alt="" />
    <div class="inner c">
      <h1>The evidence workspace for research teams</h1>
      <p class="lead">Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="inner"><ul>{RAYS.map(([c, h, t, s]) => <li style={`--c:${c}`}><a href={h}><b>{t}<Arrow /></b><span>{s}</span></a></li>)}</ul></div>
  </section>
</Base>
<style>
  .hero { position: relative; display: grid; align-content: start; padding: 112px 0 0; background: #040b2c; } .p { position: absolute; z-index: -1; left: 50%; top: 290px; width: 190vw; height: auto; max-width: none; translate: -50% 0; -webkit-mask-image: linear-gradient(transparent, #000 12%, #000 84%, transparent); mask-image: linear-gradient(transparent, #000 12%, #000 84%, transparent); }
  .c { display: grid; justify-items: start; gap: 18px; } h1 { max-width: 12em; } .c :global(.big) { width: min(100%, 600px); margin-top: 6px; } .lead { max-width: 30em; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 84vw; padding-bottom: 32px; } li a { display: grid; gap: 6px; padding-top: 14px; border-top: 2px solid var(--c); } li b { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 18px; letter-spacing: -.01em; } li b :global(i) { display: grid; color: var(--c); transition: transform .25s var(--ease); } li a:hover b :global(i) { transform: translateX(4px); } li span { font-size: 15px; line-height: 1.35; color: #c8d3ee; }
  @media (min-width: 1000px) { .p { left: 56%; top: auto; bottom: 20px; width: max(1680px, 118%); } .hero { min-height: 860px; align-content: space-between; padding-top: 128px; } ul { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; margin-top: 360px; padding-bottom: 36px; } }
</style>
