---
// Hero to compare: night above, a street of public sites in daylight below. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const Y = [32, 14, 0, 0, 14, 32];
const cap = (s) => s[0].toUpperCase() + s.slice(1);
---
<Base top="#040b2e" title="Hero 1: OpenScholar" description="Hero option">
  <section class="bleed h">
    <div class="night">
      <h1><b>OpenScholar</b> is where your team works through the evidence</h1>
      <div class="bar-w"><div class="anchor"><Art name="slot" eager /></div><AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" /></div>
    </div>
    <div class="day">
      <div class="d-t"><h2><b>Evidence Communities</b> are where anyone can read it</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
      <ul class="street">{COMMUNITIES.map((c, i) => <li style={`--y:${Y[i]}`}><a href={c.url}><b>{cap(c.subject)}</b><span class="frame"><span class="url">{c.host}</span><img src={`/img/site-${c.key}.avif`} width="960" height="600" decoding="async" alt="" /></span></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .h { --hu: 1px; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; }
  h1, h2 { font-weight: 500; letter-spacing: -.03em; line-height: 1.08; text-wrap: balance; } b { font-weight: inherit; }
  .night { position: relative; isolation: isolate; overflow: clip; display: grid; justify-items: center; gap: 24px; padding: 104px var(--pad) 48px; background: #040b2e; color: #fff; text-align: center; }
  .night::before { content: ""; position: absolute; z-index: -1; left: 50%; top: 40px; width: min(1160px, 100%); height: 300px; translate: -50% 0; background: radial-gradient(closest-side, #040b2e 72%, transparent); }
  h1 { max-width: 15em; font-size: clamp(34px, 8.4vw, 56px); color: #a9bbe6; } h1 b { color: #fff; }
  .bar-w { position: relative; width: min(100%, 720px); } .anchor { position: absolute; z-index: -2; left: 50%; top: 50%; width: max(100vw, 1000px); aspect-ratio: 16 / 9; translate: -50% -50%; }
  .day { padding: 32px 0 0; background: var(--soft); color: var(--ink); overflow: clip; }
  .d-t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; padding-inline: var(--pad); } h2 { font-size: clamp(24px, 5.6vw, 34px); color: var(--t2); } h2 b { color: var(--ink); }
  .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: 15px; } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  .street { display: flex; gap: 12px; margin-top: 16px; padding: 16px var(--pad) 32px; overflow-x: auto; scroll-snap-type: x mandatory; } li { flex: none; width: 66vw; scroll-snap-align: center; } li a { display: grid; gap: 8px; } li b { font-size: 15px; letter-spacing: -.01em; }
  .frame { display: block; border-radius: 12px; background: #fff; overflow: clip; box-shadow: 0 0 0 1px var(--line), 0 24px 44px -28px rgb(10 26 63 / .6); transition: transform .45s var(--ease), box-shadow .3s var(--ease); } li a:hover .frame { transform: translateY(-10px); box-shadow: 0 0 0 1px var(--line2), 0 36px 54px -28px rgb(10 26 63 / .7); }
  .url { display: flex; align-items: center; height: 28px; padding-inline: 10px; color: var(--t2); font: 400 11px/1 var(--mono); white-space: nowrap; overflow: clip; border-bottom: 1px solid var(--line); } .frame img { display: block; width: 100%; height: auto; max-width: none; }
  @media (min-width: 1000px) {
    .h { --hu: max(.62px, min(1px, 100svh / 900, 100vw / 1400)); height: 100svh; min-height: 620px; grid-template-rows: auto minmax(0, 1fr); }
    .night { gap: calc(var(--hu) * 32); padding: calc(max(88px, var(--hu) * 164)) var(--pad) calc(var(--hu) * 144); } h1 { font-size: calc(var(--hu) * 64); }
    .bar-w { width: calc(var(--hu) * 760); } .bar-w :global(.big input) { height: max(46px, calc(var(--hu) * 64)); font-size: max(15px, calc(var(--hu) * 19)); }
    .day { display: grid; grid-template-columns: minmax(0, 1fr); align-content: space-between; padding-top: calc(var(--hu) * 32); } .d-t { padding-inline: max(var(--pad), calc(50vw - 624px)); } h2 { font-size: calc(var(--hu) * 32); }
    .street { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: calc(var(--hu) * 12); margin: calc(var(--hu) * 8) 0 calc(var(--hu) * -24); padding: calc(var(--hu) * 16) calc(var(--hu) * 24) 0; overflow: visible; } li { width: auto; margin-top: calc(var(--hu) * var(--y)); } li b { font-size: max(13px, calc(var(--hu) * 15)); }
  }
</style>
