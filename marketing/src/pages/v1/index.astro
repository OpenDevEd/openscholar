---
// Hero to compare: the search box beside what it gives you, a real question answered with papers already sorted. The communities follow as their own section. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import { COMMUNITIES } from "../../data/site.mjs";
const PAPERS = [["Using Peer Tutoring to Improve Reading Skills", 2015, true], ["Peer tutoring in reading in Scotland: thinking big", 2011, true], ["Peer tutoring of reading using paired reading", 1988, true], ["Peer Tutored Instruction in Reading", 1996, false]];
---
<Base top="#01072c" title="Hero 1: OpenScholar" description="Hero option">
  <section class="bleed hero">
    <div class="inner g">
      <div class="c">
        <h1>The evidence workspace for research teams</h1>
        <p>Find the literature, screen it against your criteria and extract the data you need.</p>
        <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
      </div>
      <div class="ans" aria-label="An example of a search in OpenScholar">
        <p class="q"><Icon name="search" size={18} />Does peer tutoring improve reading?</p>
        <p class="a">Studies point the same way: pupils paired to read together tend to read better, and the tutors gain as well as the tutees.</p>
        <ul>{PAPERS.map(([t, y, ok]) => <li class:list={{ out: !ok }}><span class="m" aria-label={ok ? "Included" : "Excluded"}>{ok ? <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg> : <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>}</span><b>{t}</b><em>{y}</em></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="bleed ec light">
    <div class="inner t"><h2>Evidence Communities are public homes for a field's evidence</h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
    <ul class="row">{COMMUNITIES.map((c) => <li><a href={c.url}><span class="f"><span class="u">{c.host}</span><img src={`/img/site-${c.key}.avif`} width="960" height="600" decoding="async" loading="lazy" alt="" /></span><b>{c.name}</b></a></li>)}</ul>
  </section>
</Base>
<style>
  .hero { padding: 128px 0 72px; background: #01072c; color: #fff; } .g { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; }
  .c { display: grid; justify-items: start; align-content: center; gap: 18px; } h1 { font-weight: 500; font-size: clamp(38px, 5vw, 60px); letter-spacing: -.035em; line-height: 1.04; text-wrap: balance; } .c > p { font-size: 19px; line-height: 1.35; opacity: .86; } .c :global(.big) { width: 100%; margin-top: 8px; }
  .ans { padding: 22px; border-radius: 20px; background: #0c1334; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12), 0 40px 70px -30px #000; } .q { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 500; letter-spacing: -.01em; } .q :global(svg) { flex: none; color: #8fb4ff; } .a { margin-top: 12px; font-size: 16px; line-height: 1.45; color: #c8d3ee; }
  .ans ul { display: grid; gap: 2px; margin-top: 16px; } .ans li { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 11px 10px; border-radius: 12px; background: rgb(255 255 255 / .05); } .m { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 8px; background: #17603f; color: #7ff0bb; } .ans b { font-weight: 400; font-size: 15px; line-height: 1.25; } .ans em { font: 400 13px/1 var(--mono); color: #93a3cc; } .out { opacity: .55; } .out .m { background: rgb(255 255 255 / .1); color: #fff; } .out b { text-decoration: line-through; text-decoration-thickness: 1px; }
  .ec { padding: 64px 0 72px; background: var(--soft); color: var(--ink); overflow: clip; } .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; } h2 { max-width: 20em; font-weight: 500; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -.03em; line-height: 1.1; text-wrap: balance; } .all { display: inline-flex; align-items: center; gap: 8px; color: var(--t2); font-size: 15px; transition: color .2s var(--ease); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; }
  .row { display: flex; gap: 20px; margin-top: 28px; padding: 6px max(calc(var(--gap) + var(--pad)), calc(50vw - 640px + var(--gap) + var(--pad))) 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; } .row li { flex: none; width: min(78vw, 400px); scroll-snap-align: center; } .row a { display: grid; gap: 10px; } .f { display: block; border-radius: 14px; background: #fff; overflow: clip; box-shadow: 0 0 0 1px var(--line), 0 24px 40px -28px rgb(10 26 63 / .55); transition: box-shadow .25s var(--ease); } .row a:hover .f { box-shadow: 0 0 0 2px var(--brand), 0 24px 40px -28px rgb(10 26 63 / .55); } .u { display: block; padding: 8px 12px; color: var(--t2); font: 400 12px/1.2 var(--mono); border-bottom: 1px solid var(--line); } .f img { display: block; width: 100%; height: auto; max-width: none; } .row b { font-weight: 500; font-size: 16px; line-height: 1.25; letter-spacing: -.01em; }
  @media (min-width: 1000px) { .g { grid-template-columns: minmax(0, 1fr) 560px; gap: 64px; } .hero { padding-bottom: 88px; } }
</style>
