---
// Hero to compare: the workspace in a dark hall, lit by one great stained-glass window whose six panes are the six communities. Delete once one is picked.
import Base from "../../layouts/Base.astro";
import Art from "../../components/Art.astro";
import AskBar from "../../components/AskBar.astro";
import Arrow from "../../components/Arrow.astro";
import Fill from "../../components/Fill.astro";
import { COMMUNITIES } from "../../data/site.mjs";
// One pane: a slice of the circle from angle a to b, with a sliver left between panes for the leading.
const pane = (i) => { const gap = 1, a = i * 60 - 120 + gap, b = i * 60 - 60 - gap, pts = ["50% 50%"]; for (let t = 0; t <= 10; t++) { const r = ((a + (b - a) * t / 10) * Math.PI) / 180; pts.push(`${(50 + 50 * Math.cos(r)).toFixed(2)}% ${(50 + 50 * Math.sin(r)).toFixed(2)}%`); } return `polygon(${pts.join(",")})`; };
const mid = (i) => { const r = ((i * 60 - 90) * Math.PI) / 180; return [(50 + 35 * Math.cos(r)).toFixed(2), (50 + 35 * Math.sin(r)).toFixed(2)]; };
---
<Base top="#01072c" title="Hero 7: OpenScholar" description="Hero option">
  <section class="bleed h">
    <Art name="hero-deep" eager />
    <div class="os">
      <h1><Fill tex="sea" class="w">OpenScholar</Fill> <span>is where your team works through the evidence</span></h1>
      <p>Find the literature, screen it against your criteria and extract the data you need.</p>
      <AskBar id="ask-hero" class="big" typing mark label="Search with OpenScholar" />
    </div>
    <div class="rose">
      <ul>{COMMUNITIES.map((c, i) => <li style={`clip-path:${pane(i)};--x:${mid(i)[0]};--y:${mid(i)[1]}`}><a href={c.url} aria-label={`${c.name}, ${c.host}`}><img src={`/img/art-scene-${c.key}-960.avif`} width="960" height="960" decoding="async" alt="" /><span class="lab"><Fill tex={`tx-${c.key}-960`} base={c.color}>{c.word}</Fill>{c.name !== c.word && <small>{c.name}</small>}</span></a></li>)}</ul>
      <div class="hub light"><h2><Fill tex="tx-glass" flat base="#0a1a4f">Evidence</Fill><Fill tex="tx-glass" flat base="#0a1a4f">Communities</Fill> <span>are where anyone can read it</span></h2><a class="all" href="/evidence-communities/">How they work<Arrow /></a></div>
    </div>
    <p class="below"><span>Evidence Communities are where anyone can read it</span> <a href="/evidence-communities/">How they work<Arrow /></a></p>
  </section>
</Base>
<style>
  .h { --hu: 1px; --d: min(calc(100vw - 16px), 620px); position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; justify-items: center; padding: 104px var(--pad) 24px; background: #01072c; color: #fff; overflow: clip; } .h > :global(.art) { inset: 0; z-index: -1; }
  .os { justify-self: stretch; display: grid; justify-items: start; gap: calc(var(--hu) * 16); container-type: inline-size; } h1 { display: grid; gap: calc(var(--hu) * 8); font-weight: 500; } :global(.w) { font-size: calc(100cqw / 5.35); } h1 span { font-size: max(22px, calc(var(--hu) * 34)); letter-spacing: -.025em; line-height: 1.12; color: #a9bbe6; text-wrap: balance; } .os p { font-size: max(15px, calc(var(--hu) * 18)); line-height: 1.35; opacity: .86; } .os :global(.big) { width: 100%; } .os :global(.big input) { height: max(46px, calc(var(--hu) * 60)); font-size: max(15px, calc(var(--hu) * 18)); }
  .rose { position: relative; width: var(--d); height: var(--d); border-radius: 50%; background: #070c24; box-shadow: 0 0 0 calc(var(--d) * .012) #131b3f, 0 0 0 calc(var(--d) * .02) rgb(255 255 255 / .14), 0 0 calc(var(--d) * .22) calc(var(--d) * .02) rgb(120 170 255 / .22); }
  ul { position: absolute; inset: 0; } li { position: absolute; inset: 0; } li a { display: block; width: 100%; height: 100%; position: relative; isolation: isolate; color: #fff; } li a::after { content: ""; position: absolute; inset: 0; z-index: -1; background: rgb(1 7 44 / .3); transition: background .25s var(--ease); } li a:hover::after { background: rgb(1 7 44 / 0); }
  li img { position: absolute; z-index: -2; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%); width: 62%; height: 62%; max-width: none; translate: -50% -50%; object-fit: cover; }
  .lab { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%); translate: -50% -50%; display: grid; justify-items: center; width: calc(var(--d) * .29); gap: 2px; text-align: center; pointer-events: none; } .lab :global(.fill) { font-size: calc(var(--d) * .054); filter: drop-shadow(0 2px 8px rgb(0 0 0 / .85)); } small { display: none; font-size: calc(var(--d) * .0175); line-height: 1.2; opacity: .9; text-wrap: balance; text-shadow: 0 1px 6px rgb(0 0 0 / .8); }
  .hub { position: absolute; left: 50%; top: 50%; width: 34%; height: 34%; translate: -50% -50%; display: grid; place-content: center; justify-items: center; gap: 4px; border-radius: 50%; background: #f3f6fb; color: var(--ink); text-align: center; box-shadow: 0 0 0 calc(var(--d) * .008) #131b3f, 0 0 0 calc(var(--d) * .014) rgb(255 255 255 / .2); } h2 { display: grid; justify-items: center; font-weight: 500; } h2 :global(.fill) { --blend: normal; font-size: calc(var(--d) * .036); line-height: 1; } h2 span { margin-top: 4px; font-size: calc(var(--d) * .0185); line-height: 1.2; color: var(--t2); letter-spacing: -.01em; } .all { display: inline-flex; align-items: center; gap: 4px; font-size: calc(var(--d) * .017); color: var(--t2); } .all:hover { color: var(--ink); } .all :global(i) { display: grid; scale: .7; }
  .below { display: grid; justify-items: center; gap: 6px; text-align: center; font-size: 16px; line-height: 1.3; color: #a9bbe6; } .below a { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-size: 15px; } .below :global(i) { display: grid; } .hub span, .hub .all { display: none; } h2 :global(.fill) { font-size: calc(var(--d) * .042); }
  @media (min-width: 1000px) {
    .below { display: none; } .hub span { display: block; } .hub .all { display: inline-flex; } h2 :global(.fill) { font-size: calc(var(--d) * .036); }
    .h { --strip: min(100vw - var(--pad) * 2, max(1248px, (100svh - 32px) * 1.44)); --edge: calc((100vw - var(--strip)) / 2); --hu: max(.62px, min(var(--strip) / 1248, (100svh - 32px) / 868)); --d: calc(var(--hu) * 770); height: max(620px, calc(100svh - 32px)); padding: 0 var(--edge); grid-template-columns: minmax(0, 1fr) var(--d); column-gap: calc(var(--hu) * 40); align-items: center; }
    .os :global(.big .mk), .os :global(.big .btn) { zoom: max(1, tan(atan2(var(--hu), 1px))); } .os :global(.big .btn span) { display: none; } .os :global(.big .btn) { padding-left: 8px; }
    .rose { margin-top: calc(var(--hu) * 56); } small { display: block; }
  }
</style>
