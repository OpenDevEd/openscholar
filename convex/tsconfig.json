{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,

    /* Match root tsconfig path alias so Convex esbuild resolves @/*.
     * Omit baseUrl on purpose — setting it would steal bare-package
     * imports like "stripe" and resolve them against convex/ (which has
     * a local stripe.ts component). paths without baseUrl is valid for
     * TS >= 4.1 when entries are relative. */
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["./**/*"],
  "exclude": [
    "./_generated",
    /* `@convex-dev/workflow/test` ships .ts source whose `register`
     * function has a generic-narrowing bug (workpool.register can't
     * accept the local Schema generic). Importing it from inside
     * `convex/` makes the convex CLI's `tsc` step walk into the broken
     * module and fail the push. The helper file itself is excluded,
     * and so are all `.test.ts` files under `convex/` — TypeScript
     * follows imports regardless of `exclude`, so any test that
     * imports the helper would drag the broken module back into the
     * push's typecheck pass. Tests aren't deployed, and vitest still
     * type-checks them via the root tsconfig.json. */
    "./extraction/workflow.test-support.ts",
    "./**/*.test.ts"
  ]
}
