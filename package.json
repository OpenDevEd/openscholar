{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "worker": "tsx app/actions/worker.ts",
    "worker:dev": "tsx --watch app/actions/worker.ts",
    "worker:prod": "NODE_ENV=production tsx app/actions/worker.ts",
    "worker:pm2": "pm2 start ecosystem.config.js",
    "worker:pm2:dev": "pm2 start ecosystem.config.js --env development",
    "worker:pm2:prod": "pm2 start ecosystem.config.js --env production",
    "worker:pm2:stop": "pm2 stop ecosystem.config.js",
    "worker:pm2:restart": "pm2 restart ecosystem.config.js",
    "worker:pm2:delete": "pm2 delete ecosystem.config.js",
    "worker:pm2:logs": "pm2 logs openalex-worker",
    "worker:pm2:monit": "pm2 monit",
    "dev:full": "concurrently \"npm run dev\" \"npm run worker:dev\""
  },
