{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "dev:all": "pm2 start ecosystem.config.js",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:perf": "vitest bench --config vitest.perf.config.ts",
    "bench:transactions": "vitest bench --config vitest.perf.config.ts tests/perf/billing-transactions.bench.ts",
    "test:billing:preflight": "node ./scripts/billing-preflight.mjs",
    "test:billing:live": "vitest run --config vitest.live.config.ts tests/live-billing/required.test.ts",
    "test:billing:live:ci": "BILLING_LIVE_PUSH_CONVEX=true npm run test:billing:preflight -- --push-convex && npm run test:billing:live",
    "test:billing:extended": "vitest run --config vitest.live.config.ts tests/live-billing/extended.test.ts",
    "test:billing:extended:ci": "BILLING_LIVE_PUSH_CONVEX=true npm run test:billing:preflight -- --push-convex && npm run test:billing:extended",
    "test:billing:e2e": "playwright test --project=billing",
    "test:e2e:auth": "playwright test e2e/auth.spec.ts --config=playwright.config.ts",
    "test:ci": "npm run test && npm run build && npm run test:e2e:auth",
    "test:all": "npm run test:ci && npm run test:billing:e2e",
    "wallet-cli": "tsx scripts/wallet-cli.ts"
  },
